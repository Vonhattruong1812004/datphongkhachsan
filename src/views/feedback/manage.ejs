<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const data = typeof payload !== "undefined" ? payload : {};
  const filters = data.filters || {};
  const items = data.items || [];
  const summary = data.summary || {};
  const statusSummary = data.statusSummary || summary;
  const allServiceTypes = data.serviceTypes || ["Lưu trú", "Nhà hàng", "SPA", "Giặt là", "Dịch vụ khác"];
  const serviceTypes = allServiceTypes.filter((type) => type !== "Tư vấn");
  const advisoryTopics = data.advisoryTopics || [];
  const success = typeof successMessage !== "undefined" ? successMessage : "";
  const error = typeof errorMessage !== "undefined" ? errorMessage : "";
  const pageMode = typeof mode !== "undefined" && mode ? mode : "feedback";
  const advisoryMode = pageMode === "advisory";
  const currentUserName = (typeof currentUser !== "undefined" && currentUser ? (currentUser.displayName || currentUser.username) : "") || "CSKH";
  const totalRows = Number(data.totalRows || 0);
  const currentPage = Number(data.page || 1);
  const totalPages = Number(data.totalPages || 1);
  const baseManagePath = advisoryMode ? "/feedback/advisory/manage" : "/feedback/manage";
  const filterKeys = ["keyword", "khach_hang", "trang_thai", "danh_gia", "loai_dich_vu", "tu_van_nhom", "sentiment", "uu_tien", "thang", "tu_ngay", "den_ngay", "page", "id"];
  const exportHref = `${baseManagePath}/export.csv${buildQuery({ page: "", id: "" })}`;
  const statuses = [
    { value: "all", label: "Tất cả" },
    { value: "ChuaXuLy", label: advisoryMode ? "Chưa trả lời" : "Chưa xử lý" },
    { value: "DangXuLy", label: advisoryMode ? "Đang follow-up" : "Đang xử lý" },
    { value: "DaXuLy", label: "Đã xử lý" }
  ];
  const statusOptions = statuses.filter((item) => item.value !== "all");
  const ratings = [
    { value: "all", label: "Tất cả" },
    { value: "5", label: "5 sao" },
    { value: "4plus", label: "Từ 4 sao" },
    { value: "3minus", label: "Từ 3 sao trở xuống" },
    { value: "4", label: "4 sao" },
    { value: "3", label: "3 sao" },
    { value: "2", label: "2 sao" },
    { value: "1", label: "1 sao" }
  ];
  const sentiments = [
    { value: "all", label: "Tất cả" },
    { value: "Negative", label: "Tiêu cực" },
    { value: "Neutral", label: "Trung lập" },
    { value: "Positive", label: "Tích cực" }
  ];
  const priorities = [
    { value: "all", label: "Tất cả" },
    { value: "urgent", label: "Khẩn cấp" },
    { value: "high", label: "Ưu tiên cao" },
    { value: "overdue", label: "Quá SLA" }
  ];
  const statusTabs = [
    { value: "all", label: "Tất cả", count: statusSummary.tong },
    { value: "ChuaXuLy", label: advisoryMode ? "Chưa trả lời" : "Chưa xử lý", count: statusSummary.chua_xu_ly },
    { value: "DangXuLy", label: "Đang xử lý", count: statusSummary.dang_xu_ly },
    { value: "DaXuLy", label: "Đã xử lý", count: statusSummary.da_xu_ly }
  ];
  function numberText(value) {
    return Number(value || 0).toLocaleString("vi-VN");
  }

  function selectedAttr(actual, expected) {
    return String(actual || "all") === String(expected) ? "selected" : "";
  }

  function activeClass(actual, expected) {
    return String(actual || "all") === String(expected) ? "is-active" : "";
  }

  function toneClass(tone) {
    return `is-${tone || "neutral"}`;
  }

  function statusLabel(status) {
    return ({ ChuaXuLy: advisoryMode ? "Chưa trả lời" : "Chưa xử lý", DangXuLy: "Đang xử lý", DaXuLy: "Đã xử lý" }[status] || status || "Chưa xử lý");
  }

  function statusTone(status) {
    return ({ ChuaXuLy: "pending", DangXuLy: "processing", DaXuLy: "done" }[status] || "pending");
  }

  function sentimentLabel(sentiment) {
    return ({ Positive: "Tích cực", Neutral: "Trung lập", Negative: "Tiêu cực" }[sentiment] || "Trung lập");
  }

  function sentimentTone(sentiment) {
    return ({ Positive: "positive", Neutral: "neutral", Negative: "negative" }[sentiment] || "neutral");
  }

  function buildQuery(extra) {
    const merged = Object.assign({}, filters, { page: currentPage }, extra || {});
    const params = [];
    filterKeys.forEach(function (key) {
      const value = merged[key];
      if (value === undefined || value === null || value === "" || value === "all") return;
      if (key === "page" && Number(value) <= 1) return;
      params.push(`${encodeURIComponent(key)}=${encodeURIComponent(String(value))}`);
    });
    return params.length ? `?${params.join("&")}` : "";
  }
%>

<style>
  body{background:#eef6ff;color:#102033}
  .feedback-page{
    --blue:#0575e6;
    --blue-dark:#034ea2;
    --ink:#102033;
    --muted:#65758b;
    --line:#cfe2f7;
    --soft:#f4f9ff;
    --green:#07875f;
    --red:#c0263d;
    --amber:#b45309;
    width:min(1380px,calc(100vw - 40px));
    margin:0 auto;
    padding:28px 0 56px;
  }
  .fb-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    border-radius:12px;
    padding:20px 24px;
    background:linear-gradient(135deg,var(--blue),var(--blue-dark));
    color:#fff;
    box-shadow:0 18px 42px rgba(0,90,190,.18);
  }
  .fb-title h1{margin:0;font-size:34px;line-height:1.08;color:#fff}
  .fb-title h1::before{content:"";display:inline-block;width:6px;height:38px;border-radius:999px;background:#fff;margin-right:12px;vertical-align:-7px}
  .fb-title p{margin:5px 0 0;color:rgba(255,255,255,.86);font-weight:750}
  .fb-title-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
  .fb-btn,.filter-summary{
    min-height:44px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    border:1px solid var(--line);
    border-radius:9px;
    padding:0 14px;
    background:#fff;
    color:#06479d;
    text-decoration:none;
    font:inherit;
    font-weight:850;
    cursor:pointer;
  }
  .fb-btn:hover,.filter-summary:hover{background:#f0f7ff;border-color:#9ecbff}
  .fb-btn.is-primary{background:var(--blue);border-color:var(--blue);color:#fff}
  .fb-btn.is-danger{background:#fff;border-color:#ffc4c4;color:#b91c1c}
  .fb-alert{margin-top:14px;border-radius:10px;padding:12px 14px;border:1px solid var(--line);background:#fff;font-weight:800}
  .fb-alert.is-success{border-color:#a7f3d0;background:#ecfdf5;color:#047857}
  .fb-alert.is-error{border-color:#fecaca;background:#fff1f2;color:#be123c}
  .fb-toolbar{
    position:relative;
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid var(--line);
    border-radius:12px;
    background:rgba(255,255,255,.94);
    padding:12px;
    box-shadow:0 14px 35px rgba(15,23,42,.07);
    z-index:4;
  }
  .fb-search{display:flex;align-items:center;gap:8px;flex:0 1 560px;min-width:280px;max-width:620px}
  .fb-export-btn{margin-left:auto}
  .fb-search input{width:100%;min-height:44px;border:1px solid var(--line);border-radius:9px;padding:0 13px;font:inherit;font-weight:700;color:var(--ink);outline:none}
  .fb-search input:focus,.fb-field input:focus,.fb-field select:focus,.fb-field textarea:focus{border-color:#83bfff;box-shadow:0 0 0 4px rgba(5,117,230,.12)}
  .fb-filter{position:relative}
  .fb-filter details{position:relative}
  .fb-filter details[open] .filter-panel{display:block}
  .filter-summary{list-style:none}
  .filter-summary::-webkit-details-marker{display:none}
  .filter-panel{
    display:none;
    position:absolute;
    left:0;
    top:calc(100% + 10px);
    width:min(780px,calc(100vw - 70px));
    border:1px solid var(--line);
    border-radius:12px;
    background:#fff;
    box-shadow:0 28px 70px rgba(15,23,42,.18);
    padding:16px;
    z-index:20;
  }
  .filter-panel h2{margin:0 0 12px;font-size:22px;color:#06479d;text-align:center}
  .filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .fb-field{display:grid;gap:6px}
  .fb-field label{font-size:13px;font-weight:850;color:var(--ink)}
  .fb-field input,.fb-field select,.fb-field textarea{width:100%;min-height:42px;border:1px solid var(--line);border-radius:9px;background:#fff;padding:0 12px;font:inherit;font-weight:700;color:var(--ink);box-sizing:border-box;outline:none}
  .fb-field textarea{min-height:118px;padding:12px;line-height:1.5;resize:vertical}
  .filter-actions{display:flex;justify-content:space-between;gap:10px;margin-top:14px;border-top:1px solid #e6eef8;padding-top:14px}
  .status-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
  .status-tabs a{display:inline-flex;align-items:center;gap:8px;min-height:40px;border:1px solid var(--line);border-radius:999px;padding:0 13px;background:#fff;color:#06479d;text-decoration:none;font-weight:850}
  .status-tabs a.is-active{background:var(--blue);border-color:var(--blue);color:#fff}
  .fb-table-panel,.fb-detail-panel{margin-top:14px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.96);box-shadow:0 18px 45px rgba(15,23,42,.08);overflow:hidden}
  .fb-table{width:100%;border-collapse:collapse;table-layout:fixed}
  .fb-table th{height:52px;background:#edf3f9;color:#334155;font-size:13px;text-align:left;text-transform:uppercase;letter-spacing:.02em}
  .fb-table th,.fb-table td{padding:12px 14px;border-bottom:1px solid #e3edf8;vertical-align:middle}
  .fb-table tr{cursor:pointer}
  .fb-table tbody tr:hover{background:#f7fbff}
  .fb-table tbody tr.is-active{background:#edf6ff}
  .fb-code{font-weight:950;color:#06479d}
  .fb-main-text{display:block;color:var(--ink);font-weight:900;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .fb-sub-text{display:block;margin-top:3px;color:var(--muted);font-size:13px;font-weight:700;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .fb-badge{display:inline-flex;align-items:center;justify-content:center;min-height:28px;border-radius:999px;padding:0 9px;border:1px solid var(--line);background:#f8fbff;color:#475569;font-size:12px;font-weight:850;white-space:nowrap}
  .fb-badge.is-done,.fb-badge.is-positive{border-color:#a7f3d0;background:#ecfdf5;color:#047857}
  .fb-badge.is-processing,.fb-badge.is-blue{border-color:#bae6fd;background:#ecfeff;color:#0369a1}
  .fb-badge.is-pending,.fb-badge.is-yellow{border-color:#fde68a;background:#fffbeb;color:#92400e}
  .fb-badge.is-negative{border-color:#fecaca;background:#fff1f2;color:#be123c}
  .fb-badge.is-neutral{border-color:#dbe4ef;background:#f8fafc;color:#475569}
  .fb-stars{color:#f59e0b;font-weight:900;white-space:nowrap}
  .fb-empty{padding:28px;border:1px dashed var(--line);border-radius:10px;background:#f8fbff;color:var(--muted);font-weight:800;text-align:center}
  .fb-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;background:#fff}
  .fb-pages{display:flex;gap:6px;align-items:center}
  .fb-page{min-width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:8px;background:#fff;color:#06479d;text-decoration:none;font-weight:850}
  .fb-page.is-active{background:var(--blue);border-color:var(--blue);color:#fff}
  .fb-detail-panel{padding:18px;overflow:visible}
  .detail-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px}
  .detail-head h2{margin:0;font-size:26px;color:var(--ink)}
  .detail-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px}
  .detail-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:14px}
  .detail-card{border:1px solid var(--line);border-radius:10px;background:#fff;padding:14px}
  .detail-card h3{margin:0 0 10px;font-size:20px}
  .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .info-cell{border:1px solid #e3edf8;border-radius:9px;background:#f8fbff;padding:10px}
  .info-cell span{display:block;color:var(--muted);font-size:12px;font-weight:850;text-transform:uppercase}
  .info-cell strong{display:block;margin-top:4px;color:var(--ink);font-size:14px;word-break:break-word}
  .feedback-content{white-space:pre-line;color:#334155;line-height:1.55;font-weight:700}
  .attachment{display:block;margin-top:12px;border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .attachment img{display:block;width:100%;max-height:260px;object-fit:cover}
  .suggestions{display:grid;gap:8px;margin-top:10px}
  .suggestions button{width:100%;text-align:left;border:1px solid #bae6fd;border-radius:9px;background:#f4fbff;color:#06479d;padding:10px 12px;font:inherit;font-weight:750;cursor:pointer}
  .thread{display:grid;gap:8px}
  .thread-item{border:1px solid #e3edf8;border-radius:9px;background:#f8fbff;padding:10px}
  .thread-item strong{display:block;color:var(--ink)}
  .thread-item small{display:block;margin-top:3px;color:var(--muted);font-weight:750}
  .form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}
  .mobile-only{display:none}
  @media(max-width:1080px){
    .feedback-page{width:min(100% - 24px,900px)}
    .fb-toolbar{flex-wrap:wrap}
    .fb-search{flex:1 1 100%;max-width:none}
    .fb-export-btn{margin-left:0}
    .detail-grid{grid-template-columns:1fr}
  }
  @media(max-width:760px){
    .fb-title{display:block;padding:18px}
    .fb-title h1{font-size:28px}
    .fb-title-actions{justify-content:flex-start;margin-top:12px}
    .filter-grid,.info-grid{grid-template-columns:1fr}
    .fb-table{min-width:860px}
    .fb-table-panel{overflow-x:auto}
    .fb-pagination{display:block}
    .fb-pages{margin-top:10px;flex-wrap:wrap}
  }
</style>

<main class="feedback-page">
  <section class="fb-title">
    <div>
      <h1><%= advisoryMode ? "Trả lời tư vấn" : "Quản lý phản hồi" %></h1>
      <p><%= advisoryMode ? "Tiếp nhận câu hỏi, trả lời theo ngữ cảnh và theo dõi follow-up." : "Tiếp nhận phản hồi, phân loại ưu tiên, trả lời khách và đóng case." %></p>
    </div>
    <div class="fb-title-actions">
      <a class="fb-btn" href="/dashboard/cskh">Quay về</a>
      <a class="fb-btn" href="<%= advisoryMode ? "/feedback/manage" : "/feedback/advisory/manage" %>"><%= advisoryMode ? "Sang phản hồi" : "Sang tư vấn" %></a>
    </div>
  </section>

  <% if (success) { %><div class="fb-alert is-success"><%= success %></div><% } %>
  <% if (error) { %><div class="fb-alert is-error"><%= error %></div><% } %>

  <form method="get" action="<%= baseManagePath %>">
    <section class="fb-toolbar" aria-label="Tìm kiếm và lọc">
      <div class="fb-filter">
        <details>
          <summary class="filter-summary">Bộ lọc</summary>
          <div class="filter-panel">
            <h2>Bộ lọc</h2>
            <div class="filter-grid">
              <div class="fb-field">
                <label>Trạng thái</label>
                <select name="trang_thai">
                  <% statuses.forEach((item) => { %>
                    <option value="<%= item.value %>" <%= selectedAttr(filters.trang_thai, item.value) %>><%= item.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="fb-field">
                <label>Ưu tiên</label>
                <select name="uu_tien">
                  <% priorities.forEach((item) => { %>
                    <option value="<%= item.value %>" <%= selectedAttr(filters.uu_tien, item.value) %>><%= item.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="fb-field">
                <label>Khách hàng</label>
                <input name="khach_hang" value="<%= filters.khach_hang || "" %>" placeholder="Tên, email hoặc SĐT khách..." />
              </div>
              <div class="fb-field">
                <label>Tháng</label>
                <input type="month" name="thang" value="<%= filters.thang || "" %>" />
              </div>
              <% if (advisoryMode) { %>
                <input type="hidden" name="loai_dich_vu" value="Tư vấn" />
                <input type="hidden" name="danh_gia" value="all" />
                <input type="hidden" name="sentiment" value="all" />
                <div class="fb-field">
                  <label>Nhóm câu hỏi</label>
                  <select name="tu_van_nhom">
                    <% advisoryTopics.forEach((item) => { %>
                      <option value="<%= item.value %>" <%= selectedAttr(filters.tu_van_nhom, item.value) %>><%= item.label %></option>
                    <% }) %>
                  </select>
                </div>
              <% } else { %>
                <div class="fb-field">
                  <label>Đánh giá</label>
                  <select name="danh_gia">
                    <% ratings.forEach((item) => { %>
                      <option value="<%= item.value %>" <%= selectedAttr(filters.danh_gia, item.value) %>><%= item.label %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="fb-field">
                  <label>Cảm xúc</label>
                  <select name="sentiment">
                    <% sentiments.forEach((item) => { %>
                      <option value="<%= item.value %>" <%= selectedAttr(filters.sentiment, item.value) %>><%= item.label %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="fb-field">
                  <label>Loại dịch vụ</label>
                  <select name="loai_dich_vu">
                    <option value="all" <%= selectedAttr(filters.loai_dich_vu, "all") %>>Tất cả</option>
                    <% serviceTypes.forEach((type) => { %>
                      <option value="<%= type %>" <%= selectedAttr(filters.loai_dich_vu, type) %>><%= type %></option>
                    <% }) %>
                  </select>
                </div>
              <% } %>
              <div class="fb-field">
                <label>Từ ngày</label>
                <input type="date" name="tu_ngay" value="<%= filters.tu_ngay || "" %>" />
              </div>
              <div class="fb-field">
                <label>Đến ngày</label>
                <input type="date" name="den_ngay" value="<%= filters.den_ngay || "" %>" />
              </div>
            </div>
            <div class="filter-actions">
              <a class="fb-btn" href="<%= baseManagePath %>">Đặt lại</a>
              <button class="fb-btn is-primary" type="submit">Áp dụng lọc</button>
            </div>
          </div>
        </details>
      </div>

      <div class="fb-search">
        <input name="keyword" value="<%= filters.keyword || "" %>" placeholder="<%= advisoryMode ? "Tìm nội dung tư vấn, nhóm câu hỏi, dịch vụ..." : "Tìm nội dung phản hồi hoặc loại dịch vụ..." %>" />
        <button class="fb-btn is-primary" type="submit" aria-label="Tìm kiếm">Tìm</button>
      </div>
      <a class="fb-btn fb-export-btn" href="<%= exportHref %>">Xuất báo cáo</a>
    </section>
  </form>

  <nav class="status-tabs" aria-label="Lọc nhanh trạng thái">
    <% statusTabs.forEach((tab) => { %>
      <a class="<%= activeClass(filters.trang_thai, tab.value) %>" href="<%= baseManagePath %><%= buildQuery({ trang_thai: tab.value, page: 1, id: "" }) %>">
        <span><%= tab.label %></span>
        <strong><%= numberText(tab.count) %></strong>
      </a>
    <% }) %>
  </nav>

  <section class="fb-table-panel" aria-label="<%= advisoryMode ? "Danh sách tư vấn" : "Danh sách phản hồi" %>">
    <table class="fb-table">
      <thead>
        <tr>
          <th style="width:90px">Mã</th>
          <th style="width:250px">Khách hàng</th>
          <th style="width:190px"><%= advisoryMode ? "Nhóm hỏi" : "Dịch vụ" %></th>
          <th style="width:120px"><%= advisoryMode ? "Trả lời" : "Đánh giá" %></th>
          <th style="width:130px"><%= advisoryMode ? "SLA" : "Cảm xúc" %></th>
          <th style="width:130px">Ưu tiên</th>
          <th style="width:150px">Trạng thái</th>
          <th>Nội dung</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((item) => { %>
          <tr data-href="<%= baseManagePath %>/<%= item.id %><%= buildQuery({ id: "" }) %>">
            <td><span class="fb-code">#<%= item.id %></span></td>
            <td>
              <span class="fb-main-text"><%= item.tenKh || "Khách chưa xác định" %></span>
              <span class="fb-sub-text"><%= item.sdt || item.email || "Chưa có liên hệ" %></span>
            </td>
            <td>
              <span class="fb-main-text"><%= advisoryMode ? (item.advisoryIntentLabel || "Tư vấn") : (item.loaiDichVu || "Dịch vụ") %></span>
              <span class="fb-sub-text"><%= item.ngayTaoLabel || "" %></span>
            </td>
            <td>
              <% if (advisoryMode) { %>
                <span class="fb-badge"><%= Number(item.replyCount || 0) %> lượt</span>
              <% } else { %>
                <span class="fb-stars"><%= item.stars || "" %></span>
              <% } %>
            </td>
            <td>
              <% if (advisoryMode) { %>
                <span class="fb-badge <%= toneClass(item.slaTone) %>"><%= item.slaLabel %></span>
              <% } else { %>
                <span class="fb-badge <%= toneClass(item.sentimentTone || sentimentTone(item.sentiment)) %>"><%= item.sentimentLabel || sentimentLabel(item.sentiment) %></span>
              <% } %>
            </td>
            <td><span class="fb-badge <%= toneClass(item.priorityTone) %>"><%= item.priorityLabel %></span></td>
            <td><span class="fb-badge <%= toneClass(item.statusTone || statusTone(item.trangThai)) %>"><%= item.statusLabel || statusLabel(item.trangThai) %></span></td>
            <td>
              <span class="fb-main-text"><%= item.noiDung || "" %></span>
              <span class="fb-sub-text"><%= item.contextLine || item.ageLabel || "" %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (items.length === 0) { %>
      <div class="fb-empty">Không có <%= advisoryMode ? "yêu cầu tư vấn" : "phản hồi" %> phù hợp với bộ lọc hiện tại.</div>
    <% } %>
    <div class="fb-pagination">
      <div>Hiển thị <strong><%= items.length ? ((currentPage - 1) * Number(data.limit || 10) + 1) : 0 %>-<%= Math.min(currentPage * Number(data.limit || 10), totalRows) %></strong> trong tổng số <strong><%= numberText(totalRows) %></strong> bản ghi</div>
      <div class="fb-pages">
        <a class="fb-page" href="<%= baseManagePath %><%= buildQuery({ page: Math.max(1, currentPage - 1), id: "" }) %>">Trước</a>
        <% for (let pageNo = 1; pageNo <= totalPages; pageNo++) { %>
          <% if (pageNo <= 5 || pageNo === totalPages || Math.abs(pageNo - currentPage) <= 1) { %>
            <a class="fb-page <%= pageNo === currentPage ? "is-active" : "" %>" href="<%= baseManagePath %><%= buildQuery({ page: pageNo, id: "" }) %>"><%= pageNo %></a>
          <% } else if (pageNo === 6 && totalPages > 7) { %>
            <span class="fb-page">...</span>
          <% } %>
        <% } %>
        <a class="fb-page" href="<%= baseManagePath %><%= buildQuery({ page: Math.min(totalPages, currentPage + 1), id: "" }) %>">Sau</a>
      </div>
    </div>
  </section>

</main>

<script>
  (() => {
    document.querySelectorAll("[data-href]").forEach((row) => {
      row.addEventListener("click", () => {
        const href = row.getAttribute("data-href");
        if (href) window.location.href = href;
      });
    });

  })();
</script>

<%- include("../partials/footer") %>
<%- include("../partials/cskh-background") %>
