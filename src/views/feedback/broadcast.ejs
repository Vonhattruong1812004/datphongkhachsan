<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const stats = payload.stats || {};
  const form = payload.form || {};
  const templates = payload.templates || [];
  const audiences = payload.audiences || [];
  const channels = payload.channels || [];
  const preview = payload.preview || { items: [], total: 0 };
  const recentCampaigns = payload.recentCampaigns || [];
  const previewTotal = Number(preview.total || 0);
  const previewChannelReady = Number(preview.channelReadyTotal || 0);
  const previewSendable = Number(preview.sendableTotal || 0);
  const previewBlocked = Number(preview.blockedByChannel || 0);
  const previewDeduped = Number(preview.dedupedCount || 0);
  const templatesJson = JSON.stringify(templates).replace(/</g, "\\u003c");

  function numberText(value) {
    return Number(value || 0).toLocaleString("vi-VN");
  }

  function selectedAttr(actual, expected) {
    return String(actual || "") === String(expected) ? "selected" : "";
  }

  function templateActive(actual, expected) {
    return String(actual || "") === String(expected) ? "is-active" : "";
  }

  function campaignTone(status) {
    return ({
      Queued: "pending",
      Sending: "processing",
      Sent: "done",
      PartialFailed: "warning",
      Failed: "danger"
    }[status] || "neutral");
  }

  function channelTone(channel) {
    return ({
      Email: "blue",
      SMS: "green",
      Zalo: "processing",
      Mixed: "neutral"
    }[channel] || "neutral");
  }
%>

<style>
  body{background:#eef6ff;color:#102033}
  .broadcast-page{
    --blue:#0575e6;
    --blue-dark:#034ea2;
    --ink:#102033;
    --muted:#65758b;
    --line:#cfe2f7;
    --soft:#f4f9ff;
    --green:#07875f;
    --red:#c0263d;
    --amber:#b45309;
    width:min(1380px,calc(100vw - 40px));
    margin:0 auto;
    padding:28px 0 56px;
  }
  .bc-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    border-radius:12px;
    padding:20px 24px;
    background:linear-gradient(135deg,var(--blue),var(--blue-dark));
    color:#fff;
    box-shadow:0 18px 42px rgba(0,90,190,.18);
  }
  .bc-title h1{margin:0;font-size:34px;line-height:1.08;color:#fff}
  .bc-title h1::before{content:"";display:inline-block;width:6px;height:38px;border-radius:999px;background:#fff;margin-right:12px;vertical-align:-7px}
  .bc-title p{margin:5px 0 0;color:rgba(255,255,255,.86);font-weight:750}
  .bc-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
  .bc-btn{
    min-height:44px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    border:1px solid var(--line);
    border-radius:9px;
    padding:0 14px;
    background:#fff;
    color:#06479d;
    text-decoration:none;
    font:inherit;
    font-weight:850;
    cursor:pointer;
  }
  .bc-btn:hover{background:#f0f7ff;border-color:#9ecbff}
  .bc-btn.is-primary{background:var(--blue);border-color:var(--blue);color:#fff}
  .bc-btn.is-danger{background:#fff;border-color:#ffc4c4;color:#b91c1c}
  .bc-alert{margin-top:14px;border-radius:10px;padding:12px 14px;border:1px solid var(--line);background:#fff;font-weight:800}
  .bc-alert.is-success{border-color:#a7f3d0;background:#ecfdf5;color:#047857}
  .bc-alert.is-error{border-color:#fecaca;background:#fff1f2;color:#be123c}
  .bc-stats{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:10px;
    margin:14px 0;
  }
  .bc-stat,.bc-panel,.bc-template,.bc-recipient,.bc-campaign,.bc-empty{
    border:1px solid var(--line);
    background:rgba(255,255,255,.96);
    box-shadow:0 18px 45px rgba(15,23,42,.08);
  }
  .bc-stat{
    border-radius:12px;
    padding:14px;
  }
  .bc-stat strong{display:block;font-size:26px;color:var(--ink);letter-spacing:0}
  .bc-stat span{display:block;margin-top:5px;color:var(--muted);font-size:12px;font-weight:850;text-transform:uppercase;letter-spacing:.02em}
  .bc-layout{
    display:grid;
    grid-template-columns:minmax(0,1fr) 410px;
    gap:14px;
    align-items:start;
  }
  .bc-panel{
    border-radius:12px;
    padding:18px;
  }
  .bc-panel + .bc-panel{margin-top:14px}
  .bc-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
    margin-bottom:14px;
  }
  .bc-head h2,.bc-panel h3{margin:0;color:var(--ink)}
  .bc-head h2{font-size:24px}
  .bc-panel h3{font-size:19px}
  .bc-muted,.bc-note,.bc-meta{color:var(--muted);font-weight:750;line-height:1.5}
  .bc-note{font-size:13px}
  .bc-meta{font-size:13px}
  .bc-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:28px;
    border-radius:999px;
    padding:0 9px;
    border:1px solid var(--line);
    background:#f8fbff;
    color:#475569;
    font-size:12px;
    font-weight:850;
    white-space:nowrap;
  }
  .bc-badge.is-done,.bc-badge.is-green{border-color:#a7f3d0;background:#ecfdf5;color:#047857}
  .bc-badge.is-processing,.bc-badge.is-blue{border-color:#bae6fd;background:#ecfeff;color:#0369a1}
  .bc-badge.is-pending,.bc-badge.is-warning{border-color:#fde68a;background:#fffbeb;color:#92400e}
  .bc-badge.is-danger{border-color:#fecaca;background:#fff1f2;color:#be123c}
  .bc-badge.is-neutral{border-color:#dbe4ef;background:#f8fafc;color:#475569}
  .bc-template-grid{
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:10px;
    margin-bottom:16px;
  }
  .bc-template{
    min-height:116px;
    border-radius:10px;
    padding:12px;
    text-align:left;
    color:var(--ink);
    cursor:pointer;
    transition:border-color .16s ease, background .16s ease, transform .16s ease;
  }
  .bc-template:hover,.bc-template.is-active{
    border-color:#83bfff;
    background:#f4fbff;
    transform:translateY(-1px);
  }
  .bc-template strong{display:block;font-size:14px;color:#06479d}
  .bc-template span{display:block;margin-top:6px;color:var(--ink);font-size:13px;font-weight:800;line-height:1.35}
  .bc-template small{display:inline-flex;margin-top:8px;color:var(--muted);font-size:12px;font-weight:850}
  .bc-form-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
  }
  .bc-field{display:grid;gap:6px;min-width:0}
  .bc-field.is-full{grid-column:1 / -1}
  .bc-field label{font-size:13px;font-weight:850;color:var(--ink)}
  .bc-field input,.bc-field select,.bc-field textarea{
    width:100%;
    min-height:42px;
    border:1px solid var(--line);
    border-radius:9px;
    background:#fff;
    padding:0 12px;
    font:inherit;
    font-weight:700;
    color:var(--ink);
    box-sizing:border-box;
    outline:none;
  }
  .bc-field textarea{min-height:132px;padding:12px;line-height:1.5;resize:vertical}
  .bc-field input:focus,.bc-field select:focus,.bc-field textarea:focus{border-color:#83bfff;box-shadow:0 0 0 4px rgba(5,117,230,.12)}
  .bc-readonly{
    min-height:42px;
    display:flex;
    align-items:center;
    border:1px solid #e3edf8;
    border-radius:9px;
    background:#f8fbff;
    padding:0 12px;
    color:#334155;
    font-weight:850;
  }
  .bc-token-row,.bc-form-actions,.bc-row{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:8px;
  }
  .bc-token-row{margin-top:8px}
  .bc-token{
    display:inline-flex;
    align-items:center;
    min-height:26px;
    border:1px solid #bae6fd;
    border-radius:999px;
    padding:0 8px;
    background:#ecfeff;
    color:#0369a1;
    font-size:12px;
    font-weight:850;
  }
  .bc-count{margin-left:auto;color:var(--muted);font-size:12px;font-weight:850}
  .bc-form-actions{justify-content:space-between;margin-top:2px}
  .bc-preview-metrics{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:8px;
    margin-bottom:12px;
  }
  .bc-metric{
    border:1px solid #e3edf8;
    border-radius:10px;
    background:#f8fbff;
    padding:10px;
  }
  .bc-metric strong{display:block;color:var(--ink);font-size:22px}
  .bc-metric span{display:block;margin-top:3px;color:var(--muted);font-size:12px;font-weight:850;text-transform:uppercase}
  .bc-list{display:grid;gap:8px}
  .bc-recipient,.bc-campaign,.bc-empty{
    border-radius:10px;
    padding:12px;
    box-shadow:none;
  }
  .bc-row{justify-content:space-between}
  .bc-recipient strong,.bc-campaign strong{color:var(--ink)}
  .bc-empty{
    border-style:dashed;
    text-align:center;
    color:var(--muted);
    font-weight:800;
    background:#f8fbff;
  }
  .bc-campaign-message{
    margin-top:7px;
    padding:9px 10px;
    border-radius:8px;
    background:#f8fbff;
    color:#334155;
    font-size:13px;
    font-weight:700;
    line-height:1.45;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  @media(max-width:1180px){
    .bc-layout{grid-template-columns:1fr}
    .bc-template-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  }
  @media(max-width:760px){
    .broadcast-page{width:min(100% - 24px,900px)}
    .bc-title{display:block;padding:18px}
    .bc-title h1{font-size:28px}
    .bc-actions{justify-content:flex-start;margin-top:12px}
    .bc-stats,.bc-form-grid,.bc-template-grid,.bc-preview-metrics{grid-template-columns:1fr}
    .bc-form-actions{display:grid}
    .bc-btn{width:100%}
    .bc-count{margin-left:0}
  }
</style>

<main class="broadcast-page">
  <section class="bc-title">
    <div>
      <h1>Gửi tin nhắn hàng loạt</h1>
      <p>Chọn tệp khách, kiểm tra kênh liên hệ, chống gửi trùng và gửi chiến dịch CSKH tự động.</p>
    </div>
    <div class="bc-actions">
      <a class="bc-btn" href="/dashboard/cskh">Dashboard CSKH</a>
      <a class="bc-btn" href="/feedback/manage">Quản lý phản hồi</a>
      <a class="bc-btn" href="/feedback/advisory/manage">Trả lời tư vấn</a>
    </div>
  </section>

  <% if (successMessage) { %><div class="bc-alert is-success"><%= successMessage %></div><% } %>
  <% if (errorMessage) { %><div class="bc-alert is-error"><%= errorMessage %></div><% } %>

  <section class="bc-stats" aria-label="Tổng quan tệp khách CSKH">
    <article class="bc-stat"><strong><%= numberText(stats.contactableCustomers) %></strong><span>Khách có liên hệ</span></article>
    <article class="bc-stat"><strong><%= numberText(stats.upcomingCheckinCount) %></strong><span>Sắp check-in</span></article>
    <article class="bc-stat"><strong><%= numberText(stats.todayCheckoutCount) %></strong><span>Check-out hôm nay</span></article>
    <article class="bc-stat"><strong><%= numberText(stats.winbackCount) %></strong><span>Cần chăm sóc lại</span></article>
  </section>

  <section class="bc-layout">
    <div>
      <article class="bc-panel" id="broadcast-form">
        <div class="bc-head">
          <div>
            <h2>Soạn chiến dịch</h2>
            <p class="bc-muted" style="margin:6px 0 0">Quy trình đúng: chọn mẫu, xác định tệp khách, chọn kênh, xem preview rồi gửi.</p>
          </div>
          <span class="bc-badge is-blue">CSKH outbound</span>
        </div>

        <div class="bc-template-grid" aria-label="Mẫu chiến dịch">
          <% templates.forEach((item) => { %>
            <button class="bc-template <%= templateActive(form.template_key, item.key) %>" type="button" data-template-key="<%= item.key %>">
              <strong><%= item.label %></strong>
              <span><%= item.title %></span>
              <small><%= item.channel %></small>
            </button>
          <% }) %>
        </div>

        <form id="broadcast-compose" method="post" action="/feedback/broadcast/send" class="bc-form-grid">
          <input type="hidden" name="send_timing" value="now" />

          <div class="bc-field">
            <label for="template_key">Mẫu chiến dịch</label>
            <select id="template_key" name="template_key">
              <% templates.forEach((item) => { %>
                <option value="<%= item.key %>" <%= selectedAttr(form.template_key, item.key) %>><%= item.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="bc-field">
            <label for="audience_key">Tệp khách nhận tin</label>
            <select id="audience_key" name="audience_key">
              <% audiences.forEach((item) => { %>
                <option value="<%= item.value %>" <%= selectedAttr(form.audience_key, item.value) %>><%= item.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="bc-field">
            <label for="channel">Kênh gửi</label>
            <select id="channel" name="channel">
              <% channels.forEach((item) => { %>
                <option value="<%= item.value %>" <%= selectedAttr(form.channel, item.value) %>><%= item.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="bc-field">
            <label for="dedupe_days">Chống gửi trùng</label>
            <select id="dedupe_days" name="dedupe_days">
              <% [0, 1, 3, 7, 14, 30].forEach((days) => { %>
                <option value="<%= days %>" <%= Number(form.dedupe_days || 0) === days ? "selected" : "" %>><%= days === 0 ? "Không chặn" : `${days} ngày` %></option>
              <% }) %>
            </select>
          </div>

          <div class="bc-field">
            <label>Nhịp gửi thực tế</label>
            <div class="bc-readonly">Gửi tự động ngay sau khi bấm gửi</div>
          </div>

          <div class="bc-field">
            <label>Điều kiện gửi hiện tại</label>
            <div class="bc-readonly"><%= preview.channelRequirement || "Thông tin liên hệ hợp lệ" %></div>
          </div>

          <div class="bc-field is-full">
            <label for="title">Tiêu đề chiến dịch</label>
            <input id="title" name="title" maxlength="140" value="<%= form.title || "" %>" />
          </div>

          <div class="bc-field is-full">
            <label for="campaign_goal">Mục tiêu gửi</label>
            <input id="campaign_goal" name="campaign_goal" maxlength="180" value="<%= form.campaign_goal || "" %>" placeholder="Ví dụ: nhắc hoàn tất eKYC, giảm no-show, kéo khách cũ quay lại..." />
          </div>

          <div class="bc-field is-full">
            <label for="message">Nội dung tin nhắn</label>
            <textarea id="message" name="message" maxlength="1200"><%= form.message || "" %></textarea>
            <div class="bc-token-row" aria-label="Biến cá nhân hóa">
              <span class="bc-token">{{ten_kh}}</span>
              <span class="bc-token">{{ma_giao_dich}}</span>
              <span class="bc-token">{{khach_san}}</span>
              <span class="bc-token">{{ngay_nhan}}</span>
              <span class="bc-token">{{ngay_tra}}</span>
              <span class="bc-count" id="message-count">0/1200 ký tự</span>
            </div>
            <div class="bc-note">Nội dung nên nêu rõ lý do liên hệ, hành động khách cần làm và kênh CSKH sẽ tiếp tục theo dõi.</div>
          </div>

          <div class="bc-field is-full">
            <label for="internal_note">Ghi chú nội bộ</label>
            <textarea id="internal_note" name="internal_note" maxlength="500" style="min-height:92px"><%= form.internal_note || "" %></textarea>
            <div class="bc-note">Ghi chú chỉ dùng cho CSKH/ca sau, không gửi cho khách.</div>
          </div>

          <div class="bc-field is-full">
            <div class="bc-form-actions">
              <span class="bc-meta"><%= previewSendable > 0 ? `${numberText(previewSendable)} khách sẽ được đưa vào hàng gửi.` : "Chưa có người nhận phù hợp để gửi." %></span>
              <div class="bc-row">
                <button class="bc-btn" type="submit" formmethod="get" formaction="/feedback/broadcast/manage">Cập nhật preview</button>
                <button class="bc-btn is-primary" type="submit" <%= previewSendable <= 0 ? "disabled" : "" %>>Gửi chiến dịch</button>
              </div>
            </div>
          </div>
        </form>
      </article>
    </div>

    <aside>
      <article class="bc-panel">
        <div class="bc-head">
          <div>
            <h2>Preview tệp khách</h2>
            <p class="bc-muted" style="margin:6px 0 0"><%= preview.audienceLabel || "Tệp khách" %> · <%= preview.channelLabel || "Kênh gửi" %></p>
          </div>
          <span class="bc-badge is-<%= channelTone(preview.channel) %>"><%= preview.channelLabel || "Kênh" %></span>
        </div>

        <div class="bc-preview-metrics">
          <div class="bc-metric"><strong><%= numberText(previewTotal) %></strong><span>Trong tệp</span></div>
          <div class="bc-metric"><strong><%= numberText(previewChannelReady) %></strong><span>Đúng kênh</span></div>
          <div class="bc-metric"><strong><%= numberText(previewSendable) %></strong><span>Gửi được</span></div>
          <div class="bc-metric"><strong><%= numberText(previewBlocked + previewDeduped) %></strong><span>Bị loại</span></div>
        </div>

        <div class="bc-list">
          <% if (preview.items && preview.items.length) { %>
            <% preview.items.forEach((item) => { %>
              <article class="bc-recipient">
                <div class="bc-row">
                  <strong><%= item.customerName %></strong>
                  <span class="bc-badge is-blue"><%= item.bookingLabel %></span>
                </div>
                <div class="bc-meta"><%= item.target %></div>
                <div class="bc-meta"><%= item.reason || "Phù hợp với tệp outbound" %></div>
                <div class="bc-row bc-meta">
                  <span><%= item.hotelLabel %></span>
                  <span><%= item.checkinLabel || "-" %> -> <%= item.checkoutLabel || "-" %></span>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <div class="bc-empty">Chưa có khách gửi được theo tệp, kênh và khoảng chống trùng hiện tại.</div>
          <% } %>
        </div>

        <% if (previewBlocked || previewDeduped) { %>
          <p class="bc-note" style="margin:12px 0 0"><%= numberText(previewBlocked) %> khách thiếu thông tin đúng kênh · <%= numberText(previewDeduped) %> khách bị chặn do chống gửi trùng.</p>
        <% } %>
      </article>

      <article class="bc-panel">
        <div class="bc-head">
          <div>
            <h2>Lịch sử chiến dịch</h2>
            <p class="bc-muted" style="margin:6px 0 0">Đối soát chiến dịch đã gửi và số khách đã xử lý.</p>
          </div>
        </div>

        <div class="bc-list">
          <% if (recentCampaigns.length) { %>
            <% recentCampaigns.forEach((item) => { %>
              <article class="bc-campaign">
                <div class="bc-row">
                  <strong><%= item.title %></strong>
                  <span class="bc-badge is-<%= campaignTone(item.status) %>"><%= item.statusLabel %></span>
                </div>
                <div class="bc-meta"><%= item.audienceLabel %> · <%= item.channelLabel %> · <%= item.recipientSummary %></div>
                <div class="bc-meta"><%= item.goalLabel %></div>
                <% if (item.skippedSummary) { %><div class="bc-meta"><%= item.skippedSummary %></div><% } %>
                <div class="bc-row bc-meta">
                  <span><%= item.createdByName || "Hệ thống / CSKH" %></span>
                  <span><%= item.createdAtLabel %></span>
                </div>
                <% if (item.message) { %><div class="bc-campaign-message"><%= item.message %></div><% } %>
              </article>
            <% }) %>
          <% } else { %>
            <div class="bc-empty">Chưa có chiến dịch outbound nào được tạo.</div>
          <% } %>
        </div>
      </article>
    </aside>
  </section>
</main>

<script>
  (() => {
    const templates = <%- templatesJson %>;
    const templateSelect = document.getElementById("template_key");
    const audienceSelect = document.getElementById("audience_key");
    const channelSelect = document.getElementById("channel");
    const titleInput = document.getElementById("title");
    const messageInput = document.getElementById("message");
    const count = document.getElementById("message-count");
    const cards = Array.from(document.querySelectorAll(".bc-template"));

    function updateCount() {
      if (!messageInput || !count) return;
      count.textContent = `${messageInput.value.length}/1200 ký tự`;
    }

    function applyTemplate(key) {
      const selected = templates.find((item) => item.key === key);
      if (!selected) return;
      if (templateSelect) templateSelect.value = selected.key;
      if (audienceSelect) audienceSelect.value = selected.key;
      if (channelSelect) channelSelect.value = selected.channel;
      if (titleInput) titleInput.value = selected.title;
      if (messageInput) messageInput.value = selected.message;
      cards.forEach((card) => card.classList.toggle("is-active", card.dataset.templateKey === selected.key));
      updateCount();
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => applyTemplate(card.dataset.templateKey));
    });
    templateSelect?.addEventListener("change", () => applyTemplate(templateSelect.value));
    messageInput?.addEventListener("input", updateCount);
    updateCount();
  })();
</script>

<%- include("../partials/footer") %>
