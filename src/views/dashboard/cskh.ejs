<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const staffName = (typeof currentUser !== "undefined" && currentUser ? (currentUser.displayName || currentUser.username) : "") || "CSKH";
  const primaryActions = actions || [];
  const snapshot = (typeof stats !== "undefined" && stats) ? stats : {};
  const overview = snapshot.overview || {};
  const recentEvents = snapshot.recentEvents || [];
  const formatNumber = (value) => new Intl.NumberFormat("vi-VN").format(Number(value || 0));
  const formatDateTime = (value) => {
    if (!value) return "Chưa rõ";
    try {
      return new Intl.DateTimeFormat("vi-VN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }).format(new Date(value));
    } catch (_err) {
      return value;
    }
  };
  const actionByLabel = (keyword) => primaryActions.find((item) => String(item.label || "").toLowerCase().includes(keyword));
  const feedbackAction = actionByLabel("phản hồi") || primaryActions[0] || { href: "/feedback/manage", label: "Quản lý phản hồi" };
  const advisoryAction = actionByLabel("tư vấn") || primaryActions[1] || { href: "/feedback/advisory/manage", label: "Trả lời tư vấn" };
  const broadcastAction = actionByLabel("hàng loạt") || primaryActions[2] || { href: "/feedback/broadcast/manage", label: "Gửi tin nhắn hàng loạt" };
  const promoAction = actionByLabel("khuyến mãi") || primaryActions[3] || { href: "/manager/promotions", label: "Quản lý khuyến mãi" };
  const statCards = [
    { label: "Phản hồi", value: overview.totalFeedback, href: feedbackAction.href },
    { label: "Tư vấn", value: overview.totalTransactions, href: advisoryAction.href },
    { label: "Tệp khách", value: overview.totalCustomers, href: broadcastAction.href },
    { label: "Khuyến mãi", value: overview.totalPromotions, href: promoAction.href }
  ];
  const workItems = [
    { title: "Tiếp nhận phản hồi", href: feedbackAction.href, value: overview.totalFeedback, tone: "blue", detail: "Đọc phản hồi, trả lời khách và cập nhật trạng thái xử lý." },
    { title: "Trả lời tư vấn", href: advisoryAction.href, value: overview.totalTransactions, tone: "green", detail: "Xử lý câu hỏi theo booking, eKYC, thanh toán và dịch vụ." },
    { title: "Gửi chăm sóc hàng loạt", href: broadcastAction.href, value: overview.totalCustomers, tone: "cyan", detail: "Soạn nhắc check-in/out, cảm ơn sau lưu trú và giữ chân khách." },
    { title: "Điều phối khuyến mãi", href: promoAction.href, value: overview.totalPromotions, tone: "amber", detail: "Kiểm tra mã ưu đãi, thời hạn, kênh áp dụng và hiệu quả tư vấn." }
  ];
%>

<style>
  html{
    background:#dceeff url("/images/dulich-1757292000061879518539.webp?v=2") center/cover fixed no-repeat;
  }
  body{
    background:transparent;
  }
  .care-page{
    --blue:#0575e6;
    --blue-dark:#034ea2;
    --ink:#102033;
    --muted:#65758b;
    --line:#cfe2f7;
    --soft:#f3f8ff;
    --green:#07875f;
    --cyan:#0891b2;
    --amber:#b45309;
    min-height:calc(100vh - 84px);
    position:relative;
    isolation:isolate;
    padding:28px 18px 56px;
    color:var(--ink);
    background:transparent;
  }
  .care-page::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-2;
    background:url("/images/dulich-1757292000061879518539.webp?v=2") center/cover fixed no-repeat;
  }
  .care-page::after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-1;
    background:linear-gradient(180deg,rgba(235,246,255,.18),rgba(247,251,255,.36));
    pointer-events:none;
  }
  .care-shell{width:min(1360px,calc(100vw - 40px));margin:0 auto;display:grid;grid-template-columns:280px minmax(0,1fr);gap:16px;align-items:start}
  .care-sidebar,.care-title,.care-card,.care-panel,.care-work-card,.care-event{border:1px solid rgba(207,226,247,.84);background:rgba(255,255,255,.74);box-shadow:0 18px 45px rgba(15,23,42,.08);backdrop-filter:blur(8px) saturate(1.08)}
  .care-sidebar{border-radius:12px;padding:14px;position:sticky;top:104px}
  .care-sidebar h2{margin:0 0 12px;font-size:22px;line-height:1.1}
  .care-nav{display:grid;gap:8px}
  .care-nav a{min-height:48px;display:flex;align-items:center;border:1px solid var(--line);border-radius:8px;padding:0 12px;color:#06479d;text-decoration:none;font-size:14px;font-weight:850;background:rgba(255,255,255,.82);transition:background .15s ease,border-color .15s ease,color .15s ease,transform .15s ease}
  .care-nav a:hover{background:#edf6ff;border-color:#9ecbff;transform:translateX(2px)}
  .care-nav a.is-active{background:linear-gradient(135deg,var(--blue),var(--blue-dark));color:#fff;border-color:transparent;box-shadow:0 12px 24px rgba(0,108,228,.18)}
  .care-today{margin-top:14px;border:1px solid var(--line);border-radius:10px;background:rgba(248,251,255,.78);padding:12px}
  .care-today strong{display:block;color:#034ea2;font-size:20px}
  .care-today span{display:block;margin-top:3px;color:var(--muted);font-size:13px;font-weight:750}
  .care-main{min-width:0}
  .care-title{border-radius:12px;padding:20px 24px;background:linear-gradient(135deg,#087cf0,#034ea2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .care-title h1{margin:0;font-size:34px;line-height:1.05;letter-spacing:-.03em;color:#fff}
  .care-title h1::before{content:"";display:inline-block;width:6px;height:38px;border-radius:999px;background:#fff;margin-right:12px;vertical-align:-7px}
  .care-title p{margin:4px 0 0;color:rgba(255,255,255,.86);font-weight:750}
  .care-title-meta{display:flex;align-items:center;gap:10px;justify-content:flex-end;flex-wrap:wrap}
  .care-chip{display:inline-flex;align-items:center;min-height:38px;border-radius:999px;border:1px solid rgba(255,255,255,.42);background:rgba(255,255,255,.14);color:#fff;padding:0 12px;font-weight:900}
  .care-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0}
  .care-card{border-radius:12px;padding:16px;text-decoration:none;color:var(--ink);transition:transform .15s ease,border-color .15s ease,background .15s ease}
  .care-card:hover{transform:translateY(-1px);border-color:#9ecbff;background:rgba(255,255,255,.96)}
  .care-card strong{display:block;color:#034ea2;font-size:34px;line-height:1}
  .care-card span{display:block;margin-top:8px;color:var(--muted);font-size:13px;font-weight:850}
  .care-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:14px;align-items:start}
  .care-panel{border-radius:12px;padding:18px}
  .care-panel h2{margin:0 0 12px;font-size:24px}
  .care-muted{color:var(--muted);font-weight:750;line-height:1.5}
  .work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .care-work-card{border-radius:10px;padding:14px;text-decoration:none;color:var(--ink);box-shadow:none;background:rgba(255,255,255,.78);transition:transform .15s ease,border-color .15s ease,background .15s ease}
  .care-work-card:hover{transform:translateY(-1px);border-color:#9ecbff;background:#f4f9ff}
  .care-work-card small{display:inline-flex;border-radius:999px;padding:5px 9px;background:#edf6ff;color:#06479d;font-size:11px;font-weight:950;text-transform:uppercase;letter-spacing:.04em}
  .care-work-card h3{margin:10px 0 6px;font-size:20px;line-height:1.15}
  .care-work-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.5;font-weight:750}
  .care-work-card strong{display:block;margin-top:12px;font-size:24px;color:#034ea2}
  .care-work-card.is-green strong{color:var(--green)}
  .care-work-card.is-cyan strong{color:var(--cyan)}
  .care-work-card.is-amber strong{color:var(--amber)}
  .event-list{display:grid;gap:10px}
  .care-event{border-radius:10px;padding:12px;background:rgba(255,255,255,.78);box-shadow:none}
  .care-event strong{display:block;font-size:15px;line-height:1.35}
  .care-event span{display:block;margin-top:4px;color:var(--muted);font-size:13px;line-height:1.45}
  .care-event small{display:inline-flex;margin-top:8px;border-radius:999px;padding:5px 9px;background:#edf6ff;color:#06479d;font-size:11px;font-weight:900}
  .quick-list{display:grid;gap:8px}
  .quick-link{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.82);padding:12px;text-decoration:none;color:#06479d;font-weight:900}
  .quick-link:hover{background:#f4f9ff;border-color:#9ecbff}
  .quick-link span:last-child{color:var(--muted);font-size:13px}
  .empty{padding:22px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);background:#f8fbff}
  @media(max-width:1120px){
    .care-shell{grid-template-columns:1fr}
    .care-sidebar{position:static}
    .care-nav{grid-template-columns:repeat(2,minmax(0,1fr))}
    .care-grid{grid-template-columns:1fr}
  }
  @media(max-width:760px){
    .care-page{padding:18px 10px 42px}
    .care-shell{width:100%}
    .care-title{align-items:stretch;flex-direction:column}
    .care-title h1{font-size:28px}
    .care-stats,.work-grid,.care-nav{grid-template-columns:1fr}
  }
</style>

<main class="care-page">
  <div class="care-shell">
    <aside class="care-sidebar">
      <h2>Chức năng</h2>
      <nav class="care-nav" aria-label="Chức năng CSKH">
        <a class="is-active" href="/dashboard/cskh">Trang chủ CSKH</a>
        <% primaryActions.forEach((item) => { %>
          <a href="<%= item.href %>"><%= item.label %></a>
        <% }) %>
      </nav>
      <div class="care-today">
        <strong><%= formatNumber(overview.totalFeedback) %></strong>
        <span>phản hồi trong hệ thống</span>
      </div>
    </aside>

    <section class="care-main">
      <section class="care-title">
        <div>
          <h1>Trang chủ CSKH</h1>
          <p>Điều phối phản hồi, tư vấn, broadcast và khuyến mãi trong một màn.</p>
        </div>
        <div class="care-title-meta">
          <span class="care-chip"><%= staffName %></span>
          <span class="care-chip">CSKH</span>
        </div>
      </section>

      <section class="care-stats" aria-label="Tổng quan CSKH">
        <% statCards.forEach((item) => { %>
          <a class="care-card" href="<%= item.href %>">
            <strong><%= formatNumber(item.value) %></strong>
            <span><%= item.label %></span>
          </a>
        <% }) %>
      </section>

      <section class="care-grid">
        <section class="care-panel">
          <h2>Luồng xử lý chính</h2>
          <div class="work-grid">
            <% workItems.forEach((item) => { %>
              <a class="care-work-card is-<%= item.tone %>" href="<%= item.href %>">
                <small><%= item.title %></small>
                <h3><%= item.title %></h3>
                <p><%= item.detail %></p>
                <strong><%= formatNumber(item.value) %></strong>
              </a>
            <% }) %>
          </div>
        </section>

        <section class="care-panel">
          <h2>Lối vào nhanh</h2>
          <div class="quick-list">
            <% primaryActions.forEach((item) => { %>
              <a class="quick-link" href="<%= item.href %>">
                <span><%= item.label %></span>
                <span>Mở</span>
              </a>
            <% }) %>
          </div>
        </section>
      </section>

      <section class="care-panel" style="margin-top:14px">
        <h2>Hoạt động gần đây</h2>
        <% if (!recentEvents.length) { %>
          <div class="empty">Chưa có hoạt động gần đây.</div>
        <% } else { %>
          <div class="event-list">
            <% recentEvents.slice(0, 6).forEach((item) => { %>
              <article class="care-event">
                <strong><%= item.title %></strong>
                <span><%= item.detail %></span>
                <small><%= formatDateTime(item.happenedAt) %></small>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
<%- include("../partials/cskh-background") %>
