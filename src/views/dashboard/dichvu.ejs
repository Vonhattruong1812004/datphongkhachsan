<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const staffName = (typeof currentUser !== "undefined" && currentUser ? (currentUser.displayName || currentUser.username) : "") || "Nhân viên dịch vụ";
  const primaryActions = actions || [];
  const overview = stats?.overview || {};
  const recentEvents = stats?.recentEvents || [];
  const generatedAtLabel = stats?.generatedAt
    ? new Date(stats.generatedAt).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" })
    : new Date().toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
  const roomTotal = Number(overview.totalRooms || 0);
  const stayedRooms = Number(overview.stayedRooms || 0);
  const cleaningRooms = Number(overview.cleaningRooms || 0);
  const maintenanceRooms = Number(overview.maintenanceRooms || 0);
  const availableRooms = Number(overview.availableRooms || 0);
  const serviceTotal = Number(overview.totalServices || 0);
  const boardItems = [
    { label: "Đang ở", value: stayedRooms, tone: "blue" },
    { label: "Cần vệ sinh", value: cleaningRooms, tone: "amber" },
    { label: "Bảo trì", value: maintenanceRooms, tone: "rose" },
    { label: "Sẵn sàng", value: availableRooms, tone: "green" }
  ];
  const formatEventTime = (value) => {
    if (!value) return "";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";
    return date.toLocaleString("vi-VN", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" });
  };
%>

<style>
  .svc-home {
    --ink: #132033;
    --muted: #667085;
    --line: #c9e0fb;
    --blue: #006ce4;
    --blue-dark: #003b95;
    --green: #07865f;
    --amber: #b45309;
    --rose: #be123c;
    --shadow: 0 14px 34px rgba(15, 36, 66, .08);
    min-height: calc(100vh - 84px);
    padding: 24px 18px 56px;
    color: var(--ink);
    background:
      linear-gradient(180deg, rgba(235, 246, 255, .24), rgba(235, 246, 255, .38)),
      linear-gradient(90deg, rgba(235, 246, 255, .40), rgba(235, 246, 255, .18) 48%, rgba(235, 246, 255, .38)),
      url("/images/san-pham-du-lich.webp") center center / cover no-repeat fixed;
  }

  .svc-home *,
  .svc-home *::before,
  .svc-home *::after { box-sizing: border-box; }

  .svc-layout {
    width: min(1280px, calc(100vw - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .svc-side,
  .svc-panel,
  .svc-card,
  .svc-toolbar,
  .svc-event-list {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, .78);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px) saturate(1.08);
  }

  .svc-side {
    position: sticky;
    top: 96px;
    padding: 16px;
  }

  .svc-side h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .svc-nav {
    display: grid;
    gap: 10px;
  }

  .svc-nav a {
    min-height: 54px;
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0 14px;
    color: #064a9f;
    background: rgba(255, 255, 255, .82);
    text-decoration: none;
    font-size: 15px;
    font-weight: 850;
    transition: border-color .15s ease, background .15s ease, color .15s ease, transform .15s ease;
  }

  .svc-nav a.is-active,
  .svc-nav a:hover {
    color: #fff;
    border-color: transparent;
    background: var(--blue);
    transform: translateX(3px);
  }

  .svc-main {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .svc-title {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    box-shadow: 0 18px 42px rgba(0, 72, 171, .20);
  }

  .svc-title h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: clamp(28px, 3.1vw, 40px);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .svc-title h1::before {
    content: "";
    width: 6px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .88);
  }

  .svc-title small {
    color: rgba(255, 255, 255, .84);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  .svc-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .svc-card {
    min-height: 108px;
    padding: 16px;
  }

  .svc-card strong {
    display: block;
    color: #064a9f;
    font-size: 30px;
    line-height: 1;
    font-weight: 900;
  }

  .svc-card span {
    display: block;
    margin-top: 9px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 700;
  }

  .svc-card.is-green strong { color: var(--green); }
  .svc-card.is-amber strong { color: var(--amber); }
  .svc-card.is-rose strong { color: var(--rose); }

  .svc-grid {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: 14px;
  }

  .svc-panel {
    padding: 18px;
    min-width: 0;
  }

  .svc-panel h2 {
    margin: 0 0 14px;
    color: var(--ink);
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .svc-board {
    display: grid;
    gap: 10px;
  }

  .svc-board-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    border: 1px solid rgba(20, 32, 51, .08);
    border-radius: 10px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, .72);
  }

  .svc-board-row span {
    color: var(--muted);
    font-size: 14px;
    font-weight: 750;
  }

  .svc-board-row strong {
    color: #064a9f;
    font-size: 22px;
    font-weight: 900;
  }

  .svc-board-row.is-green strong { color: var(--green); }
  .svc-board-row.is-amber strong { color: var(--amber); }
  .svc-board-row.is-rose strong { color: var(--rose); }

  .svc-event-list {
    overflow: hidden;
  }

  .svc-event {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    padding: 13px 14px;
    border-bottom: 1px solid rgba(20, 32, 51, .08);
    background: rgba(255, 255, 255, .72);
  }

  .svc-event:last-child { border-bottom: 0; }

  .svc-event b {
    display: block;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.25;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .svc-event span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.35;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .svc-event time {
    color: #064a9f;
    font-size: 12px;
    font-weight: 850;
    white-space: nowrap;
  }

  .svc-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .svc-action {
    min-height: 118px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px;
    color: var(--ink);
    background: rgba(255, 255, 255, .82);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
  }

  .svc-action:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 108, 228, .38);
    box-shadow: 0 18px 42px rgba(0, 108, 228, .14);
  }

  .svc-action strong {
    color: #064a9f;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 900;
  }

  .svc-action span {
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
  }

  .svc-empty {
    border: 1px dashed rgba(20, 32, 51, .18);
    border-radius: 10px;
    padding: 16px;
    color: var(--muted);
    background: rgba(255, 255, 255, .72);
    font-weight: 700;
  }

  @media (max-width: 1060px) {
    .svc-layout { grid-template-columns: 1fr; }
    .svc-side { position: static; }
    .svc-nav { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .svc-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 760px) {
    .svc-home { padding: 18px 12px 42px; }
    .svc-layout { width: 100%; }
    .svc-title { align-items: flex-start; flex-direction: column; }
    .svc-title small { white-space: normal; }
    .svc-kpis,
    .svc-actions,
    .svc-nav { grid-template-columns: 1fr; }
  }
</style>

<main class="svc-home">
  <div class="svc-layout">
    <aside class="svc-side" aria-label="Chức năng dịch vụ">
      <h2>Chức năng</h2>
      <nav class="svc-nav">
        <a class="is-active" href="/dashboard/dichvu">Trang chủ dịch vụ</a>
        <% primaryActions.forEach((item) => { %>
          <a href="<%= item.href %>"><%= item.label %></a>
        <% }) %>
      </nav>
    </aside>

    <section class="svc-main">
      <section class="svc-title">
        <h1>Trang chủ dịch vụ</h1>
        <small><%= staffName %> · cập nhật <%= generatedAtLabel %></small>
      </section>

      <section class="svc-kpis" aria-label="Tổng quan nhanh">
        <article class="svc-card"><strong><%= roomTotal %></strong><span>Tổng phòng theo dõi</span></article>
        <article class="svc-card is-green"><strong><%= serviceTotal %></strong><span>Dịch vụ trong danh mục</span></article>
        <article class="svc-card is-amber"><strong><%= cleaningRooms %></strong><span>Phòng cần vệ sinh</span></article>
        <article class="svc-card is-rose"><strong><%= maintenanceRooms %></strong><span>Phòng cần xử lý</span></article>
      </section>

      <section class="svc-grid">
        <article class="svc-panel">
          <h2>Trạng thái phòng</h2>
          <div class="svc-board">
            <% boardItems.forEach((item) => { %>
              <div class="svc-board-row is-<%= item.tone %>">
                <span><%= item.label %></span>
                <strong><%= item.value %></strong>
              </div>
            <% }) %>
          </div>
        </article>

        <article class="svc-panel">
          <h2>Hoạt động gần đây</h2>
          <div class="svc-event-list">
            <% if (!recentEvents.length) { %>
              <div class="svc-empty">Chưa có hoạt động mới.</div>
            <% } else { %>
              <% recentEvents.slice(0, 6).forEach((event) => { %>
                <div class="svc-event">
                  <div>
                    <b><%= event.title %></b>
                    <span><%= event.detail %></span>
                  </div>
                  <time><%= formatEventTime(event.happenedAt) %></time>
                </div>
              <% }) %>
            <% } %>
          </div>
        </article>
      </section>

      <section class="svc-actions" aria-label="Lối vào nghiệp vụ">
        <% primaryActions.forEach((item) => { %>
          <a class="svc-action" href="<%= item.href %>">
            <strong><%= item.label %></strong>
            <span>Mở màn hình</span>
          </a>
        <% }) %>
      </section>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
