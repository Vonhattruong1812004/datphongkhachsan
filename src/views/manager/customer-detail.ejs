<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const customer = detail.customer;
  const bookings = detail.bookings || [];
  const feedback = detail.feedback || [];
  const audit = detail.audit || [];
  const duplicates = detail.duplicateSuggestions || [];
  const success = typeof successMessage !== "undefined" ? successMessage : "";
  const error = typeof errorMessage !== "undefined" ? errorMessage : "";
%>

<style>
  body:has(.customer-detail-page){
    background:#f4f8ff;
  }
  body:has(.customer-detail-page) .floating-assist{
    display:none !important;
  }
  .customer-detail-page{
    --ink:#102033;
    --muted:#607086;
    --line:#cfe0f3;
    --blue:#006ce4;
    --blue-dark:#003b95;
    --soft:#f7fbff;
    --shadow:0 18px 42px rgba(0,59,149,.10);
    min-height:calc(100vh - 68px);
    padding:24px 18px 48px;
    color:var(--ink);
    background:linear-gradient(180deg,#eaf4ff 0%,#f8fbff 230px,#ffffff 100%);
  }
  .customer-detail-shell{max-width:1220px;margin:0 auto;display:grid;gap:14px}
  .customer-detail-title{display:flex;align-items:center;justify-content:space-between;gap:14px}
  .customer-detail-title h1{
    margin:0;
    padding:0 12px 2px 14px;
    border-left:5px solid var(--blue);
    color:var(--blue-dark);
    background:#fff;
    font-size:30px;
    line-height:1.2;
    letter-spacing:0;
  }
  .customer-detail-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
  .customer-detail-button{
    display:inline-flex;align-items:center;justify-content:center;min-height:40px;border-radius:8px;padding:9px 14px;
    border:1px solid #bfdcff;background:#fff;color:var(--blue-dark);text-decoration:none;font:inherit;font-size:14px;font-weight:850;
    box-shadow:0 8px 18px rgba(0,59,149,.08);cursor:pointer;
  }
  .customer-detail-button:hover{border-color:var(--blue);background:#f0f7ff}
  .customer-detail-button--primary{border-color:var(--blue);background:var(--blue);color:#fff;box-shadow:0 12px 26px rgba(0,108,228,.20)}
  .customer-detail-button--danger{border-color:#fecaca;background:#fff5f5;color:#b42318;box-shadow:none}
  .customer-detail-button:disabled{cursor:not-allowed;opacity:.62}
  .customer-detail-alert{border-radius:8px;padding:12px 14px;border:1px solid #d6e4f2;background:#fff;font-weight:800}
  .customer-detail-alert--error{color:#b42318;background:#fff4f4;border-color:#fecaca}
  .customer-detail-alert--success{color:#047857;background:#effcf6;border-color:#b7efd9}
  .customer-detail-card{border:1px solid var(--line);border-radius:8px;background:#fff;box-shadow:var(--shadow)}
  .customer-profile{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:16px;padding:18px}
  .customer-profile-main{display:grid;grid-template-columns:64px minmax(0,1fr);gap:14px;align-items:center}
  .customer-avatar{display:grid;place-items:center;width:64px;height:64px;border-radius:8px;background:var(--blue);color:#fff;font-size:28px;font-weight:950;text-transform:uppercase}
  .customer-profile h2{margin:0 0 8px;color:var(--ink);font-size:26px;line-height:1.18}
  .customer-muted{color:var(--muted);font-size:13px;line-height:1.55}
  .customer-contact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:14px}
  .customer-contact-item{border:1px solid #d6e4f2;border-radius:8px;padding:10px;background:var(--soft)}
  .customer-contact-item span{display:block;color:var(--muted);font-size:12px;font-weight:850}
  .customer-contact-item strong{display:block;margin-top:4px;color:var(--ink);overflow-wrap:anywhere}
  .customer-side{display:grid;align-content:start;gap:10px}
  .customer-status{display:inline-flex;width:max-content;align-items:center;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:850;border:1px solid transparent}
  .customer-status--green,.customer-status--cyan{color:#00613c;background:#effcf6;border-color:#b7efd9}
  .customer-status--sun{color:#8a5a00;background:#fff8d7;border-color:#f7dda0}
  .customer-status--rose{color:#b42318;background:#fff4f4;border-color:#fecaca}
  .customer-status--slate{color:#475569;background:#f3f6f9;border-color:#d7e1eb}
  .customer-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .customer-kpi{padding:16px;border:1px solid var(--line);border-radius:8px;background:#fff;box-shadow:0 12px 28px rgba(0,59,149,.08)}
  .customer-kpi span{display:block;color:var(--muted);font-size:12px;font-weight:850;text-transform:uppercase}
  .customer-kpi strong{display:block;margin-top:8px;color:var(--blue-dark);font-size:26px;line-height:1}
  .customer-detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:14px;align-items:start}
  .customer-section{padding:16px}
  .customer-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #e2edf8}
  .customer-section h2{margin:0;color:var(--ink);font-size:22px;line-height:1.25}
  .customer-section h3{margin:0;color:var(--ink);font-size:17px;line-height:1.3}
  .customer-list{display:grid;gap:10px}
  .customer-split{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .customer-item{border:1px solid #d6e4f2;border-radius:8px;background:#fff;padding:12px}
  .customer-item h3{margin:8px 0 4px}
  .customer-item a{color:var(--blue-dark);text-decoration:none}
  .customer-item a:hover{text-decoration:underline}
  .customer-money{color:var(--blue-dark);font-weight:950}
  .customer-lock{border-color:#fecaca;background:#fff5f5}
  .customer-empty{border:1px dashed #cfe0f3;border-radius:8px;background:#f7fbff;padding:14px;color:var(--muted)}
  .customer-audit{display:grid;gap:8px}
  .customer-audit .customer-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}
  @media(max-width:1040px){
    .customer-profile,.customer-detail-layout,.customer-split{grid-template-columns:1fr}
    .customer-contact-grid,.customer-kpis{grid-template-columns:1fr 1fr}
  }
  @media(max-width:640px){
    .customer-detail-page{padding:18px 10px 42px}
    .customer-detail-title{display:grid;gap:10px}
    .customer-detail-title h1{font-size:26px}
    .customer-detail-actions{justify-content:stretch}
    .customer-detail-button{flex:1 1 130px}
    .customer-detail-actions form{flex:1 1 100%;display:flex}
    .customer-detail-actions form .customer-detail-button{width:100%}
    .customer-profile-main{grid-template-columns:48px minmax(0,1fr)}
    .customer-avatar{width:48px;height:48px;font-size:22px}
    .customer-contact-grid,.customer-kpis{grid-template-columns:1fr}
    .customer-audit .customer-item{grid-template-columns:1fr}
  }
</style>

<main class="customer-detail-page">
  <div class="customer-detail-shell">
    <section class="customer-detail-title">
      <h1>Chi tiết khách hàng</h1>
      <div class="customer-detail-actions">
        <a class="customer-detail-button" href="/manager/customers">Danh sách</a>
        <a class="customer-detail-button customer-detail-button--primary" href="/manager/customers/<%= customer.id %>/edit">Sửa hồ sơ</a>
        <form method="post" action="/manager/customers/<%= customer.id %>/delete" onsubmit="return confirm('Xóa khách hàng này? Chỉ xóa được khi khách chưa có giao dịch.')">
          <button class="customer-detail-button customer-detail-button--danger" type="submit" <%= customer.canDelete ? "" : "disabled title='Khách đã có giao dịch nên không thể xóa'" %>>
            <%= customer.canDelete ? "Xóa hồ sơ" : "Khóa xóa" %>
          </button>
        </form>
      </div>
    </section>

    <% if (error) { %><div class="customer-detail-alert customer-detail-alert--error"><%= error %></div><% } %>
    <% if (success) { %><div class="customer-detail-alert customer-detail-alert--success"><%= success %></div><% } %>

    <section class="customer-detail-card customer-profile">
      <div>
        <div class="customer-profile-main">
          <span class="customer-avatar"><%= String(customer.tenKh || "?").trim().slice(0, 1).toUpperCase() || "?" %></span>
          <div>
            <h2><%= customer.tenKh %></h2>
            <div class="customer-muted">Mã khách hàng #<%= customer.id %></div>
          </div>
        </div>
        <div class="customer-contact-grid">
          <div class="customer-contact-item"><span>Email</span><strong><%= customer.email || "Chưa email" %></strong></div>
          <div class="customer-contact-item"><span>Số điện thoại</span><strong><%= customer.sdt || "Chưa SĐT" %></strong></div>
          <div class="customer-contact-item"><span>CCCD</span><strong><%= customer.cccd || "Chưa CCCD" %></strong></div>
        </div>
      </div>
      <aside class="customer-side">
        <span class="customer-status customer-status--<%= customer.ekycMeta.tone %>"><%= customer.ekycMeta.label %></span>
        <div class="customer-muted"><%= customer.ekycMeta.hint || "Theo dõi trạng thái xác minh định danh của khách." %></div>
        <% if (!customer.canDelete) { %>
          <div class="customer-item customer-lock">
            <span class="customer-status customer-status--rose">Khóa xóa</span>
            <p class="customer-muted" style="margin:8px 0 0">Khách đã có giao dịch nên chỉ cho sửa hồ sơ để bảo toàn lịch sử đặt phòng.</p>
          </div>
        <% } %>
      </aside>
    </section>

    <section class="customer-kpis">
      <article class="customer-kpi"><span>Chi tiêu</span><strong><%= customer.totalSpentFormatted %></strong></article>
      <article class="customer-kpi"><span>Giao dịch</span><strong><%= customer.transactionCount %></strong></article>
      <article class="customer-kpi"><span>Booking đang mở</span><strong><%= customer.activeBookingCount %></strong></article>
    </section>

    <section class="customer-detail-layout">
      <section class="customer-detail-card customer-section">
        <div class="customer-section-head">
          <h2>Lịch sử hoạt động</h2>
        </div>
        <div class="customer-split">
          <div>
            <div class="customer-section-head">
              <h3>Booking gần đây</h3>
            </div>
            <div class="customer-list">
              <% if (!bookings.length) { %><div class="customer-empty">Khách chưa có booking.</div><% } %>
              <% bookings.forEach((booking) => { %>
                <article class="customer-item">
                  <span class="customer-status customer-status--cyan"><%= booking.trangThai %></span>
                  <h3><%= booking.bookingCode || `GD-${booking.id}` %> · <span class="customer-money"><%= booking.tongTienFormatted %></span></h3>
                  <p class="customer-muted"><%= booking.ngayGiaoDichLabel %> · <%= booking.roomCount %> phòng · <%= booking.hotelLabel || "Chưa gắn cơ sở" %></p>
                </article>
              <% }) %>
            </div>
          </div>
          <div>
            <div class="customer-section-head">
              <h3>Feedback gần đây</h3>
            </div>
            <div class="customer-list">
              <% if (!feedback.length) { %><div class="customer-empty">Chưa có phản hồi từ khách này.</div><% } %>
              <% feedback.forEach((fb) => { %>
                <article class="customer-item">
                  <span class="customer-status customer-status--sun"><%= fb.stars %></span>
                  <h3><%= fb.loaiDichVu || "Phản hồi" %> · <%= fb.tinhTrang || "ChuaXuLy" %></h3>
                  <p class="customer-muted"><%= fb.ngayPhanHoiLabel %> · <%= fb.sentiment || "Neutral" %></p>
                  <p class="customer-muted"><%= String(fb.noiDung || "").slice(0, 130) %></p>
                </article>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="customer-section-head" style="margin-top:18px">
          <h3>Audit log</h3>
        </div>
        <div class="customer-audit">
          <% if (!audit.length) { %><div class="customer-empty">Chưa có lịch sử chỉnh sửa.</div><% } %>
          <% audit.forEach((log) => { %>
            <article class="customer-item">
              <div>
                <span class="customer-status customer-status--slate"><%= log.hanhDong %></span>
                <strong style="display:block;margin-top:8px"><%= log.usernameThucHien || "system" %></strong>
                <p class="customer-muted"><%= log.ghichu || "" %></p>
              </div>
              <div class="customer-muted"><%= log.thoigianLabel %></div>
            </article>
          <% }) %>
        </div>
      </section>

      <aside class="customer-detail-card customer-section">
        <div class="customer-section-head">
          <h2>Đối soát hồ sơ</h2>
        </div>
        <% if (duplicates.length) { %>
          <div class="customer-list">
            <% duplicates.forEach((item) => { %>
              <article class="customer-item">
                <span class="customer-status customer-status--<%= item.meta.tone %>"><%= item.meta.label %> · <%= item.scoreLabel %></span>
                <h3><a href="/manager/customers/<%= item.id %>"><%= item.tenKh %></a></h3>
                <p class="customer-muted"><%= item.email || "Chưa email" %> · <%= item.sdt || "Chưa SĐT" %> · <%= item.cccd || "Chưa CCCD" %></p>
                <p class="customer-muted"><%= (item.reasons || []).join(", ") %></p>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="customer-empty">Chưa thấy hồ sơ nào có dấu hiệu trùng mềm với khách hàng này.</div>
        <% } %>
      </aside>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
