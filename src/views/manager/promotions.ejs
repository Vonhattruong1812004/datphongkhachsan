  /* Manager promotion UC refresh. */
  body{background:#eef6ff;color:#102033}
  .promo-home{
    --promo-ink:#102033;
    --promo-muted:#65758b;
    --promo-line:#cfe2f7;
    --promo-card:#ffffff;
    --promo-blue:#0575e6;
    --promo-blue-dark:#034ea2;
    --promo-green:#07875f;
    --promo-red:#c0263d;
    --promo-amber:#b45309;
    --promo-shadow:0 18px 45px rgba(15,23,42,.08);
    width:min(1380px,calc(100vw - 40px));
    max-width:none;
    min-height:calc(100vh - 84px);
    margin:0 auto;
    padding:28px 0 56px;
    color:var(--promo-ink);
    background:transparent;
    overflow:visible;
  }
  .promo-home::before,.promo-home::after,.promo-hero-main::before,.promo-hero-main::after,.promo-stat::after{display:none}
