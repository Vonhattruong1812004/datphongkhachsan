    .promo-home{width:min(100% - 24px,900px);padding:22px 0 48px}
    .promo-hero h1{font-size:28px}
    .promo-summary,.promo-field-grid,.promo-filter-grid,.promo-table tr[data-promo-row]{grid-template-columns:1fr}
    .promo-button{width:100%}
  }
</style>

<main class="promo-home">
  <div class="promo-shell">
    <section class="promo-hero">
      <div class="promo-hero-main">
        <div class="promo-hero-content">
          <div class="promo-chip"><span class="promo-dot"></span> UC quản lý khuyến mãi</div>
          <h1>Quản lý <span>khuyến mãi</span></h1>
          <div class="promo-actions">
            <% if (promotionForm.promotion_id) { %><a class="promo-button" href="/manager/promotions">Tạo khuyến mãi mới</a><% } %>
          </div>
        </div>
        <div class="promo-hero-mark" aria-hidden="true">
          <div class="promo-mark-line"><span></span></div>
          <div class="promo-mark-line"><span></span></div>
          <div class="promo-mark-line"><span></span></div>
          <div class="promo-mark-line"><span></span></div>
        </div>
      </div>
    </section>

    <% if (noticeState.error) { %><div class="promo-alert promo-alert--error"><%= noticeState.error %></div><% } %>
    <% if (noticeState.success) { %><div class="promo-alert promo-alert--success"><%= noticeState.success %></div><% } %>

    <section class="promo-layout">
      <div class="promo-main-stack">
        <section class="promo-panel promo-form-panel <%= promotionForm.promotion_id ? "is-open" : "" %>" id="promotion-form-panel" data-promo-form-panel>
          <div style="display:flex;justify-content:space-between;gap:14px;align-items:flex-end;flex-wrap:wrap">
            <div>
              <h2 data-promo-form-title><%= promotionForm.promotion_id ? "Sửa khuyến mãi" : "Thêm khuyến mãi" %></h2>
              <p class="promo-muted">Nhập thông tin khuyến mãi và điều kiện áp dụng. Đây là rule dùng khi đặt phòng và kiểm soát việc áp dụng ưu đãi trong hệ thống.</p>
            </div>
            <span class="promo-live-pill" data-promo-form-state><%= promotionForm.promotion_id ? "Đang sửa chương trình hiện có" : "Sẵn sàng tạo chương trình mới" %></span>
          </div>

          <form method="post" action="/manager/promotions" id="promotionForm">
            <input type="hidden" name="promotion_id" value="<%= promotionForm.promotion_id %>" />
            <div class="promo-field-grid">
              <div class="promo-field is-wide">
                <label for="ten_chuong_trinh">Tên chương trình</label>
                <input id="ten_chuong_trinh" name="ten_chuong_trinh" value="<%= promotionForm.ten_chuong_trinh %>" maxlength="150" required />
              </div>
              <div class="promo-field">
                <label for="ngay_bat_dau">Ngày bắt đầu</label>
                <input id="ngay_bat_dau" name="ngay_bat_dau" type="date" value="<%= promotionForm.ngay_bat_dau %>" required />
              </div>
              <div class="promo-field">
                <label for="ngay_ket_thuc">Ngày kết thúc</label>
                <input id="ngay_ket_thuc" name="ngay_ket_thuc" type="date" value="<%= promotionForm.ngay_ket_thuc %>" required />
              </div>
              <div class="promo-field">
                <label for="loai_uu_dai">Loại ưu đãi</label>
                <select id="loai_uu_dai" name="loai_uu_dai" required>
                  <option value="PERCENT" <%= promotionForm.loai_uu_dai === "PERCENT" ? "selected" : "" %>>Phần trăm</option>
                  <option value="FIXED" <%= promotionForm.loai_uu_dai === "FIXED" ? "selected" : "" %>>Số tiền cố định</option>
                </select>
              </div>
              <div class="promo-field">
                <label for="muc_uu_dai">Mức ưu đãi</label>
                <input id="muc_uu_dai" name="muc_uu_dai" type="number" min="0" step="0.01" value="<%= promotionForm.muc_uu_dai %>" required />
              </div>
              <div class="promo-field">
                <label for="trang_thai">Trạng thái</label>
                <select id="trang_thai" name="trang_thai" required>
                  <option value="DangApDung" <%= promotionForm.trang_thai === "DangApDung" ? "selected" : "" %>>Đang áp dụng</option>
                  <option value="TamNgung" <%= promotionForm.trang_thai === "TamNgung" ? "selected" : "" %>>Tạm ngưng</option>
                  <option value="HetHan" <%= promotionForm.trang_thai === "HetHan" ? "selected" : "" %>>Hết hạn</option>
                </select>
              </div>
              <div class="promo-field">
                <label for="doi_tuong">Tệp khách áp dụng</label>
                <input id="doi_tuong" name="doi_tuong" value="<%= promotionForm.doi_tuong %>" maxlength="120" placeholder="TatCa, VIP, khách cũ..." />
              </div>
              <div class="promo-field">
                <label for="kenh_ap_dung">Kênh áp dụng</label>
                <select id="kenh_ap_dung" name="kenh_ap_dung">
                  <option value="All" <%= promotionForm.kenh_ap_dung === "All" ? "selected" : "" %>>Tất cả kênh</option>
                  <option value="Website" <%= promotionForm.kenh_ap_dung === "Website" ? "selected" : "" %>>Website</option>
                  <option value="Direct" <%= promotionForm.kenh_ap_dung === "Direct" ? "selected" : "" %>>Booking trực tiếp</option>
                  <option value="Frontdesk" <%= promotionForm.kenh_ap_dung === "Frontdesk" ? "selected" : "" %>>Lễ tân</option>
                  <option value="CSKH" <%= promotionForm.kenh_ap_dung === "CSKH" ? "selected" : "" %>>Chăm sóc khách hàng</option>
                </select>
              </div>
              <div class="promo-field">
                <label for="so_dem_toi_thieu">Số đêm tối thiểu</label>
                <input id="so_dem_toi_thieu" name="so_dem_toi_thieu" type="number" min="0" max="30" step="1" value="<%= promotionForm.so_dem_toi_thieu %>" placeholder="0" />
              </div>
              <div class="promo-field">
                <label for="gia_tri_toi_thieu">Giá trị tối thiểu</label>
                <input id="gia_tri_toi_thieu" name="gia_tri_toi_thieu" type="number" min="0" step="1000" value="<%= promotionForm.gia_tri_toi_thieu %>" placeholder="0" />
              </div>
              <div class="promo-field">
                <label for="gioi_han_luot_dung">Quota sử dụng</label>
                <input id="gioi_han_luot_dung" name="gioi_han_luot_dung" type="number" min="0" max="1000000" step="1" value="<%= promotionForm.gioi_han_luot_dung %>" placeholder="0" />
                <div class="promo-field-hint">Nhập 0 nếu không giới hạn.</div>
              </div>
              <div class="promo-field">
                <label for="chinh_sach_cong_don">Chính sách cộng dồn</label>
                <select id="chinh_sach_cong_don" name="chinh_sach_cong_don">
                  <option value="NoStack" <%= promotionForm.chinh_sach_cong_don === "NoStack" ? "selected" : "" %>>Không cộng dồn</option>
                  <option value="AllowServiceOnly" <%= promotionForm.chinh_sach_cong_don === "AllowServiceOnly" ? "selected" : "" %>>Chỉ cộng dịch vụ</option>
                  <option value="ManualReview" <%= promotionForm.chinh_sach_cong_don === "ManualReview" ? "selected" : "" %>>Cần duyệt thủ công</option>
                </select>
              </div>
              <div class="promo-field is-wide">
                <label for="ngay_chan">Ngày chặn</label>
                <input id="ngay_chan" name="ngay_chan" value="<%= promotionForm.ngay_chan %>" placeholder="2026-06-01, 2026-06-02" />
                <div class="promo-field-hint">Dùng cho ngày lễ/cao điểm không áp dụng ưu đãi, cách nhau bằng dấu phẩy.</div>
              </div>
              <div class="promo-field is-wide">
                <label for="muc_tieu_chien_dich">Mục tiêu áp dụng</label>
                <textarea id="muc_tieu_chien_dich" name="muc_tieu_chien_dich" placeholder="Ví dụ: tăng booking ngày thường, kéo khách cũ quay lại, đẩy gói nghỉ dưỡng 2 đêm..."><%= promotionForm.muc_tieu_chien_dich %></textarea>
              </div>
            </div>
            <div class="promo-form-actions">
              <button class="promo-button promo-button--primary" type="submit"><%= promotionForm.promotion_id ? "Lưu thay đổi" : "Tạo khuyến mãi" %></button>
              <% if (promotionForm.promotion_id) { %><a class="promo-button" href="/manager/promotions">Tạo mới</a><% } %>
              <button class="promo-button" type="button" data-close-promo-form>Đóng form</button>
            </div>
          </form>
        </section>

        <section class="promo-table-panel">
          <div class="promo-table-toolbar">
            <nav class="status-tabs" aria-label="Lọc nhanh trạng thái khuyến mãi">
              <% statusTabs.forEach((tab, index) => { %>
                <button class="<%= index === 0 ? "is-active" : "" %>" type="button" data-promo-status-tab="<%= tab.value %>">
                  <span><%= tab.label %></span>
                  <strong><%= tab.count %></strong>
                </button>
              <% }) %>
            </nav>

            <div class="promo-toolbar-actions">
              <div class="promo-filter-popover">
                <button class="promo-button" type="button" data-toggle-promo-filter aria-expanded="false">Lọc nâng cao</button>
                <section class="promo-panel promo-filter-panel">
                  <div class="promo-filter-head">
                    <div>
                      <h2>Lọc danh sách khuyến mãi</h2>
                      <p class="promo-muted">Thu hẹp danh sách bên dưới theo từ khóa, trạng thái, loại ưu đãi, thời gian, kênh và cảnh báo.</p>
                    </div>
                    <span class="promo-live-pill" data-promo-live-state>Sẵn sàng lọc realtime</span>
                  </div>
                  <div class="promo-filter-grid">
                    <div class="promo-field">
                      <label for="promo_keyword">Từ khóa</label>
                      <input id="promo_keyword" placeholder="Tên chương trình, đối tượng..." />
                    </div>
                    <div class="promo-field">
                      <label for="promo_status_filter">Trạng thái</label>
                      <select id="promo_status_filter">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="DangApDung">Đang áp dụng</option>
                        <option value="TamNgung">Tạm ngưng</option>
                        <option value="HetHan">Hết hạn</option>
                      </select>
                    </div>
                    <div class="promo-field">
                      <label for="promo_type_filter">Loại ưu đãi</label>
                      <select id="promo_type_filter">
                        <option value="all">Tất cả loại</option>
                        <option value="PERCENT">Phần trăm</option>
                        <option value="FIXED">Số tiền cố định</option>
                      </select>
                    </div>
                    <div class="promo-field">
                      <label for="promo_timeline_filter">Timeline</label>
                      <select id="promo_timeline_filter">
                        <option value="all">Tất cả timeline</option>
                        <option value="active">Đang trong thời gian</option>
                        <option value="upcoming">Sắp bắt đầu</option>
                        <option value="expired">Đã quá hạn</option>
                      </select>
                    </div>
                    <div class="promo-field">
                      <label for="promo_channel_filter">Kênh</label>
                      <select id="promo_channel_filter">
                        <option value="all">Tất cả kênh</option>
                        <option value="All">Tất cả</option>
                        <option value="Website">Website</option>
                        <option value="Direct">Booking trực tiếp</option>
                        <option value="Frontdesk">Lễ tân</option>
                        <option value="CSKH">Chăm sóc khách hàng</option>
                      </select>
                    </div>
                    <div class="promo-field">
                      <label for="promo_health_filter">Cảnh báo</label>
                      <select id="promo_health_filter">
                        <option value="all">Tất cả</option>
                        <option value="attention">Có cảnh báo</option>
                        <option value="green">Đang ổn</option>
                        <option value="slate">Chưa phát sinh</option>
                      </select>
                    </div>
                  </div>
                </section>
              </div>
              <details class="promo-io">
                <summary class="promo-button">Import</summary>
                <div class="promo-io-menu">
                  <button type="button" data-promo-import-csv>CSV</button>
                  <button type="button" data-promo-import-excel>Excel</button>
                  <button type="button" data-promo-template>Tải mẫu CSV</button>
                  <button type="button" data-promo-template-excel>Tải mẫu Excel</button>
                </div>
              </details>
              <details class="promo-io">
                <summary class="promo-button">Export</summary>
                <div class="promo-io-menu">
                  <button type="button" data-promo-export-csv>CSV</button>
                  <button type="button" data-promo-export-excel>Excel</button>
                  <button type="button" data-promo-export-pdf>PDF</button>
                </div>
              </details>
              <input type="file" accept=".csv,.xls,text/csv,application/vnd.ms-excel" data-promo-import-file hidden />
              <button class="promo-button promo-button--primary" type="button" data-open-promo-form>Thêm khuyến mãi</button>
            </div>
          </div>

          <div class="promo-table-wrap">
            <table class="promo-table">
              <thead>
                <tr>
                  <th>Chương trình</th>
                  <th>Khung ngày</th>
                  <th>Ưu đãi</th>
                  <th>Điều kiện áp dụng</th>
                  <th>Trạng thái</th>
                  <th>Hiệu quả</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody data-promo-table-body>
                <% if (!promotions.length) { %>
                  <tr><td colspan="7" class="promo-muted">Chưa có chương trình khuyến mãi nào trong hệ thống.</td></tr>
                <% } %>
                <% promotions.forEach((item) => { %>
                  <tr
                    class="<%= ["rose", "amber"].includes(item.health?.tone || "") ? "is-attention" : "" %>"
                    data-promo-row
                    data-status="<%= item.trangThai %>"
                    data-type="<%= item.loaiUuDai %>"
                    data-timeline="<%= item.isExpiredByDate ? "expired" : (item.isUpcoming ? "upcoming" : (item.isActiveWindow ? "active" : "other")) %>"
                    data-channel="<%= item.promotionMeta?.channel || "All" %>"
                    data-health="<%= item.health?.tone || "slate" %>"
                    data-export-name="<%= item.tenChuongTrinh %>"
                    data-export-start="<%= item.startDate || "" %>"
                    data-export-end="<%= item.endDate || "" %>"
                    data-export-discount-type="<%= item.loaiUuDai || "PERCENT" %>"
                    data-export-discount-value="<%= item.mucUuDai || "" %>"
                    data-export-audience="<%= item.doiTuong || "TatCa" %>"
                    data-export-status="<%= item.trangThai || "DangApDung" %>"
                    data-export-channel="<%= item.promotionMeta?.channel || "All" %>"
                    data-export-min-nights="<%= item.promotionMeta?.minNights || 0 %>"
                    data-export-min-amount="<%= item.promotionMeta?.minAmount || 0 %>"
                    data-export-quota="<%= item.usageLimit || 0 %>"
                    data-export-blackout="<%= (item.blackoutDates || []).join(", ") %>"
                    data-export-stack="<%= item.promotionMeta?.stackPolicy || "NoStack" %>"
                    data-export-goal="<%= item.promotionMeta?.campaignGoal || "" %>"
                    data-keyword="<%= [item.maGiamGia || '', item.tenChuongTrinh, item.doiTuong || '', item.conditionLabel || '', item.channelLabel || '', statusLabel(item.trangThai), typeLabel(item.loaiUuDai)].join(' ').toLowerCase() %>"
                  >
                    <td>
                      <div class="promo-code">
                        <strong><%= item.tenChuongTrinh %></strong>
                        <span><%= item.maGiamGia ? `Mã ${item.maGiamGia}` : `Mã KM #${item.id}` %></span>
                      </div>
                    </td>
                    <td>
                      <strong><%= item.startDate ? dateLabel(item.startDate) : "Chưa đặt" %> → <%= item.endDate ? dateLabel(item.endDate) : "Chưa đặt" %></strong>
                      <div class="promo-muted"><%= timelineLabel(item) %></div>
                    </td>
                    <td>
                      <div class="promo-value"><%= item.valueLabel %></div>
                    </td>
                    <td>
                      <strong><%= item.doiTuong || "TatCa" %></strong>
                      <div class="promo-condition">
                        <span class="promo-tag"><%= item.channelLabel || channelLabel(item.promotionMeta?.channel) %></span>
                        <span class="promo-tag"><%= compactConditionLabel(item.conditionLabel) %></span>
                        <% if ((item.promotionMeta?.stackPolicy || "NoStack") !== "NoStack") { %>
                          <span class="promo-tag"><%= item.stackPolicyLabel || stackLabel(item.promotionMeta?.stackPolicy) %></span>
                        <% } %>
                      </div>
                      <% if (item.blackoutDates && item.blackoutDates.length) { %>
                        <div class="promo-muted" style="margin-top:6px">Ngày chặn: <%= item.blackoutDates.slice(0, 3).join(", ") %><%= item.blackoutDates.length > 3 ? "..." : "" %></div>
                      <% } %>
                    </td>
                    <td>
                      <span class="promo-status promo-status--<%= item.statusTone %>"><%= statusLabel(item.trangThai) %></span>
                      <div class="promo-muted" style="margin-top:6px"><span class="promo-status promo-status--<%= item.timelineTone %>"><%= timelineLabel(item) %></span></div>
                    </td>
                    <td>
                      <strong><%= item.totalUsageCount %> lần dùng</strong>
                      <div class="promo-muted"><%= item.bookingUsageCount %> giao dịch · <%= item.detailUsageCount %> chi tiết phòng</div>
                      <% if (item.usageLimit > 0 && item.totalUsageCount > 0) { %>
                        <div class="promo-meter" aria-label="Tỷ lệ dùng"><span style="width:<%= item.usageRate || 0 %>%"></span></div>
                      <% } else if (item.usageLimit <= 0) { %>
                        <div class="promo-muted">Không giới hạn</div>
                      <% } %>
                    </td>
                    <td>
                      <div class="promo-row-actions">
                        <button class="promo-menu-button" type="button" aria-label="Mở thao tác khuyến mãi" aria-expanded="false" data-promo-menu-button>&#9776;</button>
                        <div class="promo-action-menu" data-promo-action-menu>
                          <a class="promo-button" href="/manager/promotions?edit_promotion=<%= item.id %>#promotion-form-panel">Sửa</a>
                          <form method="post" action="/manager/promotions/<%= item.id %>/delete" onsubmit="return confirm('Xóa khuyến mãi này? Chương trình đã phát sinh giao dịch sẽ bị khóa xóa.');">
                            <button class="promo-button promo-button--danger" type="submit" <%= item.canDelete ? "" : "disabled title='Khuyến mãi đã phát sinh nên không thể xóa.'" %>><%= item.canDelete ? "Xóa" : "Khóa xóa" %></button>
                          </form>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% }) %>
                <tr class="promo-no-results" data-promo-empty-row><td colspan="7" class="promo-muted">Không có chương trình phù hợp với bộ lọc hiện tại.</td></tr>
              </tbody>
            </table>
            <div class="promo-pagination" data-promo-pagination>
              <div data-promo-page-range>Hiển thị <strong>0-0</strong> trong tổng số <strong>0</strong> bản ghi</div>
              <div class="promo-pages" data-promo-pages aria-label="Phân trang danh sách khuyến mãi"></div>
            </div>
          </div>
        </section>
      </div>

    </section>
  </div>
</main>

<script>
  (() => {
    const formPanel = document.querySelector("[data-promo-form-panel]");
    const formElement = document.getElementById("promotionForm");
    const filterPanel = document.querySelector(".promo-filter-panel");
    const formTitle = document.querySelector("[data-promo-form-title]");
    const formState = document.querySelector("[data-promo-form-state]");
    const openFormButtons = Array.from(document.querySelectorAll("[data-open-promo-form]"));
    const closeFormButtons = Array.from(document.querySelectorAll("[data-close-promo-form]"));
    const filterToggleButtons = Array.from(document.querySelectorAll("[data-toggle-promo-filter]"));
    const menuButtons = Array.from(document.querySelectorAll("[data-promo-menu-button]"));
    const statusTabs = Array.from(document.querySelectorAll("[data-promo-status-tab]"));
    const exportCsvButton = document.querySelector("[data-promo-export-csv]");
    const exportExcelButton = document.querySelector("[data-promo-export-excel]");
    const exportPdfButton = document.querySelector("[data-promo-export-pdf]");
    const templateButton = document.querySelector("[data-promo-template]");
    const templateExcelButton = document.querySelector("[data-promo-template-excel]");
    const importCsvButton = document.querySelector("[data-promo-import-csv]");
    const importExcelButton = document.querySelector("[data-promo-import-excel]");
    const importFileInput = document.querySelector("[data-promo-import-file]");
    const importExportMenus = Array.from(document.querySelectorAll(".promo-io"));
    const exportFields = [
      ["ten_chuong_trinh", "data-export-name"],
      ["ngay_bat_dau", "data-export-start"],
      ["ngay_ket_thuc", "data-export-end"],
      ["loai_uu_dai", "data-export-discount-type"],
      ["muc_uu_dai", "data-export-discount-value"],
      ["doi_tuong", "data-export-audience"],
      ["trang_thai", "data-export-status"],
      ["kenh_ap_dung", "data-export-channel"],
      ["so_dem_toi_thieu", "data-export-min-nights"],
      ["gia_tri_toi_thieu", "data-export-min-amount"],
      ["gioi_han_luot_dung", "data-export-quota"],
      ["ngay_chan", "data-export-blackout"],
      ["chinh_sach_cong_don", "data-export-stack"],
      ["muc_tieu_chien_dich", "data-export-goal"]
    ];
    let matchedRowsForExport = [];

    openFormButtons.forEach((button) => {
      button.addEventListener("click", () => {
        resetFormForCreate();
        openFormPanel(true);
      });
    });

    closeFormButtons.forEach((button) => {
      button.addEventListener("click", () => {
        formPanel?.classList.remove("is-open");
      });
    });

    function closeImportExportMenus() {
      importExportMenus.forEach((menu) => {
        menu.open = false;
      });
    }

    filterToggleButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const isOpen = filterPanel?.classList.toggle("is-open");
        filterToggleButtons.forEach((item) => {
          item.textContent = isOpen ? "Ẩn lọc" : "Lọc nâng cao";
          item.setAttribute("aria-expanded", isOpen ? "true" : "false");
        });
      });
    });

    exportCsvButton?.addEventListener("click", () => {
      downloadPromotionCsv(matchedRowsForExport.length ? matchedRowsForExport : rows, "khuyen-mai");
      closeImportExportMenus();
    });

    exportExcelButton?.addEventListener("click", () => {
      downloadPromotionExcel(matchedRowsForExport.length ? matchedRowsForExport : rows, "khuyen-mai");
      closeImportExportMenus();
    });

    exportPdfButton?.addEventListener("click", () => {
      printPromotionPdf(matchedRowsForExport.length ? matchedRowsForExport : rows);
      closeImportExportMenus();
    });

    templateButton?.addEventListener("click", () => {
      downloadPromotionCsv([], "mau-import-khuyen-mai", true);
      closeImportExportMenus();
    });

    templateExcelButton?.addEventListener("click", () => {
      downloadPromotionExcel([], "mau-import-khuyen-mai", true);
      closeImportExportMenus();
    });

    importCsvButton?.addEventListener("click", () => {
      if (importFileInput) importFileInput.accept = ".csv,text/csv";
      importFileInput?.click();
    });

    importExcelButton?.addEventListener("click", () => {
      if (importFileInput) importFileInput.accept = ".xls,application/vnd.ms-excel";
      importFileInput?.click();
    });

    importFileInput?.addEventListener("change", async () => {
      const file = importFileInput.files?.[0];
      if (!file) return;
      try {
        const text = await file.text();
        importPromotionCsv(text);
        closeImportExportMenus();
      } catch (_error) {
        window.alert("Không đọc được file import. Vui lòng dùng CSV hoặc Excel mẫu của hệ thống.");
      } finally {
        importFileInput.value = "";
      }
    });

    statusTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const status = String(tab.getAttribute("data-promo-status-tab") || "all");
        if (statusFilter) statusFilter.value = status;
        statusTabs.forEach((item) => item.classList.toggle("is-active", item === tab));
        currentPage = 1;
        applyFilters();
      });
    });

    menuButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        const actionWrap = button.closest(".promo-row-actions");
        const isOpen = actionWrap?.classList.contains("is-open");
        closeActionMenus();
        if (!isOpen && actionWrap) {
          actionWrap.classList.add("is-open");
          button.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", closeActionMenus);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeActionMenus();
    });

    if (formPanel?.classList.contains("is-open") && window.location.hash === "#promotion-form-panel") {
      formPanel.scrollIntoView({ block: "start" });
    }

    function openFormPanel(shouldScroll) {
      formPanel?.classList.add("is-open");
      if (shouldScroll) formPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function resetFormForCreate() {
      if (!formElement) return;
      formElement.reset();
      const defaults = {
        promotion_id: "",
        ten_chuong_trinh: "",
        ngay_bat_dau: "",
        ngay_ket_thuc: "",
        muc_uu_dai: "",
        doi_tuong: "TatCa",
        trang_thai: "DangApDung",
        loai_uu_dai: "PERCENT",
        kenh_ap_dung: "All",
        so_dem_toi_thieu: "",
        gia_tri_toi_thieu: "",
        gioi_han_luot_dung: "",
        ngay_chan: "",
        chinh_sach_cong_don: "NoStack",
        muc_tieu_chien_dich: ""
      };

      Object.entries(defaults).forEach(([name, value]) => {
        const field = formElement.elements.namedItem(name);
        if (field && "value" in field) field.value = value;
      });

      const submitButton = formElement.querySelector("button[type='submit']");
      if (submitButton) submitButton.textContent = "Tạo khuyến mãi";
      if (formTitle) formTitle.textContent = "Thêm khuyến mãi";
      if (formState) formState.textContent = "Sẵn sàng tạo chương trình mới";
    }

    function closeActionMenus() {
      document.querySelectorAll(".promo-row-actions.is-open").forEach((item) => {
        item.classList.remove("is-open");
        item.querySelector("[data-promo-menu-button]")?.setAttribute("aria-expanded", "false");
      });
    }

    const keywordInput = document.getElementById("promo_keyword");
    const statusFilter = document.getElementById("promo_status_filter");
    const typeFilter = document.getElementById("promo_type_filter");
    const timelineFilter = document.getElementById("promo_timeline_filter");
    const channelFilter = document.getElementById("promo_channel_filter");
    const healthFilter = document.getElementById("promo_health_filter");
    const rows = Array.from(document.querySelectorAll("[data-promo-row]"));
    const liveState = document.querySelector("[data-promo-live-state]");
    const emptyRow = document.querySelector("[data-promo-empty-row]");
    const pageRange = document.querySelector("[data-promo-page-range]");
    const pagesWrap = document.querySelector("[data-promo-pages]");
    const pageSize = 10;
    let currentPage = 1;

    [keywordInput, statusFilter, typeFilter, timelineFilter, channelFilter, healthFilter].forEach((element) => {
      if (!element) return;
      element.addEventListener("input", () => {
        currentPage = 1;
        applyFilters();
      });
      element.addEventListener("change", () => {
        currentPage = 1;
        syncStatusTabs();
        applyFilters();
      });
    });

    function syncStatusTabs() {
      const status = String(statusFilter?.value || "all");
      statusTabs.forEach((tab) => {
        tab.classList.toggle("is-active", String(tab.getAttribute("data-promo-status-tab") || "all") === status);
      });
    }

    function applyFilters() {
      const keyword = String(keywordInput?.value || "").trim().toLowerCase();
      const status = String(statusFilter?.value || "all");
      const type = String(typeFilter?.value || "all");
      const timeline = String(timelineFilter?.value || "all");
      const channel = String(channelFilter?.value || "all");
      const health = String(healthFilter?.value || "all");
      const matchedRows = [];

      rows.forEach((row) => {
        const matchesKeyword = !keyword || String(row.getAttribute("data-keyword") || "").includes(keyword);
        const matchesStatus = status === "all" || String(row.getAttribute("data-status") || "") === status;
        const matchesType = type === "all" || String(row.getAttribute("data-type") || "") === type;
        const matchesTimeline = timeline === "all" || String(row.getAttribute("data-timeline") || "") === timeline;
        const rowHealth = String(row.getAttribute("data-health") || "slate");
        const matchesChannel = channel === "all" || String(row.getAttribute("data-channel") || "All") === channel;
        const matchesHealth = health === "all"
          || (health === "attention" ? ["rose", "amber"].includes(rowHealth) : rowHealth === health);
        const visible = matchesKeyword && matchesStatus && matchesType && matchesTimeline && matchesChannel && matchesHealth;
        if (visible) matchedRows.push(row);
      });

      matchedRowsForExport = matchedRows;
      const visibleCount = matchedRows.length;
      const totalPages = Math.max(1, Math.ceil(visibleCount / pageSize));
      currentPage = Math.min(Math.max(currentPage, 1), totalPages);
      const startIndex = visibleCount ? (currentPage - 1) * pageSize : 0;
      const endIndex = Math.min(startIndex + pageSize, visibleCount);
      const pageRows = new Set(matchedRows.slice(startIndex, endIndex));

      rows.forEach((row) => {
        row.style.display = pageRows.has(row) ? "" : "none";
      });

      if (liveState) liveState.textContent = visibleCount ? `Đã lọc ${visibleCount} chương trình phù hợp` : "Không có chương trình phù hợp";
      if (emptyRow) emptyRow.style.display = visibleCount ? "none" : "";
      updatePagination(visibleCount, startIndex, endIndex, totalPages);
    }

    function updatePagination(totalRows, startIndex, endIndex, totalPages) {
      if (pageRange) {
        const from = totalRows ? startIndex + 1 : 0;
        pageRange.innerHTML = `Hiển thị <strong>${from}-${endIndex}</strong> trong tổng số <strong>${totalRows.toLocaleString("vi-VN")}</strong> bản ghi`;
      }

      if (!pagesWrap) return;
      pagesWrap.innerHTML = "";

      const addPageButton = (label, page, options = {}) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `promo-page${options.active ? " is-active" : ""}`;
        button.textContent = label;
        button.disabled = Boolean(options.disabled);
        button.addEventListener("click", () => {
          if (button.disabled) return;
          currentPage = page;
          applyFilters();
        });
        pagesWrap.appendChild(button);
      };

      addPageButton("Trước", Math.max(1, currentPage - 1), { disabled: currentPage <= 1 });
      for (let pageNo = 1; pageNo <= totalPages; pageNo += 1) {
        if (pageNo <= 5 || pageNo === totalPages || Math.abs(pageNo - currentPage) <= 1) {
          addPageButton(String(pageNo), pageNo, { active: pageNo === currentPage });
        } else if (pageNo === 6 && totalPages > 7) {
          const dots = document.createElement("span");
          dots.className = "promo-page";
          dots.textContent = "...";
          pagesWrap.appendChild(dots);
        }
      }
      addPageButton("Sau", Math.min(totalPages, currentPage + 1), { disabled: currentPage >= totalPages });
    }

    function csvEscape(value) {
      return `"${String(value ?? "").replace(/"/g, '""')}"`;
    }

    function promotionExampleRow() {
      return [
        "Giảm 15% khách đặt sớm",
        "2026-09-01",
        "2026-09-30",
        "PERCENT",
        "15",
        "TatCa",
        "DangApDung",
        "Website",
        "2",
        "1000000",
        "200",
        "2026-09-02, 2026-09-03",
        "NoStack",
        "Đẩy đặt phòng trước mùa cao điểm"
      ];
    }

    function downloadPromotionCsv(sourceRows, filePrefix, includeExample = false) {
      const headers = exportFields.map(([header]) => header);
      const rowsToExport = includeExample
        ? [promotionExampleRow()]
        : sourceRows.map((row) => exportFields.map(([, attr]) => row.getAttribute(attr) || ""));

      const csv = [headers, ...rowsToExport].map((line) => line.map(csvEscape).join(",")).join("\n");
      const blob = new Blob([`\uFEFF${csv}`], { type: "text/csv;charset=utf-8" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `${filePrefix}-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(link);
      link.click();
      URL.revokeObjectURL(link.href);
      link.remove();
    }

    function promotionExportRows(sourceRows) {
      return sourceRows.map((row) => exportFields.map(([, attr]) => row.getAttribute(attr) || ""));
    }

    function htmlEscape(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function downloadPromotionExcel(sourceRows, filePrefix, includeExample = false) {
      const headers = exportFields.map(([header]) => header);
      const rowsToExport = includeExample ? [promotionExampleRow()] : promotionExportRows(sourceRows);
      const table = `
        <table>
          <thead><tr>${headers.map((header) => `<th>${htmlEscape(header)}</th>`).join("")}</tr></thead>
          <tbody>${rowsToExport.map((row) => `<tr>${row.map((cell) => `<td>${htmlEscape(cell)}</td>`).join("")}</tr>`).join("")}</tbody>
        </table>
      `;
      const workbook = `<!doctype html><html><head><meta charset="utf-8"></head><body>${table}</body></html>`;
      const blob = new Blob([workbook], { type: "application/vnd.ms-excel;charset=utf-8" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `${filePrefix}-${new Date().toISOString().slice(0, 10)}.xls`;
      document.body.appendChild(link);
      link.click();
      URL.revokeObjectURL(link.href);
      link.remove();
    }

    function printPromotionPdf(sourceRows) {
      const headers = ["Chương trình", "Ngày bắt đầu", "Ngày kết thúc", "Ưu đãi", "Tệp khách", "Trạng thái", "Kênh", "Quota"];
      const rowsToExport = sourceRows.map((row) => [
        row.getAttribute("data-export-name") || "",
        row.getAttribute("data-export-start") || "",
        row.getAttribute("data-export-end") || "",
        `${row.getAttribute("data-export-discount-value") || ""} ${row.getAttribute("data-export-discount-type") || ""}`.trim(),
        row.getAttribute("data-export-audience") || "",
        row.getAttribute("data-export-status") || "",
        row.getAttribute("data-export-channel") || "",
        row.getAttribute("data-export-quota") || "0"
      ]);
      const reportWindow = window.open("", "_blank", "width=1120,height=720");
      if (!reportWindow) {
        window.alert("Trình duyệt đang chặn popup. Vui lòng cho phép popup để xuất PDF.");
        return;
      }
      reportWindow.document.write(`
        <!doctype html>
        <html>
          <head>
            <meta charset="utf-8">
            <title>Danh sách khuyến mãi</title>
            <style>
              body{font-family:Arial,sans-serif;margin:28px;color:#172033}
              h1{margin:0 0 6px;font-size:24px}
              p{margin:0 0 18px;color:#667085;font-weight:700}
              table{width:100%;border-collapse:collapse;font-size:12px}
              th,td{border:1px solid #dbe7f5;padding:8px;text-align:left;vertical-align:top}
              th{background:#eef6ff;color:#06479d;text-transform:uppercase}
              @media print{button{display:none}}
            </style>
          </head>
          <body>
            <h1>Danh sách khuyến mãi</h1>
            <p>Xuất ngày ${new Date().toLocaleDateString("vi-VN")} · ${rowsToExport.length.toLocaleString("vi-VN")} bản ghi</p>
            <table>
              <thead><tr>${headers.map((header) => `<th>${htmlEscape(header)}</th>`).join("")}</tr></thead>
              <tbody>${rowsToExport.map((row) => `<tr>${row.map((cell) => `<td>${htmlEscape(cell)}</td>`).join("")}</tr>`).join("")}</tbody>
            </table>
            <script>window.onload = () => { window.print(); };<\/script>
          </body>
        </html>
      `);
      reportWindow.document.close();
    }

    function parsePromotionCsv(text) {
      const rows = [];
      let row = [];
      let cell = "";
      let quoted = false;

      for (let index = 0; index < text.length; index += 1) {
        const char = text[index];
        const next = text[index + 1];
        if (quoted) {
          if (char === '"' && next === '"') {
            cell += '"';
            index += 1;
          } else if (char === '"') {
            quoted = false;
          } else {
            cell += char;
          }
        } else if (char === '"') {
          quoted = true;
        } else if (char === ",") {
          row.push(cell);
          cell = "";
        } else if (char === "\n") {
          row.push(cell);
          rows.push(row);
          row = [];
          cell = "";
        } else if (char !== "\r") {
          cell += char;
        }
      }

      if (cell || row.length) {
        row.push(cell);
        rows.push(row);
      }
      return rows.filter((item) => item.some((cellValue) => String(cellValue || "").trim()));
    }

    function parsePromotionExcelHtml(text) {
      const parsed = new DOMParser().parseFromString(text, "text/html");
      const tableRows = Array.from(parsed.querySelectorAll("tr"));
      return tableRows.map((tableRow) => {
        return Array.from(tableRow.querySelectorAll("th,td")).map((cell) => String(cell.textContent || "").trim());
      }).filter((row) => row.some((cell) => cell));
    }

    function importPromotionCsv(text) {
      const parsedRows = /<table[\s>]/i.test(text) ? parsePromotionExcelHtml(text) : parsePromotionCsv(text);
      if (parsedRows.length < 2) {
        window.alert("File import cần có dòng tiêu đề và ít nhất 1 dòng dữ liệu.");
        return;
      }

      const headers = parsedRows[0].map((header) => String(header || "").trim());
      const firstDataRow = parsedRows[1];
      const imported = {};
      headers.forEach((header, index) => {
        imported[header] = firstDataRow[index] || "";
      });

      resetFormForCreate();
      Object.keys(imported).forEach((name) => {
        const field = formElement?.elements.namedItem(name);
        if (field && "value" in field) field.value = imported[name];
      });
      openFormPanel(true);
      if (formState) formState.textContent = `Đã import 1/${parsedRows.length - 1} dòng - kiểm tra trước khi tạo`;
    }

    syncStatusTabs();
    applyFilters();
  })();
</script>

