  .promo-hero-mark{right:50px;top:50%;bottom:auto;transform:translateY(-50%);width:230px;z-index:2;gap:12px}
  .promo-mark-line{border-radius:999px}
  .promo-mark-line span{border-radius:999px}
  .promo-mark-line:nth-child(1) span{background:#67e8f9}.promo-mark-line:nth-child(2) span{background:#fff2a8}.promo-mark-line:nth-child(3) span{background:#bbf7d0}.promo-mark-line:nth-child(4) span{background:#fecdd3}
  .promo-stat{background:linear-gradient(180deg,rgba(255,255,255,.90),rgba(255,255,255,.66));position:relative;overflow:hidden}
  .promo-stat::after{content:"";position:absolute;right:-34px;top:-40px;width:112px;height:112px;border-radius:999px}
  .promo-stat:nth-child(2)::after{background:radial-gradient(circle,rgba(33,207,166,.22),transparent 68%)}
  .promo-stat:nth-child(4)::after,.promo-stat:nth-child(7)::after{background:radial-gradient(circle,rgba(255,111,163,.20),transparent 68%)}
  .promo-stat:nth-child(5)::after{background:radial-gradient(circle,rgba(255,209,102,.28),transparent 68%)}
  .promo-stat strong{position:relative;z-index:1}
  .promo-stat span{position:relative;z-index:1}
  .promo-table-panel::before{height:0;background:none}
  .promo-table tbody tr{transition:background .18s ease,box-shadow .18s ease}
  @keyframes promo-float{from{transform:translate3d(0,0,0) rotate(0)}to{transform:translate3d(28px,24px,0) rotate(14deg)}}
  @keyframes promo-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.72);opacity:.68}}
  @media(max-width:1280px){.promo-home{max-width:1240px}.promo-hero-main{grid-template-columns:1fr}.promo-hero-main::after,.promo-hero-mark{display:none}.promo-summary{grid-template-columns:repeat(3,minmax(0,1fr))}.promo-layout{grid-template-columns:1fr}.promo-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.promo-field-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.promo-table{min-width:1180px;table-layout:fixed}}
  @media(max-width:720px){.promo-field.is-wide{grid-column:auto}.promo-row-actions{grid-template-columns:1fr}}
