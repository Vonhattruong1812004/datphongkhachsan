    border:1px solid var(--promo-line);
    border-radius:12px;
    padding:18px;
    background:rgba(255,255,255,.96);
    color:var(--promo-ink);
    box-shadow:var(--promo-shadow);
    backdrop-filter:none;
    overflow:visible;
