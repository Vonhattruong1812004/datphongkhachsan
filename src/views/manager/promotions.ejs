  .promo-panel,.promo-hero-main,.promo-table-panel,.promo-stat{backdrop-filter:blur(26px)}
  .promo-hero-main{grid-template-columns:minmax(0,1fr) 320px}
  .promo-hero-main::before{content:"";position:absolute;inset:-1px;pointer-events:none}
  .promo-hero-main::after{content:"";position:absolute;right:22px;top:22px;bottom:22px;width:320px;border-radius:32px}
  .promo-chip{border-radius:999px;padding:7px 12px;font-size:12px;font-weight:1000}
  .promo-dot{border-radius:999px;animation:promo-pulse 1.8s ease-in-out infinite}
  .promo-hero h1 span{-webkit-background-clip:text}
