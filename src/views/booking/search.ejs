<%
  const pageSummary = summary || {};
  const recentRoomItems = typeof recentRooms !== "undefined" && Array.isArray(recentRooms) ? recentRooms : [];
  const destinationSuggestions = typeof popularDestinations !== "undefined" && Array.isArray(popularDestinations) ? popularDestinations : [];
  const accommodationTypeItems = typeof accommodationTypes !== "undefined" && Array.isArray(accommodationTypes) ? accommodationTypes : [];
  const staffMode = String((typeof query !== "undefined" && query && query.staff_mode) || "");
  const isCskhAssist = staffMode === "cskh" || Number(currentUser?.maVaiTro || 0) === 5;
  const searchQueryParams = new URLSearchParams(filters || {});
  if (staffMode) searchQueryParams.set("staff_mode", staffMode);
  const searchQuery = searchQueryParams.toString();
  const roomHref = (room) => {
    const params = new URLSearchParams(filters || {});
    if (staffMode) params.set("staff_mode", staffMode);
    return `/booking/rooms/${room.id}${params.toString() ? `?${params.toString()}` : ""}`;
  };
  const roomDetailHref = (room) => {
    const params = new URLSearchParams(filters || {});
    if (staffMode) params.set("staff_mode", staffMode);
    return `/booking/rooms/${room.id}/detail${params.toString() ? `?${params.toString()}` : ""}`;
  };
  const directionsHref = (room) => {
    if (!room.hotelLatitude || !room.hotelLongitude) return "";
    const params = new URLSearchParams({
      api: "1",
      destination: `${room.hotelLatitude},${room.hotelLongitude}`
    });
    if (filters.user_lat && filters.user_lng) {
      params.set("origin", `${filters.user_lat},${filters.user_lng}`);
    }
    return `https://www.google.com/maps/dir/?${params.toString()}`;
  };
  const roomMapItems = [];
  const seenMapKeys = new Set();
  (rooms || []).forEach((room) => {
    const lat = Number(room.hotelLatitude);
    const lng = Number(room.hotelLongitude);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
    const key = String(room.maKhachSan || `${lat},${lng},${room.khachSan}`);
    if (seenMapKeys.has(key)) return;
    seenMapKeys.add(key);
    roomMapItems.push({
      id: room.id,
      title: room.khachSan,
      type: room.loaiLuuTruTen || "Hotel",
      city: room.tinhThanh || "",
      district: room.quanHuyen || "",
      address: room.diaChi || "",
      roomLabel: `${room.loaiPhong || "Phòng"} · P${room.soPhong || ""}`,
      price: room.priceFormatted || `${Number(room.gia || 0).toLocaleString("vi-VN")} đ`,
      lat,
      lng,
      nearbyName: room.nearbyPlaceName || "",
      nearbyDistance: room.nearbyDistanceLabel || "",
      userDistance: room.userDistanceLabel || "",
      detailUrl: roomDetailHref(room),
      directionsUrl: directionsHref(room)
    });
  });
  const roomMapJson = JSON.stringify(roomMapItems).replace(/</g, "\\u003c");
  const numberFilterValue = (value) => Number(value || 0) > 0 ? value : "";
  const activeDestinationLabel = filters.dia_diem || filters.hotel_city || "Toàn quốc";
  const promoTypeLabel = (value) => value === "PERCENT" ? "Giảm %" : "Giảm tiền";
  const formatPromoDate = (value) => {
    if (!value) return "";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return String(value);
    return date.toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" });
  };
%>
