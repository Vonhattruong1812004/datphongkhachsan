  /* Booking search UI pass: compact, readable, Booking/Traveloka-like work surface. */
  body {
    background:
      linear-gradient(180deg, #f6fbff 0%, #eef6ff 42%, #f8fbff 100%) !important;
    color: #172033;
  }

  .guest-booking-shell {
    max-width: 1320px;
    display: grid;
    gap: 16px;
    padding: 24px 18px 56px;
  }

  .guest-booking-shell::before,
  .guest-booking-shell::after,
  .guest-hero::before,
  .guest-hero::after,
  .guest-hero p,
  .guest-journey,
  .guest-summary-grid,
  .map-panel {
    display: none !important;
  }

  .guest-hero {
    min-height: 0;
    margin: 0;
    padding: 22px 24px;
    border-radius: 10px;
    border-color: #bfdbfe;
    background: linear-gradient(135deg, #0071e8, #0047a8) !important;
    box-shadow: 0 18px 42px rgba(0, 59, 149, .16);
  }

  .guest-kicker {
    color: #dff5ff;
    background: rgba(255, 255, 255, .12);
    border-color: rgba(255, 255, 255, .22);
    letter-spacing: 0;
    text-transform: none;
  }

  .guest-hero h1 {
    margin: 10px 0 0;
    color: #ffffff !important;
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1.05;
    letter-spacing: 0;
    text-shadow: 0 3px 18px rgba(0, 32, 92, .28);
  }

  .guest-hero h1 span {
    color: #dff5ff !important;
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
  }

  .guest-search-layout {
    display: grid;
    grid-template-columns: 326px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .guest-results-stack {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .guest-panel {
    margin: 0;
    border-radius: 10px;
    border-color: #c9e0fb;
    background: rgba(255, 255, 255, .96);
    box-shadow: 0 16px 38px rgba(15, 36, 66, .08);
    backdrop-filter: none;
  }

  .guest-filter-panel {
    position: sticky;
    top: 118px;
    padding: 18px;
  }

  .guest-panel h2 {
    margin-bottom: 12px;
    color: #0b1f3a;
    font-size: 22px;
    letter-spacing: 0;
  }

  .guest-filter-panel .guest-muted,
  .guest-results-panel > .guest-muted {
    display: none;
  }

  .destination-chip-row {
    margin: 0 0 14px;
    gap: 6px;
  }

  .destination-chip {
    padding: 7px 10px;
    background: #f8fbff;
    color: #0057c2;
    border-color: #c9e0fb;
    box-shadow: none;
  }

  .guest-form-grid {
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 0;
  }

  .guest-field {
    gap: 5px;
  }

  .guest-field label {
    color: #52657b;
    font-size: 12px;
    letter-spacing: 0;
    text-transform: none;
  }

  .guest-field input,
  .guest-field select {
    min-height: 42px;
    border-radius: 8px;
    border-color: #d8e4f2;
    background: #ffffff;
    box-shadow: none;
  }

  .guest-error-msg {
    min-height: 0;
  }

  .guest-actions {
    gap: 8px;
    margin-top: 14px;
  }

  .guest-button {
    min-height: 40px;
    border-radius: 8px;
    box-shadow: none;
  }

  .guest-button--primary {
    background: #006ce4;
    box-shadow: 0 10px 22px rgba(0, 108, 228, .18);
  }

  .geo-row {
    margin-top: 10px;
  }

  .geo-status {
    width: 100%;
    min-height: 34px;
    border-radius: 8px;
    justify-content: center;
    background: #f8fbff;
  }

  .room-grid-fresh {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 0;
  }

  .room-fresh {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    min-height: 220px;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 14px 34px rgba(15, 36, 66, .08);
  }

  .room-fresh:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 46px rgba(15, 36, 66, .12);
  }

  .room-fresh img {
    height: 100%;
    min-height: 220px;
  }

  .room-fresh__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 10px 18px;
    align-content: start;
    padding: 16px 18px;
  }

  .room-main {
    min-width: 0;
  }

  .room-booking-side {
    display: grid;
    justify-items: end;
    align-content: start;
    gap: 10px;
  }

  .room-badge {
    padding: 5px 9px;
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #0057c2;
    letter-spacing: 0;
    text-transform: none;
  }

  .room-fresh h3 {
    margin: 8px 0 5px;
    font-size: 22px;
    letter-spacing: 0;
  }

  .room-fresh p {
    margin-bottom: 5px;
    color: #52657b;
  }

  .room-address {
    overflow-wrap: anywhere;
  }

  .room-nearby {
    margin: 8px 0;
    border-radius: 8px;
    background: #f8fbff;
  }

  .room-nearby__pin {
    background: #006ce4;
  }

  .room-signal {
    margin: 8px 0 0;
  }

  .room-signal span {
    color: #047857;
    background: #ecfdf5;
    border-color: #bbf7d0;
  }

  .room-price {
    margin: 0;
    color: #047857;
    font-size: 22px;
    text-align: right;
    white-space: nowrap;
  }

  .room-money-grid {
    width: 100%;
    grid-template-columns: 1fr;
    gap: 8px;
    margin: 0;
  }

  .room-money {
    border-radius: 8px;
    background: #f8fbff;
  }

  .room-booking-side .guest-actions {
    width: 100%;
    justify-content: flex-end;
    margin-top: 0;
  }

  .promo-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .promo-card {
    border-radius: 10px;
    padding: 14px;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 36, 66, .07);
  }

  .promo-card h3 {
    margin: 8px 0;
    font-size: 16px;
    line-height: 1.25;
  }

  .promo-card .room-price {
    text-align: left;
    font-size: 20px;
  }

  @media(max-width:1100px) {
    .guest-search-layout {
      grid-template-columns: 1fr;
    }

    .guest-filter-panel {
      position: static;
    }

    .guest-form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media(max-width:820px) {
    .room-fresh,
    .room-fresh__body {
      grid-template-columns: 1fr;
    }

    .room-fresh img {
      height: 210px;
    }

    .room-booking-side {
      justify-items: start;
    }

    .room-price {
      text-align: left;
    }

    .promo-grid {
      grid-template-columns: 1fr;
    }
  }

  @media(max-width:680px) {
    .guest-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<main class="guest-booking-shell">
  <section class="guest-hero">
    <div class="guest-kicker"><%= isCskhAssist ? "CSKH hỗ trợ" : "Đặt phòng trực tuyến" %></div>
    <h1>Tìm nơi lưu trú <span><%= activeDestinationLabel %></span></h1>
    <p>Lọc phòng theo ngày ở, điểm đến, loại cơ sở lưu trú, hạng phòng, view, loại giường và ngân sách. Khi khách xác nhận, hệ thống tạo QR cọc SePay 50%, giữ phòng 10 phút và tự tạo đặt phòng sau khi tiền về đúng nội dung.</p>
    <div class="guest-journey" aria-label="Luồng đặt phòng trực tuyến">
      <div class="guest-step"><span>01</span><strong>Tìm phòng trống theo lịch</strong></div>
      <div class="guest-step"><span>02</span><strong>Kiểm tra giá và khuyến mãi</strong></div>
      <div class="guest-step"><span>03</span><strong>Tạo QR cọc SePay 50%</strong></div>
      <div class="guest-step"><span>04</span><strong>SePay xác nhận đặt phòng</strong></div>
    </div>
  </section>

  <div class="guest-search-layout">
  <section class="guest-panel guest-filter-panel">
    <h2>Bộ lọc</h2>
    <div class="guest-muted">Chọn ngày nhận/trả để kiểm tra trùng lịch đặt phòng. Nếu chưa chọn ngày, hệ thống chỉ hiển thị phòng đang ở trạng thái trống.</div>
    <div class="guest-summary-grid" aria-label="Tóm tắt tìm kiếm">
      <div class="guest-summary-card"><span>Thời gian</span><strong><%= pageSummary.checkinLabel || "Chưa chọn" %> → <%= pageSummary.checkoutLabel || "Chưa chọn" %></strong></div>
      <div class="guest-summary-card"><span>Số đêm</span><strong><%= Number(pageSummary.nights || 0) %> đêm</strong></div>
      <div class="guest-summary-card"><span>Giá tốt nhất</span><strong><%= pageSummary.bestPriceFormatted || "Chưa có" %></strong></div>
      <div class="guest-summary-card"><span>Thanh toán</span><strong><%= pageSummary.depositPolicyLabel || "Cọc 50% qua SePay" %></strong></div>
    </div>
    <% if (destinationSuggestions.length) { %>
      <div class="destination-chip-row" aria-label="Địa điểm gợi ý">
        <% destinationSuggestions.slice(0, 5).forEach((destination) => { %>
          <a class="destination-chip" href="/booking/search?dia_diem=<%= encodeURIComponent(destination.name) %>">
            <span></span><%= destination.name %>
          </a>
        <% }) %>
      </div>
    <% } %>
    <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
      <div class="guest-search-alert"><%= errorMessage %></div>
    <% } %>
    <form method="get" action="/booking/search" id="bookingSearchForm" novalidate>
      <% if (staffMode) { %><input type="hidden" name="staff_mode" value="<%= staffMode %>" /><% } %>
      <input type="hidden" name="user_lat" id="searchUserLat" value="<%= filters.user_lat || "" %>" />
      <input type="hidden" name="user_lng" id="searchUserLng" value="<%= filters.user_lng || "" %>" />
      <div class="guest-form-grid">
        <div class="guest-field"><label>Gần địa điểm</label><input name="dia_diem" value="<%= filters.dia_diem %>" placeholder="VD: Vũng Tàu, Bà Nà..." /></div>
        <div class="guest-field"><label>Loại lưu trú</label>
          <select name="loai_luu_tru">
            <option value="">Tất cả</option>
            <% accommodationTypeItems.forEach((type) => { %>
              <option value="<%= type.code %>" <%= filters.loai_luu_tru === type.code ? "selected" : "" %>><%= type.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="guest-field"><label>Tỉnh/thành</label><input name="hotel_city" value="<%= filters.hotel_city %>" placeholder="VD: Bà Rịa - Vũng Tàu" /></div>
        <div class="guest-field"><label>Quận/huyện</label><input name="hotel_district" value="<%= filters.hotel_district %>" placeholder="VD: Vũng Tàu, Xuyên Mộc" /></div>
        <div class="guest-field"><label>Cơ sở lưu trú</label><input name="hotel_name" value="<%= filters.hotel_name %>" placeholder="Tên hotel, resort, homestay..." /></div>
        <div class="guest-field"><label>Loại phòng</label><input name="loai_phong" value="<%= filters.loai_phong %>" placeholder="VD: Deluxe, Suite..." /></div>
        <div class="guest-field"><label>Loại giường</label><input name="loai_giuong" value="<%= filters.loai_giuong %>" placeholder="VD: King, Twin..." /></div>
        <div class="guest-field"><label>View phòng</label><input name="view_phong" value="<%= filters.view_phong %>" placeholder="Biển, Vườn..." /></div>
        <div class="guest-field">
          <label for="search_so_khach">Số khách</label>
          <input id="search_so_khach" name="so_khach" type="number" min="1" value="<%= numberFilterValue(filters.so_khach) %>" />
          <div class="guest-error-msg" id="err_search_so_khach"></div>
        </div>
        <div class="guest-field">
          <label for="search_ngay_nhan">Ngày nhận</label>
          <input id="search_ngay_nhan" name="ngay_nhan" type="date" value="<%= filters.ngay_nhan %>" />
          <div class="guest-error-msg" id="err_search_ngay_nhan"></div>
        </div>
        <div class="guest-field">
          <label for="search_ngay_tra">Ngày trả</label>
          <input id="search_ngay_tra" name="ngay_tra" type="date" value="<%= filters.ngay_tra %>" />
          <div class="guest-error-msg" id="err_search_ngay_tra"></div>
        </div>
        <div class="guest-field">
          <label for="search_gia_goi_y">Ngân sách / đêm</label>
          <input id="search_gia_goi_y" name="gia_goi_y" type="number" min="0" step="50000" value="<%= numberFilterValue(filters.gia_goi_y) %>" />
          <div class="guest-error-msg" id="err_search_gia_goi_y"></div>
        </div>
        <div class="guest-field"><label>Sắp xếp</label>
          <select name="sort_by">
            <option value="ai" <%= filters.sort_by === "ai" ? "selected" : "" %>>Gợi ý thông minh</option>
            <option value="distance" <%= filters.sort_by === "distance" ? "selected" : "" %>>Gần tôi nhất</option>
            <option value="price_asc" <%= filters.sort_by === "price_asc" ? "selected" : "" %>>Giá thấp trước</option>
            <option value="price_desc" <%= filters.sort_by === "price_desc" ? "selected" : "" %>>Giá cao trước</option>
            <option value="capacity_fit" <%= filters.sort_by === "capacity_fit" ? "selected" : "" %>>Vừa số khách</option>
          </select>
        </div>
      </div>
      <div class="guest-actions">
        <button class="guest-button guest-button--primary" type="submit">Tìm phòng phù hợp</button>
        <button class="guest-button" type="button" id="useCurrentLocation">Dùng vị trí của tôi</button>
        <a class="guest-button" href="/booking/search<%= staffMode ? `?staff_mode=${staffMode}` : "" %>">Nhập lại</a>
      </div>
      <div class="geo-row">
        <span class="geo-status <%= filters.user_lat && filters.user_lng ? "is-active" : "" %>" id="geoStatus">
          <%= filters.user_lat && filters.user_lng ? "Đã bật vị trí, đang ưu tiên nơi gần bạn" : "Chưa dùng vị trí hiện tại" %>
        </span>
      </div>
    </form>
  </section>

  <div class="guest-results-stack">
  <% if (recentRoomItems.length) { %>
    <section class="guest-panel guest-recent-panel">
      <h2>Phòng đã xem gần đây</h2>
      <div class="recent-room-strip">
        <% recentRoomItems.forEach((room) => { %>
          <article class="recent-room-card">
            <img src="<%= room.imageUrl %>" alt="<%= room.loaiPhong %> - phòng <%= room.soPhong %>" />
            <div>
              <span class="room-badge"><%= room.tinhThanh || "Điểm đến" %></span>
              <h3><%= room.loaiPhong %> · Phòng <%= room.soPhong %></h3>
              <p><%= room.loaiLuuTruTen || "Hotel" %> · <%= room.khachSan %> · <%= room.loaiGiuong %> · <%= room.viewPhong %></p>
              <strong><%= room.priceFormatted %> / đêm</strong>
              <div class="recent-room-actions">
                <a class="guest-button" href="<%= room.detailHref %>">Chi tiết</a>
                <a class="guest-button guest-button--primary" href="<%= room.bookingHref %>"><%= isCskhAssist ? "Hỗ trợ đặt" : "Đặt lại" %></a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="guest-panel guest-results-panel">
    <h2><%= rooms.length %> phòng phù hợp</h2>
    <div class="guest-muted">
      Sắp xếp: <%= pageSummary.sortLabel || "Gợi ý thông minh" %>.
      <% if (Number(pageSummary.heldRoomCount || 0) > 0) { %>
        Đã loại <%= Number(pageSummary.heldRoomCount || 0) %> phòng đang được giữ cọc trong khung ngày này.
      <% } %>
      Chọn một phòng để nhập thông tin, xem tóm tắt giá rồi mới xác nhận tạo QR cọc.
    </div>
    <% if (!rooms.length) { %>
      <div class="guest-empty" style="margin-top:16px">Không tìm thấy phòng phù hợp. Bạn thử đổi ngày ở, giảm tiêu chí lọc hoặc mở AI chat để được gợi ý nhanh hơn.</div>
    <% } else { %>
      <% if (false && roomMapItems.length) { %>
        <div class="map-panel" aria-label="Bản đồ vị trí cơ sở lưu trú">
          <div class="map-canvas" id="bookingSearchMap"></div>
          <aside class="map-side">
            <h3>Vị trí trên bản đồ</h3>
            <p>Xem nhanh cơ sở lưu trú nằm ở khu nào, có gần điểm du lịch hoặc gần vị trí của bạn không.</p>
            <div class="map-place-list">
              <% roomMapItems.slice(0, 8).forEach((item) => { %>
                <a class="map-place" href="<%= item.detailUrl %>">
                  <strong><%= item.title %></strong>
                  <span><%= item.type %> · <%= item.district ? `${item.district} · ` : "" %><%= item.city %></span>
                  <% if (item.nearbyName) { %><span>Gần <%= item.nearbyName %><%= item.nearbyDistance ? ` · ${item.nearbyDistance}` : "" %></span><% } %>
                  <% if (item.userDistance) { %><span>Cách bạn khoảng <%= item.userDistance %></span><% } %>
                </a>
              <% }) %>
            </div>
          </aside>
        </div>
      <% } %>
      <div class="room-grid-fresh">
        <% rooms.forEach((room) => { %>
          <article class="room-fresh">
            <img src="<%= room.imageUrl %>" alt="<%= room.loaiPhong %> - phòng <%= room.soPhong %>" />
            <div class="room-fresh__body">
              <div class="room-main">
                <span class="room-badge"><%= room.loaiLuuTruTen || "Hotel" %> · <%= room.quanHuyen || room.tinhThanh || "Điểm đến" %></span>
                <h3><%= room.khachSan || `${room.loaiPhong} phòng ${room.soPhong}` %></h3>
                <p><%= room.loaiPhong %> · Phòng <%= room.soPhong %> · <%= room.loaiGiuong || "Giường tiêu chuẩn" %> · <%= room.viewPhong || "View nội khu" %></p>
                <p class="room-address"><%= room.diaChi || "Địa chỉ đang được cập nhật" %><%= room.tinhThanh ? ` · ${room.tinhThanh}` : "" %></p>
                <% if (room.userDistanceLabel) { %>
                  <div class="room-distance">
                    <span>⌖</span> Cách bạn khoảng <%= room.userDistanceLabel %>
                    <% if (directionsHref(room)) { %><a href="<%= directionsHref(room) %>" target="_blank" rel="noopener">Xem đường đi</a><% } %>
                  </div>
                <% } %>
                <% if (room.nearbyPlaceName) { %>
                  <div class="room-nearby">
                    <span class="room-nearby__pin">G</span>
                    <div>
                      <strong>Gần <%= room.nearbyPlaceName %></strong>
                      <span><%= room.nearbyDistanceLabel || "Đang cập nhật khoảng cách" %><%= room.nearbyTravelTimeLabel ? ` · ${room.nearbyTravelTimeLabel}` : "" %><%= room.nearbyPlaceType ? ` · ${room.nearbyPlaceType}` : "" %></span>
                    </div>
                  </div>
                <% } %>
                <div class="room-signal">
                  <span><%= room.capacityFitLabel || `Tối đa ${room.soKhachToiDa} khách` %></span>
                  <span>Cọc SePay 50%</span>
                </div>
              </div>
              <div class="room-booking-side">
                <strong class="room-price"><%= room.priceFormatted || `${Number(room.gia).toLocaleString("vi-VN")} đ` %> / đêm</strong>
                <% if (room.estimatedNights) { %>
                  <div class="room-money-grid">
                    <div class="room-money"><span>Tổng <%= room.estimatedNights %> đêm</span><strong><%= room.estimatedTotalFormatted %></strong></div>
                    <div class="room-money"><span>Cọc 50%</span><strong><%= room.estimatedDepositFormatted %></strong></div>
                  </div>
                <% } %>
                <div class="guest-actions">
                  <a class="guest-button" href="<%= roomDetailHref(room) %>">Chi tiết</a>
                  <a class="guest-button guest-button--primary" href="<%= roomHref(room) %>"><%= isCskhAssist ? "Hỗ trợ đặt" : "Đặt phòng" %></a>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
  </div>
  </div>

  <section class="guest-panel guest-promo-panel">
    <h2>Ưu đãi đang áp dụng</h2>
    <% if (!promotions.length) { %>
      <div class="guest-empty">Chưa có chương trình khuyến mãi đang áp dụng.</div>
    <% } else { %>
      <div class="promo-grid">
        <% promotions.forEach((promotion) => { %>
          <article class="promo-card">
            <span class="room-badge"><%= promoTypeLabel(promotion.loaiUuDai) %></span>
            <h3><%= promotion.tenChuongTrinh %></h3>
            <% if (promotion.maGiamGia) { %><p class="guest-muted">Mã: <strong><%= promotion.maGiamGia %></strong></p><% } %>
            <strong class="room-price"><%= Number(promotion.mucUuDai).toLocaleString("vi-VN") %><%= promotion.loaiUuDai === "PERCENT" ? "%" : " đ" %></strong>
            <p class="guest-muted"><%= formatPromoDate(promotion.ngayBatDau) || "Chưa đặt ngày" %> → <%= formatPromoDate(promotion.ngayKetThuc) || "Không giới hạn" %></p>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>
<script type="application/json" id="bookingSearchMapData"><%- roomMapJson %></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("bookingSearchForm");
  if (!form) return;

  const fields = {
    so_khach: document.getElementById("search_so_khach"),
    gia_goi_y: document.getElementById("search_gia_goi_y"),
    ngay_nhan: document.getElementById("search_ngay_nhan"),
    ngay_tra: document.getElementById("search_ngay_tra")
  };
  const errors = {
    so_khach: document.getElementById("err_search_so_khach"),
    gia_goi_y: document.getElementById("err_search_gia_goi_y"),
    ngay_nhan: document.getElementById("err_search_ngay_nhan"),
    ngay_tra: document.getElementById("err_search_ngay_tra")
  };
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const todayValue = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, "0"),
    String(today.getDate()).padStart(2, "0")
  ].join("-");

  fields.ngay_nhan?.setAttribute("min", todayValue);
  fields.ngay_tra?.setAttribute("min", todayValue);

  const geoButton = document.getElementById("useCurrentLocation");
  const geoStatus = document.getElementById("geoStatus");
  const userLatInput = document.getElementById("searchUserLat");
  const userLngInput = document.getElementById("searchUserLng");
  const sortSelect = form.querySelector('select[name="sort_by"]');

  function setGeoStatus(message, tone) {
    if (!geoStatus) return;
    geoStatus.textContent = message;
    geoStatus.classList.toggle("is-active", tone === "active");
    geoStatus.classList.toggle("is-error", tone === "error");
  }

  geoButton?.addEventListener("click", function () {
    if (!navigator.geolocation) {
      setGeoStatus("Trình duyệt không hỗ trợ lấy vị trí.", "error");
      return;
    }

    geoButton.disabled = true;
    setGeoStatus("Đang xin quyền truy cập vị trí...", "");
    navigator.geolocation.getCurrentPosition(function (position) {
      userLatInput.value = position.coords.latitude.toFixed(7);
      userLngInput.value = position.coords.longitude.toFixed(7);
      if (sortSelect) sortSelect.value = "distance";
      setGeoStatus("Đã lấy vị trí, đang tải nơi gần bạn...", "active");
      form.submit();
    }, function () {
      setGeoStatus("Bạn chưa cho phép truy cập vị trí. Hãy bật quyền vị trí trên trình duyệt rồi thử lại.", "error");
      geoButton.disabled = false;
    }, {
      enableHighAccuracy: true,
      timeout: 10000,
      maximumAge: 300000
    });
  });

  function parseDate(value) {
    if (!value) return null;
    const date = new Date(`${value}T00:00:00`);
    return Number.isNaN(date.getTime()) ? null : date;
  }

  function value(name) {
    return String(fields[name]?.value || "").trim();
  }

  function setError(name, message) {
    const field = fields[name];
    const box = errors[name];
    if (field) field.classList.add("is-invalid");
    if (box) box.textContent = message;
    return false;
  }

  function clearError(name) {
    const field = fields[name];
    const box = errors[name];
    if (field) field.classList.remove("is-invalid");
    if (box) box.textContent = "";
  }

  function validateField(name) {
    clearError(name);
    const current = value(name);

    if (name === "so_khach" && current) {
      const count = Number(current);
      if (!Number.isInteger(count) || count < 1) return setError(name, "Số khách phải là số nguyên từ 1 trở lên.");
    }

    if (name === "gia_goi_y" && current) {
      const budget = Number(current);
      if (!Number.isFinite(budget) || budget < 0) return setError(name, "Ngân sách không được âm.");
    }

    if (name === "ngay_nhan") {
      const checkinValue = value("ngay_nhan");
      const checkoutValue = value("ngay_tra");
      const checkin = parseDate(checkinValue);
      if (checkinValue && !checkin) return setError(name, "Ngày nhận phòng không hợp lệ.");
      if (checkin && checkin < today) return setError(name, "Ngày nhận phòng phải từ hôm nay trở đi.");
      if (checkinValue && !checkoutValue) return setError("ngay_tra", "Vui lòng chọn ngày trả phòng để kiểm tra phòng trống.");
      validateField("ngay_tra");
    }

    if (name === "ngay_tra") {
      const checkinValue = value("ngay_nhan");
      const checkoutValue = value("ngay_tra");
      const checkin = parseDate(checkinValue);
      const checkout = parseDate(checkoutValue);
      if (checkoutValue && !checkout) return setError(name, "Ngày trả phòng không hợp lệ.");
      if (checkout && checkout < today) return setError(name, "Ngày trả phòng không được nhỏ hơn hôm nay.");
      if (!checkinValue && checkoutValue) return setError("ngay_nhan", "Vui lòng chọn ngày nhận phòng trước.");
      if (checkin && checkout && checkout <= checkin) return setError(name, "Ngày trả phòng phải sau ngày nhận phòng.");
    }

    return true;
  }

  Object.keys(fields).forEach((name) => {
    fields[name]?.addEventListener("input", () => validateField(name));
    fields[name]?.addEventListener("change", () => validateField(name));
    fields[name]?.addEventListener("blur", () => validateField(name));
  });

  form.addEventListener("submit", (event) => {
    const ok = Object.keys(fields).every((name) => validateField(name));
    if (!ok) {
      event.preventDefault();
      const firstInvalid = form.querySelector(".is-invalid");
      firstInvalid?.focus();
    }
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const mapNode = document.getElementById("bookingSearchMap");
  const dataNode = document.getElementById("bookingSearchMapData");
  if (!mapNode || !dataNode) return;

  let items = [];
  try {
    items = JSON.parse(dataNode.textContent || "[]");
  } catch (_error) {
    items = [];
  }

  if (!items.length) {
    mapNode.innerHTML = '<div class="map-fallback">Chưa có tọa độ cơ sở lưu trú để hiển thị bản đồ.</div>';
    return;
  }

  if (!window.L) {
    mapNode.innerHTML = '<div class="map-fallback">Không tải được bản đồ. Bạn vẫn có thể bấm "Xem đường đi" trong từng phòng.</div>';
    return;
  }

  const map = L.map(mapNode, { scrollWheelZoom: false });
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap"
  }).addTo(map);

  const markerIcon = L.divIcon({
    className: "",
    html: '<div class="map-marker">B</div>',
    iconSize: [34, 34],
    iconAnchor: [17, 17],
    popupAnchor: [0, -16]
  });
  const bounds = [];

  items.forEach((item) => {
    const latLng = [Number(item.lat), Number(item.lng)];
    if (!Number.isFinite(latLng[0]) || !Number.isFinite(latLng[1])) return;
    bounds.push(latLng);
    const popup = `
      <div class="map-popup">
        <strong>${escapeMapText(item.title)}</strong>
        <p>${escapeMapText(item.type)} · ${escapeMapText(item.city)}</p>
        <p>${escapeMapText(item.roomLabel)} · ${escapeMapText(item.price)}</p>
        ${item.nearbyName ? `<p>Gần ${escapeMapText(item.nearbyName)}${item.nearbyDistance ? ` · ${escapeMapText(item.nearbyDistance)}` : ""}</p>` : ""}
        ${item.userDistance ? `<p>Cách bạn khoảng ${escapeMapText(item.userDistance)}</p>` : ""}
        <a href="${escapeMapAttr(item.detailUrl)}">Xem chi tiết</a>
      </div>
    `;
    L.marker(latLng, { icon: markerIcon }).addTo(map).bindPopup(popup);
  });

  if (bounds.length > 1) {
    map.fitBounds(bounds, { padding: [34, 34], maxZoom: 13 });
  } else {
    map.setView(bounds[0], 14);
  }

  setTimeout(() => map.invalidateSize(), 120);

  function escapeMapText(value) {
    return String(value || "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[char]));
  }

  function escapeMapAttr(value) {
    return escapeMapText(value).replace(/`/g, "&#96;");
  }
});
</script>
