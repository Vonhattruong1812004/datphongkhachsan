<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const filters = payload.filters || {};
  const rows = payload.rows || [];
  const summary = payload.summary || {};
  const statusOptions = payload.statusOptions || [];
  const statusBreakdown = payload.statusBreakdown || [];
  const page = Number(payload.currentPage || 1);
  const totalPages = Number(payload.totalPages || 1);
  const totalRecords = Number(payload.totalRecords || 0);
  const currentLimit = Number(filters.limit || payload.limit || 10);
  const displayFrom = totalRecords > 0 ? ((page - 1) * currentLimit) + 1 : 0;
  const displayTo = totalRecords > 0 ? Math.min(displayFrom + rows.length - 1, totalRecords) : 0;
  const makeQuery = (overrides = {}) => new URLSearchParams({ ...filters, ...overrides }).toString();
  const csvQuery = makeQuery({ format: "csv" });
  const pages = [];
  const firstPage = Math.max(1, page - 2);
  const lastPage = Math.min(totalPages, page + 2);
  for (let i = firstPage; i <= lastPage; i += 1) pages.push(i);
%>

<style>
  .refund-home {
    --ink: #132033;
    --muted: #667085;
    --line: #c9e0fb;
    --blue: #006ce4;
    --blue-dark: #003b95;
    --green: #07865f;
    --amber: #b45309;
    --rose: #be123c;
    --shadow: 0 14px 34px rgba(15, 36, 66, .08);
    min-height: calc(100vh - 84px);
    padding: 24px 18px 54px;
    color: var(--ink);
  }

  .refund-home *,
  .refund-home *::before,
  .refund-home *::after { box-sizing: border-box; }

  .refund-wrap {
    width: min(1240px, calc(100vw - 48px));
    margin: 0 auto;
    display: grid;
    gap: 14px;
  }

  .refund-title {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    box-shadow: 0 18px 42px rgba(0, 72, 171, .20);
  }

  .refund-title h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .refund-title h1::before {
    content: "";
    width: 6px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .88);
  }

  .refund-title small {
    font-size: 13px;
    font-weight: 850;
    color: rgba(255, 255, 255, .82);
  }

  .refund-toolbar,
  .refund-board,
  .refund-stat {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, .82);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px) saturate(1.08);
  }

  .refund-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px;
  }

  .refund-search {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .refund-filter {
    position: relative;
    flex: 0 0 auto;
  }

  .refund-filter summary,
  .refund-icon-btn,
  .refund-btn,
  .refund-page {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid #b9d8ff;
    border-radius: 10px;
    background: #fff;
    color: var(--blue-dark);
    font: inherit;
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
  }

  .refund-filter summary {
    padding: 0 14px;
    list-style: none;
  }

  .refund-filter summary::-webkit-details-marker { display: none; }

  .refund-filter[open] summary {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(0, 108, 228, .10);
  }

  .refund-filter-panel {
    position: absolute;
    z-index: 30;
    top: calc(100% + 10px);
    left: 0;
    width: min(720px, calc(100vw - 56px));
    padding: 16px;
    border: 1px solid #b9d8ff;
    border-radius: 14px;
    background: rgba(255, 255, 255, .98);
    box-shadow: 0 28px 76px rgba(15, 23, 42, .18);
  }

  .refund-filter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .refund-field {
    display: grid;
    gap: 6px;
  }

  .refund-field label {
    color: var(--ink);
    font-size: 12px;
    font-weight: 900;
  }

  .refund-field input,
  .refund-field select,
  .refund-search input {
    width: 100%;
    min-height: 42px;
    border: 1px solid #d5e6fa;
    border-radius: 10px;
    padding: 0 12px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 750;
    outline: none;
  }

  .refund-field input:focus,
  .refund-field select:focus,
  .refund-search input:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(0, 108, 228, .10);
  }

  .refund-filter-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(19, 32, 51, .08);
  }

  .refund-btn {
    padding: 0 14px;
  }

  .refund-btn.is-primary,
  .refund-icon-btn.is-primary,
  .refund-page.is-active {
    border-color: transparent;
    background: var(--blue);
    color: #fff;
  }

  .refund-icon-btn {
    width: 44px;
    padding: 0;
    flex: 0 0 auto;
  }

  .refund-icon-btn svg,
  .refund-filter svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
  }

  .refund-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .refund-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .refund-stat {
    min-height: 92px;
    padding: 14px 16px;
    border-left: 5px solid var(--blue);
  }

  .refund-stat:nth-child(2) { border-left-color: #f59e0b; }
  .refund-stat:nth-child(3) { border-left-color: #10b981; }
  .refund-stat:nth-child(4) { border-left-color: #ef4444; }

  .refund-stat strong {
    display: block;
    color: var(--blue-dark);
    font-size: 26px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .refund-stat span {
    display: block;
    margin-top: 7px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 850;
  }

  .refund-board {
    overflow: hidden;
  }

  .refund-alert {
    border: 1px solid #bbf7d0;
    border-radius: 10px;
    padding: 12px 14px;
    background: rgba(236, 253, 245, .90);
    color: #065f46;
    font-size: 14px;
    font-weight: 850;
  }

  .refund-alert.is-error {
    border-color: #fecdd3;
    background: rgba(255, 241, 242, .92);
    color: #9f1239;
  }

  .refund-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    background: rgba(255, 255, 255, .72);
  }

  .refund-table th,
  .refund-table td {
    padding: 14px 16px;
    border-bottom: 1px solid #dbeafe;
    text-align: left;
    vertical-align: middle;
  }

  .refund-table th {
    background: rgba(239, 246, 255, .92);
    color: #344054;
    font-size: 12px;
    font-weight: 950;
    text-transform: uppercase;
  }

  .refund-table tbody tr {
    cursor: pointer;
    transition: background .16s ease, transform .16s ease;
  }

  .refund-table tbody tr:hover {
    background: rgba(239, 246, 255, .72);
  }

  .refund-main {
    color: var(--ink);
    font-size: 14px;
    font-weight: 950;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .refund-sub {
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .refund-money {
    color: var(--green);
    font-size: 15px;
    font-weight: 950;
    white-space: nowrap;
  }

  .refund-status {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    border-radius: 999px;
    padding: 5px 10px;
    border: 1px solid #d5e6fa;
    background: #f4f9ff;
    color: var(--blue-dark);
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
  }

  .refund-status--sun { border-color: #fde68a; background: #fffbeb; color: var(--amber); }
  .refund-status--green { border-color: #bbf7d0; background: #ecfdf5; color: var(--green); }
  .refund-status--rose { border-color: #fecdd3; background: #fff1f2; color: var(--rose); }
  .refund-status--slate { border-color: #e2e8f0; background: #f8fafc; color: #475569; }

  .refund-empty {
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-weight: 850;
  }

  .refund-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 750;
  }

  .refund-pagination,
  .refund-limit {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .refund-page {
    min-width: 38px;
    padding: 0 12px;
  }

  .refund-limit select {
    min-height: 38px;
    border: 1px solid #d5e6fa;
    border-radius: 9px;
    padding: 0 10px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 850;
  }

  @media (max-width: 980px) {
    .refund-wrap { width: min(100%, calc(100vw - 24px)); }
    .refund-toolbar,
    .refund-footer { align-items: stretch; flex-direction: column; }
    .refund-toolbar-actions,
    .refund-search { width: 100%; }
    .refund-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .refund-table { min-width: 920px; }
    .refund-board { overflow-x: auto; }
  }

  @media (max-width: 640px) {
    .refund-home { padding: 18px 12px 38px; }
    .refund-title { align-items: flex-start; flex-direction: column; }
    .refund-filter-panel,
    .refund-filter-grid,
    .refund-stats { grid-template-columns: 1fr; }
  }
</style>
<%- include("../partials/accounting-background") %>

<main class="refund-home">
  <section class="accounting-uc-layout">
    <%- include("../partials/accounting-uc-sidebar", { activeHref: "/accounting/refunds" }) %>
    <div class="accounting-uc-main">
  <div class="refund-wrap">
    <section class="refund-title">
      <h1>Xử lý hoàn tiền</h1>
      <small><%= payload.rangeLabel %> · <%= totalRecords %> yêu cầu</small>
    </section>

    <% if (notice?.success) { %><div class="refund-alert"><%= notice.success %></div><% } %>
    <% if (notice?.error) { %><div class="refund-alert is-error"><%= notice.error %></div><% } %>
    <% if (payload.warnings && payload.warnings.length) { %>
      <div class="refund-alert is-error"><%= payload.warnings.join(" ") %></div>
    <% } %>

    <form class="refund-toolbar" method="get" action="/accounting/refunds">
      <div class="refund-search">
        <details class="refund-filter">
          <summary>
            <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16l-6 7v5l-4 2v-7L4 5Z" stroke-width="2" stroke-linejoin="round"/></svg>
            Bộ lọc
          </summary>
          <div class="refund-filter-panel">
            <div class="refund-filter-grid">
              <div class="refund-field">
                <label for="tu_ngay">Từ ngày</label>
                <input id="tu_ngay" name="tu_ngay" type="date" value="<%= filters.tu_ngay %>" />
              </div>
              <div class="refund-field">
                <label for="den_ngay">Đến ngày</label>
                <input id="den_ngay" name="den_ngay" type="date" value="<%= filters.den_ngay %>" />
              </div>
              <div class="refund-field">
                <label for="trang_thai">Trạng thái</label>
                <select id="trang_thai" name="trang_thai">
                  <% statusOptions.forEach((item) => { %>
                    <option value="<%= item.value %>" <%= item.value === filters.trang_thai ? "selected" : "" %>><%= item.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="refund-field">
                <label for="limit">Hiển thị</label>
                <select id="limit" name="limit">
                  <% [10, 15, 25, 50].forEach((item) => { %>
                    <option value="<%= item %>" <%= Number(filters.limit || 10) === item ? "selected" : "" %>><%= item %> dòng</option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="refund-filter-actions">
              <a class="refund-btn" href="/accounting/refunds">Đặt lại</a>
              <button class="refund-btn is-primary" type="submit">Áp dụng</button>
            </div>
          </div>
        </details>

        <input type="search" name="search" value="<%= filters.search || "" %>" placeholder="Tìm mã hoàn tiền, giao dịch, khách, STK..." />
        <button class="refund-icon-btn is-primary" type="submit" aria-label="Tìm kiếm">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke-width="2"/><path d="M16.5 16.5 21 21" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>

      <div class="refund-toolbar-actions">
        <a class="refund-icon-btn" href="/api/accounting/refunds?<%= csvQuery %>" aria-label="Xuất CSV" title="Xuất CSV">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </form>

    <section class="refund-stats" aria-label="Tổng hợp hoàn tiền">
      <article class="refund-stat"><strong><%= summary.pendingAmountFormatted || "0 đ" %></strong><span>Chờ kế toán chuyển khoản · <%= summary.pendingCount || 0 %></span></article>
      <article class="refund-stat"><strong><%= summary.managerPendingAmountFormatted || "0 đ" %></strong><span>Chờ quản lý duyệt · <%= summary.managerPendingCount || 0 %></span></article>
      <article class="refund-stat"><strong><%= summary.paidAmountFormatted || "0 đ" %></strong><span>Đã hoàn · <%= summary.paidCount || 0 %></span></article>
      <article class="refund-stat"><strong><%= summary.rejectedAmountFormatted || "0 đ" %></strong><span>Từ chối · <%= summary.rejectedCount || 0 %></span></article>
    </section>

    <section class="refund-board">
      <% if (!rows.length) { %>
        <div class="refund-empty">Không có yêu cầu hoàn tiền phù hợp bộ lọc.</div>
      <% } else { %>
        <table class="refund-table">
          <thead>
            <tr>
              <th style="width:18%">Yêu cầu</th>
              <th style="width:22%">Khách / đặt phòng</th>
              <th style="width:20%">Tài khoản nhận</th>
              <th style="width:14%">Số tiền</th>
              <th style="width:16%">Trạng thái</th>
              <th style="width:10%">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((row) => { %>
              <tr data-href="<%= row.detailHref %>" tabindex="0" aria-label="Mở <%= row.refundCode %>">
                <td>
                  <div class="refund-main"><%= row.refundCode %></div>
                  <div class="refund-sub"><%= row.createdAtLabel %> · <%= row.scope === "partial" ? "Một phần" : "Toàn bộ" %></div>
                </td>
                <td>
                  <div class="refund-main"><%= row.customerName || "Khách hàng" %></div>
                  <div class="refund-sub"><%= row.bookingCode || `GD-${row.maGiaoDich}` %> · <%= row.customerPhone || row.customerEmail || "Chưa có liên hệ" %></div>
                  <div class="refund-sub"><%= row.hotelLabel %></div>
                </td>
                <td>
                  <div class="refund-main"><%= row.bankName %></div>
                  <div class="refund-sub"><%= row.bankAccountNo %> · <%= row.bankAccountName %></div>
                </td>
                <td>
                  <div class="refund-money"><%= row.amountRequestedFormatted %></div>
                  <div class="refund-sub">Giữ lại <%= row.retainedDepositFormatted %></div>
                </td>
                <td>
                  <span class="refund-status refund-status--<%= row.statusMeta?.tone || "slate" %>"><%= row.statusMeta?.label || row.status %></span>
                  <% if (row.refundBankTxnId) { %><div class="refund-sub">NH: <%= row.refundBankTxnId %></div><% } %>
                  <% if (row.expenseId) { %><div class="refund-sub">CP-<%= row.expenseId %></div><% } %>
                </td>
                <td>
                  <a class="refund-btn" href="<%= row.detailHref %>" onclick="event.stopPropagation()"><%= row.accountingActionLabel %></a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <div class="refund-footer">
        <span>Hiển thị <strong><%= displayFrom %>-<%= displayTo %></strong> trong tổng số <strong><%= totalRecords %></strong> bản ghi</span>
        <div class="refund-pagination">
          <a class="refund-page" href="/accounting/refunds?<%= makeQuery({ page: Math.max(1, page - 1) }) %>">Trước</a>
          <% if (firstPage > 1) { %><a class="refund-page" href="/accounting/refunds?<%= makeQuery({ page: 1 }) %>">1</a><% } %>
          <% pages.forEach((item) => { %>
            <a class="refund-page <%= item === page ? "is-active" : "" %>" href="/accounting/refunds?<%= makeQuery({ page: item }) %>"><%= item %></a>
          <% }) %>
          <% if (lastPage < totalPages) { %><a class="refund-page" href="/accounting/refunds?<%= makeQuery({ page: totalPages }) %>"><%= totalPages %></a><% } %>
          <a class="refund-page" href="/accounting/refunds?<%= makeQuery({ page: Math.min(totalPages, page + 1) }) %>">Sau</a>
        </div>
      </div>
    </section>
  </div>
    </div>
  </section>
</main>

<script>
  (() => {
    document.querySelectorAll("[data-href]").forEach((row) => {
      row.addEventListener("click", () => {
        window.location.href = row.getAttribute("data-href");
      });
      row.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          window.location.href = row.getAttribute("data-href");
        }
      });
    });
  })();
</script>

<%- include("../partials/footer") %>
