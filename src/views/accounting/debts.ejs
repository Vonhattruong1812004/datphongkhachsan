<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const filters = payload.filters || {};
  const rows = payload.rows || [];
  const summary = payload.summary || {};
  const statusOptions = payload.statusOptions || [];
  const hotelOptions = payload.hotelOptions || [];
  const page = Number(payload.currentPage || 1);
  const totalPages = Number(payload.totalPages || 1);
  const totalRecords = Number(payload.totalRecords || 0);
  const currentLimit = Number(filters.limit || payload.limit || 10);
  const displayFrom = totalRecords > 0 ? ((page - 1) * currentLimit) + 1 : 0;
  const displayTo = totalRecords > 0 ? Math.min(displayFrom + rows.length - 1, totalRecords) : 0;
  const makeQuery = (overrides = {}) => new URLSearchParams({ ...filters, ...overrides }).toString();
  const csvQuery = makeQuery({ format: "csv" });
  const pages = [];
  const firstPage = Math.max(1, page - 2);
  const lastPage = Math.min(totalPages, page + 2);
  for (let i = firstPage; i <= lastPage; i += 1) pages.push(i);
%>

<style>
  .debt-home {
    --ink: #142033;
    --muted: #667085;
    --line: #c9e0fb;
    --blue: #006ce4;
    --blue-dark: #003b95;
    --green: #07865f;
    --amber: #b45309;
    --rose: #be123c;
    --violet: #6d28d9;
    --shadow: 0 14px 34px rgba(15, 36, 66, .08);
    min-height: calc(100vh - 84px);
    padding: 24px 18px 54px;
    color: var(--ink);
  }

  .debt-home *,
  .debt-home *::before,
  .debt-home *::after { box-sizing: border-box; }

  .debt-wrap {
    width: min(1280px, calc(100vw - 48px));
    margin: 0 auto;
    display: grid;
    gap: 14px;
  }

  .debt-title {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    box-shadow: 0 18px 42px rgba(0, 72, 171, .20);
  }

  .debt-title h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .debt-title h1::before {
    content: "";
    width: 6px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .88);
  }

  .debt-title small {
    font-size: 13px;
    font-weight: 800;
    color: rgba(255, 255, 255, .82);
    white-space: nowrap;
  }

  .debt-toolbar,
  .debt-stat,
  .debt-board {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, .82);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px) saturate(1.08);
  }

  .debt-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px;
  }

  .debt-search {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .debt-filter {
    position: relative;
    flex: 0 0 auto;
  }

  .debt-filter summary,
  .debt-icon-btn,
  .debt-btn,
  .debt-page {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: #064a9f;
    background: #fff;
    text-decoration: none;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
  }

  .debt-filter summary {
    gap: 8px;
    padding: 0 14px;
    list-style: none;
  }

  .debt-filter summary::-webkit-details-marker { display: none; }

  .debt-filter[open] summary {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(0, 108, 228, .10);
  }

  .debt-filter-menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 10px);
    left: 0;
    width: min(720px, calc(100vw - 56px));
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(255, 255, 255, .98);
    box-shadow: 0 28px 70px rgba(19, 32, 51, .18);
  }

  .debt-filter-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .debt-field {
    display: grid;
    gap: 7px;
  }

  .debt-field.is-wide { grid-column: span 2; }

  .debt-field span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
  }

  .debt-input,
  .debt-field input,
  .debt-field select {
    width: 100%;
    min-height: 42px;
    border: 1px solid rgba(20, 32, 51, .14);
    border-radius: 10px;
    padding: 9px 12px;
    color: var(--ink);
    background: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 650;
    outline: none;
  }

  .debt-search .debt-input {
    flex: 1 1 520px;
    max-width: 620px;
  }

  .debt-icon-btn {
    width: 42px;
    flex: 0 0 42px;
    padding: 0;
  }

  .debt-btn {
    padding: 0 16px;
  }

  .debt-btn.is-primary,
  .debt-icon-btn.is-primary,
  .debt-page.is-active {
    color: #fff;
    border-color: transparent;
    background: var(--blue);
    box-shadow: 0 10px 22px rgba(0, 108, 228, .22);
  }

  .debt-btn.is-ghost {
    color: var(--muted);
    border-color: rgba(20, 32, 51, .12);
  }

  .debt-icon-btn svg,
  .debt-filter svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .debt-filter-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(20, 32, 51, .08);
  }

  .debt-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .debt-stat {
    min-height: 96px;
    padding: 16px;
  }

  .debt-stat strong {
    display: block;
    color: #064a9f;
    font-size: 26px;
    line-height: 1.1;
    font-weight: 900;
  }

  .debt-stat span {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
    font-weight: 700;
  }

  .debt-stat.is-risk strong { color: var(--rose); }
  .debt-stat.is-soon strong { color: var(--amber); }
  .debt-stat.is-ok strong { color: var(--green); }

  .debt-warning {
    margin: 0;
    padding: 12px 14px;
    border: 1px solid rgba(245, 158, 11, .30);
    border-radius: 12px;
    color: #8a4b00;
    background: rgba(255, 247, 223, .92);
    font-weight: 750;
  }

  .debt-board {
    overflow: hidden;
  }

  .debt-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    background: rgba(255, 255, 255, .76);
  }

  .debt-table th {
    height: 48px;
    padding: 0 14px;
    color: #475569;
    background: rgba(237, 243, 249, .94);
    font-size: 12px;
    line-height: 1.2;
    font-weight: 850;
    text-align: left;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
  }

  .debt-table td {
    padding: 13px 14px;
    color: var(--ink);
    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
    vertical-align: middle;
    border-bottom: 1px solid rgba(20, 32, 51, .08);
  }

  .debt-table tr[data-href] {
    cursor: pointer;
    transition: background .15s ease, box-shadow .15s ease;
  }

  .debt-table tr[data-href]:hover {
    background: rgba(248, 251, 255, .96);
    box-shadow: inset 4px 0 0 var(--blue);
  }

  .debt-main {
    display: block;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.25;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .debt-code { color: #064a9f; }

  .debt-sub {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.35;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .debt-money {
    color: #064a9f;
    font-size: 15px;
    font-weight: 850;
    white-space: nowrap;
  }

  .debt-money.is-paid { color: var(--green); }
  .debt-money.is-debt { color: var(--rose); }

  .debt-status {
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(20, 32, 51, .08);
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 12px;
    line-height: 1.1;
    font-weight: 800;
    white-space: nowrap;
  }

  .debt-status--rose { color: var(--rose); background: rgba(244, 63, 94, .10); }
  .debt-status--orange { color: #b45309; background: rgba(245, 158, 11, .13); }
  .debt-status--sun { color: #92400e; background: rgba(255, 209, 102, .22); }
  .debt-status--green { color: var(--green); background: rgba(16, 185, 129, .12); }
  .debt-status--cyan { color: #0369a1; background: rgba(18, 191, 243, .13); }
  .debt-status--violet { color: var(--violet); background: rgba(128, 104, 255, .13); }
  .debt-status--slate { color: #475569; background: rgba(100, 116, 139, .12); }

  .debt-empty {
    margin: 18px;
    padding: 22px;
    border: 1px dashed rgba(20, 32, 51, .20);
    border-radius: 12px;
    color: var(--muted);
    background: rgba(255, 255, 255, .76);
    font-weight: 750;
  }

  .debt-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    background: rgba(255, 255, 255, .86);
  }

  .debt-footer span {
    color: var(--ink);
    font-size: 13px;
    font-weight: 650;
  }

  .debt-footer strong { font-weight: 900; }

  .debt-pagination,
  .debt-limit-form {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .debt-limit-form {
    color: var(--muted);
    font-size: 13px;
    font-weight: 750;
  }

  .debt-limit-form select {
    min-height: 36px;
    border: 1px solid rgba(20, 32, 51, .12);
    border-radius: 10px;
    padding: 0 10px;
    color: var(--ink);
    background: #fff;
    font: inherit;
  }

  .debt-page {
    min-width: 36px;
    min-height: 36px;
    padding: 0 11px;
    font-size: 13px;
  }

  .debt-page.is-disabled {
    pointer-events: none;
    color: #98a2b3;
    border-color: rgba(20, 32, 51, .08);
    background: #f8fafc;
  }

  @media (max-width: 1040px) {
    .debt-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .debt-toolbar { align-items: stretch; flex-direction: column; }
    .debt-search { width: 100%; }
    .debt-search .debt-input { max-width: none; }
    .debt-table { min-width: 980px; }
    .debt-board { overflow-x: auto; }
  }

  @media (max-width: 680px) {
    .debt-home { padding: 18px 12px 42px; }
    .debt-wrap { width: 100%; }
    .debt-title { align-items: flex-start; flex-direction: column; }
    .debt-title small { white-space: normal; }
    .debt-filter-grid,
    .debt-stats { grid-template-columns: 1fr; }
    .debt-field.is-wide { grid-column: auto; }
    .debt-footer { align-items: flex-start; flex-direction: column; }
  }
</style>
<%- include("../partials/accounting-background") %>

<main class="debt-home">
  <section class="accounting-uc-layout">
    <%- include("../partials/accounting-uc-sidebar", { activeHref: "/accounting/debts" }) %>
    <div class="accounting-uc-main">
  <div class="debt-wrap">
    <section class="debt-title">
      <h1>Quản lý công nợ</h1>
      <small><%= payload.rangeLabel %> · <%= totalRecords %> khoản phải thu</small>
    </section>

    <% (payload.warnings || []).forEach((warning) => { %>
      <p class="debt-warning"><%= warning %></p>
    <% }) %>

    <form class="debt-toolbar" method="get" action="/accounting/debts" aria-label="Công cụ công nợ">
      <div class="debt-search">
        <details class="debt-filter">
          <summary>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
              <path d="M3 5h18l-7 8v5l-4 2v-7L3 5Z"></path>
            </svg>
            Bộ lọc
          </summary>
          <div class="debt-filter-menu">
            <input type="hidden" name="page" value="1">
            <div class="debt-filter-grid">
              <label class="debt-field">
                <span>Từ ngày</span>
                <input type="date" name="tu_ngay" value="<%= filters.tu_ngay %>">
              </label>
              <label class="debt-field">
                <span>Đến ngày</span>
                <input type="date" name="den_ngay" value="<%= filters.den_ngay %>">
              </label>
              <label class="debt-field">
                <span>Trạng thái</span>
                <select name="trang_thai">
                  <% statusOptions.forEach((item) => { %>
                    <option value="<%= item.value %>" <%= filters.trang_thai === item.value ? "selected" : "" %>><%= item.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="debt-field is-wide">
                <span>Cơ sở lưu trú</span>
                <select name="hotel_id">
                  <option value="0" <%= Number(filters.hotel_id || 0) === 0 ? "selected" : "" %>>Toàn bộ cơ sở</option>
                  <% hotelOptions.forEach((hotel) => { %>
                    <option value="<%= hotel.id %>" <%= Number(filters.hotel_id || 0) === Number(hotel.id) ? "selected" : "" %>><%= hotel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="debt-field">
                <span>Hiển thị</span>
                <select name="limit">
                  <% [10, 15, 25, 50].forEach((limit) => { %>
                    <option value="<%= limit %>" <%= currentLimit === limit ? "selected" : "" %>><%= limit %> dòng</option>
                  <% }) %>
                </select>
              </label>
            </div>
            <div class="debt-filter-actions">
              <a class="debt-btn is-ghost" href="/accounting/debts">Đặt lại</a>
              <button class="debt-btn is-primary" type="submit">Áp dụng</button>
            </div>
          </div>
        </details>

        <input type="hidden" name="page" value="1">
        <input class="debt-input" type="search" name="search" value="<%= filters.search || "" %>" placeholder="Tìm mã giao dịch, đặt chỗ, khách, email, SĐT...">
        <button class="debt-icon-btn is-primary" type="submit" aria-label="Tìm công nợ">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16.5 16.5 4 4"></path>
          </svg>
        </button>
      </div>

      <a class="debt-icon-btn" href="/api/accounting/debts?<%= csvQuery %>" title="Xuất CSV" aria-label="Xuất CSV">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <path d="M7 10l5 5 5-5"></path>
          <path d="M12 15V3"></path>
        </svg>
      </a>
    </form>

    <section class="debt-stats" aria-label="Tổng hợp công nợ">
      <article class="debt-stat is-risk"><strong><%= summary.tongCongNoFormatted || "0 đ" %></strong><span>Còn phải thu · <%= totalRecords %> khoản</span></article>
      <article class="debt-stat is-risk"><strong><%= summary.overdueAmountFormatted || "0 đ" %></strong><span>Quá hạn · <%= summary.overdueCount || 0 %> khoản</span></article>
      <article class="debt-stat is-soon"><strong><%= summary.dueSoonAmountFormatted || "0 đ" %></strong><span>Sắp đến hạn · <%= summary.dueSoonCount || 0 %> khoản</span></article>
      <article class="debt-stat is-ok"><strong><%= summary.doiSoatCoverageFormatted || "0%" %></strong><span>Tỷ lệ đã thu trong kỳ</span></article>
    </section>

    <section class="debt-board">
      <% if (!rows.length) { %>
        <div class="debt-empty">Không có khoản công nợ phù hợp với bộ lọc hiện tại.</div>
      <% } else { %>
        <table class="debt-table">
          <thead>
            <tr>
              <th style="width:17%">Giao dịch</th>
              <th style="width:20%">Khách / liên hệ</th>
              <th style="width:21%">Cơ sở lưu trú</th>
              <th style="width:13%">Số tiền</th>
              <th style="width:12%">Hạn thu</th>
              <th style="width:12%">Trạng thái</th>
              <th style="width:5%"></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((row) => { %>
              <tr data-href="/accounting/revenue?search=<%= encodeURIComponent(row.maGiaoDich) %>" tabindex="0" title="<%= row.collectionAction %>">
                <td>
                  <span class="debt-main debt-code"><%= row.bookingCode || `GD-${row.maGiaoDich}` %></span>
                  <span class="debt-sub">GD #<%= row.maGiaoDich %> · <%= row.ngayGiaoDichLabel %></span>
                </td>
                <td>
                  <span class="debt-main"><%= row.customerName || row.groupName || "Khách lẻ" %></span>
                  <span class="debt-sub"><%= row.doiTuongType %> · <%= row.contactLabel %></span>
                </td>
                <td>
                  <span class="debt-main"><%= row.hotelLabel %></span>
                  <span class="debt-sub"><%= row.roomCount %> phòng · <%= row.paymentMeta?.label || row.phuongThucThanhToan %></span>
                </td>
                <td>
                  <span class="debt-money is-debt"><%= row.conLaiFormatted %></span>
                  <span class="debt-sub">Đã thu <%= row.daThanhToanFormatted %></span>
                </td>
                <td>
                  <span class="debt-status debt-status--<%= row.agingMeta?.tone || "slate" %>"><%= row.dueSignal %></span>
                  <span class="debt-sub"><%= row.ngayDenHanLabel %></span>
                </td>
                <td>
                  <span class="debt-status debt-status--<%= row.statusMeta?.tone || "slate" %>"><%= row.statusMeta?.label || row.trangThaiCongNo %></span>
                  <span class="debt-sub"><%= row.riskMeta?.label || "Theo dõi" %></span>
                </td>
                <td>
                  <a class="debt-icon-btn" href="/accounting/revenue?search=<%= encodeURIComponent(row.maGiaoDich) %>" onclick="event.stopPropagation()" aria-label="Mở doanh thu liên quan" title="Mở doanh thu liên quan">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true">
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <footer class="debt-footer">
        <span>Hiển thị <strong><%= displayFrom %>-<%= displayTo %></strong> trong tổng số <strong><%= totalRecords %></strong> bản ghi</span>
        <div class="debt-pagination">
          <form class="debt-limit-form" method="get" action="/accounting/debts">
            <input type="hidden" name="tu_ngay" value="<%= filters.tu_ngay %>">
            <input type="hidden" name="den_ngay" value="<%= filters.den_ngay %>">
            <input type="hidden" name="trang_thai" value="<%= filters.trang_thai %>">
            <input type="hidden" name="hotel_id" value="<%= filters.hotel_id || 0 %>">
            <input type="hidden" name="search" value="<%= filters.search || "" %>">
            <span>Hiển thị</span>
            <select name="limit" onchange="this.form.submit()">
              <% [10, 15, 25, 50].forEach((limit) => { %>
                <option value="<%= limit %>" <%= currentLimit === limit ? "selected" : "" %>><%= limit %></option>
              <% }) %>
            </select>
          </form>

          <a class="debt-page <%= page <= 1 ? "is-disabled" : "" %>" href="/accounting/debts?<%= makeQuery({ page: Math.max(1, page - 1) }) %>">Trước</a>
          <% if (firstPage > 1) { %><a class="debt-page" href="/accounting/debts?<%= makeQuery({ page: 1 }) %>">1</a><% } %>
          <% pages.forEach((item) => { %>
            <a class="debt-page <%= item === page ? "is-active" : "" %>" href="/accounting/debts?<%= makeQuery({ page: item }) %>"><%= item %></a>
          <% }) %>
          <% if (lastPage < totalPages) { %><a class="debt-page" href="/accounting/debts?<%= makeQuery({ page: totalPages }) %>"><%= totalPages %></a><% } %>
          <a class="debt-page <%= page >= totalPages ? "is-disabled" : "" %>" href="/accounting/debts?<%= makeQuery({ page: Math.min(totalPages, page + 1) }) %>">Sau</a>
        </div>
      </footer>
    </section>
  </div>
    </div>
  </section>
</main>

<script>
  (() => {
    document.querySelectorAll("[data-href]").forEach((row) => {
      row.addEventListener("click", () => {
        window.location.href = row.getAttribute("data-href");
      });
      row.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          window.location.href = row.getAttribute("data-href");
        }
      });
    });
  })();
</script>

<%- include("../partials/footer") %>
