    --mgr-line: #c9e0fb;
    min-height: calc(100vh - 96px);
    padding: 24px 18px 54px;
    background: linear-gradient(180deg, #f6fbff 0%, #eef6ff 100%) !important;
    color: var(--mgr-ink);
  }

