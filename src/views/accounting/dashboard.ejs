  }
  .accounting-comet--three{
    left:28%;
    top:-14%;
    transform:rotate(90deg);
    animation:accounting-comet-fall 9s linear infinite 2s;
  }
  @keyframes accounting-star-drift{from{transform:translate3d(0,0,0)}to{transform:translate3d(-80px,56px,0)}}
  @keyframes accounting-nebula-breathe{from{transform:rotate(-16deg) scale(.96);opacity:.62}to{transform:rotate(-12deg) scale(1.06);opacity:.92}}
  @keyframes accounting-orbit-spin{to{transform:rotate(342deg)}}
  @keyframes accounting-earth-float{0%,100%{transform:translate(-50%,-50%) scale(1)}50%{transform:translate(-50%,-54%) scale(1.035)}}
  @keyframes accounting-moon-float{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(-12px,10px,0)}}
  @keyframes accounting-comet-horizontal{from{transform:translate3d(0,0,0)}to{transform:translate3d(620%,0,0)}}
  @keyframes accounting-comet-horizontal-reverse{from{transform:translate3d(0,0,0) rotate(180deg)}to{transform:translate3d(-620%,0,0) rotate(180deg)}}
  @keyframes accounting-comet-fall{from{transform:translate3d(0,0,0) rotate(90deg)}to{transform:translate3d(0,520%,0) rotate(90deg)}}
