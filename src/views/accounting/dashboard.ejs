  .accounting-dashboard-layout {
    display: grid;
    grid-template-columns: 292px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .accounting-side-tabs {
    position: sticky;
    top: 116px;
    display: grid;
    gap: 12px;
  }

  .accounting-side-card,
  .accounting-side-nav,
  .accounting-main-panel {
    border: 1px solid #c9e0fb;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 36, 66, .07);
  }

  .accounting-side-card {
    padding: 16px;
  }

  .accounting-side-card__label {
    margin: 0;
    color: #64748b !important;
    font-size: 12px;
    font-weight: 900;
  }

  .accounting-side-card__name {
    margin: 6px 0 0;
    color: #0f2442 !important;
    font-size: 24px;
    font-weight: 1000;
    line-height: 1.1;
  }

  .accounting-side-card__status {
