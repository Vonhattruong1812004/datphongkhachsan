  .exp-quick-search input {
    width: min(360px, 34vw);
    min-height: 34px;
    border: 1px solid #c9e0fb;
    border-right: 0;
    border-radius: 8px 0 0 8px;
    padding: 0 12px;
    background: #ffffff;
    color: #0f2442;
    font-size: 13px;
    font-weight: 800;
    outline: none;
  }

  .exp-quick-search input:focus {
    border-color: #006ce4;
    box-shadow: inset 0 0 0 2px rgba(0, 108, 228, .08);
  }

  .exp-search-button {
    width: 38px;
    min-width: 38px !important;
    min-height: 34px !important;
    padding: 0 !important;
    border-radius: 0 8px 8px 0 !important;
  }

  .exp-search-button svg {
    width: 16px;
    height: 16px;
    stroke-width: 2.6;
  }

  .exp-filter-menu > summary {
    gap: 8px;
  }

  .exp-filter-menu > summary svg,
  .exp-icon-button svg {
    width: 17px;
    height: 17px;
    stroke-width: 2.2;
  }

  .exp-filter-inline {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 24;
    width: min(860px, calc(100vw - 48px));
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
    min-width: 0;
    padding: 14px;
    border: 1px solid #c9e0fb;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 20px 42px rgba(15, 36, 66, .14);
  }

  .exp-filter-inline .exp-field {
    min-width: 0;
  }

  .exp-filter-inline .exp-field label {
    margin-bottom: 4px;
    font-size: 11px;
  }

  .exp-filter-inline .exp-field input,
  .exp-filter-inline .exp-field select {
    min-height: 38px;
    padding: 0 10px;
    font-size: 13px;
  }

  .exp-filter-inline .exp-button {
    min-height: 38px;
    padding: 0 14px;
    white-space: nowrap;
  }

  .exp-filter-search input {
    min-width: 0;
  }

  .exp-filter-menu,
  .exp-create-menu {
    position: relative;
  }

  .exp-filter-menu > summary,
  .exp-create-menu > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 142px;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .exp-filter-menu > summary::-webkit-details-marker,
  .exp-create-menu > summary::-webkit-details-marker {
    display: none;
  }

  .exp-filter-menu[open] > summary {
    border-color: transparent !important;
    background: #006ce4 !important;
    color: #ffffff !important;
  }

  .exp-create-menu {
    justify-self: end;
  }

  .exp-toolbar-actions {
    display: flex;
    align-items: end;
    justify-content: flex-end;
    gap: 8px;
    min-width: max-content;
    margin-left: auto;
  }

  .exp-toolbar-actions .exp-button,
  .exp-filter-menu > summary,
  .exp-create-menu > summary {
    min-height: 34px;
    min-width: 112px;
    padding: 0 12px;
    border-radius: 8px !important;
    font-size: 13px;
  }

  .exp-toolbar-actions .exp-icon-button,
  .exp-create-menu > summary.exp-icon-button {
    width: 40px;
    min-width: 40px;
    padding: 0;
  }

  .exp-icon-button {
    gap: 0;
  }

  .exp-create-menu[open] > summary {
    background: #0057bd !important;
  }

  .exp-form--create {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 25;
    width: min(720px, calc(100vw - 48px));
    padding: 16px !important;
  }

  .exp-form--create h2 {
    font-size: 20px;
  }

  .exp-form--create .exp-field-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .exp-list-stack {
    width: 100%;
    min-width: 0;
  }

  .exp-list-stack .exp-table-panel {
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .exp-list-stack .exp-table-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .exp-list-stack .exp-table-head h2 {
    margin-bottom: 2px;
  }

  @media (max-width: 1180px) {
    .exp-layout {
      grid-template-columns: 1fr !important;
    }

    .exp-toolbar-panel {
      display: grid;
      grid-template-columns: 1fr;
    }

    .exp-toolbar-left {
      display: grid;
      grid-template-columns: 1fr;
    }

    .exp-quick-search input {
      width: 100%;
    }

    .exp-filter-menu,
    .exp-create-menu {
      justify-self: stretch;
    }

    .exp-toolbar-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      justify-content: stretch;
    }

    .exp-toolbar-actions > .exp-button,
    .exp-filter-menu > summary,
    .exp-create-menu > summary {
      width: 100%;
    }

    .exp-filter-inline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .exp-expense-item {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    }

    .exp-expense-header {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .exp-home {
      padding: 18px 12px 42px;
    }

    .exp-field-grid {
      grid-template-columns: 1fr;
    }

    .exp-filter-inline,
    .exp-form--create .exp-field-grid {
      grid-template-columns: 1fr;
    }

    .exp-filter-inline {
      position: static;
      width: 100%;
      margin-top: 10px;
    }

    .exp-form--create {
      position: static;
      width: 100%;
      margin-top: 10px;
    }

    .exp-table-head,
    .exp-status-form {
      align-items: stretch;
      flex-direction: column;
    }

    .exp-expense-item {
      grid-template-columns: 1fr;
    }

    .exp-list-footer {
      align-items: stretch;
      flex-direction: column;
    }

    .exp-list-controls {
      justify-content: flex-start;
    }

    .exp-hero-content {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .exp-hero-content .exp-actions {
      justify-content: flex-start;
    }

    .exp-expense-money {
      text-align: left;
    }
  }
</style>
<%- include("../partials/accounting-background") %>

<main class="exp-home">
  <section class="accounting-uc-layout">
    <%- include("../partials/accounting-uc-sidebar", { activeHref: "/accounting/expenses" }) %>
    <div class="accounting-uc-main">
  <div class="exp-wrap">
    <section class="exp-hero" aria-label="Quản lý chi phí">
      <div class="exp-hero-main">
        <div class="exp-hero-content">
          <div class="exp-hero-copy">
            <h1>Quản lý chi phí</h1>
          </div>
        </div>
      </div>
    </section>

    <% if (payload.warnings && payload.warnings.length) { %>
      <section class="exp-alert">
        <% payload.warnings.forEach((warning) => { %>
          <p><%= warning %></p>
        <% }) %>
      </section>
    <% } %>

    <section class="exp-layout exp-workbench">
      <section class="exp-toolbar-panel">
        <div class="exp-toolbar-left">
          <details class="exp-filter-menu">
            <summary class="exp-button">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 5h16l-6 7v5l-4 2v-7L4 5Z" stroke="currentColor" stroke-linejoin="round"></path>
              </svg>
              Bộ lọc
            </summary>
            <form class="exp-filter-inline" method="get" action="/accounting/expenses">
              <div class="exp-field">
                <label for="tu_ngay">Từ ngày</label>
                <input id="tu_ngay" type="date" name="tu_ngay" value="<%= filters.tu_ngay %>" />
              </div>
              <div class="exp-field">
                <label for="den_ngay">Đến ngày</label>
                <input id="den_ngay" type="date" name="den_ngay" value="<%= filters.den_ngay %>" />
              </div>
              <div class="exp-field">
                <label for="trang_thai">Trạng thái</label>
                <select id="trang_thai" name="trang_thai">
                  <% statusOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= filters.trang_thai === option.value ? "selected" : "" %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="exp-field">
                <label for="nhom">Nhóm</label>
                <select id="nhom" name="nhom">
                  <% categoryOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= filters.nhom === option.value ? "selected" : "" %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="exp-field">
                <label for="hotel_id">Cơ sở</label>
                <select id="hotel_id" name="hotel_id">
                  <option value="0" <%= Number(filters.hotel_id || 0) === 0 ? "selected" : "" %>>Toàn bộ cơ sở</option>
                  <% hotelOptions.forEach((hotel) => { %>
                    <option value="<%= hotel.id %>" <%= Number(filters.hotel_id || 0) === Number(hotel.id) ? "selected" : "" %>>
                      <%= hotel.tenKhachSan %><%= hotel.tinhThanh ? ` · ${hotel.tinhThanh}` : "" %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="exp-field">
                <label for="limit">Hiển thị</label>
                <select id="limit" name="limit">
                  <% [10, 20, 30].forEach((limit) => { %>
                    <option value="<%= limit %>" <%= Number(filters.limit) === limit ? "selected" : "" %>><%= limit %> dòng</option>
                  <% }) %>
                </select>
              </div>
              <div class="exp-field exp-filter-search">
                <label for="search">Tìm kiếm</label>
                <input id="search" name="search" value="<%= filters.search %>" placeholder="Mã phiếu, tên chi phí, chứng từ..." />
              </div>
              <input type="hidden" name="page" value="1" />
              <button class="exp-button exp-button--primary" type="submit">Áp dụng</button>
              <a class="exp-button" href="/accounting/expenses">Đặt lại</a>
            </form>
          </details>
          <form class="exp-quick-search" method="get" action="/accounting/expenses">
            <input type="hidden" name="tu_ngay" value="<%= filters.tu_ngay %>" />
            <input type="hidden" name="den_ngay" value="<%= filters.den_ngay %>" />
            <input type="hidden" name="trang_thai" value="<%= filters.trang_thai %>" />
            <input type="hidden" name="nhom" value="<%= filters.nhom %>" />
            <input type="hidden" name="hotel_id" value="<%= filters.hotel_id %>" />
            <input type="hidden" name="limit" value="<%= filters.limit %>" />
            <input type="hidden" name="page" value="1" />
            <input id="quick_search" name="search" value="<%= filters.search %>" placeholder="Tìm mã phiếu, tên chi phí..." aria-label="Tìm kiếm phiếu chi" />
            <button class="exp-button exp-button--primary exp-search-button" type="submit" aria-label="Tìm kiếm">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke="currentColor"></circle>
                <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-linecap="round"></path>
              </svg>
            </button>
          </form>
        </div>

        <div class="exp-toolbar-actions">
          <a class="exp-button exp-icon-button" href="/api/accounting/expenses?<%= csvQuery %>" aria-label="Xuất file CSV" title="Xuất file CSV">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 4v10" stroke="currentColor" stroke-linecap="round"></path>
              <path d="M8 10l4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5 19h14" stroke="currentColor" stroke-linecap="round"></path>
            </svg>
          </a>
          <details class="exp-create-menu">
            <summary class="exp-button exp-button--primary exp-icon-button" aria-label="Thêm phiếu chi" title="Thêm phiếu chi">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14" stroke="currentColor" stroke-linecap="round"></path>
                <path d="M5 12h14" stroke="currentColor" stroke-linecap="round"></path>
              </svg>
            </summary>
            <section class="exp-form exp-form--create">
              <h2>Thêm phiếu chi</h2>
              <form method="post" action="/accounting/expenses">
                <div class="exp-field-grid">
                  <div class="exp-field is-wide">
                    <label for="ten_chi_phi">Tên chi phí</label>
                    <input id="ten_chi_phi" name="ten_chi_phi" required placeholder="Ví dụ: Chi phí bảo trì phòng" />
                  </div>
                  <div class="exp-field">
                    <label for="ngay_chi">Ngày chi</label>
                    <input id="ngay_chi" type="date" name="ngay_chi" required value="<%= filters.den_ngay %>" />
                  </div>
                  <div class="exp-field">
                    <label for="so_tien">Số tiền</label>
                    <input id="so_tien" name="so_tien" type="number" min="0" step="1000" required placeholder="0" />
                  </div>
                  <div class="exp-field">
                    <label for="loai_chi_phi">Nhóm chi phí</label>
                    <select id="loai_chi_phi" name="loai_chi_phi">
                      <% categoryOptions.filter((option) => option.value !== "all").forEach((option) => { %>
                        <option value="<%= option.value %>"><%= option.label %></option>
                      <% }) %>
                    </select>
                  </div>
                  <input type="hidden" name="trang_thai" value="ChoDuyet" />
                  <div class="exp-field">
                    <label for="hotel_id_create">Cơ sở ghi nhận</label>
                    <select id="hotel_id_create" name="hotel_id">
                      <option value="0">Chi phí dùng chung</option>
                      <% hotelOptions.forEach((hotel) => { %>
                        <option value="<%= hotel.id %>"><%= hotel.tenKhachSan %><%= hotel.tinhThanh ? ` · ${hotel.tinhThanh}` : "" %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="exp-field">
                    <label for="phuong_thuc_chi">Phương thức chi</label>
                    <select id="phuong_thuc_chi" name="phuong_thuc_chi">
                      <option value="ChuyenKhoan">Chuyển khoản</option>
                      <option value="TienMat">Tiền mặt</option>
                      <option value="The">Thẻ</option>
                      <option value="ViDienTu">Ví điện tử</option>
                      <option value="CongNo">Công nợ NCC</option>
                    </select>
                  </div>
                  <div class="exp-field">
                    <label for="nha_cung_cap">Nhà cung cấp</label>
                    <input id="nha_cung_cap" name="nha_cung_cap" placeholder="Tên nhà cung cấp..." />
                  </div>
                  <div class="exp-field">
                    <label for="so_hoa_don">Số chứng từ</label>
                    <input id="so_hoa_don" name="so_hoa_don" placeholder="Hóa đơn/phiếu chi..." />
                  </div>
                  <div class="exp-field is-wide">
                    <label for="noi_dung">Nội dung</label>
                    <input id="noi_dung" name="noi_dung" placeholder="Ghi chú chứng từ, nhà cung cấp hoặc lý do chi..." />
                  </div>
                </div>
                <div class="exp-form-actions">
                  <button class="exp-button exp-button--primary" type="submit">Lưu phiếu chi</button>
                </div>
              </form>
            </section>
          </details>
        </div>
      </section>

      <section class="exp-side-stack exp-list-stack">
        <section class="exp-table-panel">
          <% if (!payload.hasData) { %>
            <div class="exp-empty">Không có phiếu chi phù hợp với bộ lọc hiện tại.</div>
          <% } else { %>
            <div class="exp-expense-list">
              <div class="exp-expense-header" aria-hidden="true">
                <span>Phiếu chi <span class="exp-expense-sort">↕</span></span>
                <span>Ngày chi <span class="exp-expense-sort">↕</span></span>
                <span>Nhóm <span class="exp-expense-sort">↕</span></span>
                <span>Cơ sở <span class="exp-expense-sort">↕</span></span>
                <span>Chứng từ <span class="exp-expense-sort">↕</span></span>
                <span>Số tiền <span class="exp-expense-sort">↕</span></span>
                <span>Trạng thái <span class="exp-expense-sort">↕</span></span>
                <span></span>
              </div>
              <% rows.forEach((row) => { %>
                <a class="exp-expense-item" href="/accounting/expenses/<%= row.id %>" aria-label="Mở phiếu chi CP-<%= row.id %>">
                  <div class="exp-expense-main">
                    <strong class="exp-expense-title"><%= row.tenChiPhi %></strong>
                    <span class="exp-expense-sub">CP-<%= row.id %> · <%= row.noiDung || "Không có nội dung" %></span>
                  </div>
                  <span><%= row.ngayChiLabel %></span>
                  <div class="exp-expense-meta">
                    <span class="exp-cat exp-cat--<%= row.categoryMeta.tone %>"><%= row.categoryMeta.label %></span>
                  </div>
                  <span><%= row.hotelLabel %></span>
                  <div class="exp-expense-meta">
                    <strong><%= row.vendorLabel %></strong>
                    <span class="exp-expense-sub"><%= row.phuongThucChiLabel %> · <%= row.invoiceLabel %></span>
                  </div>
                  <strong class="exp-expense-money"><%= row.soTienFormatted %></strong>
                  <span class="exp-status exp-status--<%= row.statusMeta.tone %>"><%= row.statusMeta.label %></span>
                  <span class="exp-expense-action" aria-hidden="true">☰</span>
                </a>
              <% }) %>
            </div>

            <div class="exp-list-footer">
              <div class="exp-list-count">
                Hiển thị <strong><%= displayFrom %>-<%= displayTo %></strong> trong tổng số <strong><%= totalRecords %></strong> bản ghi
              </div>
              <div class="exp-list-controls">
                <form class="exp-limit-form" method="get" action="/accounting/expenses">
                  <span class="exp-limit-label">Hiển thị</span>
                  <input type="hidden" name="tu_ngay" value="<%= filters.tu_ngay %>" />
                  <input type="hidden" name="den_ngay" value="<%= filters.den_ngay %>" />
                  <input type="hidden" name="trang_thai" value="<%= filters.trang_thai %>" />
                  <input type="hidden" name="nhom" value="<%= filters.nhom %>" />
                  <input type="hidden" name="hotel_id" value="<%= filters.hotel_id %>" />
                  <input type="hidden" name="search" value="<%= filters.search %>" />
                  <input type="hidden" name="page" value="1" />
                  <select class="exp-limit-select" name="limit" onchange="this.form.submit()" aria-label="Số dòng hiển thị">
                    <% [10, 20, 30].forEach((limit) => { %>
                      <option value="<%= limit %>" <%= currentLimit === limit ? "selected" : "" %>><%= limit %></option>
                    <% }) %>
                  </select>
                </form>
                <nav class="exp-pagination" aria-label="Phân trang chi phí">
                  <% if (page > 1) { %>
                    <a class="exp-page" href="/accounting/expenses?<%= makeQuery({ page: page - 1 }) %>">Trước</a>
                  <% } else { %>
                    <span class="exp-page is-disabled">Trước</span>
                  <% } %>
                  <% if (firstPage > 1) { %>
                    <a class="exp-page" href="/accounting/expenses?<%= makeQuery({ page: 1 }) %>">1</a>
                  <% } %>
                  <% pages.forEach((item) => { %>
                    <a class="exp-page <%= item === page ? "is-active" : "" %>" href="/accounting/expenses?<%= makeQuery({ page: item }) %>"><%= item %></a>
                  <% }) %>
                  <% if (lastPage < totalPages) { %>
                    <a class="exp-page" href="/accounting/expenses?<%= makeQuery({ page: totalPages }) %>"><%= totalPages %></a>
                  <% } %>
                  <% if (page < totalPages) { %>
                    <a class="exp-page" href="/accounting/expenses?<%= makeQuery({ page: page + 1 }) %>">Sau</a>
                  <% } else { %>
                    <span class="exp-page is-disabled">Sau</span>
                  <% } %>
                </nav>
              </div>
            </div>
          <% } %>
        </section>
      </section>
    </section>
  </div>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
