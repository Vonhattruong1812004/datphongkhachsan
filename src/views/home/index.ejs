          <div>
            <h2>Tin tức du lịch</h2>
            <p>Điểm đến đang được bàn tán, có ảnh, cảm xúc và bình luận cộng đồng.</p>
          </div>
          <a class="travel-link" href="/news">Xem chuyên mục tin tức</a>
        </div>

        <div class="travel-news-grid">
          <% destinationNews.forEach((article) => { %>
            <a class="travel-news-card" href="/news/<%= article.slug %>">
