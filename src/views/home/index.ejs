    --travel-sea: #14b8a6;
    --travel-mint: #6ee7b7;
    --travel-sun: #fbbf24;
    --travel-coral: #fb7185;
    --travel-peach: #fdba74;
    --travel-violet: #a78bfa;
    --travel-shadow: 0 28px 80px rgba(20, 84, 122, 0.20);
    position: relative;
    overflow: hidden;
    color: var(--travel-ink);
