                <img src="<%= article.imageUrl %>" alt="<%= article.imageAlt %>" loading="lazy" onerror="this.onerror=null;this.src='/uploads/phong/22.png';" />
                <span class="travel-news-badge"><%= article.location %> · <%= article.viralScore %> hot score</span>
              </div>
              <div class="travel-news-body">
                <div class="travel-news-meta">
                  <span><%= article.category %></span>
                  <span><%= Object.values(article.reactions).reduce((sum, value) => sum + Number(value || 0), 0) %> cảm xúc</span>
