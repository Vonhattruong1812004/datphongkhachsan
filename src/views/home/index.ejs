<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const featuredRooms = home.rooms || [];
  const cities = home.hotelCities || [];
  const hotels = home.hotels || [];
  const bedTypes = home.bedTypes || [];
  const roomTypes = home.roomTypes || [];
  const viewTypes = home.viewTypes || [];
  const accommodationTypes = home.accommodationTypes || [];
  const destinationNews = home.news || [];
  const tourPackages = home.tours || [];
  const accentCities = cities.slice(0, 5);
  const destinationFallbackImages = [
    "/uploads/destinations/da-nang-ba-na.jpg",
    "/uploads/destinations/can-tho-cai-rang.jpg",
    "/uploads/destinations/hoi-an.jpg",
    "/uploads/destinations/phu-quoc.jpg",
    "/uploads/destinations/nha-trang.jpg",
    "/uploads/destinations/ha-long.jpg",
    "/uploads/destinations/sa-pa.jpg"
  ];
  const getDestinationImage = (city, index = 0) => {
    const key = String(city || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/đ/g, "d")
      .replace(/Đ/g, "D")
      .toLowerCase();

    if (key.includes("can tho")) return "/uploads/destinations/can-tho-cai-rang.jpg";
    if (key.includes("hoi an") || key.includes("quang nam")) return "/uploads/destinations/hoi-an.jpg";
    if (key.includes("da nang") || key.includes("ba na")) return "/uploads/destinations/da-nang-ba-na.jpg";
    if (key.includes("phu quoc") || key.includes("kien giang")) return "/uploads/destinations/phu-quoc.jpg";
    if (key.includes("nha trang") || key.includes("khanh hoa")) return "/uploads/destinations/nha-trang.jpg";
    if (key.includes("ha long") || key.includes("quang ninh")) return "/uploads/destinations/ha-long.jpg";
    if (key.includes("sapa") || key.includes("sa pa") || key.includes("lao cai")) return "/uploads/destinations/sa-pa.jpg";

    return destinationFallbackImages[index % destinationFallbackImages.length];
  };
  const amenities = [
    "Hồ bơi vô cực ngoài trời nhìn thẳng ra biển.",
    "Spa, xông hơi, jacuzzi và massage thư giãn.",
    "Nhà hàng buffet sáng cùng thực đơn Au - A.",
    "Rooftop bar và nhạc live cuối tuần.",
    "Khu vui chơi trẻ em và phòng gym hiện đại.",
    "Tour tham quan, thuê xe và đưa đón sân bay."
  ];
%>

<link rel="stylesheet" href="/home.css?v=20261010-cleanup1" />





<main class="travel-home" id="main-content" data-theme="day">
  <div class="travel-shell">
    <section class="travel-hero">
      <div class="travel-panel">
        <div class="travel-eyebrow">
          <span class="travel-eyebrow-dot"></span>
          Nền tảng lưu trú toàn quốc
        </div>

        <h1 class="travel-title">
          Bento Booking
        </h1>

        <p class="travel-description">
          Chọn nơi ở cho chuyến đi của bạn. Khám phá khách sạn, resort và homestay trên toàn quốc.
        </p>

        <div class="travel-actions">
          <a class="travel-button travel-button--primary" href="#travel-search">Tìm phòng ngay</a>
          <button class="travel-button travel-button--secondary" type="button" data-open-booking-assistant>Tư vấn chuyến đi</button>
          <% if (roleMenu) { %>
            <a class="travel-button travel-button--secondary" href="<%= roleMenu.href %>"><%= roleMenu.label %></a>
          <% } %>
        </div>

      </div>
      <span class="travel-hero-location">Cầu Vàng · Đà Nẵng</span>
    </section>

        <section class="travel-search-card" id="travel-search" aria-labelledby="homeSearchTitle">
          <div class="travel-search-heading"><h2 id="homeSearchTitle">Bạn muốn nghỉ ở đâu?</h2><a href="/booking/multi">Xem tất cả phòng</a></div>
          <form action="/booking/multi" method="get" id="homeTravelSearchForm">
            <input type="hidden" name="user_lat" id="homeUserLat" value="" />
            <input type="hidden" name="user_lng" id="homeUserLng" value="" />
            <input type="hidden" name="sort_by" id="homeSortBy" value="ai" />
            <div class="travel-field travel-field--wide">
              <label for="dia_diem">Gần địa điểm</label>
              <input id="dia_diem" type="text" name="dia_diem" placeholder="Bà Nà, biển Mỹ Khê..." />
            </div>

            <div class="travel-field">
              <label for="hotel_city">Tỉnh/thành</label>
              <select id="hotel_city" name="hotel_city">
                <option value="">Tất cả điểm đến</option>
                <% cities.forEach((city) => { %>
                  <option value="<%= city %>"><%= city %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-field">
              <label for="ngay_nhan">Ngày nhận phòng</label>
              <input id="ngay_nhan" type="date" name="ngay_nhan" />
            </div>

            <div class="travel-field">
              <label for="ngay_tra">Ngày trả phòng</label>
              <input id="ngay_tra" type="date" name="ngay_tra" />
            </div>

            <div class="travel-field">
              <label for="so_khach">Số khách</label>
              <input id="so_khach" type="number" min="1" max="12" step="1" name="so_khach" placeholder="2 khách" />
            </div>

            <details class="travel-extra-filters">
              <summary>Thêm tiêu chí phòng</summary>
              <div class="travel-extra-grid">
                <div class="travel-field">
                  <label for="loai_luu_tru">Loại lưu trú</label>
                  <select id="loai_luu_tru" name="loai_luu_tru">
                    <option value="">Tất cả loại lưu trú</option>
                    <% accommodationTypes.forEach((type) => { %>
                      <option value="<%= type.code %>"><%= type.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="travel-field">
                  <label for="loai_phong">Loại phòng</label>
                  <select id="loai_phong" name="loai_phong">
                    <option value="">Tất cả loại phòng</option>
                    <% roomTypes.forEach((type) => { %>
                      <option value="<%= type %>"><%= type %></option>
                    <% }) %>
                  </select>
                </div>
            <div class="travel-field">
              <label for="view_phong">View phòng</label>
              <select id="view_phong" name="view_phong">
                <option value="">Không giới hạn</option>
                <% viewTypes.forEach((view) => { %>
                  <option value="<%= view %>"><%= view %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-field travel-field--wide">
              <label for="loai_giuong">Kiểu giường</label>
              <select id="loai_giuong" name="loai_giuong">
                <option value="">Chọn kiểu giường</option>
                <% bedTypes.forEach((bed) => { %>
                  <option value="<%= bed %>"><%= bed %></option>
                <% }) %>
              </select>
            </div>
              </div>
            </details>
            <div class="travel-search-actions">
              <button class="travel-button travel-button--primary" type="submit">Tìm phòng</button>
              <button class="travel-button travel-button--secondary" type="button" id="homeUseCurrentLocation">Dùng vị trí của tôi</button>
              <button class="travel-button travel-button--secondary" type="button" data-open-booking-assistant>Nhờ Bento tư vấn</button>
            </div>
          </form>
          <div class="travel-geo-status" id="homeGeoStatus" role="status" hidden></div>
        </section>

    <section class="travel-section travel-section--destinations">
      <div class="travel-trust-grid" aria-label="Lý do khách có thể yên tâm đặt phòng">
        <article class="travel-trust-card"><span class="travel-trust-icon">✓</span><strong>Thanh toán an toàn</strong><span>SePay/VietQR ghi nhận thanh toán tự động.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">★</span><strong>Đối tác xác thực</strong><span>Cơ sở lưu trú, phòng và trạng thái được quản lý tập trung.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">24</span><strong>Hỗ trợ 24/7</strong><span>CSKH, tư vấn và phản hồi trong cùng hệ thống.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">↺</span><strong>Hủy phòng rõ ràng</strong><span>Chính sách hủy và hoàn tiền được hiển thị rõ.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">₫</span><strong>Giá tốt trực tiếp</strong><span>Ưu đãi trực tiếp và khuyến mãi theo mùa.</span></article>
      </div>
    </section>

    <section class="travel-section">
      <div class="travel-section-head">
        <div>
          <h2>Điểm đến phổ biến</h2>
          <p>Bắt đầu từ điểm đến, sau đó so sánh phòng trống, dịch vụ và quyền lợi đặt trực tiếp.</p>
        </div>
      </div>

      <div class="travel-city-grid">
        <% accentCities.forEach((city, index) => { %>
          <a class="travel-city-card" href="/booking/multi?hotel_city=<%= encodeURIComponent(city) %>">
            <span class="travel-city-image" style="background-image:url('<%= getDestinationImage(city, index) %>')"></span>
            <span class="travel-city-content">
              <strong><%= city %></strong>
              <span><%= hotels.filter((hotel) => hotel.tinhThanh === city).length || 1 %> cơ sở · từ <%= Number((featuredRooms.find((room) => room.tinhThanh === city)?.gia) || 5000).toLocaleString("vi-VN") %> đ / đêm</span>
            </span>
          </a>
        <% }) %>
      </div>
    </section>

    <% if (destinationNews.length) { %>
      <section class="travel-section travel-section--news">
        <div class="travel-section-head">
          <div>
            <h2>Tin tức du lịch</h2>
            <p>Điểm đến đang được bàn tán, có ảnh, cảm xúc và bình luận cộng đồng.</p>
          </div>
          <a class="travel-link" href="/news">Xem chuyên mục tin tức</a>
        </div>

        <div class="travel-news-grid">
          <% destinationNews.forEach((article) => { %>
            <a class="travel-news-card" href="/news/<%= article.slug %>">
              <div class="travel-news-media">
                <img src="<%= article.imageUrl %>" alt="<%= article.imageAlt %>" loading="lazy" onerror="this.onerror=null;this.src='/uploads/phong/22.png';" />
                <span class="travel-news-badge"><%= article.location %> · <%= article.viralScore %> hot score</span>
              </div>
              <div class="travel-news-body">
                <div class="travel-news-meta">
                  <span><%= article.category %></span>
                  <span><%= Object.values(article.reactions).reduce((sum, value) => sum + Number(value || 0), 0) %> cảm xúc</span>
                  <span><%= article.comments.length %> bình luận</span>
                </div>
                <h3><%= article.title %></h3>
                <p><%= article.summary %></p>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (tourPackages.length) { %>
      <section class="travel-section travel-section--tours">
        <div class="travel-section-head">
          <div>
            <h2>Gói tour du lịch</h2>
            <p>Tour theo điểm đến, dễ ghép với phòng gần khu tham quan.</p>
          </div>
          <a class="travel-link" href="/tours">Xem tất cả tour</a>
        </div>

        <div class="travel-tour-grid">
          <% tourPackages.forEach((tour) => { %>
            <article class="travel-tour-card">
              <img src="<%= tour.imageUrl %>" alt="<%= tour.name %>" loading="lazy" />
              <div class="travel-tour-body">
                <div class="travel-news-meta">
                  <span><%= tour.type %></span>
                  <span><%= tour.duration %></span>
                  <span><%= tour.destinationName || tour.destinationCity || "Điểm đến" %></span>
                </div>
                <h3><%= tour.name %></h3>
                <p><%= tour.departurePoint || tour.hotelName || "Khởi hành theo lịch xác nhận" %></p>
                <strong class="travel-tour-price"><%= tour.priceFormatted %> / khách</strong>
                <div class="travel-tour-actions">
                  <a class="travel-button travel-button--primary" href="<%= tour.bookingHref %>">Yêu cầu tour</a>
                  <a class="travel-button travel-button--secondary" href="<%= tour.roomSearchHref %>">Tìm phòng gần đây</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="travel-section travel-section--rooms">
      <div class="travel-section-head">
        <div>
          <h2>Phòng nổi bật</h2>
          <p>Phòng được trình bày rõ giá, vị trí, tiện ích và có lối đặt nhanh.</p>
        </div>
        <a class="travel-link" href="/booking/multi">Xem tất cả phòng</a>
      </div>

      <div class="travel-room-grid">
        <% featuredRooms.slice(0, 6).forEach((room) => { %>
          <article class="travel-room-card">
            <div class="travel-room-media">
              <img src="<%= room.imageUrl %>" alt="Phòng <%= room.soPhong %> - <%= room.loaiPhong %>" loading="lazy" onerror="this.onerror=null;this.src='/uploads/phong/1.png';" />
              <div class="travel-room-overlay">
                <span class="travel-room-badge"><%= room.loaiPhong %></span>
                <span class="travel-room-price"><%= Number(room.gia || 0).toLocaleString("vi-VN") %> đ / đêm</span>
              </div>
            </div>
            <div class="travel-room-body">
              <%- include("../partials/room-image-note", { imageUrl: room.imageUrl }) %>
              <h3><%= room.khachSan || "Đối tác lưu trú" %></h3>
              <div class="travel-room-meta">
                <%= room.loaiLuuTruTen || "Hotel" %> · <%= room.loaiPhong %> · Phòng <%= room.soPhong %> · <%= room.tinhThanh %> · tối đa <%= room.soKhachToiDa %> khách
              </div>
              <div class="travel-room-pills">
                <span class="travel-room-pill"><%= room.loaiLuuTruTen || "Hotel" %></span>
                <% if (room.loaiGiuong) { %><span class="travel-room-pill"><%= room.loaiGiuong %></span><% } %>
                <% if (room.viewPhong) { %><span class="travel-room-pill">View <%= room.viewPhong %></span><% } %>
                <span class="travel-room-pill">Chính sách hủy rõ ràng</span>
                <span class="travel-room-pill">Có tùy chọn bữa sáng</span>
              </div>
              <div class="travel-room-actions">
                <a class="travel-button travel-button--primary" href="/booking/rooms/<%= room.id %>/detail?hotel_city=<%= encodeURIComponent(room.tinhThanh || "") %>&so_khach=<%= encodeURIComponent(room.soKhachToiDa || 1) %>">Đặt ngay</a>
                <a class="travel-room-link" href="/booking/multi?hotel_city=<%= encodeURIComponent(room.tinhThanh) %>">Xem chi tiết</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="travel-section travel-section--info">
      <div class="travel-section-head">
        <div>
          <h2>Về Bento Booking</h2>
          <p>Nền tảng kết nối khách với nhiều cơ sở lưu trú và đối tác vận hành trên toàn quốc.</p>
        </div>
      </div>

      <div class="travel-info-grid">
        <article class="travel-info-card">
          <h3>Một nền tảng cho nhiều hotel, resort, homestay và penthouse</h3>
          <p>
            Bento Booking gom nhiều cơ sở lưu trú trên cùng một website để khách dễ tìm theo điểm đến, loại lưu trú,
            khoảng cách, bản đồ, giá phòng và tiện ích trước khi đặt.
          </p>
          <p>
            Đại lý khách sạn và đối tác lưu trú làm việc với hệ thống để đăng cơ sở, quản lý phòng, cập nhật giá,
            khuyến mãi và trạng thái phòng theo thời gian vận hành thực tế.
          </p>
          <ul class="travel-list">
            <li>Tìm lưu trú theo tỉnh/thành, địa điểm gần đó và vị trí hiện tại.</li>
            <li>So sánh hotel, resort, homestay, penthouse, villa và căn hộ trên cùng giao diện.</li>
            <li>Đặt phòng, gói tour, dịch vụ đi kèm và khuyến mãi trong cùng quy trình.</li>
          </ul>
        </article>

        <article class="travel-info-card">
          <h3>Tiện ích & dịch vụ được khách quan tâm nhiều</h3>
          <div class="travel-amenities-grid">
            <% amenities.forEach((item) => { %>
              <div class="travel-amenity-item">
                <span class="travel-amenity-dot"></span>
                <span><%= item %></span>
              </div>
            <% }) %>
          </div>
        </article>
      </div>
    </section>

    <section class="travel-section travel-section--partner" id="travel-partner">
      <div class="travel-section-head">
        <div>
          <h2>Dành cho đối tác lưu trú</h2>
          <p>Khách sạn, resort, homestay, penthouse và villa có thể đăng cơ sở lên hệ thống để bán phòng toàn quốc.</p>
        </div>
        <a class="travel-link" href="mailto:partners@bentobooking.vn">Liên hệ đăng cơ sở</a>
      </div>

      <div class="travel-trust-grid" aria-label="Quy trình dành cho đối tác">
        <article class="travel-trust-card"><span class="travel-trust-icon">1</span><strong>Đăng cơ sở</strong><span>Gửi thông tin pháp lý, vị trí, ảnh, tiện ích và chính sách lưu trú.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">2</span><strong>Quản lý phòng</strong><span>Cập nhật loại phòng, giá, sức chứa, trạng thái và lịch bán phòng.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">3</span><strong>Nhận đặt phòng</strong><span>Theo dõi booking, thanh toán cọc, dịch vụ đi kèm và yêu cầu hỗ trợ.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">4</span><strong>Đồng bộ vận hành</strong><span>Lễ tân, quản lý, CSKH và kế toán xử lý nghiệp vụ trên cùng dữ liệu.</span></article>
      </div>
    </section>

    <section class="travel-section travel-section--promo">
      <div class="travel-promo-card">
        <div>
          <h3>Ưu đãi thành viên đến 30%</h3>
          <p>Đặt trực tiếp để nhận ưu đãi theo mùa, combo Stay & Dine và quyền lợi linh hoạt khi đủ điều kiện.</p>
        </div>
        <a class="travel-button" href="/booking/multi">Khám phá ưu đãi</a>
      </div>
    </section>

    <section class="travel-section travel-section--contact">
      <div class="travel-contact-card">
        <h3>Liên hệ & hỗ trợ đặt phòng</h3>
        <p>Khách cần xác nhận nhanh về phòng, ưu đãi hoặc dịch vụ đi kèm có thể liên hệ trực tiếp.</p>
        <ul class="travel-list">
          <li><strong>Hotline:</strong> 1900 1234 567</li>
          <li><strong>Email đặt phòng:</strong> reservation@bentobooking.vn</li>
          <li><strong>Email đối tác:</strong> partners@bentobooking.vn</li>
          <li><strong>Phạm vi:</strong> Kết nối cơ sở lưu trú trên toàn quốc</li>
        </ul>
      </div>
    </section>

  </div>
</main>

<script>
  (() => {
    const searchForm = document.getElementById("homeTravelSearchForm");
    const geoButton = document.getElementById("homeUseCurrentLocation");
    const geoStatus = document.getElementById("homeGeoStatus");
    const userLatInput = document.getElementById("homeUserLat");
    const userLngInput = document.getElementById("homeUserLng");
    const sortByInput = document.getElementById("homeSortBy");

    function setGeoStatus(message, tone) {
      if (!geoStatus) return;
      geoStatus.hidden = false;
      geoStatus.textContent = message;
      geoStatus.classList.toggle("is-active", tone === "active");
      geoStatus.classList.toggle("is-error", tone === "error");
    }

    geoButton?.addEventListener("click", () => {
      if (!navigator.geolocation || !searchForm) {
        setGeoStatus("Trình duyệt không hỗ trợ lấy vị trí.", "error");
        return;
      }

      geoButton.disabled = true;
      setGeoStatus("Đang xin quyền truy cập vị trí...", "");
      navigator.geolocation.getCurrentPosition((position) => {
        userLatInput.value = position.coords.latitude.toFixed(7);
        userLngInput.value = position.coords.longitude.toFixed(7);
        sortByInput.value = "distance";
        setGeoStatus("Đã lấy vị trí, đang mở danh sách gần bạn...", "active");
        searchForm.submit();
      }, () => {
        geoButton.disabled = false;
        setGeoStatus("Bạn chưa cho phép truy cập vị trí. Hãy bật quyền vị trí trên trình duyệt rồi thử lại.", "error");
      }, {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 300000
      });
    });

    document.querySelectorAll("[data-open-booking-assistant]").forEach((button) => {
      button.addEventListener("click", () => window.dispatchEvent(new Event("abc:ai-widget-open")));
    });

  })();
</script>

<%- include("../partials/footer") %>
