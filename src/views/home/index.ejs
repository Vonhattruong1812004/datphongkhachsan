    font-size: 18px;
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .travel-news-card:first-child .travel-news-body h3 {
    font-size: 25px;
  }

  .travel-news-body p {
    margin: 0;
    color: var(--booking-muted) !important;
    font-size: 13px;
    line-height: 1.55;
  }

  .travel-news-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #075eb8;
    font-size: 12px;
    font-weight: 900;
  }

  .travel-tour-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .travel-tour-card {
    overflow: hidden;
    border: 1px solid #cfe5ff !important;
    border-radius: 20px;
    background: #ffffff !important;
    box-shadow: 0 14px 34px rgba(0, 59, 149, .08) !important;
  }

  .travel-tour-card img {
    width: 100%;
    height: 184px;
    object-fit: cover;
    display: block;
    background: #dbeafe;
  }

  .travel-tour-body {
    padding: 16px;
  }

  .travel-tour-body h3 {
    margin: 10px 0 8px;
    color: var(--booking-navy) !important;
    font-size: 20px;
    line-height: 1.16;
    letter-spacing: -0.03em;
  }

  .travel-tour-price {
    display: block;
    margin: 12px 0;
    color: #047857 !important;
    font-size: 22px;
    font-weight: 1000;
  }

  .travel-tour-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .travel-promo-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: center;
    border-radius: 24px;
    padding: 30px;
    background:
      radial-gradient(circle at 92% 12%, rgba(255, 255, 255, 0.26), transparent 22%),
      linear-gradient(135deg, #003b95, #006ce4 54%, #06b6d4) !important;
    color: #ffffff;
  }

  .travel-promo-card h3,
  .travel-promo-card p {
    color: #ffffff !important;
  }

  .travel-promo-card h3 {
    margin: 0;
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.05em;
  }

  .travel-promo-card p {
    max-width: 690px;
    margin: 10px 0 0;
    line-height: 1.65;
  }

  .travel-promo-card .travel-button {
    background: #ffffff !important;
    color: var(--booking-blue-dark) !important;
  }

  .travel-info-grid {
    grid-template-columns: 1.05fr 0.95fr;
  }

  .travel-info-card,
  .travel-contact-card {
    border-radius: 20px;
  }

  .travel-info-card h3,
  .travel-contact-card h3 {
    color: var(--booking-navy);
  }

  .travel-info-card p,
  .travel-contact-card p {
    color: var(--booking-muted);
  }

  @media (max-width: 1080px) {
    .travel-hero,
    .travel-info-grid {
      grid-template-columns: 1fr;
    }

    .travel-search-card form,
    .travel-trust-grid,
    .travel-city-grid,
    .travel-news-grid,
    .travel-tour-grid,
    .travel-room-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .travel-shell {
      width: min(100% - 22px, 1220px);
      padding-top: 20px;
    }

    .travel-panel,
    .travel-scene-card {
      min-height: auto;
      border-radius: 22px;
    }

    .travel-title {
      font-size: 44px;
    }

    .travel-search-card form,
    .travel-trust-grid,
    .travel-city-grid,
    .travel-news-grid,
    .travel-tour-grid,
    .travel-room-grid,
    .travel-promo-card {
      grid-template-columns: 1fr;
    }

    .travel-news-card:first-child {
      grid-row: auto;
    }

    .travel-news-card:first-child .travel-news-media,
    .travel-news-media {
      height: 210px;
    }
  }

  .travel-scene-card--hotel-gif {
    min-height: clamp(420px, 58vh, 680px);
    padding: 0 !important;
    overflow: hidden;
    background: #020617 !important;
  }

  .travel-scene-card--hotel-gif::before,
  .travel-scene-card--hotel-gif::after {
    display: none !important;
  }

  .travel-hero-gif {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 700px) {
    .travel-scene-card--hotel-gif {
    min-height: 300px;
    }
  }

  /* Homepage readability pass: keep content on solid surfaces and prevent cramped labels. */
  .travel-panel {
    background:
      radial-gradient(circle at 100% 0%, rgba(0, 108, 228, 0.08), transparent 34%),
      linear-gradient(180deg, #ffffff 0%, #fbfdff 100%) !important;
  }

  .travel-panel,
  .travel-search-card,
  .travel-section,
  .travel-trust-card,
  .travel-room-card,
  .travel-city-card {
    color: var(--booking-navy) !important;
  }

  .travel-search-card {
    background: #ffffff !important;
    border-color: #d8e1ec !important;
  }

  .travel-search-card form {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    align-items: end;
  }

  .travel-field,
  .travel-search-actions {
    min-width: 0;
  }

  .travel-field label {
    line-height: 1.25 !important;
    min-height: 16px;
    white-space: normal;
  }

  .travel-field input,
  .travel-field select {
    width: 100%;
  }

  .travel-search-actions {
    justify-content: flex-start !important;
  }

  .travel-trust-card > .travel-trust-icon {
    display: grid !important;
    place-items: center !important;
    margin: 0 0 12px !important;
    color: #ffffff !important;
    background: linear-gradient(135deg, var(--booking-blue), var(--booking-cyan)) !important;
  }

  .travel-trust-card > span:not(.travel-trust-icon) {
    color: var(--booking-muted) !important;
  }

  .travel-link,
  .travel-room-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px 14px;
    border-radius: 12px;
    color: var(--booking-blue-dark) !important;
    background: #eff6ff !important;
    border: 1px solid #bfdbfe;
    font-weight: 850;
  }

  .travel-hero {
    position: relative;
    min-height: 640px;
    display: grid;
    grid-template-columns: 1fr !important;
    align-items: end;
    overflow: hidden;
    border: 1px solid rgba(191, 219, 254, .72);
    border-radius: 28px;
    padding: clamp(28px, 4vw, 48px);
    background:
      linear-gradient(180deg, rgba(3, 16, 37, .20) 0%, rgba(4, 21, 47, .62) 58%, rgba(4, 21, 47, .84) 100%),
      url("/uploads/destinations/da-nang-ba-na.jpg") center / cover no-repeat !important;
    box-shadow: 0 28px 72px rgba(15, 36, 66, .18);
  }

  .travel-panel {
    width: min(100%, 1120px);
    min-height: 0;
    border: 0 !important;
    border-radius: 0;
    padding: 0;
    background: transparent !important;
    box-shadow: none !important;
  }

  .travel-eyebrow {
    color: #ffffff !important;
    background: rgba(15, 36, 66, .56) !important;
    border-color: rgba(255, 255, 255, .22) !important;
    backdrop-filter: blur(10px);
  }

  .travel-title {
    max-width: 880px;
    color: #ffffff !important;
    text-shadow: 0 5px 24px rgba(0, 0, 0, .28) !important;
  }

  .travel-description {
    max-width: 760px;
    color: rgba(255, 255, 255, .88) !important;
    text-shadow: 0 3px 14px rgba(0, 0, 0, .25);
  }

  .travel-actions {
    margin-top: 20px;
  }

  .travel-actions .travel-button--secondary,
  .travel-actions .travel-button--install {
    color: #ffffff !important;
    background: rgba(15, 36, 66, .54) !important;
    border-color: rgba(255, 255, 255, .22) !important;
    backdrop-filter: blur(10px);
  }

  .travel-search-card {
    max-width: 1120px;
    margin-top: 28px;
    border: 1px solid rgba(255, 255, 255, .30) !important;
    background: rgba(255, 255, 255, .96) !important;
    box-shadow: 0 22px 58px rgba(2, 14, 34, .26) !important;
  }

  .travel-search-note {
    color: #4f647a !important;
  }

  .travel-scene-card,
  .travel-scene-card--hotel-gif,
  .travel-hero-gif {
    display: none !important;
  }

  @media (min-width: 1180px) {
    .travel-hero {
      grid-template-columns: 1fr !important;
    }
  }

  @media (max-width: 700px) {
    .travel-hero {
      min-height: auto;
      padding: 24px 14px;
      border-radius: 20px;
      background-position: center top !important;
    }

    .travel-title {
      font-size: 38px;
      line-height: 1.04;
    }

    .travel-search-card form {
      grid-template-columns: 1fr !important;
    }
  }

  .travel-geo-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(14, 165, 233, .18);
    background: rgba(255, 255, 255, .86);
    color: #075985;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 900;
  }

  .travel-geo-status::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #94a3b8;
  }

  .travel-geo-status.is-active::before {
    background: #22c55e;
    box-shadow: 0 0 0 5px rgba(34, 197, 94, .13);
  }

  .travel-geo-status.is-error {
    border-color: rgba(244, 63, 94, .24);
    background: rgba(255, 241, 242, .92);
    color: #be123c;
  }

  .travel-geo-status.is-error::before {
    background: #f43f5e;
  }

  /* Travel image backgrounds: keep each homepage block visual, not boxed white. */
  .travel-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-color: rgba(191, 219, 254, .72) !important;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .24), rgba(240, 249, 255, .08)),
      url("/uploads/destinations/ha-long.jpg") center / cover no-repeat !important;
    box-shadow: 0 22px 62px rgba(15, 36, 66, .13) !important;
  }

  .travel-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(circle at 16% 14%, rgba(255, 255, 255, .20), transparent 24%),
      linear-gradient(90deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, .04));
    pointer-events: none;
  }

  .travel-section > * {
    position: relative;
    z-index: 1;
  }

  .travel-section--destinations {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .24), rgba(236, 253, 245, .08)),
      url("/uploads/destinations/hoi-an.jpg") center / cover no-repeat !important;
  }

  .travel-section--news {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .22), rgba(236, 254, 255, .07)),
