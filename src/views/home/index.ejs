    text-shadow: 0 3px 18px rgba(0, 20, 60, .28);
  }

  .travel-section--promo .travel-promo-card {
    background:
      linear-gradient(135deg, rgba(0, 59, 149, .86), rgba(0, 108, 228, .70) 54%, rgba(6, 182, 212, .64)) !important;
    border: 1px solid rgba(255, 255, 255, .22);
    backdrop-filter: blur(8px);
