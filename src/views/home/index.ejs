  }

  .travel-section--tours {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .20), rgba(239, 246, 255, .06)),
      url("/uploads/destinations/sa-pa.jpg") center / cover no-repeat !important;
  }

  .travel-section--rooms {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .22), rgba(240, 253, 250, .06)),
      url("/uploads/destinations/phu-quoc.jpg") center / cover no-repeat !important;
  }

  .travel-section--info {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .24), rgba(239, 246, 255, .07)),
      url("/uploads/destinations/nha-trang.jpg") center / cover no-repeat !important;
  }

  .travel-section--partner {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .22), rgba(236, 254, 255, .06)),
      url("/uploads/destinations/da-nang-ba-na.jpg") center / cover no-repeat !important;
  }

  .travel-section--promo {
    background:
      linear-gradient(115deg, rgba(3, 59, 149, .70), rgba(0, 108, 228, .48)),
      url("/uploads/destinations/ha-long.jpg") center / cover no-repeat !important;
  }

  .travel-section--contact {
    background:
      linear-gradient(115deg, rgba(255, 255, 255, .24), rgba(240, 249, 255, .07)),
      url("/uploads/destinations/hoi-an.jpg") center / cover no-repeat !important;
  }

  .travel-news-card,
  .travel-tour-card,
  .travel-room-card,
  .travel-city-card,
  .travel-trust-card,
  .travel-info-card,
  .travel-contact-card {
    background: rgba(255, 255, 255, .68) !important;
    border-color: rgba(201, 224, 251, .82) !important;
    box-shadow: 0 14px 34px rgba(0, 59, 149, .10) !important;
    backdrop-filter: blur(10px);
  }

  .travel-news-body,
  .travel-tour-body,
  .travel-room-body,
  .travel-info-card,
  .travel-contact-card {
    background: rgba(255, 255, 255, .68) !important;
  }

  .travel-section-head h2,
  .travel-section-head p {
