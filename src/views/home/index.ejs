</style>

<main class="travel-home" id="travel-home" data-theme="day">
  <div class="galaxy-background" aria-hidden="true">
    <span class="galaxy-milkyway"></span>
    <span class="galaxy-deep-field"></span>
    <span class="galaxy-dust"></span>
    <span class="galaxy-near-field"></span>
    <span class="galaxy-lens-field"></span>
    <span class="galaxy-nebula galaxy-nebula--one"></span>
    <span class="galaxy-nebula galaxy-nebula--two"></span>
    <span class="galaxy-star-cluster galaxy-star-cluster--one"></span>
    <span class="galaxy-star-cluster galaxy-star-cluster--two"></span>
    <span class="galaxy-constellation"><i></i><i></i><i></i><i></i></span>
    <span class="galaxy-comet galaxy-comet--one"></span>
    <span class="galaxy-comet galaxy-comet--reverse galaxy-comet--two"></span>
    <span class="galaxy-comet galaxy-comet--fall galaxy-comet--three"></span>
    <span class="galaxy-comet galaxy-comet--fall galaxy-comet--rise galaxy-comet--five"></span>
  </div>
  <div class="travel-shell">
    <section class="travel-hero">
      <div class="travel-panel">
        <div class="travel-eyebrow">
          <span class="travel-eyebrow-dot"></span>
          Nền tảng lưu trú toàn quốc
        </div>

        <h1 class="travel-title">
          Tìm nơi lưu trú phù hợp nhất.
        </h1>

        <p class="travel-description">
          So sánh hotel, resort, homestay, penthouse và villa từ các đối tác lưu trú trên toàn quốc.
        </p>

        <div class="travel-actions">
          <a class="travel-button travel-button--primary" href="#travel-search">Tìm phòng ngay</a>
          <a class="travel-button travel-button--secondary" href="/booking/multi">Mở đặt phòng trực tuyến</a>
          <a class="travel-button travel-button--secondary" href="#travel-partner">Đăng cơ sở lưu trú</a>
          <button class="travel-button travel-button--install" type="button" id="travel-install-app">Tải app Bento</button>
          <% if (roleMenu) { %>
            <a class="travel-button travel-button--secondary" href="<%= roleMenu.href %>"><%= roleMenu.label %></a>
          <% } %>
        </div>

        <section class="travel-search-card" id="travel-search">
          <form action="/booking/multi" method="get" id="homeTravelSearchForm">
            <input type="hidden" name="user_lat" id="homeUserLat" value="" />
            <input type="hidden" name="user_lng" id="homeUserLng" value="" />
            <input type="hidden" name="sort_by" id="homeSortBy" value="ai" />
            <div class="travel-field travel-field--wide">
              <label for="dia_diem">Gần địa điểm</label>
              <input id="dia_diem" type="text" name="dia_diem" placeholder="VD: Chợ nổi Cái Răng, Bà Nà, biển Mỹ Khê" />
            </div>

            <div class="travel-field">
              <label for="loai_luu_tru">Loại lưu trú</label>
              <select id="loai_luu_tru" name="loai_luu_tru">
                <option value="">Tất cả loại lưu trú</option>
                <% accommodationTypes.forEach((type) => { %>
                  <option value="<%= type.code %>"><%= type.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-field">
              <label for="hotel_city">Tỉnh/thành</label>
              <select id="hotel_city" name="hotel_city">
                <option value="">Tất cả điểm đến</option>
                <% cities.forEach((city) => { %>
                  <option value="<%= city %>"><%= city %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-field">
              <label for="loai_phong">Loại phòng</label>
              <select id="loai_phong" name="loai_phong">
                <option value="">Chọn loại phòng</option>
                <% roomTypes.forEach((type) => { %>
                  <option value="<%= type %>"><%= type %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-field">
              <label for="ngay_nhan">Ngày nhận phòng</label>
              <input id="ngay_nhan" type="date" name="ngay_nhan" />
            </div>

            <div class="travel-field">
              <label for="ngay_tra">Ngày trả phòng</label>
              <input id="ngay_tra" type="date" name="ngay_tra" />
            </div>

            <div class="travel-field">
              <label for="so_khach">Số khách</label>
              <input id="so_khach" type="number" min="1" max="12" step="1" name="so_khach" placeholder="2 khách" />
            </div>

            <div class="travel-field">
              <label for="view_phong">View phòng</label>
              <select id="view_phong" name="view_phong">
                <option value="">Không giới hạn</option>
                <% viewTypes.forEach((view) => { %>
                  <option value="<%= view %>"><%= view %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-field travel-field--wide">
              <label for="loai_giuong">Kiểu giường</label>
              <select id="loai_giuong" name="loai_giuong">
                <option value="">Chọn kiểu giường</option>
                <% bedTypes.forEach((bed) => { %>
                  <option value="<%= bed %>"><%= bed %></option>
                <% }) %>
              </select>
            </div>

            <div class="travel-search-actions">
              <button class="travel-button travel-button--primary" type="submit">Tìm phòng</button>
              <button class="travel-button travel-button--secondary" type="button" id="homeUseCurrentLocation">Dùng vị trí của tôi</button>
              <a class="travel-button travel-button--secondary" href="/ai/concierge">Nhờ trợ lý tư vấn đặt phòng</a>
            </div>
          </form>
          <p class="travel-search-note">
            Cập nhật điểm đến, ngày ở, số khách và sở thích phòng ngay trong luồng đặt phòng.
          </p>
          <div class="travel-geo-status" id="homeGeoStatus">Chưa dùng vị trí hiện tại</div>
        </section>
      </div>

    </section>

    <section class="travel-section travel-section--destinations">
      <div class="travel-trust-grid" aria-label="Lý do khách có thể yên tâm đặt phòng">
        <article class="travel-trust-card"><span class="travel-trust-icon">✓</span><strong>Thanh toán an toàn</strong><span>SePay/VietQR ghi nhận thanh toán tự động.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">★</span><strong>Đối tác xác thực</strong><span>Cơ sở lưu trú, phòng và trạng thái được quản lý tập trung.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">24</span><strong>Hỗ trợ 24/7</strong><span>CSKH, tư vấn và phản hồi trong cùng hệ thống.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">↺</span><strong>Hủy phòng rõ ràng</strong><span>Chính sách hủy và hoàn tiền được hiển thị rõ.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">₫</span><strong>Giá tốt trực tiếp</strong><span>Ưu đãi trực tiếp và khuyến mãi theo mùa.</span></article>
      </div>
    </section>

    <section class="travel-section">
      <div class="travel-section-head">
        <div>
          <h2>Điểm đến phổ biến</h2>
          <p>Bắt đầu từ điểm đến, sau đó so sánh phòng trống, dịch vụ và quyền lợi đặt trực tiếp.</p>
        </div>
      </div>

      <div class="travel-city-grid">
        <% accentCities.forEach((city, index) => { %>
          <a class="travel-city-card" href="/booking/multi?hotel_city=<%= encodeURIComponent(city) %>">
            <span class="travel-city-image" style="background-image:url('<%= getDestinationImage(city, index) %>')"></span>
            <span class="travel-city-content">
              <strong><%= city %></strong>
              <span><%= hotels.filter((hotel) => hotel.tinhThanh === city).length || 1 %> cơ sở · từ <%= Number((featuredRooms.find((room) => room.tinhThanh === city)?.gia) || 5000).toLocaleString("vi-VN") %> đ / đêm</span>
            </span>
          </a>
        <% }) %>
      </div>
