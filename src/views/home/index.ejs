                </div>
                <h3><%= article.title %></h3>
                <p><%= article.summary %></p>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (tourPackages.length) { %>
      <section class="travel-section travel-section--tours">
        <div class="travel-section-head">
          <div>
            <h2>Gói tour du lịch</h2>
            <p>Tour theo điểm đến, dễ ghép với phòng gần khu tham quan.</p>
          </div>
          <a class="travel-link" href="/tours">Xem tất cả tour</a>
        </div>

        <div class="travel-tour-grid">
          <% tourPackages.forEach((tour) => { %>
            <article class="travel-tour-card">
              <img src="<%= tour.imageUrl %>" alt="<%= tour.name %>" loading="lazy" />
              <div class="travel-tour-body">
                <div class="travel-news-meta">
                  <span><%= tour.type %></span>
                  <span><%= tour.duration %></span>
                  <span><%= tour.destinationName || tour.destinationCity || "Điểm đến" %></span>
                </div>
                <h3><%= tour.name %></h3>
                <p><%= tour.departurePoint || tour.hotelName || "Khởi hành theo lịch xác nhận" %></p>
                <strong class="travel-tour-price"><%= tour.priceFormatted %> / khách</strong>
                <div class="travel-tour-actions">
                  <a class="travel-button travel-button--primary" href="<%= tour.bookingHref %>">Yêu cầu tour</a>
                  <a class="travel-button travel-button--secondary" href="<%= tour.roomSearchHref %>">Tìm phòng gần đây</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="travel-section travel-section--rooms">
      <div class="travel-section-head">
        <div>
          <h2>Phòng nổi bật</h2>
          <p>Phòng được trình bày rõ giá, vị trí, tiện ích và có lối đặt nhanh.</p>
        </div>
        <a class="travel-link" href="/booking/multi">Xem tất cả phòng</a>
      </div>

      <div class="travel-room-grid">
        <% featuredRooms.slice(0, 6).forEach((room) => { %>
          <article class="travel-room-card">
            <div class="travel-room-media">
              <img src="<%= room.imageUrl %>" alt="Phòng <%= room.soPhong %> - <%= room.loaiPhong %>" loading="lazy" onerror="this.onerror=null;this.src='/uploads/phong/1.png';" />
              <div class="travel-room-overlay">
                <span class="travel-room-badge">8.<%= (room.id % 8) + 1 %> · <%= 80 + (room.id % 900) %> đánh giá</span>
                <span class="travel-room-price"><%= Number(room.gia || 0).toLocaleString("vi-VN") %> đ / đêm</span>
              </div>
            </div>
            <div class="travel-room-body">
              <h3><%= room.khachSan || "Đối tác lưu trú" %></h3>
              <div class="travel-room-meta">
                <%= room.loaiLuuTruTen || "Hotel" %> · <%= room.loaiPhong %> · Phòng <%= room.soPhong %> · <%= room.tinhThanh %> · tối đa <%= room.soKhachToiDa %> khách
              </div>
              <div class="travel-room-pills">
                <span class="travel-room-pill"><%= room.loaiLuuTruTen || "Hotel" %></span>
                <% if (room.loaiGiuong) { %><span class="travel-room-pill"><%= room.loaiGiuong %></span><% } %>
                <% if (room.viewPhong) { %><span class="travel-room-pill">View <%= room.viewPhong %></span><% } %>
                <span class="travel-room-pill">Chính sách hủy rõ ràng</span>
                <span class="travel-room-pill">Có tùy chọn bữa sáng</span>
              </div>
              <div class="travel-room-actions">
                <a class="travel-button travel-button--primary" href="/booking/rooms/<%= room.id %>/detail?hotel_city=<%= encodeURIComponent(room.tinhThanh || "") %>&so_khach=<%= encodeURIComponent(room.soKhachToiDa || 1) %>">Đặt ngay</a>
                <a class="travel-room-link" href="/booking/multi?hotel_city=<%= encodeURIComponent(room.tinhThanh) %>">Xem chi tiết</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="travel-section travel-section--info">
      <div class="travel-section-head">
        <div>
          <h2>Về Bento Booking</h2>
          <p>Nền tảng kết nối khách với nhiều cơ sở lưu trú và đối tác vận hành trên toàn quốc.</p>
        </div>
      </div>

      <div class="travel-info-grid">
        <article class="travel-info-card">
          <h3>Một nền tảng cho nhiều hotel, resort, homestay và penthouse</h3>
          <p>
            Bento Booking gom nhiều cơ sở lưu trú trên cùng một website để khách dễ tìm theo điểm đến, loại lưu trú,
            khoảng cách, bản đồ, giá phòng và tiện ích trước khi đặt.
          </p>
          <p>
            Đại lý khách sạn và đối tác lưu trú làm việc với hệ thống để đăng cơ sở, quản lý phòng, cập nhật giá,
            khuyến mãi và trạng thái phòng theo thời gian vận hành thực tế.
          </p>
          <ul class="travel-list">
            <li>Tìm lưu trú theo tỉnh/thành, địa điểm gần đó và vị trí hiện tại.</li>
            <li>So sánh hotel, resort, homestay, penthouse, villa và căn hộ trên cùng giao diện.</li>
            <li>Đặt phòng, gói tour, dịch vụ đi kèm và khuyến mãi trong cùng quy trình.</li>
          </ul>
        </article>

        <article class="travel-info-card">
          <h3>Tiện ích & dịch vụ được khách quan tâm nhiều</h3>
          <div class="travel-amenities-grid">
            <% amenities.forEach((item) => { %>
              <div class="travel-amenity-item">
                <span class="travel-amenity-dot"></span>
                <span><%= item %></span>
              </div>
            <% }) %>
          </div>
        </article>
      </div>
    </section>

    <section class="travel-section travel-section--partner" id="travel-partner">
      <div class="travel-section-head">
        <div>
          <h2>Dành cho đối tác lưu trú</h2>
          <p>Khách sạn, resort, homestay, penthouse và villa có thể đăng cơ sở lên hệ thống để bán phòng toàn quốc.</p>
        </div>
        <a class="travel-link" href="mailto:partners@bentobooking.vn">Liên hệ đăng cơ sở</a>
      </div>

      <div class="travel-trust-grid" aria-label="Quy trình dành cho đối tác">
        <article class="travel-trust-card"><span class="travel-trust-icon">1</span><strong>Đăng cơ sở</strong><span>Gửi thông tin pháp lý, vị trí, ảnh, tiện ích và chính sách lưu trú.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">2</span><strong>Quản lý phòng</strong><span>Cập nhật loại phòng, giá, sức chứa, trạng thái và lịch bán phòng.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">3</span><strong>Nhận đặt phòng</strong><span>Theo dõi booking, thanh toán cọc, dịch vụ đi kèm và yêu cầu hỗ trợ.</span></article>
        <article class="travel-trust-card"><span class="travel-trust-icon">4</span><strong>Đồng bộ vận hành</strong><span>Lễ tân, quản lý, CSKH và kế toán xử lý nghiệp vụ trên cùng dữ liệu.</span></article>
      </div>
    </section>

    <section class="travel-section travel-section--promo">
      <div class="travel-promo-card">
        <div>
          <h3>Ưu đãi thành viên đến 30%</h3>
          <p>Đặt trực tiếp để nhận ưu đãi theo mùa, combo Stay & Dine và quyền lợi linh hoạt khi đủ điều kiện.</p>
        </div>
        <a class="travel-button" href="/booking/multi">Khám phá ưu đãi</a>
      </div>
    </section>

    <section class="travel-section travel-section--contact">
      <div class="travel-contact-card">
        <h3>Liên hệ & hỗ trợ đặt phòng</h3>
        <p>Khách cần xác nhận nhanh về phòng, ưu đãi hoặc dịch vụ đi kèm có thể liên hệ trực tiếp.</p>
        <ul class="travel-list">
          <li><strong>Hotline:</strong> 1900 1234 567</li>
          <li><strong>Email đặt phòng:</strong> reservation@bentobooking.vn</li>
          <li><strong>Email đối tác:</strong> partners@bentobooking.vn</li>
          <li><strong>Phạm vi:</strong> Kết nối cơ sở lưu trú trên toàn quốc</li>
        </ul>
      </div>
    </section>

  </div>
</main>

<script type="module" src="/js/home-galaxy-earth.js"></script>
<script>
  (() => {
    const THEME_KEY = "bento_home_day_night_theme_v1";
    const homeRoot = document.getElementById("travel-home");
    const themeToggle = document.getElementById("travel-theme-toggle");
    const themeLabel = themeToggle?.querySelector("[data-theme-label]");
    const installButtons = [
      document.getElementById("travel-install-app")
    ].filter(Boolean);
    const searchForm = document.getElementById("homeTravelSearchForm");
    const geoButton = document.getElementById("homeUseCurrentLocation");
    const geoStatus = document.getElementById("homeGeoStatus");
    const userLatInput = document.getElementById("homeUserLat");
    const userLngInput = document.getElementById("homeUserLng");
    const sortByInput = document.getElementById("homeSortBy");

    function readTheme() {
      const saved = localStorage.getItem(THEME_KEY);
      return saved === "night" ? "night" : "day";
    }

    function applyTheme(theme, persist = true) {
      if (!homeRoot) return;
      const nextTheme = theme === "night" ? "night" : "day";
      homeRoot.dataset.theme = nextTheme;
      document.body.classList.toggle("travel-night", nextTheme === "night");
      themeToggle?.setAttribute("aria-pressed", nextTheme === "night" ? "true" : "false");
      themeToggle?.setAttribute("title", nextTheme === "night" ? "Kéo rèm lên để mở ban ngày" : "Kéo rèm xuống để mở ban đêm");
      themeToggle?.setAttribute("aria-label", nextTheme === "night" ? "Kéo rèm lên để mở ban ngày" : "Kéo rèm xuống để mở ban đêm");
      if (themeLabel) themeLabel.textContent = nextTheme === "night" ? "Kéo mở ngày" : "Kéo xuống đêm";
      if (persist) localStorage.setItem(THEME_KEY, nextTheme);
    }

    const updateInstallButtons = () => {
      const state = window.__abcPwaState || {};
      const canInstall = Boolean(state.installAvailable && typeof window.__abcPwaInstall === "function");
      const installed = Boolean(state.installed);

      installButtons.forEach((button) => {
        if (!button) return;
        if (installed) {
          button.textContent = "Đã ở app mode";
          button.disabled = true;
          button.style.opacity = "0.72";
          button.style.cursor = "default";
          return;
        }

        button.disabled = false;
        button.style.opacity = "1";
        button.style.cursor = "pointer";
        button.textContent = canInstall ? "Cài app Bento" : "Tải app Bento";
      });

    };

    const handleInstall = async () => {
      const state = window.__abcPwaState || {};
      if (state.installAvailable && typeof window.__abcPwaInstall === "function") {
        await window.__abcPwaInstall();
        updateInstallButtons();
        return;
      }

      window.location.href = "/app-download";
    };

    installButtons.forEach((button) => {
      button.addEventListener("click", handleInstall);
    });

    function setGeoStatus(message, tone) {
      if (!geoStatus) return;
      geoStatus.textContent = message;
      geoStatus.classList.toggle("is-active", tone === "active");
      geoStatus.classList.toggle("is-error", tone === "error");
    }

    geoButton?.addEventListener("click", () => {
      if (!navigator.geolocation || !searchForm) {
        setGeoStatus("Trình duyệt không hỗ trợ lấy vị trí.", "error");
        return;
      }

      geoButton.disabled = true;
      setGeoStatus("Đang xin quyền truy cập vị trí...", "");
      navigator.geolocation.getCurrentPosition((position) => {
        userLatInput.value = position.coords.latitude.toFixed(7);
        userLngInput.value = position.coords.longitude.toFixed(7);
        sortByInput.value = "distance";
        setGeoStatus("Đã lấy vị trí, đang mở danh sách gần bạn...", "active");
        searchForm.submit();
      }, () => {
        geoButton.disabled = false;
        setGeoStatus("Bạn chưa cho phép truy cập vị trí. Hãy bật quyền vị trí trên trình duyệt rồi thử lại.", "error");
      }, {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 300000
      });
    });

    themeToggle?.addEventListener("click", () => {
      const current = homeRoot?.dataset.theme === "night" ? "night" : "day";
      applyTheme(current === "night" ? "day" : "night");
    });

    window.addEventListener("abc:pwa-state", updateInstallButtons);
    applyTheme(readTheme(), false);
    updateInstallButtons();
  })();
</script>

