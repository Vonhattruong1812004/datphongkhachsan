  .travel-scene-badge span {
    color: var(--travel-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .travel-sun {
    position: absolute;
    top: 52px;
    right: 88px;
    width: 108px;
    height: 108px;
    border-radius: 999px;
    background: radial-gradient(circle at 34% 34%, #fff7bf, #ffd45c 52%, #f59e0b 100%);
