<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const featuredRooms = home.rooms || [];
  const cities = home.hotelCities || [];
  const hotels = home.hotels || [];
  const bedTypes = home.bedTypes || [];
  const roomTypes = home.roomTypes || [];
  const viewTypes = home.viewTypes || [];
  const accommodationTypes = home.accommodationTypes || [];
  const destinationNews = home.news || [];
  const tourPackages = home.tours || [];
  const accentCities = cities.slice(0, 5);
  const destinationFallbackImages = [
    "/uploads/destinations/da-nang-ba-na.jpg",
    "/uploads/destinations/can-tho-cai-rang.jpg",
    "/uploads/destinations/hoi-an.jpg",
    "/uploads/destinations/phu-quoc.jpg",
    "/uploads/destinations/nha-trang.jpg",
    "/uploads/destinations/ha-long.jpg",
    "/uploads/destinations/sa-pa.jpg"
  ];
  const getDestinationImage = (city, index = 0) => {
    const key = String(city || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/đ/g, "d")
      .replace(/Đ/g, "D")
      .toLowerCase();

    if (key.includes("can tho")) return "/uploads/destinations/can-tho-cai-rang.jpg";
    if (key.includes("hoi an") || key.includes("quang nam")) return "/uploads/destinations/hoi-an.jpg";
    if (key.includes("da nang") || key.includes("ba na")) return "/uploads/destinations/da-nang-ba-na.jpg";
    if (key.includes("phu quoc") || key.includes("kien giang")) return "/uploads/destinations/phu-quoc.jpg";
    if (key.includes("nha trang") || key.includes("khanh hoa")) return "/uploads/destinations/nha-trang.jpg";
    if (key.includes("ha long") || key.includes("quang ninh")) return "/uploads/destinations/ha-long.jpg";
    if (key.includes("sapa") || key.includes("sa pa") || key.includes("lao cai")) return "/uploads/destinations/sa-pa.jpg";

    return destinationFallbackImages[index % destinationFallbackImages.length];
  };
  const amenities = [
    "Hồ bơi vô cực ngoài trời nhìn thẳng ra biển.",
    "Spa, xông hơi, jacuzzi và massage thư giãn.",
    "Nhà hàng buffet sáng cùng thực đơn Au - A.",
    "Rooftop bar và nhạc live cuối tuần.",
    "Khu vui chơi trẻ em và phòng gym hiện đại.",
    "Tour tham quan, thuê xe và đưa đón sân bay."
  ];
%>

