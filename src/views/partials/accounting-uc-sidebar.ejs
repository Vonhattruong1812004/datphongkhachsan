<%
  const accountingUcActive = typeof activeHref === "string" ? activeHref : "";
  const accountingUcItems = [
    { href: "/accounting", label: "Thống kê tài chính" },
    { href: "/accounting/financial-reports", label: "Lập báo cáo tài chính" },
    { href: "/accounting/revenue", label: "Quản lý doanh thu" },
    { href: "/accounting/expenses", label: "Quản lý chi phí" },
    { href: "/accounting/debts", label: "Quản lý công nợ" },
    { href: "/accounting/refunds", label: "Xử lý hoàn tiền" }
  ];
%>

<style>
  .accounting-uc-layout {
    width: min(1380px, calc(100vw - 44px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 272px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .accounting-uc-sidebar {
    position: sticky;
    top: 108px;
    display: grid;
    gap: 12px;
    padding: 14px;
    border: 1px solid rgba(0, 108, 228, .18);
    border-radius: 14px;
    background: rgba(255, 255, 255, .82);
    box-shadow: 0 20px 52px rgba(15, 36, 66, .10);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
  }

  .accounting-uc-sidebar__title {
    margin: 0;
    padding: 6px 8px 10px;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.15;
    color: #102033;
    letter-spacing: 0;
  }

  .accounting-uc-nav {
    display: grid;
    gap: 8px;
  }

  .accounting-uc-link {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding: 12px 14px;
    border: 1px solid #c9e0fb;
    border-radius: 10px;
    color: #0046a8;
    background: rgba(255, 255, 255, .86);
    font-size: 15px;
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 10px 22px rgba(0, 108, 228, .05);
    transition: border-color .16s ease, color .16s ease, background .16s ease, transform .16s ease, box-shadow .16s ease;
  }

  .accounting-uc-link:hover,
  .accounting-uc-link:focus-visible {
    color: #003b95;
    border-color: rgba(0, 108, 228, .45);
    background: #eef6ff;
    box-shadow: 0 14px 28px rgba(0, 108, 228, .12);
    transform: translateX(3px);
    outline: none;
  }

  .accounting-uc-link.is-active {
    color: #fff;
    border-color: #006ce4;
    background: linear-gradient(135deg, #0078f0, #0046b8);
    box-shadow: 0 16px 34px rgba(0, 89, 196, .22);
  }

  .accounting-uc-main {
    min-width: 0;
  }

  .accounting-uc-main :is(
    .rev-wrap,
    .exp-wrap,
    .debt-wrap,
    .refund-wrap,
    .fin-wrap,
    .expense-detail-wrap,
    .refund-detail-wrap
  ) {
    width: 100% !important;
    max-width: 100% !important;
  }

  .accounting-uc-main > :first-child {
    margin-top: 0 !important;
  }

  @media (max-width: 1180px) {
    .accounting-uc-layout {
      width: min(100%, calc(100vw - 24px));
      grid-template-columns: 1fr;
    }

    .accounting-uc-sidebar {
      position: static;
    }

    .accounting-uc-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .accounting-uc-nav {
      grid-template-columns: 1fr;
    }
  }
</style>

<aside class="accounting-uc-sidebar" aria-label="UC kế toán">
  <h2 class="accounting-uc-sidebar__title">UC kế toán</h2>
  <nav class="accounting-uc-nav">
    <% accountingUcItems.forEach((item) => { %>
      <a class="accounting-uc-link <%= accountingUcActive === item.href ? "is-active" : "" %>" href="<%= item.href %>"><%= item.label %></a>
    <% }) %>
  </nav>
</aside>
