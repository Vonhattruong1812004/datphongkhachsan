<script>
  (function registerFloatingAiConcierge() {
    const HISTORY_KEY = "abc_booking_assistant_history_v4";
    const OPEN_KEY = "abc_ai_widget_open_v1";
    const STARTERS = [
      "Tìm resort gần biển cho 2 người cuối tuần này",
      "Tìm phòng dưới 2 triệu, có view đẹp",
      "Có mã giảm giá nào áp dụng cho đặt phòng không?",
      "Gợi ý phòng gia đình gần trung tâm"
    ];

    const toggle = document.getElementById("floatingAiToggle");
    const closeButton = document.getElementById("floatingAiClose");
    const drawer = document.getElementById("floatingAiDrawer");
    const messages = document.getElementById("floatingAiMessages");
    const form = document.getElementById("floatingAiForm");
    const input = document.getElementById("floatingAiInput");
    const submit = document.getElementById("floatingAiSubmit");
    const voiceButton = document.getElementById("floatingAiVoice");
    const decisionBar = document.getElementById("floatingAiDecisionBar");

    if (!toggle || !drawer || !messages || !form || !input || !submit) {
      return;
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function customerTierLabel(tier) {
      const labels = {
        "Needs Info": "Cần bổ sung",
        Platinum: "Rất phù hợp",
        Gold: "Phù hợp",
        Silver: "Cân nhắc"
      };
      return labels[tier] || tier || "Đang tư vấn";
    }

    try {
      ["abc_ai_widget_history_v1", "abc_ai_widget_history_v2", "abc_booking_assistant_history_v3"].forEach((key) => sessionStorage.removeItem(key));
    } catch {}

    function readHistory() {
      try {
        return JSON.parse(sessionStorage.getItem(HISTORY_KEY) || "[]");
      } catch {
        return [];
      }
    }

    function writeHistory(items) {
      sessionStorage.setItem(HISTORY_KEY, JSON.stringify(items.slice(-14)));
    }

    function getLatestConversationFilters() {
      const items = readHistory();
      for (let index = items.length - 1; index >= 0; index -= 1) {
        const payload = items[index]?.payload;
        const filters = payload?.extracted_filters || payload?.recommendations?.filters;
        if (filters && typeof filters === "object") {
          return filters;
        }
      }

      return undefined;
    }

    function getLatestAssistantPayload() {
      const items = readHistory();
      for (let index = items.length - 1; index >= 0; index -= 1) {
        const payload = items[index]?.payload;
        if (payload?.recommendations?.booking_decision) {
          return payload;
        }
      }

      return null;
    }

    function renderDecisionBar() {
      if (!decisionBar) return;

      const payload = getLatestAssistantPayload();
      const decision = payload?.recommendations?.booking_decision;
      const top = payload?.recommendations?.top_pick;
      if (!payload || !decision || !top) {
        decisionBar.hidden = true;
        decisionBar.innerHTML = "";
        return;
      }

      const money = decision.moneySummary || {};
      const readiness = Number(decision.readinessScore || 0);
      decisionBar.hidden = false;
      decisionBar.innerHTML = `
        <div class="floating-assist__decision-main">
          <div class="floating-assist__decision-status">
            <b>${escapeHtml(customerTierLabel(decision.vipTier))}</b>
            <span>${readiness}/100</span>
            ${money.finalTotal ? `<span>${escapeHtml(money.finalTotal)}</span>` : ""}
          </div>
          <div class="floating-assist__decision-title">${escapeHtml(top.khachSan || "")} · ${escapeHtml(top.soPhong || "")}</div>
          <div class="floating-assist__decision-meta">${escapeHtml(decision.recommendedActionLabel || "Kế hoạch đặt phòng")}${money.deposit ? ` · Cọc ${escapeHtml(money.deposit)}` : ""}</div>
        </div>
        <a class="floating-assist__decision-action" href="${escapeHtml(`/booking/rooms/${top.id}/detail`)}">Mở phòng</a>
      `;
    }

    function setVoiceLabel(label) {
      const labelNode = voiceButton?.querySelector(".floating-assist__voice-label");
      if (labelNode) {
        labelNode.textContent = label;
      } else if (voiceButton) {
        voiceButton.textContent = label;
      }
    }

    let lastVoiceNotice = { text: "", at: 0 };

    function showVoiceNotice(text) {
      if (!text) return;
      const now = Date.now();
      if (lastVoiceNotice.text === text && now - lastVoiceNotice.at < 8000) {
        return;
      }
      lastVoiceNotice = { text, at: now };
      pushHistory({ role: "assistant", text });
    }

    function setupVoiceInput() {
      const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!voiceButton || !Recognition) {
        if (voiceButton) {
          voiceButton.classList.add("is-unsupported");
          voiceButton.disabled = true;
          voiceButton.setAttribute("aria-disabled", "true");
          voiceButton.title = "Trình duyệt này chưa hỗ trợ nhập giọng nói";
          setVoiceLabel("Không hỗ trợ");
        }
        return;
      }

      const recognition = new Recognition();
      recognition.lang = "vi-VN";
      recognition.interimResults = true;
      recognition.continuous = false;
      let baseText = "";
      let finalTranscript = "";

      recognition.onstart = () => {
        baseText = input.value.trim();
        finalTranscript = "";
        voiceButton.classList.add("is-listening");
        voiceButton.setAttribute("aria-pressed", "true");
        voiceButton.title = "Đang nghe, bấm để dừng";
        setVoiceLabel("Đang nghe");
      };

      recognition.onresult = (event) => {
        const transcript = Array.from(event.results)
          .map((result) => {
            const text = result[0]?.transcript || "";
            if (result.isFinal) finalTranscript = [finalTranscript, text].filter(Boolean).join(" ").trim();
            return text;
          })
          .join(" ")
          .trim();
        input.value = [baseText, transcript || finalTranscript].filter(Boolean).join(" ").trim();
        resizeInput();
        input.focus();
      };

      recognition.onerror = (event) => {
        voiceButton.classList.remove("is-listening");
        voiceButton.removeAttribute("aria-pressed");
        voiceButton.title = "Nhập bằng giọng nói";
        setVoiceLabel("Nói");
        if (event.error === "not-allowed" || event.error === "service-not-allowed") {
          voiceButton.classList.add("is-unsupported");
          voiceButton.title = "Hãy cấp quyền micro trong trình duyệt rồi bấm lại";
          setVoiceLabel("Cấp quyền mic");
          showVoiceNotice("Trình duyệt đang chặn micro. Bạn hãy cấp quyền micro rồi bấm Nói lại.");
        } else if (event.error === "no-speech") {
          showVoiceNotice("Mình chưa nghe rõ. Bạn thử bấm Nói lại và nói gần micro hơn nhé.");
        }
      };

      recognition.onend = () => {
        voiceButton.classList.remove("is-listening");
        voiceButton.removeAttribute("aria-pressed");
        if (!voiceButton.classList.contains("is-unsupported")) {
          voiceButton.title = "Nhập bằng giọng nói";
          setVoiceLabel("Nói");
        }
      };

      voiceButton.addEventListener("click", () => {
        if (voiceButton.classList.contains("is-listening")) {
          recognition.stop();
          return;
        }

        try {
          voiceButton.classList.remove("is-unsupported");
          voiceButton.title = "Nhập bằng giọng nói";
          setVoiceLabel("Nói");
          recognition.start();
        } catch {
          showVoiceNotice("Micro đang bận. Bạn đợi một chút rồi bấm Nói lại.");
        }
      });
    }

    function resizeInput() {
      input.style.height = "auto";
      input.style.height = `${Math.min(132, Math.max(64, input.scrollHeight))}px`;
    }

    async function copyTextToClipboard(text) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }

      const helper = document.createElement("textarea");
      helper.value = text;
      helper.setAttribute("readonly", "");
      helper.style.position = "fixed";
      helper.style.left = "-9999px";
      document.body.appendChild(helper);
      helper.select();
      const ok = document.execCommand("copy");
      helper.remove();
      return ok;
    }

    function openWidget() {
      drawer.hidden = false;
      sessionStorage.setItem(OPEN_KEY, "1");
      window.setTimeout(() => input.focus(), 40);
    }

    function closeWidget() {
      drawer.hidden = true;
      sessionStorage.removeItem(OPEN_KEY);
    }

    function renderWelcome() {
      return `
        <div class="floating-assist__message floating-assist__message--assistant">
          <h4>Xin chào, mình có thể tư vấn phòng cho bạn.</h4>
          <p>Bạn có thể nhập nhu cầu bằng tiếng Việt: muốn ở khu vực nào, ngày nào, mấy người, ngân sách bao nhiêu, thích hotel/resort/homestay, cần view nào hoặc muốn dùng mã giảm giá. Hệ thống sẽ gợi ý phòng và mở đúng bước đặt phòng.</p>
          <div class="floating-assist__starter-grid">
            ${STARTERS.map((item) => `<button type="button" class="floating-assist__starter" data-ai-starter="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join("")}
          </div>
        </div>
      `;
    }

    function renderAssistantPayload(payload) {
      if (!payload) {
        return `<div class="floating-assist__message floating-assist__message--assistant"><p class="floating-assist__empty">Không có dữ liệu từ trợ lý đặt phòng.</p></div>`;
      }

      const top = payload.recommendations?.top_pick || null;
      const alternatives = Array.isArray(payload.recommendations?.alternatives) ? payload.recommendations.alternatives : [];
      const answer = payload.answer || null;
      const contextCards = Array.isArray(payload.context_cards) ? payload.context_cards : [];
      const quickActions = Array.isArray(payload.quick_actions) ? payload.quick_actions : [];
      const isTravelInspiration = payload.intent === "inspiration";
      const isDestinationGuide = payload.intent === "location";
      const isTravelPlanning = isTravelInspiration || isDestinationGuide;
      const bookingDecision = isTravelPlanning ? null : (payload.recommendations?.booking_decision || null);
      const visibleBulletLimit = isTravelPlanning ? 5 : (bookingDecision ? 3 : 4);
      const visibleContextLimit = isTravelPlanning ? 4 : (bookingDecision ? 1 : 4);
      const filters = payload.extracted_filters || {};
      const filterChips = [
        filters.dia_diem ? `Gần ${filters.dia_diem}` : "",
        filters.loai_luu_tru ? `Loại lưu trú ${filters.loai_luu_tru}` : "",
        filters.hotel_city ? `Thành phố ${filters.hotel_city}` : "",
        filters.loai_phong ? `Loại ${filters.loai_phong}` : "",
        filters.view_phong ? `View ${filters.view_phong}` : "",
        Number(filters.so_khach || 0) > 0 ? `${filters.so_khach} khách` : "",
        Number(filters.gia_goi_y || 0) > 0 ? `${Number(filters.gia_goi_y).toLocaleString("vi-VN")} đ` : ""
      ].filter(Boolean);
      const cardIcon = (type) => ({
        room: "P",
        tour: "T",
        news: "N",
        promotion: "%",
        destination: "M",
        guide: "i"
      }[type] || "B");
      const renderContextCard = (card) => `
        <a class="floating-assist__smart-card" href="${escapeHtml(card.href || "#")}" ${card.href && card.href.startsWith("http") ? 'target="_blank" rel="noreferrer"' : ""}>
          ${card.imageUrl ? `<img src="${escapeHtml(card.imageUrl)}" alt="" loading="lazy" onerror="this.remove();" />` : `<span class="floating-assist__smart-icon">${escapeHtml(cardIcon(card.type))}</span>`}
          <span class="floating-assist__smart-body">
            <span class="floating-assist__smart-top">
              ${card.badge ? `<b>${escapeHtml(card.badge)}</b>` : ""}
              ${card.price ? `<strong>${escapeHtml(card.price)}</strong>` : ""}
            </span>
            <span class="floating-assist__smart-title">${escapeHtml(card.title || "")}</span>
            <span class="floating-assist__smart-subtitle">${escapeHtml(card.subtitle || "")}</span>
            ${card.meta ? `<span class="floating-assist__smart-meta">${escapeHtml(card.meta)}</span>` : ""}
          </span>
        </a>
      `;
      const renderVipDecision = (decision) => {
        if (!decision) return "";

        const readiness = Math.max(0, Math.min(100, Number(decision.readinessScore || 0)));
        const money = decision.moneySummary || null;
        const timeline = Array.isArray(decision.timeline) ? decision.timeline : [];
        const services = Array.isArray(decision.serviceSuggestions) ? decision.serviceSuggestions : [];
        const comparisons = Array.isArray(decision.comparisonSummary) ? decision.comparisonSummary : [];
        const advisors = Array.isArray(decision.advisorPanels) ? decision.advisorPanels : [];
        const matrix = Array.isArray(decision.decisionMatrix) ? decision.decisionMatrix : [];
        const technologies = Array.isArray(decision.technologyStack) ? decision.technologyStack : [];
        const hints = decision.conversationalHints || {};
        const risks = Array.isArray(decision.riskFlags) ? decision.riskFlags : [];
        const nextSteps = Array.isArray(decision.nextSteps) ? decision.nextSteps : [];
        const summaryParts = [
          `${decision.recommendedActionLabel || "Gợi ý đặt phòng"} (${readiness}/100)`,
          top ? `${top.khachSan || ""} - phòng ${top.soPhong || ""}` : "",
          money?.finalTotal ? `Tổng sau ưu đãi: ${money.finalTotal}` : "",
          money?.deposit ? `Cọc giữ phòng: ${money.deposit}` : "",
          advisors[0]?.verdict || "",
          risks[0] ? `Cần kiểm tra: ${risks[0]}` : ""
        ].filter(Boolean);
        const decisionSummary = summaryParts.join(" | ");

        return `
          <div class="floating-assist__vip" data-decision-summary="${escapeHtml(decisionSummary)}">
            <div class="floating-assist__vip-head">
              <span class="floating-assist__vip-kicker">${escapeHtml(customerTierLabel(decision.vipTier))}</span>
              <strong>${escapeHtml(decision.recommendedActionLabel || "Kế hoạch đặt phòng")}</strong>
              <span>${readiness}/100</span>
            </div>
            <div class="floating-assist__vip-meter" aria-label="Mức sẵn sàng đặt phòng">
              <span style="width:${readiness}%"></span>
            </div>
            ${decision.conciergeBrief ? `<p class="floating-assist__vip-brief">${escapeHtml(decision.conciergeBrief)}</p>` : ""}
            ${hints.refinement ? `<p class="floating-assist__vip-context">Đang xử lý yêu cầu nối tiếp: ${escapeHtml(hints.refinement)}</p>` : ""}
            ${money ? `
              <div class="floating-assist__vip-money">
                <span><b>${escapeHtml(money.finalTotal || "")}</b><small>Tổng sau ưu đãi</small></span>
                <span><b>${escapeHtml(money.deposit || "")}</b><small>Cọc giữ phòng</small></span>
                ${money.discount && money.discount !== "0 đ" ? `<span><b>${escapeHtml(money.discount)}</b><small>Tiết kiệm dự kiến</small></span>` : ""}
              </div>
            ` : ""}
            <div class="floating-assist__vip-tools">
              ${top ? `<a class="floating-assist__vip-tool floating-assist__vip-tool--primary" href="${escapeHtml(`/booking/rooms/${top.id}/detail`)}">Mở phòng</a>` : ""}
              <button type="button" class="floating-assist__vip-tool" data-ai-copy-decision>Sao chép tóm tắt</button>
              <button type="button" class="floating-assist__vip-tool" data-ai-toggle-compact>Thu gọn</button>
              <button type="button" class="floating-assist__vip-tool" data-ai-starter="So sánh vì sao phòng này tốt nhất">So sánh lại</button>
            </div>
            ${advisors.length ? `
              <div class="floating-assist__vip-advisors">
                ${advisors.slice(0, 2).map((advisor) => `
                  <section class="floating-assist__vip-advisor floating-assist__vip-advisor--${escapeHtml(advisor.tone || "balanced")}">
                    <div>
                      <b>${escapeHtml(advisor.title || "")}</b>
                      <span>${Number(advisor.score || 0)}/99</span>
                    </div>
                    <p>${escapeHtml(advisor.verdict || "")}</p>
                    ${Array.isArray(advisor.bullets) && advisor.bullets.length ? `<small>${escapeHtml(advisor.bullets.filter(Boolean).slice(0, 2).join(" · "))}</small>` : ""}
                  </section>
                `).join("")}
              </div>
            ` : ""}
            ${matrix.length ? `
              <div class="floating-assist__vip-matrix">
                ${matrix.slice(0, 4).map((row) => `
                  <span class="floating-assist__vip-matrix-row floating-assist__vip-matrix-row--${escapeHtml(row.tone || "balanced")}">
                    <b>${escapeHtml(row.criterion || "")}</b>
                    <strong>${Number(row.score || 0)}</strong>
                    <small>${escapeHtml(row.verdict || "")}</small>
                  </span>
                `).join("")}
              </div>
            ` : ""}
            ${technologies.length ? `
              <div class="floating-assist__vip-tech">
                ${technologies.slice(0, 5).map((tech) => `
                  <span class="floating-assist__vip-tech-item floating-assist__vip-tech-item--${escapeHtml(tech.status || "ready")}">
                    <b>${escapeHtml(tech.name || "")}</b>
                  </span>
                `).join("")}
              </div>
            ` : ""}
            ${hints.nextBestQuestion ? `
              <div class="floating-assist__vip-question">
                <b>${escapeHtml(hints.nextBestQuestion)}</b>
                ${Array.isArray(hints.suggestedReplies) && hints.suggestedReplies.length ? `
                  <div>
                    ${hints.suggestedReplies.slice(0, 4).map((reply) => `<button type="button" data-ai-starter="${escapeHtml(reply)}">${escapeHtml(reply)}</button>`).join("")}
                  </div>
                ` : ""}
              </div>
            ` : ""}
            ${timeline.length || risks.length || services.length || comparisons.length || nextSteps.length ? `
              <details class="floating-assist__vip-details">
                <summary>Chi tiết quyết định</summary>
                ${timeline.length ? `
                  <div class="floating-assist__vip-timeline">
                    ${timeline.map((step) => `<span class="floating-assist__vip-step floating-assist__vip-step--${escapeHtml(step.status || "pending")}">${escapeHtml(step.label || "")}</span>`).join("")}
                  </div>
                ` : ""}
                ${risks.length ? `<p class="floating-assist__vip-risk">Cần kiểm tra: ${escapeHtml(risks.slice(0, 2).join(" · "))}</p>` : ""}
                ${services.length ? `
                  <div class="floating-assist__vip-section">
                    <b>Dịch vụ nên gợi ý kèm</b>
                    <div class="floating-assist__vip-services">
                      ${services.slice(0, 2).map((item) => `<span>${escapeHtml(item.name || "")}<small>${escapeHtml(item.priceFormatted || "")}</small></span>`).join("")}
                    </div>
                  </div>
                ` : ""}
                ${comparisons.length ? `
                  <div class="floating-assist__vip-section">
                    <b>So sánh nhanh</b>
                    <div class="floating-assist__vip-compare">
                      ${comparisons.slice(0, 2).map((item) => `
                        <span>
                          <strong>${escapeHtml(item.room || "")}</strong>
                          <small>${escapeHtml(item.finalTotal || "")} · ${Number(item.score || 0)}/100</small>
                        </span>
                      `).join("")}
                    </div>
                  </div>
                ` : ""}
                ${nextSteps.length ? `<p class="floating-assist__vip-next">${escapeHtml(nextSteps[0])}</p>` : ""}
              </details>
            ` : ""}
          </div>
        `;
      };

      return `
        <div class="floating-assist__message floating-assist__message--assistant">
          <h4>${escapeHtml(answer?.title || payload.faq?.answer || "Đã phân tích xong nhu cầu đặt phòng của bạn.")}</h4>
          ${answer?.body ? `<p>${escapeHtml(answer.body)}</p>` : ""}
          ${Array.isArray(answer?.bullets) && answer.bullets.length ? `<ul class="floating-assist__list">${answer.bullets.slice(0, visibleBulletLimit).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>` : ""}
          ${filterChips.length ? `<div class="floating-assist__chips">${filterChips.map((item) => `<span class="floating-assist__chip">${escapeHtml(item)}</span>`).join("")}</div>` : ""}
          ${contextCards.length ? `<div class="floating-assist__smart-grid">${contextCards.slice(0, visibleContextLimit).map(renderContextCard).join("")}</div>` : ""}
          ${renderVipDecision(bookingDecision)}
          ${!contextCards.length && top ? `
            <div class="floating-assist__card">
              <div class="floating-assist__card-title">
                <span class="floating-assist__badge">${escapeHtml(top.recommendation?.label || "Gợi ý phù hợp nhất")}</span>
                <span class="floating-assist__price">${Number(top.gia || 0).toLocaleString("vi-VN")} đ / đêm</span>
              </div>
              <h5>${escapeHtml(top.loaiPhong || "")} - phòng ${escapeHtml(top.soPhong || "")}</h5>
              <p class="floating-assist__meta">${escapeHtml(top.khachSan || "")}${top.tinhThanh ? ` · ${escapeHtml(top.tinhThanh)}` : ""}</p>
              <p>${escapeHtml(top.recommendation?.summary || "")}</p>
              ${Number(top.recommendation?.confidence || 0) > 0 ? `<p class="floating-assist__meta">Độ tin cậy gợi ý: ${Number(top.recommendation.confidence)}%</p>` : ""}
              ${Array.isArray(top.recommendation?.reasons) && top.recommendation.reasons.length ? `<div class="floating-assist__chips">${top.recommendation.reasons.slice(0, 3).map((item) => `<span class="floating-assist__chip">${escapeHtml(item)}</span>`).join("")}</div>` : ""}
              ${Array.isArray(top.recommendation?.decisionNotes) && top.recommendation.decisionNotes.length ? `<ul class="floating-assist__list">${top.recommendation.decisionNotes.slice(0, 2).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>` : ""}
              ${Array.isArray(top.recommendation?.tradeoffs) && top.recommendation.tradeoffs.length ? `<p class="floating-assist__meta">Cần cân nhắc: ${escapeHtml(top.recommendation.tradeoffs[0])}</p>` : ""}
            </div>
          ` : ""}
          ${!contextCards.length && alternatives.length ? `
            <div class="floating-assist__alternatives">
              ${alternatives.slice(0, 3).map((item) => `
                <div class="floating-assist__card" style="margin-top:0;flex:1 1 180px;">
                  <span class="floating-assist__badge">${escapeHtml(item.recommendation?.label || "Lựa chọn khác")}</span>
                  <p style="margin-top:8px;"><strong>${escapeHtml(item.loaiPhong || "")}</strong> · ${escapeHtml(item.soPhong || "")}</p>
                  <p class="floating-assist__meta">${escapeHtml(item.khachSan || "")}</p>
                </div>
              `).join("")}
            </div>
          ` : ""}
          <div class="floating-assist__actions">
            ${
              quickActions.length
                ? quickActions.slice(0, 4).map((action) => action.href
                    ? `<a class="floating-assist__action ${action.primary ? "floating-assist__action--primary" : ""}" href="${escapeHtml(action.href)}">${escapeHtml(action.label)}</a>`
                    : `<button type="button" class="floating-assist__action ${action.primary ? "floating-assist__action--primary" : ""}" data-ai-starter="${escapeHtml(action.prompt || action.label)}">${escapeHtml(action.label)}</button>`
                  ).join("")
                : `
                  <a class="floating-assist__action floating-assist__action--primary" href="${escapeHtml(top ? `/booking/rooms/${top.id}/detail` : (payload.cta?.href || "/booking/search"))}">${top ? "Xem phòng này" : "Mở tìm phòng"}</a>
                  <a class="floating-assist__action" href="${escapeHtml(payload.cta?.href || "/booking/search")}">${escapeHtml(payload.cta?.label || "Xem danh sách phòng")}</a>
                `
            }
            <a class="floating-assist__action" href="https://zalo.me/0333204860" target="_blank" rel="noreferrer">Zalo CSKH</a>
          </div>
          ${Array.isArray(payload.follow_up_prompts) && payload.follow_up_prompts.length ? `
            <div class="floating-assist__starter-grid">
              ${payload.follow_up_prompts.map((item) => `<button type="button" class="floating-assist__starter" data-ai-starter="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join("")}
            </div>
          ` : ""}
        </div>
      `;
    }

    function renderHistory() {
      const items = readHistory();
      if (!items.length) {
        messages.innerHTML = renderWelcome();
      } else {
        messages.innerHTML = items.map((item) => {
          if (item.role === "assistant" && item.loading) {
            return `
              <div class="floating-assist__message floating-assist__message--assistant">
                <div class="floating-assist__thinking">
                  <div class="floating-assist__thinking-head">
                    <span>Đang tìm phương án đặt phòng</span>
                    <span class="floating-assist__thinking-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                  </div>
                  <div class="floating-assist__thinking-steps">
                    <span>Hiểu nhu cầu</span>
                    <span>Đối chiếu phòng</span>
                    <span>Tối ưu ưu đãi</span>
                    <span>Chấm quyết định</span>
                  </div>
                </div>
              </div>
            `;
          }

          if (item.role === "assistant" && item.payload) {
            return renderAssistantPayload(item.payload);
          }

          return `
            <div class="floating-assist__message floating-assist__message--${item.role === "user" ? "user" : "assistant"}">
              <p>${escapeHtml(item.text || "")}</p>
            </div>
          `;
        }).join("");
      }
      renderDecisionBar();
      const latestMessage = messages.lastElementChild;
      const vipPanel = latestMessage?.querySelector(".floating-assist__vip");
      if (vipPanel) {
        messages.scrollTop = Math.max(0, latestMessage.offsetTop + vipPanel.offsetTop - 16);
      } else {
        messages.scrollTop = messages.scrollHeight;
      }
    }

    function pushHistory(entry) {
      const items = readHistory();
      items.push(entry);
      writeHistory(items);
      renderHistory();
    }

    async function submitMessage(message) {
      const trimmed = String(message || "").trim();
      if (!trimmed) {
        return;
      }

      openWidget();
      pushHistory({ role: "user", text: trimmed });
      input.value = "";
      resizeInput();
      submit.disabled = true;
      pushHistory({ role: "assistant", loading: true });

      try {
        const response = await fetch("/api/ai/concierge", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ message: trimmed, filters: getLatestConversationFilters() })
        });

        const json = await response.json();
        if (!json.ok) {
          throw new Error(json.message || "Không thể xử lý trợ lý đặt phòng.");
        }

        const items = readHistory();
        items.pop();
        writeHistory(items);
        pushHistory({ role: "assistant", payload: json.data });
      } catch (error) {
        const items = readHistory();
        items.pop();
        writeHistory(items);
        pushHistory({
          role: "assistant",
          text: error instanceof Error ? error.message : "Không thể xử lý trợ lý đặt phòng lúc này."
        });
      } finally {
        submit.disabled = false;
      }
    }

    toggle.addEventListener("click", () => {
      if (drawer.hidden) openWidget();
      else closeWidget();
    });

    closeButton?.addEventListener("click", closeWidget);

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      submitMessage(input.value);
    });

    input.addEventListener("input", resizeInput);

    input.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.shiftKey || event.isComposing) return;
      event.preventDefault();
      submitMessage(input.value);
    });

    messages.addEventListener("click", (event) => {
      const copyButton = event.target.closest("[data-ai-copy-decision]");
      if (copyButton) {
        const panel = copyButton.closest(".floating-assist__vip");
        const summary = panel?.getAttribute("data-decision-summary") || "";
        if (summary) {
          copyTextToClipboard(summary).then((ok) => {
            if (!ok) throw new Error("copy failed");
            const previous = copyButton.textContent;
            copyButton.textContent = "Đã sao chép";
            window.setTimeout(() => {
              copyButton.textContent = previous || "Sao chép tóm tắt";
            }, 1600);
          }).catch(() => {
            copyButton.textContent = "Không sao chép được";
          });
        }
        return;
      }

      const compactButton = event.target.closest("[data-ai-toggle-compact]");
      if (compactButton) {
        const panel = compactButton.closest(".floating-assist__vip");
        if (panel) {
          panel.classList.toggle("is-compact");
          compactButton.textContent = panel.classList.contains("is-compact") ? "Mở rộng" : "Thu gọn";
        }
        return;
      }

      const starter = event.target.closest("[data-ai-starter]");
      if (!starter) return;
      submitMessage(starter.getAttribute("data-ai-starter") || "");
    });

    form.addEventListener("click", (event) => {
      const starter = event.target.closest("[data-ai-starter]");
      if (!starter) return;
      submitMessage(starter.getAttribute("data-ai-starter") || "");
    });

    window.addEventListener("abc:ai-widget-open", openWidget);

    if (sessionStorage.getItem(OPEN_KEY) === "1") {
      openWidget();
    }
    setupVoiceInput();
    resizeInput();

    renderHistory();
  })();

</script>
</body>
</html>
