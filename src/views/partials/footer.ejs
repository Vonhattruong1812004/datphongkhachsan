<link rel="stylesheet" href="/runtime-ui.css?v=20261010-layout1" />

<link rel="stylesheet" href="/booking-experience.css?v=20261010-payment1" />
<aside class="floating-assist" id="bookingAssistant" aria-label="Trợ lý đặt phòng và liên hệ nhanh">
  <div class="floating-assist__fab-stack">
    <a
      class="floating-assist__fab-link floating-assist__fab-link--zalo"
      href="https://zalo.me/0333204860"
      target="_blank"
      rel="noreferrer"
      aria-label="Liên hệ Zalo 0333204860"
      title="Zalo 0333204860"
    >
      <span class="floating-assist__fab-icon" aria-hidden="true">
        <span class="floating-assist__fab-label">Zalo</span>
      </span>
    </a>

    <button class="floating-assist__toggle" type="button" id="floatingAiToggle" aria-label="Mở trợ lý đặt phòng" title="Trợ lý đặt phòng" aria-controls="floatingAiDrawer" aria-expanded="false">
      <span class="floating-assist__toggle-badge"></span>
      <span class="floating-assist__toggle-icon" aria-hidden="true">
        <img src="/vendor/lucide/messages-square.svg" width="24" height="24" alt="" />
      </span>
      <span class="floating-assist__toggle-label">Hỏi Bento</span>
    </button>
  </div>

  <section class="floating-assist__drawer" id="floatingAiDrawer" role="dialog" aria-labelledby="floatingAiTitle" hidden>
    <header class="floating-assist__head">
      <div class="floating-assist__brand">
        <img src="/icons/app-icon-192.png" width="40" height="40" alt="" />
        <div><h2 class="floating-assist__title" id="floatingAiTitle">Bento</h2>
        <p class="floating-assist__subtitle">Trợ lý đặt phòng</p></div>
      </div>
      <div class="floating-assist__head-tools">
        <button class="assistant-icon-button" type="button" id="floatingAiExpand" aria-label="Mở rộng hội thoại" title="Mở rộng hội thoại" aria-pressed="false"><img src="/vendor/lucide/maximize-2.svg" alt="" /></button>
        <button class="assistant-icon-button" type="button" id="floatingAiClose" aria-label="Đóng trợ lý đặt phòng" title="Đóng"><img src="/vendor/lucide/x.svg" alt="" /></button>
      </div>
    </header>


    <div class="floating-assist__body" id="floatingAiMessages" role="log" aria-label="Nội dung hội thoại" aria-live="polite" aria-relevant="additions text"></div>

    <form class="floating-assist__form" id="floatingAiForm">
      <div class="floating-assist__intent-toolbar" id="floatingAiRefinements" aria-label="Tinh chỉnh phòng đang gợi ý" hidden>
        <button type="button" data-ai-starter="Rẻ hơn nhưng vẫn phù hợp">Rẻ hơn</button>
        <button type="button" data-ai-starter="Cao cấp hơn">Cao cấp hơn</button>
        <button type="button" data-ai-starter="Gần hơn">Gần hơn</button>
        <button type="button" data-ai-starter="Phòng rộng hơn">Rộng hơn</button>
        <button type="button" data-ai-starter="So sánh vì sao phòng này tốt nhất">So sánh</button>
      </div>
      <textarea
        class="floating-assist__input"
        id="floatingAiInput"
        rows="2"
        aria-label="Nhu cầu đặt phòng"
        placeholder="Phòng ở Đà Nẵng, 2 người, dưới 2 triệu…"
      ></textarea>
      <div class="floating-assist__submit-row">
        <div class="floating-assist__voice-panel">
          <div class="floating-assist__voice-control">
            <label class="floating-assist__voice-auto" title="Khi bật, AI tự gửi yêu cầu tìm phòng sau khi bạn nói xong.">
              <input type="checkbox" id="floatingAiVoiceAuto" checked />
              <span>Tự gửi</span>
            </label>
            <button class="floating-assist__voice" type="button" id="floatingAiVoice" aria-label="Nhập nhu cầu đặt phòng bằng giọng nói tiếng Việt" title="Nhập bằng giọng nói tiếng Việt">
              <span class="floating-assist__voice-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 14.5a3.5 3.5 0 0 0 3.5-3.5V6a3.5 3.5 0 1 0-7 0v5a3.5 3.5 0 0 0 3.5 3.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M5 10.5a7 7 0 0 0 14 0M12 17.5V21M9 21h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="floating-assist__voice-label">Nói</span>
            </button>
          </div>
          <meter id="floatingAiVoiceLevel" min="0" max="1" value="0" aria-label="Mức âm thanh micro" hidden></meter>
          <div class="floating-assist__voice-status" id="floatingAiVoiceStatus" role="status" aria-live="polite" hidden></div>
        </div>
        <button class="floating-assist__submit" type="submit" id="floatingAiSubmit" aria-label="Gửi tin nhắn" title="Gửi tin nhắn"><img src="/vendor/lucide/arrow-up.svg" alt="" /></button>
      </div>
    </form>
  </section>

</aside>

<script>
  (function registerFloatingAiConcierge() {
    const HISTORY_KEY = "abc_booking_assistant_history_v4";
    const OPEN_KEY = "abc_ai_widget_open_v1";
    const toggle = document.getElementById("floatingAiToggle");
    const closeButton = document.getElementById("floatingAiClose");
    const drawer = document.getElementById("floatingAiDrawer");
    const messages = document.getElementById("floatingAiMessages");
    const form = document.getElementById("floatingAiForm");
    const input = document.getElementById("floatingAiInput");
    const submit = document.getElementById("floatingAiSubmit");
    const voiceButton = document.getElementById("floatingAiVoice");
    const voiceAuto = document.getElementById("floatingAiVoiceAuto");
    const voiceStatus = document.getElementById("floatingAiVoiceStatus");
    const expandButton = document.getElementById("floatingAiExpand");
    const refinements = document.getElementById("floatingAiRefinements");
    let returnFocus;

    if (!toggle || !drawer || !messages || !form || !input || !submit) {
      return;
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function customerTierLabel(tier) {
      const labels = {
        "Needs Info": "Cần bổ sung",
        Platinum: "Rất phù hợp",
        Gold: "Phù hợp",
        Silver: "Cân nhắc"
      };
      return labels[tier] || tier || "Đang tư vấn";
    }

    try {
      ["abc_ai_widget_history_v1", "abc_ai_widget_history_v2", "abc_booking_assistant_history_v3"].forEach((key) => sessionStorage.removeItem(key));
    } catch {}

    function readHistory() {
      try {
        return JSON.parse(sessionStorage.getItem(HISTORY_KEY) || "[]");
      } catch {
        return [];
      }
    }

    function writeHistory(items) {
      sessionStorage.setItem(HISTORY_KEY, JSON.stringify(items.slice(-14)));
    }

    function getLatestConversationFilters() {
      const items = readHistory();
      for (let index = items.length - 1; index >= 0; index -= 1) {
        const payload = items[index]?.payload;
        const filters = payload?.extracted_filters || payload?.recommendations?.filters;
        if (filters && typeof filters === "object") {
          return filters;
        }
      }

      return undefined;
    }

    function getLatestAssistantPayload() {
      const items = readHistory();
      for (let index = items.length - 1; index >= 0; index -= 1) {
        const payload = items[index]?.payload;
        if (payload?.recommendations?.booking_decision) {
          return payload;
        }
      }

      return null;
    }

    function getDialogueContext() {
      const items = readHistory();
      for (let index = items.length - 1; index >= 0; index -= 1) {
        const payload = items[index]?.payload;
        if (!payload) continue;
        if (payload.dialogue_context) return payload.dialogue_context;
        // Older stored responses may mix a destination and a room: ask instead of guessing.
        if (payload.intent === "conversation") continue;
        const isRoom = ["booking", "general"].includes(payload.intent) && payload.recommendations?.top_pick;
        return { topic: isRoom ? "booking" : "clarification", last_room_id: payload.recommendations?.top_pick ? Number(payload.recommendations.top_pick.id) : null, excluded_room_ids: [] };
      }
      return undefined;
    }

    function setVoiceLabel(label) {
      const labelNode = voiceButton?.querySelector(".floating-assist__voice-label");
      if (labelNode) {
        labelNode.textContent = label;
      } else if (voiceButton) {
        voiceButton.textContent = label;
      }
    }

    function setVoiceStatus(text, tone = "") {
      if (!voiceStatus) return;
      voiceStatus.textContent = text || "";
      voiceStatus.hidden = !text;
      voiceStatus.classList.toggle("is-hot", tone === "hot");
      voiceStatus.classList.toggle("is-risk", tone === "risk");
    }

    let cancelVoiceInput = () => {};

    function setupVoiceInput() {
      const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!voiceButton || !Recognition) {
        if (voiceButton) {
          voiceButton.classList.add("is-unsupported");
          voiceButton.disabled = true;
          voiceButton.setAttribute("aria-disabled", "true");
          voiceButton.title = "Trình duyệt này chưa hỗ trợ nhập giọng nói";
          setVoiceLabel("Không hỗ trợ");
          setVoiceStatus("Trình duyệt chưa hỗ trợ nhận giọng nói. Hãy mở bằng Chrome hoặc Edge.", "risk");
        }
        return;
      }

      const recognition = new Recognition();
      recognition.lang = "vi-VN";
      recognition.interimResults = true;
      recognition.continuous = false;
      let baseText = "";
      let finalTranscript = "";
      let hadVoiceResult = false;
      let voiceHadError = false;
      let voiceSubmitTimer = 0;
      let phase = "idle";
      let session = 0;
      let stream;
      let audioContext;
      let audioFrame = 0;
      let listenTimer = 0;
      let soundDetected = false;
      let meterAvailable = false;
      const meter = document.getElementById("floatingAiVoiceLevel");

      function releaseMicrophone() {
        window.clearTimeout(listenTimer);
        cancelAnimationFrame(audioFrame);
        stream?.getTracks().forEach((track) => track.stop());
        stream = null;
        if (audioContext) audioContext.close().catch(() => {});
        audioContext = null;
        if (meter) { meter.hidden = true; meter.value = 0; }
      }

      function resetButton() {
        phase = "idle";
        voiceButton.classList.remove("is-listening");
        voiceButton.setAttribute("aria-pressed", "false");
        voiceButton.title = "Nhập bằng giọng nói";
        setVoiceLabel("Nói");
      }

      function reportVoiceError(message, code) {
        voiceHadError = true;
        setVoiceStatus(message, "risk");
        // Log error codes only, never audio or customer transcripts.
        console.warn("[Bento voice]", code);
      }

      function noTranscriptMessage() {
        if (soundDetected) return "Micro có tín hiệu âm thanh nhưng chưa nhận được chữ từ dịch vụ nhận giọng nói. Hãy kiểm tra kết nối mạng hoặc thử lại bằng Chrome.";
        if (meterAvailable) return "Micro đã được cấp quyền nhưng chưa đo được tín hiệu âm thanh. Kiểm tra micro đầu vào hoặc trạng thái tắt tiếng.";
        return "Chưa nhận được chữ từ dịch vụ giọng nói; chưa xác định được tín hiệu micro. Bạn có thể nhập yêu cầu bằng bàn phím.";
      }

      cancelVoiceInput = () => {
        session += 1;
        window.clearTimeout(voiceSubmitTimer);
        voiceHadError = true;
        const previousPhase = phase;
        resetButton();
        releaseMicrophone();
        if (previousPhase !== "idle") setVoiceStatus("");
        if (["starting", "listening", "stopping"].includes(previousPhase)) {
          phase = "stopping";
          if (previousPhase !== "stopping") recognition.abort();
        }
      };

      function monitorMicrophone() {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        try {
          audioContext = new AudioContext();
          audioContext.resume().catch(() => {});
          const analyser = audioContext.createAnalyser();
          analyser.fftSize = 1024;
          audioContext.createMediaStreamSource(stream).connect(analyser);
          const samples = new Float32Array(analyser.fftSize);
          if (meter) meter.hidden = false;
          const sample = () => {
            analyser.getFloatTimeDomainData(samples);
            const rms = Math.sqrt(samples.reduce((total, value) => total + value * value, 0) / samples.length);
            meterAvailable = audioContext?.state === "running";
            if (rms > 0.005) soundDetected = true;
            if (meter) meter.value = Math.min(1, rms * 8);
            audioFrame = requestAnimationFrame(sample);
          };
          sample();
        } catch {
          // Recognition can still work when the optional level meter is unavailable.
          meterAvailable = false;
        }
      }

      recognition.onstart = () => {
        if (phase !== "starting") { recognition.abort(); return; }
        phase = "listening";
        openWidget();
        voiceButton.classList.add("is-listening");
        voiceButton.setAttribute("aria-pressed", "true");
        voiceButton.title = "Đang nghe, bấm để dừng";
        setVoiceLabel("Đang nghe");
        setVoiceStatus("Đang nghe…", "hot");
        listenTimer = window.setTimeout(() => recognition.stop(), 20000);
      };

      recognition.onresult = (event) => {
        if (phase !== "listening" || voiceHadError) return;
        // Each event contains previous results too; rebuild instead of appending duplicates.
        const results = Array.from(event.results);
        finalTranscript = results.filter((result) => result.isFinal).map((result) => result[0]?.transcript || "").join(" ").trim();
        const transcript = results.map((result) => result[0]?.transcript || "").join(" ").trim();
        hadVoiceResult = Boolean(transcript || finalTranscript);
        input.value = [baseText, transcript || finalTranscript].filter(Boolean).join(" ").trim();
        resizeInput();
        input.focus();
        if (transcript || finalTranscript) {
          setVoiceStatus("Đang nghe…", "hot");
        }
      };

      recognition.onerror = (event) => {
        if (phase === "idle" || phase === "stopping") return;
        const messages = {
          "not-allowed": "Trình duyệt hoặc macOS đang chặn nhận giọng nói. Kiểm tra quyền micro của trang và ứng dụng.",
          "service-not-allowed": "Micro đã được cấp quyền nhưng dịch vụ nhận giọng nói bị từ chối. Hãy thử bằng Chrome hoặc Edge.",
          "no-speech": noTranscriptMessage(),
          "network": "Micro đã được cấp quyền nhưng kết nối dịch vụ nhận giọng nói bị lỗi. Kiểm tra mạng hoặc VPN.",
          "audio-capture": "Dịch vụ nhận giọng nói không mở được micro. Kiểm tra thiết bị đầu vào và ứng dụng đang dùng micro.",
          "language-not-supported": "Dịch vụ nhận giọng nói hiện tại không hỗ trợ tiếng Việt. Hãy thử bằng Chrome."
        };
        reportVoiceError(messages[event.error] || "Nhận giọng nói bị gián đoạn. Bạn có thể thử lại hoặc nhập bằng bàn phím.", event.error);
        releaseMicrophone();
      };

      recognition.onend = () => {
        if (phase === "idle") return;
        const cancelled = phase === "stopping";
        releaseMicrophone();
        resetButton();
        if (cancelled) return;
        const spokenText = input.value.trim();
        const shouldAutoSubmit = Boolean(voiceAuto?.checked) && !voiceHadError && hadVoiceResult && spokenText.length >= 2;
        if (shouldAutoSubmit) {
          setVoiceStatus("");
          voiceSubmitTimer = window.setTimeout(() => submitMessage(spokenText), 360);
        } else if (!voiceHadError && hadVoiceResult) {
          setVoiceStatus("");
        } else if (!voiceHadError) {
          setVoiceStatus(noTranscriptMessage(), "risk");
        }
      };

      voiceButton.addEventListener("click", async () => {
        if (phase === "listening") {
          recognition.stop();
          return;
        }
        if (phase !== "idle") return;
        window.clearTimeout(voiceSubmitTimer);
        const currentSession = ++session;
        phase = "checking";
        soundDetected = false;
        meterAvailable = false;
        voiceHadError = false;
        hadVoiceResult = false;
        finalTranscript = "";
        try {
          setVoiceLabel("Kiểm tra mic");
          setVoiceStatus("Đang mở micro…", "hot");
          if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia) {
            throw new Error("UNSAFE_CONTEXT");
          }
          const policy = document.permissionsPolicy || document.featurePolicy;
          if (policy?.allowsFeature && !policy.allowsFeature("microphone")) throw new Error("POLICY_BLOCKED");
          const acquiredStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          if (currentSession !== session) {
            acquiredStream.getTracks().forEach((track) => track.stop());
            return;
          }
          stream = acquiredStream;
          monitorMicrophone();
          baseText = input.value.trim();
          phase = "starting";
          recognition.start();
        } catch (error) {
          if (currentSession !== session) return;
          const code = error.message === "UNSAFE_CONTEXT" || error.message === "POLICY_BLOCKED" ? error.message : error.name;
          const messages = {
            NotAllowedError: "Quyền micro đang bị từ chối. Cho phép micro trong cài đặt trang và quyền ứng dụng trên macOS.",
            NotFoundError: "Không tìm thấy micro đầu vào. Kiểm tra thiết bị âm thanh của máy.",
            NotReadableError: "Không mở được micro. Kiểm tra thiết bị hoặc ứng dụng đang chiếm micro.",
            UNSAFE_CONTEXT: "Micro cần HTTPS hoặc địa chỉ localhost/127.0.0.1. Hãy mở đúng địa chỉ để sử dụng.",
            POLICY_BLOCKED: "Trang đang bị chính sách trình duyệt chặn micro. Tải lại trang hoặc mở trực tiếp ngoài khung nhúng."
          };
          reportVoiceError(messages[code] || "Không khởi động được nhận giọng nói. Hãy thử lại.", code);
          releaseMicrophone();
          resetButton();
        }
      });
      window.addEventListener("pagehide", cancelVoiceInput);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) cancelVoiceInput();
      });
    }

    function resizeInput() {
      input.style.height = "auto";
      input.style.height = `${Math.min(132, Math.max(64, input.scrollHeight))}px`;
    }

    function openWidget() {
      if (drawer.hidden) returnFocus = document.activeElement;
      drawer.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      sessionStorage.setItem(OPEN_KEY, "1");
      window.setTimeout(() => input.focus(), 40);
    }

    function closeWidget() {
      cancelVoiceInput();
      drawer.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      sessionStorage.removeItem(OPEN_KEY);
      (returnFocus instanceof HTMLElement && returnFocus !== document.body ? returnFocus : toggle).focus();
    }

    function renderWelcome() {
      return `
        <div class="floating-assist__welcome">
          <img class="floating-assist__welcome-mark" src="/icons/app-icon-192.png" alt="" width="52" height="52" />
          <h3>Chuyến đi tiếp theo<br>của bạn đến đâu?</h3>
          <p>Mình là Bento. Bạn đang tìm nơi nghỉ hay cần một vài gợi ý cho chuyến đi?</p>
          <div class="floating-assist__starter-grid">
            ${["Tôi muốn đi biển", "Tìm khách sạn gần đây", "Gợi ý điểm đến", "Phòng cho gia đình"].map((item) => `<button type="button" class="floating-assist__starter" data-ai-starter="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join("")}
          </div>
        </div>
      `;
    }

    function renderAssistantPayload(payload) {
      if (!payload) {
        return `<div class="floating-assist__message floating-assist__message--assistant"><p class="floating-assist__empty">Không có dữ liệu từ trợ lý đặt phòng.</p></div>`;
      }

      const top = payload.recommendations?.top_pick || null;
      const alternatives = Array.isArray(payload.recommendations?.alternatives) ? payload.recommendations.alternatives : [];
      const answer = payload.answer || null;
      const contextCards = Array.isArray(payload.context_cards) ? payload.context_cards : [];
      const quickActions = Array.isArray(payload.quick_actions) ? payload.quick_actions : [];
      if (payload.intent === "conversation" || payload.intent === "travel_guidance") {
        const suggestions = Array.isArray(payload.follow_up_prompts) ? payload.follow_up_prompts.slice(0, 2) : [];
        return `<div class="floating-assist__message floating-assist__message--assistant">
          ${answer?.title ? `<h4>${escapeHtml(answer.title)}</h4>` : ""}
          <p>${escapeHtml(answer?.body || "Mình đây! Bạn cần mình giúp gì?")}</p>
          ${Array.isArray(answer?.bullets) && answer.bullets.length ? `<ul class="floating-assist__list">${answer.bullets.slice(0, 4).map(item => `<li>${escapeHtml(item)}</li>`).join("")}</ul>` : ""}
          ${suggestions.length ? `<div class="floating-assist__starter-grid">${suggestions.map(item => `<button type="button" class="floating-assist__starter" data-ai-starter="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join("")}</div>` : ""}
        </div>`;
      }
      if (payload.requires_location) {
        return `<div class="floating-assist__message floating-assist__message--assistant">
          <h4>Bạn đang ở đâu?</h4>
          <p>${escapeHtml(payload.location_issue || "Cho phép định vị hoặc nhập khu vực bạn muốn tìm khách sạn.")}</p>
          <div class="floating-assist__actions"><button type="button" class="floating-assist__action" data-ai-starter="Tìm khách sạn gần đây">Dùng vị trí hiện tại</button></div>
        </div>`;
      }
      if (payload.intent === "nearby_discovery" && payload.external_discovery) {
        const discovery = payload.external_discovery;
        const places = Array.isArray(discovery.places) ? discovery.places.slice(0, 3) : [];
        return `<div class="floating-assist__message floating-assist__message--assistant">
          <h4>${escapeHtml(answer?.title || "Nơi lưu trú gần bạn")}</h4>
          <p>${escapeHtml(answer?.body || "")}</p>
          ${places.map(place => `<div class="floating-assist__external-place">
            <strong>${escapeHtml(place.name)}</strong>
            <p>${escapeHtml(place.type)} · khoảng ${Number(place.distanceKm).toLocaleString("vi-VN", { maximumFractionDigits: 1 })} km (đường thẳng)</p>
            <a href="${escapeHtml(place.sourceUrl)}" target="_blank" rel="noopener noreferrer">Xem trên bản đồ</a>
          </div>`).join("")}
          ${places.length ? '<p><small>Nơi lưu trú tham khảo, chưa xác minh giá và phòng trống. Không nhận đặt cọc trên Bento.</small></p>' : ""}
          <div class="floating-assist__actions"><a class="floating-assist__action" href="${escapeHtml(discovery.mapsUrl)}" target="_blank" rel="noopener noreferrer">Tìm thêm trên Google Maps</a></div>
          <p><small><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a> · ${places.length ? `Tra cứu lúc ${new Date(discovery.checkedAt).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" })}` : "Nguồn tham khảo"}</small></p>
        </div>`;
      }
      if (!top && (payload.intent === "booking" || payload.intent === "general")) {
        return `<div class="floating-assist__message floating-assist__message--assistant">
          ${payload.reply_intro ? `<p>${escapeHtml(payload.reply_intro)}</p>` : ""}
          <h4>${escapeHtml(answer?.title || "Chưa có phòng phù hợp")}</h4>
          <p>${escapeHtml(answer?.body || "Bạn muốn tìm phòng ở khu vực nào?")}</p>
          ${contextCards.length ? `<details class="floating-assist__response-details"><summary>Xem lựa chọn khác</summary>${contextCards.slice(0, 2).map(card => `<p><a href="${escapeHtml(card.href || '/booking/search')}">${escapeHtml(card.title)}</a></p>`).join("")}</details>` : ""}
        </div>`;
      }
      if (top && (payload.intent === "booking" || payload.intent === "general")) {
        const filters = payload.extracted_filters || {};
        const hasDates = Boolean(filters.ngay_nhan && filters.ngay_tra);
        const nearby = Boolean(filters.user_lat && filters.user_lng);
        const decision = payload.recommendations?.booking_decision;
        const reasons = (top.recommendation?.reasons || []).slice(0, 3);
        const risks = (decision?.riskFlags || []).slice(0, 2);
        const question = !hasDates ? "Bạn muốn nhận và trả phòng ngày nào?"
          : !Number(filters.so_khach) ? "Bạn đi mấy người?"
          : !(Number(filters.gia_den) || Number(filters.gia_goi_y)) ? "Ngân sách mỗi đêm của bạn khoảng bao nhiêu?" : "";
        return `<div class="floating-assist__message floating-assist__message--assistant">
          ${payload.reply_intro ? `<p>${escapeHtml(payload.reply_intro)}</p>` : ""}
          <h4>${escapeHtml(top.khachSan || "Phòng gợi ý")} · ${escapeHtml(top.soPhong)}</h4>
          ${top.imageUrl ? `<img class="floating-assist__room-photo" src="${escapeHtml(top.imageUrl)}" alt="${escapeHtml(top.loaiPhong || "Phòng gợi ý")}" loading="lazy" onerror="this.remove()">${top.imageUrl.includes("/sample-") ? '<small>Ảnh minh họa</small>' : ''}` : ""}
          <p>${escapeHtml(top.loaiPhong)} · tối đa ${Number(top.soKhachToiDa || 0)} khách · ${escapeHtml(top.tinhThanh)}</p>
          ${nearby && top.userDistanceLabel ? `<p>Cách bạn khoảng <strong>${escapeHtml(top.userDistanceLabel)}</strong> (đường thẳng).</p>` : ""}
          <p><strong>${Number(top.gia || 0).toLocaleString("vi-VN")} đ / đêm</strong></p>
          ${hasDates && decision?.moneySummary?.finalTotal ? `<p>Dự kiến ${escapeHtml(decision.moneySummary.finalTotal)} cho kỳ ở đã chọn.</p>` : ""}
          ${question ? `<p>${escapeHtml(question)}</p>` : ""}
          <div class="floating-assist__actions"><a class="floating-assist__action floating-assist__action--primary" href="/booking/rooms/${Number(top.id)}/detail">Xem phòng</a></div>
          <details class="floating-assist__response-details"><summary>Lý do gợi ý & lựa chọn khác</summary>
            ${reasons.length ? `<ul>${reasons.map(reason => `<li>${escapeHtml(reason)}</li>`).join("")}</ul>` : ""}
            ${risks.length ? `<p>${escapeHtml(risks.join(" "))}</p>` : ""}
            ${alternatives.slice(0, 2).map(room => `<p><a href="/booking/rooms/${Number(room.id)}/detail">${escapeHtml(room.khachSan)} · ${escapeHtml(room.soPhong)}</a><br>${Number(room.gia || 0).toLocaleString("vi-VN")} đ / đêm${nearby && room.userDistanceLabel ? ` · ${escapeHtml(room.userDistanceLabel)}` : ""}</p>`).join("")}
          </details>
        </div>`;
      }
      const isTravelInspiration = payload.intent === "inspiration";
      const isDestinationGuide = payload.intent === "location";
      const isTravelPlanning = isTravelInspiration || isDestinationGuide;
      const visibleBulletLimit = 2;
      const visibleContextLimit = 2;
      const filters = payload.extracted_filters || {};
      const filterChips = [
        filters.dia_diem ? `Gần ${filters.dia_diem}` : "",
        filters.loai_luu_tru ? `Loại lưu trú ${filters.loai_luu_tru}` : "",
        filters.hotel_city ? `Thành phố ${filters.hotel_city}` : "",
        filters.loai_phong ? `Loại ${filters.loai_phong}` : "",
        filters.view_phong ? `View ${filters.view_phong}` : "",
        Number(filters.so_khach || 0) > 0 ? `${filters.so_khach} khách` : "",
        Number(filters.gia_goi_y || 0) > 0 ? `${Number(filters.gia_goi_y).toLocaleString("vi-VN")} đ` : ""
      ].filter(Boolean);
      const cardIcon = (type) => ({
        room: "P",
        tour: "T",
        news: "N",
        promotion: "%",
        destination: "M",
        guide: "i"
      }[type] || "B");
      const renderContextCard = (card) => `
        <a class="floating-assist__smart-card" href="${escapeHtml(card.href || "#")}" ${card.href && card.href.startsWith("http") ? 'target="_blank" rel="noreferrer"' : ""}>
          ${card.imageUrl ? `<img src="${escapeHtml(card.imageUrl)}" alt="" loading="lazy" onerror="this.remove();" />` : `<span class="floating-assist__smart-icon">${escapeHtml(cardIcon(card.type))}</span>`}
          <span class="floating-assist__smart-body">
            <span class="floating-assist__smart-top">
              ${card.badge ? `<b>${escapeHtml(card.badge)}</b>` : ""}
              ${card.price ? `<strong>${escapeHtml(card.price)}</strong>` : ""}
            </span>
            <span class="floating-assist__smart-title">${escapeHtml(card.title || "")}</span>
            <span class="floating-assist__smart-subtitle">${escapeHtml(card.subtitle || "")}</span>
            ${card.meta ? `<span class="floating-assist__smart-meta">${escapeHtml(card.meta)}</span>` : ""}
          </span>
        </a>
      `;
      return `
        <div class="floating-assist__message floating-assist__message--assistant">
          ${payload.reply_intro ? `<p>${escapeHtml(payload.reply_intro)}</p>` : ""}
          <h4>${escapeHtml(answer?.title || payload.faq?.answer || "Đã phân tích xong nhu cầu đặt phòng của bạn.")}</h4>
          ${answer?.body ? `<p>${escapeHtml(answer.body)}</p>` : ""}
          ${Array.isArray(answer?.bullets) && answer.bullets.length ? `<ul class="floating-assist__list">${answer.bullets.slice(0, visibleBulletLimit).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>` : ""}
          ${filterChips.length ? `<div class="floating-assist__chips">${filterChips.map((item) => `<span class="floating-assist__chip">${escapeHtml(item)}</span>`).join("")}</div>` : ""}
          ${contextCards.length ? `<div class="floating-assist__smart-grid">${contextCards.slice(0, visibleContextLimit).map(renderContextCard).join("")}</div>` : ""}
          ${!contextCards.length && top ? `
            <div class="floating-assist__card">
              <div class="floating-assist__card-title">
                <span class="floating-assist__badge">${escapeHtml(top.recommendation?.label || "Gợi ý phù hợp nhất")}</span>
                <span class="floating-assist__price">${Number(top.gia || 0).toLocaleString("vi-VN")} đ / đêm</span>
              </div>
              <h5>${escapeHtml(top.loaiPhong || "")} - phòng ${escapeHtml(top.soPhong || "")}</h5>
              <p class="floating-assist__meta">${escapeHtml(top.khachSan || "")}${top.tinhThanh ? ` · ${escapeHtml(top.tinhThanh)}` : ""}</p>
              <p>${escapeHtml(top.recommendation?.summary || "")}</p>
              ${Number(top.recommendation?.confidence || 0) > 0 ? `<p class="floating-assist__meta">Độ tin cậy gợi ý: ${Number(top.recommendation.confidence)}%</p>` : ""}
              ${Array.isArray(top.recommendation?.reasons) && top.recommendation.reasons.length ? `<div class="floating-assist__chips">${top.recommendation.reasons.slice(0, 3).map((item) => `<span class="floating-assist__chip">${escapeHtml(item)}</span>`).join("")}</div>` : ""}
              ${Array.isArray(top.recommendation?.decisionNotes) && top.recommendation.decisionNotes.length ? `<ul class="floating-assist__list">${top.recommendation.decisionNotes.slice(0, 2).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>` : ""}
              ${Array.isArray(top.recommendation?.tradeoffs) && top.recommendation.tradeoffs.length ? `<p class="floating-assist__meta">Cần cân nhắc: ${escapeHtml(top.recommendation.tradeoffs[0])}</p>` : ""}
            </div>
          ` : ""}
          ${!contextCards.length && alternatives.length ? `
            <div class="floating-assist__alternatives">
              ${alternatives.slice(0, 3).map((item) => `
                <div class="floating-assist__card" style="margin-top:0;flex:1 1 180px;">
                  <span class="floating-assist__badge">${escapeHtml(item.recommendation?.label || "Lựa chọn khác")}</span>
                  <p style="margin-top:8px;"><strong>${escapeHtml(item.loaiPhong || "")}</strong> · ${escapeHtml(item.soPhong || "")}</p>
                  <p class="floating-assist__meta">${escapeHtml(item.khachSan || "")}</p>
                </div>
              `).join("")}
            </div>
          ` : ""}
          <div class="floating-assist__actions">
            ${
              quickActions.length
                ? quickActions.slice(0, 2).map((action) => action.href
                    ? `<a class="floating-assist__action ${action.primary ? "floating-assist__action--primary" : ""}" href="${escapeHtml(action.href)}">${escapeHtml(action.label)}</a>`
                    : `<button type="button" class="floating-assist__action ${action.primary ? "floating-assist__action--primary" : ""}" data-ai-starter="${escapeHtml(action.prompt || action.label)}">${escapeHtml(action.label)}</button>`
                  ).join("")
                : `
                  <a class="floating-assist__action floating-assist__action--primary" href="${escapeHtml(top ? `/booking/rooms/${top.id}/detail` : (payload.cta?.href || "/booking/search"))}">${top ? "Xem phòng này" : "Mở tìm phòng"}</a>
                  <a class="floating-assist__action" href="${escapeHtml(payload.cta?.href || "/booking/search")}">${escapeHtml(payload.cta?.label || "Xem danh sách phòng")}</a>
                `
            }
          </div>
          ${!quickActions.length && Array.isArray(payload.follow_up_prompts) && payload.follow_up_prompts.length ? `
            <div class="floating-assist__starter-grid">
              ${payload.follow_up_prompts.slice(0, 2).map((item) => `<button type="button" class="floating-assist__starter" data-ai-starter="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join("")}
            </div>
          ` : ""}
        </div>
      `;
    }

    function renderHistory() {
      const items = readHistory();
      if (!items.length) {
        messages.innerHTML = renderWelcome();
      } else {
        messages.innerHTML = items.map((item) => {
          if (item.role === "assistant" && item.loading) {
            return `
              <div class="floating-assist__message floating-assist__message--assistant">
                <div class="floating-assist__thinking">
                  <div class="floating-assist__thinking-head">
                    <span>Mình đang xem nhé…</span>
                    <span class="floating-assist__thinking-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                  </div>
                </div>
              </div>
            `;
          }

          if (item.role === "assistant" && item.payload) {
            return renderAssistantPayload(item.payload);
          }

          return `
            <div class="floating-assist__message floating-assist__message--${item.role === "user" ? "user" : "assistant"}">
              <p>${escapeHtml(item.role === "assistant" && /Failed to fetch|NetworkError|Load failed/i.test(item.text || "") ? "Không kết nối được với Bento. Bạn hãy kiểm tra mạng và gửi lại câu hỏi." : (item.text || ""))}</p>
              ${item.retry_message ? `<div class="floating-assist__actions"><button type="button" class="floating-assist__action" data-ai-retry="${escapeHtml(item.retry_message)}">Thử lại câu hỏi</button></div>` : ""}
            </div>
          `;
        }).join("");
      }
      const latestPayload = [...items].reverse().find(item => item.role === "assistant")?.payload;
      refinements.hidden = !latestPayload?.recommendations?.top_pick || !["booking", "general"].includes(latestPayload.intent);
      const latestMessage = messages.lastElementChild;
      if (latestMessage && latestMessage.offsetHeight > messages.clientHeight * .7) {
        const relativeTop = latestMessage.getBoundingClientRect().top - messages.getBoundingClientRect().top;
        messages.scrollTop += relativeTop - 18;
      } else {
        messages.scrollTop = messages.scrollHeight;
      }
    }

    function pushHistory(entry) {
      const items = readHistory();
      items.push(entry);
      writeHistory(items);
      renderHistory();
    }

    let currentLocation;

    function requestsNearby(message) {
      const normalized = message.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/gi, "d").toLowerCase();
      return /\b(gan day|quanh day|gan toi|gan cho toi|gan vi tri (?:cua )?toi|gan vi tri hien tai|gan minh|quanh toi|near me|nearby)\b/.test(normalized);
    }

    function locateUser() {
      return new Promise((resolve, reject) => {
        if (!navigator.geolocation) return reject({ code: 2 });
        navigator.geolocation.getCurrentPosition(position => resolve({
          latitude: position.coords.latitude,
          longitude: position.coords.longitude,
          accuracy: position.coords.accuracy,
          capturedAt: position.timestamp
        }), reject, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
      });
    }

    async function submitMessage(message) {
      const trimmed = String(message || "").trim();
      if (!trimmed || submit.disabled) {
        return;
      }

      cancelVoiceInput();
      openWidget();
      pushHistory({ role: "user", text: trimmed });
      input.value = "";
      resizeInput();
      submit.disabled = true;
      pushHistory({ role: "assistant", loading: true });
      const requestController = new AbortController();
      let requestTimeout;

      try {
        let locationIssue = "";
        if (requestsNearby(trimmed)) {
          currentLocation = undefined;
          try {
            currentLocation = await locateUser();
            if (currentLocation.accuracy > 5000) locationIssue = "Vị trí chưa đủ chính xác. Bạn nhập tên khu vực để mình tìm nhé.";
          } catch (error) {
            locationIssue = error.code === 1
              ? "Chưa được cấp quyền vị trí. Bạn có thể bật định vị hoặc nhập tên khu vực."
              : "Chưa lấy được vị trí. Bạn thử lại hoặc nhập tên khu vực nhé.";
          }
        }
        const location = currentLocation && Date.now() - currentLocation.capturedAt <= 300000 ? currentLocation : undefined;
        requestTimeout = window.setTimeout(() => requestController.abort(), 25000);
        const response = await fetch("/api/ai/concierge", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          signal: requestController.signal,
          body: JSON.stringify({ message: trimmed, filters: getLatestConversationFilters(), location, dialogue_context: getDialogueContext() })
        });

        if (response.status === 401 || response.status === 403) {
          throw new Error("Phiên làm việc đã thay đổi. Vui lòng tải lại trang trước khi gửi tiếp.");
        }
        if (!response.headers.get("content-type")?.includes("application/json")) {
          throw new Error("Máy chủ chưa sẵn sàng trả lời. Bạn có thể thử lại sau ít phút.");
        }
        const json = await response.json();
        if (!response.ok || !json.ok) {
          throw new Error(json.message || "Không thể xử lý trợ lý đặt phòng.");
        }
        if (!json.data?.answer) throw new Error("Phản hồi chưa đầy đủ. Bạn vui lòng thử lại câu hỏi.");

        const items = readHistory();
        items.pop();
        writeHistory(items);
        pushHistory({ role: "assistant", payload: { ...json.data, location_issue: locationIssue } });
      } catch (error) {
        const items = readHistory();
        items.pop();
        writeHistory(items);
        pushHistory({
          role: "assistant",
          text: error?.name === "AbortError" ? "Bento phản hồi chậm hơn dự kiến. Bạn có thể thử lại câu hỏi."
            : error instanceof TypeError ? navigator.onLine === false
              ? "Thiết bị đang mất kết nối mạng. Khi có mạng trở lại, bạn có thể thử lại câu hỏi."
              : "Không kết nối được với máy chủ Bento. Bạn kiểm tra kết nối và thử lại sau ít phút nhé."
            : error instanceof Error ? error.message : "Không thể xử lý trợ lý đặt phòng lúc này.",
          retry_message: trimmed
        });
      } finally {
        window.clearTimeout(requestTimeout);
        submit.disabled = false;
      }
    }

    toggle.addEventListener("click", () => {
      if (drawer.hidden) openWidget();
      else closeWidget();
    });

    closeButton?.addEventListener("click", closeWidget);

    expandButton?.addEventListener("click", () => {
      const expanded = drawer.classList.toggle("is-expanded");
      const label = expanded ? "Thu gọn hội thoại" : "Mở rộng hội thoại";
      expandButton.setAttribute("aria-pressed", String(expanded));
      expandButton.setAttribute("aria-label", label);
      expandButton.title = label;
      expandButton.querySelector("img").src = `/vendor/lucide/${expanded ? "minimize-2" : "maximize-2"}.svg`;
    });

    document.addEventListener("keydown", (event) => {
      if (drawer.hidden) return;
      if (event.key === "Escape") { event.preventDefault(); closeWidget(); }
      if (event.key !== "Tab" || !window.matchMedia("(max-width: 700px)").matches) return;
      const controls = [...drawer.querySelectorAll('button:not(:disabled), a[href], textarea, input, summary')]
        .filter(element => element.getClientRects().length);
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      submitMessage(input.value);
    });

    input.addEventListener("input", resizeInput);

    input.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.shiftKey || event.isComposing) return;
      event.preventDefault();
      submitMessage(input.value);
    });

    messages.addEventListener("click", (event) => {
      const retryButton = event.target.closest("[data-ai-retry]");
      if (retryButton) { submitMessage(retryButton.getAttribute("data-ai-retry")); return; }
      const starter = event.target.closest("[data-ai-starter]");
      if (!starter) return;
      submitMessage(starter.getAttribute("data-ai-starter") || "");
    });

    form.addEventListener("click", (event) => {
      const starter = event.target.closest("[data-ai-starter]");
      if (!starter) return;
      submitMessage(starter.getAttribute("data-ai-starter") || "");
    });

    window.addEventListener("abc:ai-widget-open", openWidget);

    if (sessionStorage.getItem(OPEN_KEY) === "1") {
      openWidget();
    }
    setupVoiceInput();
    resizeInput();

    renderHistory();
  })();

</script>

<!-- Scroll-to-top button -->
<button class="ux-scroll-top" id="uxScrollTop" type="button" aria-label="Cuộn lên đầu trang" title="Lên đầu trang">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<!-- Toast container -->
<div class="ux-toast-container" id="uxToastContainer" aria-live="polite"></div>

<script>
(() => {
  // Scroll-to-top
  const scrollBtn = document.getElementById("uxScrollTop");
  if (scrollBtn) {
    let ticking = false;
    const checkScroll = () => {
      scrollBtn.classList.toggle("is-visible", window.scrollY > 400);
      ticking = false;
    };
    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(checkScroll); }
    }, { passive: true });
    scrollBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    checkScroll();
  }

  // Toast system
  window.bentoToast = (message, type = "info", duration = 4000) => {
    const container = document.getElementById("uxToastContainer");
    if (!container) return;
    const toast = document.createElement("div");
    toast.className = `ux-toast ux-toast--${type}`;
    toast.textContent = message;
    toast.addEventListener("click", () => {
      toast.classList.add("is-leaving");
      setTimeout(() => toast.remove(), 250);
    });
    container.appendChild(toast);
    setTimeout(() => {
      if (toast.parentNode) {
        toast.classList.add("is-leaving");
        setTimeout(() => toast.remove(), 250);
      }
    }, duration);
  };

  // Skip link target: use the page's <main> when it has no explicit id
  if (!document.getElementById("main-content")) {
    const main = document.querySelector("body > main") || document.querySelector("main");
    if (main) {
      if (main.id) {
        document.querySelector(".ux-skip-link")?.setAttribute("href", `#${main.id}`);
      } else {
        main.id = "main-content";
      }
      if (!main.hasAttribute("tabindex")) main.setAttribute("tabindex", "-1");
    }
  }

  // Submit loading state: runs after page handlers (bubble phase on document),
  // and only when the submit was not cancelled by client-side validation or an AJAX handler.
  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || form.hasAttribute("data-no-loading")) return;
    if (form.closest(".floating-assist, .header-search")) return;
    window.setTimeout(() => {
      if (event.defaultPrevented) return;
      const submitBtn = event.submitter instanceof HTMLElement && event.submitter.form === form
        ? event.submitter
        : form.querySelector('button[type="submit"], button:not([type])');
      if (!submitBtn || submitBtn.tagName !== "BUTTON" || submitBtn.classList.contains("ux-btn-loading")) return;
      submitBtn.classList.add("ux-btn-loading");
      submitBtn.setAttribute("aria-busy", "true");
      window.setTimeout(() => {
        submitBtn.classList.remove("ux-btn-loading");
        submitBtn.removeAttribute("aria-busy");
      }, 8000);
    }, 0);
  });

  // Restore buttons when the page is shown again from the back/forward cache
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    document.querySelectorAll(".ux-btn-loading").forEach((button) => {
      button.classList.remove("ux-btn-loading");
      button.removeAttribute("aria-busy");
    });
  });
})();
</script>
</body>
</html>
