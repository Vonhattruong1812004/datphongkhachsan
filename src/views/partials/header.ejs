<%
    const roleId = currentUser ? Number(currentUser.maVaiTro) : 0;
    const activePath = typeof currentPath === "string" ? currentPath : "";
    const dashboardHrefByRole = {
      1: "/dashboard/admin",
      2: "/dashboard/letan",
      3: "/accounting",
      4: "/dashboard/dichvu",
      5: "/dashboard/cskh",
      6: "/dashboard/quanly",
      7: "/customer/dashboard"
    };
    const dashboardLabelByRole = {
      1: "Dashboard Admin",
      2: "Dashboard Lễ tân",
      3: "Quay về",
      4: "Dashboard Dịch vụ",
      5: "Dashboard CSKH",
      6: "Dashboard Quản lý",
      7: "Trang của tôi"
    };
    const accountingQuickLinks = [
      { href: "/accounting", label: "Thống kê tài chính" },
      { href: "/accounting/financial-reports", label: "Lập báo cáo tài chính" },
      { href: "/accounting/revenue", label: "Quản lý doanh thu" },
      { href: "/accounting/expenses", label: "Quản lý chi phí" },
      { href: "/accounting/debts", label: "Quản lý công nợ" },
      { href: "/accounting/refunds", label: "Xử lý hoàn tiền" }
    ];
    const isActiveAccountingLink = (href) => {
      if (!activePath) return false;
      if (href === "/accounting") return activePath === "/accounting" || activePath === "/accounting/reports";
      return activePath === href || activePath.startsWith(`${href}/`);
    };
    const showCustomerNav = !currentUser || roleId === 7;
    const showBookingSearch = !currentUser;
    const useCompactHeader = Boolean(currentUser);
    const isStaffHeader = Boolean(currentUser && roleId !== 7);
    const showHeaderNotifications = true;
    const roleDashboardHref = dashboardHrefByRole[roleId] || "/";
    const isOnRoleDashboard = Boolean(currentUser && roleDashboardHref && activePath === roleDashboardHref);
    const loadedHeaderNotifications = typeof headerNotifications !== "undefined" && Array.isArray(headerNotifications)
      ? headerNotifications
      : [];
    const fallbackHeaderNotifications = currentUser
      ? []
      : [
          { title: "Ưu đãi lưu trú", text: "Khám phá hotel, resort, homestay và penthouse trên toàn quốc.", href: "/booking/search", read: false },
          { title: "Tin tức du lịch", text: "Cập nhật điểm đến hot và kinh nghiệm du lịch mới.", href: "/news", read: false },
          { title: "Tải app Bento", text: "Quét QR để dùng app đa nền tảng.", href: "/app-download", read: true }
        ];
    const headerNotificationItems = currentUser ? loadedHeaderNotifications : fallbackHeaderNotifications;
    const unreadHeaderNotifications = headerNotificationItems.filter((item) => !item.read);
    const readHeaderNotifications = headerNotificationItems.filter((item) => item.read);
  %>
<header class="site-header <%= useCompactHeader ? "site-header--staff" : "" %> <%= roleId === 2 ? "site-header--frontdesk" : "" %> <%= roleId === 7 ? "site-header--customer" : "" %>">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img class="brand__mark" src="/icons/bento-logo-mark.svg" alt="" aria-hidden="true" />
      <strong>Bento Booking</strong>
      <span>Nền tảng đặt phòng lưu trú toàn quốc</span>
    </a>

    <% if (showBookingSearch) { %>
    <form class="header-search" action="/booking/search" method="get" role="search" id="headerSearchForm">
      <div class="header-search__shell" id="headerSearchShell" aria-label="Tìm phòng">
        <span class="header-search__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </span>
        <input
          class="header-search__input"
          type="text"
          name="dia_diem"
          value="<%= typeof query?.dia_diem === 'string' ? query.dia_diem : '' %>"
          placeholder="Tìm hotel, resort, homestay hoặc điểm đến"
          autocomplete="off"
          id="headerSearchInput"
        />
        <button class="header-search__submit" type="button" id="headerSearchToggle">Tìm kiếm</button>
      </div>

      <div class="header-search__panel" id="headerSearchPanel" hidden>
        <div class="header-search__grid">
          <div class="header-search__field">
            <label for="header_hotel_city">Điểm đến</label>
            <input
              id="header_hotel_city"
              type="text"
              name="hotel_city"
              value="<%= typeof query?.hotel_city === 'string' ? query.hotel_city : '' %>"
              placeholder="Ví dụ: Đà Nẵng"
            />
          </div>
          <div class="header-search__field">
            <label for="header_hotel_name">Cơ sở lưu trú</label>
            <input
              id="header_hotel_name"
              type="text"
              name="hotel_name"
              value="<%= typeof query?.hotel_name === 'string' ? query.hotel_name : '' %>"
              placeholder="Tên cơ sở nếu đã biết"
            />
          </div>
          <div class="header-search__field">
            <label for="header_so_khach">Số khách</label>
            <input
              id="header_so_khach"
              type="number"
              name="so_khach"
              min="1"
              max="12"
              value="<%= typeof query?.so_khach === 'string' ? query.so_khach : '' %>"
              placeholder="2"
            />
          </div>
          <div class="header-search__field">
            <label for="header_ngay_nhan">Ngày nhận</label>
            <input
              id="header_ngay_nhan"
              type="date"
              name="ngay_nhan"
              value="<%= typeof query?.ngay_nhan === 'string' ? query.ngay_nhan : '' %>"
            />
          </div>
          <div class="header-search__field">
            <label for="header_ngay_tra">Ngày trả</label>
            <input
              id="header_ngay_tra"
              type="date"
              name="ngay_tra"
              value="<%= typeof query?.ngay_tra === 'string' ? query.ngay_tra : '' %>"
            />
          </div>
        </div>
        <div class="header-search__meta">
          <span class="header-search__hint">Nhập nhanh điểm đến hoặc mở bộ lọc để tìm theo ngày và số khách.</span>
          <div class="header-search__actions">
            <a class="header-search__link" href="/booking/search">Mở trang tìm phòng đầy đủ</a>
            <button class="header-search__submit header-search__submit--panel" type="submit">Tìm phòng</button>
          </div>
        </div>
      </div>
    </form>
    <% } %>

    <button class="mobile-nav-toggle" type="button" id="mobileNavToggle" aria-expanded="false" aria-controls="siteNavLinks">
      <span></span>
      <span></span>
      <span></span>
      <strong>Menu</strong>
    </button>

    <div class="header-utility">
      <div class="header-clock" aria-label="Đồng hồ và lịch">
        <span class="header-clock__date" id="globalHeaderDate">--/--/----</span>
        <strong class="header-clock__time" id="globalHeaderTime">--:--:--</strong>
      </div>

      <% if (showHeaderNotifications) { %>
        <details class="header-notification" data-header-notification>
          <summary aria-label="Mở thông báo">
            <span class="header-notification__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <path d="M18 9.8C18 6.4 15.8 4 12 4S6 6.4 6 9.8v2.9c0 .9-.3 1.7-.9 2.4L4 16.5h16l-1.1-1.4c-.6-.7-.9-1.5-.9-2.4V9.8Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path>
                <path d="M9.5 18.2c.4 1.1 1.3 1.8 2.5 1.8s2.1-.7 2.5-1.8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
              </svg>
            </span>
            <% if (unreadHeaderNotifications.length) { %>
              <span class="header-notification__badge" data-notification-badge><%= unreadHeaderNotifications.length %></span>
            <% } %>
          </summary>
          <div class="header-notification__panel">
            <div class="header-notification__head">
              <strong>Thông báo</strong>
              <span data-notification-count><%= unreadHeaderNotifications.length %> chưa đọc</span>
            </div>
            <% if (unreadHeaderNotifications.length) { %>
              <div class="header-notification__group" data-notification-group="unread">
                <div class="header-notification__label">Chưa đọc</div>
                <div class="header-notification__list" data-notification-list="unread">
                  <% unreadHeaderNotifications.forEach((item) => { %>
                    <a class="header-notification__item is-unread" href="<%= item.href %>" <% if (item.id) { %>data-notification-id="<%= item.id %>"<% } %>>
                      <span class="header-notification__dot"></span>
                      <span>
                        <strong><%= item.title %></strong>
                        <small><%= item.text %></small>
                        <% if (item.createdLabel) { %><em><%= item.createdLabel %></em><% } %>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
            <% if (readHeaderNotifications.length) { %>
              <div class="header-notification__group" data-notification-group="read">
                <div class="header-notification__label">Đã đọc</div>
                <div class="header-notification__list" data-notification-list="read">
                  <% readHeaderNotifications.forEach((item) => { %>
                    <a class="header-notification__item is-read" href="<%= item.href %>" <% if (item.id) { %>data-notification-id="<%= item.id %>"<% } %>>
                      <span class="header-notification__dot"></span>
                      <span>
                        <strong><%= item.title %></strong>
                        <small><%= item.text %></small>
                        <% if (item.createdLabel) { %><em><%= item.createdLabel %></em><% } %>
                      </span>
                    </a>
                  <% }) %>
                </div>
              </div>
            <% } %>
            <% if (!headerNotificationItems.length) { %>
              <div class="header-notification__empty">Chưa có thông báo mới.</div>
            <% } %>
          </div>
        </details>
      <% } %>
    </div>

    <nav class="nav-links <%= useCompactHeader ? "nav-links--staff" : "" %>" id="siteNavLinks">
      <% if (showCustomerNav && !currentUser) { %>
        <a class="chip nav-shortcut" href="/booking/search">Tìm phòng</a>
        <a class="chip nav-shortcut" href="/app-download">Tải app</a>
        <a class="chip nav-shortcut" href="/tours">Tour</a>
        <a class="chip nav-shortcut" href="/news">Tin tức</a>
        <a class="chip nav-shortcut" href="/#travel-partner">Đăng cơ sở</a>
        <a class="chip nav-shortcut" href="<%= currentUser && roleId === 7 ? "/customer/bookings" : "/auth/login" %>">Đặt phòng của tôi</a>
      <% } %>
      <% if (currentUser) { %>
        <% if (dashboardHrefByRole[roleId] && !isOnRoleDashboard) { %>
          <a class="chip chip--dashboard" href="<%= roleDashboardHref %>"><%= dashboardLabelByRole[roleId] %></a>
        <% } %>
        <details class="staff-account-menu">
          <summary aria-label="Mở menu tài khoản">
            <span class="staff-account-name"><%= currentUser.displayName %></span>
            <span class="staff-account-avatar" aria-hidden="true"><%= String(currentUser.displayName || "B").trim().charAt(0).toUpperCase() %></span>
          </summary>
          <div class="staff-account-dropdown">
            <strong><%= currentUser.displayName %></strong>
            <span><%= currentUser.tenVaiTro %></span>
            <a href="<%= roleDashboardHref %>">Trang chủ</a>
            <% if (roleId === 3) { %>
              <div class="staff-account-section-label">Chức năng kế toán</div>
              <% accountingQuickLinks.forEach((item) => { %>
                <a class="staff-account-uc-link <%= isActiveAccountingLink(item.href) ? "is-active" : "" %>" href="<%= item.href %>"><%= item.label %></a>
              <% }) %>
            <% } %>
            <% if (roleId === 7) { %>
              <a href="/customer/profile">Quản lý hồ sơ cá nhân</a>
              <a href="/customer/bookings">Đặt phòng của tôi</a>
              <a href="/tours">Gói tour du lịch</a>
            <% } %>
            <form action="/auth/logout" method="post">
              <button type="submit">Đăng xuất</button>
            </form>
          </div>
        </details>
      <% } else { %>
        <a class="chip" href="/auth/login">Đăng nhập</a>
        <a class="button button--primary" href="/auth/register">Đăng ký</a>
      <% } %>
    </nav>
  </div>
</header>
<script>
  (() => {
    const dateEl = document.getElementById("globalHeaderDate");
    const timeEl = document.getElementById("globalHeaderTime");

    if (!dateEl || !timeEl) return;

    const updateClock = () => {
      const now = new Date();
      dateEl.textContent = now.toLocaleDateString("vi-VN", {
        weekday: "short",
        day: "2-digit",
        month: "2-digit",
        year: "numeric"
      });
      timeEl.textContent = now.toLocaleTimeString("vi-VN", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
      });
    };

    updateClock();
    window.setInterval(updateClock, 1000);
  })();

  (() => {
    const form = document.getElementById("headerSearchForm");
    const shell = document.getElementById("headerSearchShell");
    const panel = document.getElementById("headerSearchPanel");
    const toggle = document.getElementById("headerSearchToggle");
    const input = document.getElementById("headerSearchInput");

    if (!form || !shell || !panel || !toggle || !input) return;

    const openPanel = () => {
      shell.classList.add("is-open");
      panel.hidden = false;
    };

    const closePanel = () => {
      shell.classList.remove("is-open");
      panel.hidden = true;
    };

    toggle.addEventListener("click", () => {
      if (panel.hidden) {
        openPanel();
        input.focus();
      } else {
        form.requestSubmit();
      }
    });

    input.addEventListener("focus", openPanel);
    input.addEventListener("click", openPanel);

    document.addEventListener("click", (event) => {
      if (!form.contains(event.target)) {
        closePanel();
      }
    });

    form.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closePanel();
      }
    });
  })();

  (() => {
    const toggle = document.getElementById("mobileNavToggle");
    const nav = document.getElementById("siteNavLinks");

    if (!toggle || !nav) return;

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
      nav.classList.toggle("is-open", !expanded);
    });
  })();

  (() => {
    const notification = document.querySelector("[data-header-notification]");
    if (!notification) return;

    const readGroupLabel = "Đã đọc";

    const getUnreadCount = () => notification.querySelectorAll(".header-notification__item.is-unread").length;

    const ensureReadList = () => {
      let readList = notification.querySelector('[data-notification-list="read"]');
      if (readList) return readList;

      const panel = notification.querySelector(".header-notification__panel");
      if (!panel) return null;

      const group = document.createElement("div");
      group.className = "header-notification__group";
      group.setAttribute("data-notification-group", "read");

      const label = document.createElement("div");
      label.className = "header-notification__label";
      label.textContent = readGroupLabel;

      readList = document.createElement("div");
      readList.className = "header-notification__list";
      readList.setAttribute("data-notification-list", "read");

      group.append(label, readList);
      panel.appendChild(group);
      return readList;
    };

    const syncUnreadCount = () => {
      const count = getUnreadCount();
      const summary = notification.querySelector("summary");
      const countEl = notification.querySelector("[data-notification-count]");
      let badge = notification.querySelector("[data-notification-badge]");

      if (countEl) {
        countEl.textContent = `${count} chưa đọc`;
      }

      if (count > 0) {
        if (!badge && summary) {
          badge = document.createElement("span");
          badge.className = "header-notification__badge";
          badge.setAttribute("data-notification-badge", "");
          summary.appendChild(badge);
        }
        if (badge) {
          badge.textContent = String(count);
        }
        notification.classList.remove("is-clear");
      } else {
        badge?.remove();
        notification.classList.add("is-clear");
      }
    };

    const markItemReadInUi = (item) => {
      if (!item.classList.contains("is-unread")) return;

      item.classList.remove("is-unread");
      item.classList.add("is-read");

      const readList = ensureReadList();
      if (readList) {
        readList.prepend(item);
      }

      const unreadList = notification.querySelector('[data-notification-list="unread"]');
      const unreadGroup = notification.querySelector('[data-notification-group="unread"]');
      if (unreadList && !unreadList.querySelector(".header-notification__item.is-unread")) {
        unreadGroup?.remove();
      }

      syncUnreadCount();
    };

    document.addEventListener("click", (event) => {
      if (!notification.contains(event.target)) {
        notification.removeAttribute("open");
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        notification.removeAttribute("open");
      }
    });

    notification.querySelectorAll("[data-notification-id]").forEach((item) => {
      item.addEventListener("click", async (event) => {
        const id = item.getAttribute("data-notification-id");
        if (!id) return;
        const href = item.getAttribute("href");
        event.preventDefault();

        markItemReadInUi(item);

        try {
          await window.fetch(`/notifications/${encodeURIComponent(id)}/read`, {
            method: "POST",
            credentials: "same-origin",
            headers: { "Accept": "application/json" }
          });
        } catch (_) {
          // UI already reflects the user action; next page load will reconcile with server state.
        }

        if (href) {
          window.location.assign(href);
        }
      });
    });
  })();
</script>
