    min-height:0;
    padding:0;
    overflow:visible;
    border:0;
    border-radius:0;
    background:transparent;
    box-shadow:none;
    backdrop-filter:none;
  }
  .svc-hero-main::before,
  .svc-order-card::before,
  .svc-action::before,
