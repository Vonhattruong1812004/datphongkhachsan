<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const safeQuery = (typeof query !== "undefined" && query) ? query : {};
  const pageNotice = (typeof notice !== "undefined" && notice) ? notice : {};
  const roomFeed = payload.roomFeed || { summary: {}, items: [], byHotel: [], priorityQueue: [] };
  const rooms = roomFeed.items || [];
  const inspectionHistory = payload.inspectionHistory || [];
  const draft = (typeof inspectionDraft !== "undefined" && inspectionDraft) ? inspectionDraft : {};

  const searchValue = String(safeQuery.search || "").trim();
  const statusFilter = String(safeQuery.status || "all");
  const hotelFilter = String(safeQuery.hotel_id || "all");
  const priorityFilter = String(safeQuery.priority || "all");
  const conditionFilter = String(safeQuery.condition || "all");
  const selectedRoomId = Number(draft.room_id || safeQuery.room_id || 0);
  const pageSize = 10;
  const requestedPage = Math.max(Number(safeQuery.page || 1) || 1, 1);

  const conditionOptions = [
    { value: "Tot", label: "Tốt", target: "Sẵn sàng", hint: "Đạt chuẩn mở bán." },
    { value: "CanVeSinh", label: "Cần vệ sinh", target: "Cần vệ sinh", hint: "Giữ phòng để xử lý vệ sinh." },
    { value: "HuHaiNhe", label: "Hư hại nhẹ", target: "Bảo trì", hint: "Ghi rõ lỗi cần kiểm tra." },
    { value: "HuHaiNang", label: "Hư hại nặng", target: "Bảo trì", hint: "Khóa bán đến khi xử lý xong." },
    { value: "DangBaoTri", label: "Đang bảo trì", target: "Bảo trì", hint: "Cập nhật tiến độ bảo trì." }
  ];
  const conditionValue = draft.room_condition || safeQuery.room_condition || "Tot";
  const noteValue = draft.note || "";
  const conditionLabel = (value) => (conditionOptions.find((item) => item.value === value)?.label || value || "Không rõ");
  const selectedRoom = selectedRoomId ? rooms.find((item) => Number(item.id) === selectedRoomId) : null;

  const statusText = (value) => ({
    Available: "Sẵn sàng",
    Cleaning: "Cần vệ sinh",
    Maintenance: "Bảo trì",
    Booked: "Đã đặt",
    Stayed: "Đang ở",
    Trong: "Trống",
    BaoTri: "Bảo trì"
  }[value] || value || "Chưa rõ");
  const statusClass = (value) => {
    if (value === "Available" || value === "Trong") return "pill ok";
    if (value === "Cleaning") return "pill info";
    if (value === "Maintenance" || value === "BaoTri") return "pill warn";
    if (value === "Booked") return "pill purple";
    if (value === "Stayed") return "pill teal";
    return "pill";
  };
  const priorityText = (value) => ({
    maintenance: "Ưu tiên bảo trì",
    cleaning: "Cần vệ sinh",
    booked: "Sắp nhận khách",
    stayed: "Đang có khách",
    available: "Sẵn sàng"
  }[value] || value || "Theo dõi");
  const isRoomLocked = (room) => Boolean(room?.isLocked) || Boolean(room?.transactionId) || ["Booked", "Stayed"].includes(room?.trangThaiRealtime || room?.trangThai || "");
  const isRoomActionable = (room) => room?.canInspect !== false && !isRoomLocked(room);
  const hotelMap = new Map();
  rooms.forEach((room) => {
    const key = String(room.hotelId || `${room.hotelName || ""}-${room.hotelCity || ""}`);
    if (!hotelMap.has(key)) {
      hotelMap.set(key, {
        value: key,
        label: [room.hotelName, room.hotelCity].filter(Boolean).join(" · ") || "Không rõ cơ sở"
      });
    }
  });
  const hotelChoices = Array.from(hotelMap.values());
  const matchesRoom = (room) => {
    const state = room.trangThaiRealtime || room.trangThai || "";
    const hotelKey = String(room.hotelId || `${room.hotelName || ""}-${room.hotelCity || ""}`);
    const haystack = [
      room.soPhong,
      room.loaiPhong,
      room.hotelName,
      room.hotelCity,
      room.bookingCode,
      room.guestName,
      room.tinhTrangPhong,
      room.priorityLabel
    ].filter(Boolean).join(" ").toLowerCase();
    const bySearch = !searchValue || haystack.includes(searchValue.toLowerCase());
    const byHotel = hotelFilter === "all" || hotelKey === hotelFilter;
    const byStatus = statusFilter === "all"
      || (statusFilter === "actionable" && isRoomActionable(room))
      || (statusFilter === "locked" && !isRoomActionable(room))
      || state === statusFilter;
    const byPriority = priorityFilter === "all" || String(room.priorityKey || "") === priorityFilter;
    const byCondition = conditionFilter === "all" || String(room.tinhTrangPhong || "Tot") === conditionFilter;
    return bySearch && byHotel && byStatus && byPriority && byCondition;
  };
  const filteredRooms = rooms.filter(matchesRoom);
  const pageCount = Math.max(Math.ceil(filteredRooms.length / pageSize), 1);
  const currentPage = Math.min(requestedPage, pageCount);
  const pageStart = (currentPage - 1) * pageSize;
  const pageRooms = filteredRooms.slice(pageStart, pageStart + pageSize);
  const rangeStart = filteredRooms.length ? pageStart + 1 : 0;
  const rangeEnd = Math.min(pageStart + pageSize, filteredRooms.length);
  const actionableCount = rooms.filter(isRoomActionable).length;
  const lockedCount = rooms.length - actionableCount;
  const countState = (state) => rooms.filter((room) => (room.trangThaiRealtime || room.trangThai) === state).length;
  const buildQuery = (changes = {}) => {
    const params = new URLSearchParams();
    if (searchValue) params.set("search", searchValue);
    if (statusFilter !== "all") params.set("status", statusFilter);
    if (hotelFilter !== "all") params.set("hotel_id", hotelFilter);
    if (priorityFilter !== "all") params.set("priority", priorityFilter);
    if (conditionFilter !== "all") params.set("condition", conditionFilter);
    if (selectedRoomId) params.set("room_id", String(selectedRoomId));
    Object.entries(changes).forEach(([key, value]) => {
      if (value === null || value === undefined || value === "" || value === "all") {
        params.delete(key);
      } else {
        params.set(key, String(value));
      }
    });
    return params.toString();
  };
  const pageUrl = (page) => `/service/room-inspection?${buildQuery({ page })}`;
  const buildRoomUrl = (roomId) => `/service/room-inspection?${buildQuery({ room_id: roomId, page: currentPage })}`;
  const formatDateTime = (value) => {
    if (!value) return "Chưa rõ";
    try {
      return new Intl.DateTimeFormat("vi-VN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }).format(new Date(value));
    } catch (_err) {
      return value;
    }
  };
%>

<style>
  .inspection-page{
    --blue:#0575e6;
    --blue-dark:#034ea2;
    --ink:#102033;
    --muted:#65758b;
    --line:#cfe2f7;
    --soft:#f3f8ff;
    --green:#07875f;
    min-height:calc(100vh - 84px);
    padding:28px 18px 56px;
    color:var(--ink);
    background:
      linear-gradient(180deg,rgba(235,246,255,.82),rgba(247,251,255,.92)),
      url("/images/san-pham-du-lich.webp") center/cover fixed;
  }
  .inspection-shell{width:min(1360px,calc(100vw - 40px));margin:0 auto}
  .title-band,.toolbar,.panel,.status-card,.history-card{border:1px solid var(--line);background:rgba(255,255,255,.9);box-shadow:0 18px 45px rgba(15,23,42,.08);backdrop-filter:blur(12px) saturate(1.08)}
  .title-band{border-radius:12px;padding:20px 24px;background:linear-gradient(135deg,#087cf0,#034ea2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .title-band h1{margin:0;font-size:34px;line-height:1.05;letter-spacing:-.03em;color:#fff}
  .title-band h1::before{content:"";display:inline-block;width:6px;height:38px;border-radius:999px;background:#fff;margin-right:12px;vertical-align:-7px}
  .title-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap}
  .alert{margin-top:12px;border-radius:10px;padding:12px 14px;font-weight:850}
  .alert.error{background:#fff1f2;color:#be123c;border:1px solid #fecdd3}
  .alert.success{background:#ecfdf5;color:#047857;border:1px solid #bbf7d0}
  .status-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0}
  .status-card{border-radius:12px;padding:14px 16px;text-decoration:none;color:var(--ink);transition:transform .15s ease,border-color .15s ease,background .15s ease}
  .status-card:hover{transform:translateY(-1px);border-color:#9ecbff;background:rgba(255,255,255,.96)}
  .status-card.is-active{border-color:#0b83ef;box-shadow:inset 4px 0 0 #0b83ef,0 18px 45px rgba(15,23,42,.08)}
  .status-card strong{display:block;color:#034ea2;font-size:30px;line-height:1}
  .status-card span{display:block;margin-top:7px;color:var(--muted);font-size:13px;font-weight:850}
  .toolbar{border-radius:12px;padding:14px;margin:14px 0;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .searchbar{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
  details.filter{position:relative}
  details.filter summary{list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;padding:12px 16px;min-width:112px}
  details.filter summary::-webkit-details-marker{display:none}
  .filter-pop{position:absolute;z-index:20;top:54px;left:0;width:680px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 22px 50px rgba(15,23,42,.18);padding:16px}
  .filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .field{display:grid;gap:6px}
  .field label{font-size:12px;color:#334155;font-weight:900}
  .field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;background:#fff;padding:11px 12px;color:var(--ink);font:inherit}
  .field textarea{min-height:112px;resize:vertical}
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:#0b83ef;box-shadow:0 0 0 3px rgba(11,131,239,.12)}
  .field.search-input{max-width:620px;flex:1}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .btn,.icon-btn{border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;text-decoration:none;cursor:pointer}
  .btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 16px}
  .icon-btn{width:48px;height:48px;display:inline-grid;place-items:center}
  .btn.primary,.icon-btn.primary{background:var(--blue);border-color:transparent;color:#fff}
  .btn:disabled{opacity:.55;cursor:not-allowed}
  .content-grid{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:14px;align-items:start}
  .panel{border-radius:12px;overflow:hidden}
  .table-wrap{overflow:auto}
  .room-table{width:100%;border-collapse:separate;border-spacing:0;font-size:14px;min-width:900px}
  .room-table thead th{background:#edf3f9;color:#334155;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.04em;padding:14px;border-bottom:1px solid var(--line)}
  .room-table tbody td{padding:14px;border-bottom:1px solid #e4eef8;vertical-align:middle}
  .room-table tbody tr{background:rgba(255,255,255,.92);cursor:pointer}
  .room-table tbody tr:hover{background:#f4f9ff}
  .room-table tbody tr.is-selected{box-shadow:inset 4px 0 0 var(--blue);background:#edf6ff}
  .room-code{display:block;color:#06479d;font-weight:950;font-size:18px;line-height:1.1}
  .sub{display:block;color:var(--muted);font-size:13px;line-height:1.45}
  .muted{color:var(--muted)}
  .pill{display:inline-flex;align-items:center;width:max-content;border-radius:999px;padding:6px 10px;background:#eef2f7;color:#475569;font-size:12px;font-weight:900}
  .pill.ok{background:#e9fbf1;color:#07875f}
  .pill.info{background:#eaf6ff;color:#0369a1}
  .pill.warn{background:#fff7ed;color:#c2410c}
  .pill.purple{background:#f3e8ff;color:#6d28d9}
  .pill.teal{background:#e6fffb;color:#0f766e}
  .pill.danger{background:#fff1f2;color:#be123c}
  .inspection-panel{padding:18px}
  .inspection-panel h2,.history-card h2{margin:0 0 12px;font-size:24px}
  .room-summary{border:1px solid var(--line);border-radius:12px;background:var(--soft);padding:14px;margin-bottom:14px}
  .room-summary h3{margin:10px 0 4px;font-size:26px;line-height:1.1}
  .summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
  .summary-grid div{border:1px solid var(--line);border-radius:10px;background:#fff;padding:10px}
  .summary-grid span{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:900}
  .summary-grid strong{display:block;margin-top:4px;font-size:15px}
  .condition-list{display:grid;grid-template-columns:1fr;gap:8px;margin:12px 0}
  .condition-item{border:1px solid var(--line);border-radius:10px;background:#fff;padding:10px 12px}
  .condition-item strong{display:block;color:var(--ink)}
  .condition-item span{display:block;color:var(--muted);font-size:12px;margin-top:3px}
  .condition-item.is-active{border-color:#0b83ef;background:#f0f7ff;box-shadow:inset 4px 0 0 #0b83ef}
  .form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:12px;flex-wrap:wrap}
  .empty{padding:24px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);background:#f8fbff}
  .history-card{border-radius:12px;margin-top:14px;padding:18px}
  .history-list{display:grid;gap:10px}
  .history-item{border:1px solid var(--line);border-radius:10px;background:#fff;padding:12px}
  .history-item strong{display:block;margin:6px 0 4px;font-size:15px}
  .history-item p{margin:0;color:var(--muted);font-size:13px;line-height:1.45}
  .list-footer{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;border-top:1px solid var(--line);background:#fff;flex-wrap:wrap}
  .list-footer-info{color:#334155;font-weight:700;font-size:14px}
  .list-footer-info strong{color:var(--ink)}
  .page-buttons{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .page-btn{min-width:38px;height:38px;border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;text-decoration:none;display:inline-grid;place-items:center;padding:0 10px}
  .page-btn.is-active{background:var(--blue);border-color:var(--blue);color:#fff}
  .page-btn.is-disabled{opacity:.45;pointer-events:none;background:#f8fafc;color:#94a3b8}
  @media(max-width:1120px){
    .status-strip{grid-template-columns:repeat(2,minmax(0,1fr))}
    .content-grid{grid-template-columns:1fr}
  }
  @media(max-width:720px){
    .inspection-page{padding:18px 10px 42px}
    .inspection-shell{width:100%}
    .title-band,.toolbar{align-items:stretch;flex-direction:column}
    .title-band h1{font-size:28px}
    .title-actions,.searchbar{width:100%;flex-wrap:wrap}
    .title-actions .btn{flex:1}
    .filter-pop{width:calc(100vw - 36px)}
    .filter-grid,.status-strip,.summary-grid{grid-template-columns:1fr}
  }
</style>

<main class="inspection-page">
  <div class="inspection-shell">
    <section class="title-band">
      <h1>Kiểm tra tình trạng phòng</h1>
      <div class="title-actions">
        <a class="btn" href="/dashboard/dichvu">Quay về</a>
        <a class="btn" href="/service/room-board-live">Room board</a>
      </div>
    </section>

    <% if (pageNotice.error) { %><div class="alert error"><%= pageNotice.error %></div><% } %>
    <% if (pageNotice.success) { %><div class="alert success"><%= pageNotice.success %></div><% } %>

    <section class="status-strip" aria-label="Tổng quan tình trạng phòng">
      <a class="status-card <%= statusFilter === "all" ? "is-active" : "" %>" href="/service/room-inspection">
        <strong><%= rooms.length %></strong>
        <span>Tất cả phòng</span>
      </a>
      <a class="status-card <%= statusFilter === "actionable" ? "is-active" : "" %>" href="/service/room-inspection?status=actionable">
        <strong><%= actionableCount %></strong>
        <span>Có thể cập nhật</span>
      </a>
      <a class="status-card <%= statusFilter === "Cleaning" ? "is-active" : "" %>" href="/service/room-inspection?status=Cleaning">
        <strong><%= roomFeed.summary?.cleaning ?? countState("Cleaning") %></strong>
        <span>Cần vệ sinh</span>
      </a>
      <a class="status-card <%= statusFilter === "locked" ? "is-active" : "" %>" href="/service/room-inspection?status=locked">
        <strong><%= lockedCount %></strong>
        <span>Đang khóa thao tác</span>
      </a>
    </section>

    <form class="toolbar" method="get" action="/service/room-inspection">
      <div class="searchbar">
        <details class="filter">
          <summary>Bộ lọc</summary>
          <div class="filter-pop">
            <div class="filter-grid">
              <div class="field">
                <label for="hotelFilter">Cơ sở</label>
                <select id="hotelFilter" name="hotel_id">
                  <option value="all" <%= hotelFilter === "all" ? "selected" : "" %>>Tất cả cơ sở</option>
                  <% hotelChoices.forEach((hotel) => { %>
                    <option value="<%= hotel.value %>" <%= hotelFilter === hotel.value ? "selected" : "" %>><%= hotel.label %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field">
                <label for="statusFilter">Trạng thái phòng</label>
                <select id="statusFilter" name="status">
                  <option value="all" <%= statusFilter === "all" ? "selected" : "" %>>Tất cả trạng thái</option>
                  <option value="actionable" <%= statusFilter === "actionable" ? "selected" : "" %>>Có thể cập nhật</option>
                  <option value="locked" <%= statusFilter === "locked" ? "selected" : "" %>>Đang khóa thao tác</option>
                  <option value="Available" <%= statusFilter === "Available" ? "selected" : "" %>>Sẵn sàng</option>
                  <option value="Cleaning" <%= statusFilter === "Cleaning" ? "selected" : "" %>>Cần vệ sinh</option>
                  <option value="Maintenance" <%= statusFilter === "Maintenance" ? "selected" : "" %>>Bảo trì</option>
                  <option value="Booked" <%= statusFilter === "Booked" ? "selected" : "" %>>Đã đặt</option>
                  <option value="Stayed" <%= statusFilter === "Stayed" ? "selected" : "" %>>Đang ở</option>
                </select>
              </div>
              <div class="field">
                <label for="priorityFilter">Mức xử lý</label>
                <select id="priorityFilter" name="priority">
                  <option value="all" <%= priorityFilter === "all" ? "selected" : "" %>>Tất cả mức xử lý</option>
                  <option value="maintenance" <%= priorityFilter === "maintenance" ? "selected" : "" %>>Ưu tiên bảo trì</option>
                  <option value="cleaning" <%= priorityFilter === "cleaning" ? "selected" : "" %>>Cần vệ sinh</option>
                  <option value="booked" <%= priorityFilter === "booked" ? "selected" : "" %>>Sắp nhận khách</option>
                  <option value="stayed" <%= priorityFilter === "stayed" ? "selected" : "" %>>Đang có khách</option>
                  <option value="available" <%= priorityFilter === "available" ? "selected" : "" %>>Sẵn sàng</option>
                </select>
              </div>
              <div class="field">
                <label for="conditionFilter">Kết quả kiểm tra</label>
                <select id="conditionFilter" name="condition">
                  <option value="all" <%= conditionFilter === "all" ? "selected" : "" %>>Tất cả kết quả</option>
                  <% conditionOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= conditionFilter === option.value ? "selected" : "" %>><%= option.label %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="form-actions">
              <a class="btn" href="/service/room-inspection">Đặt lại</a>
              <button class="btn primary" type="submit">Áp dụng</button>
            </div>
          </div>
        </details>
        <div class="field search-input">
          <label class="sr-only" for="roomSearch">Tìm phòng</label>
          <input id="roomSearch" name="search" value="<%= searchValue %>" placeholder="Tìm số phòng, cơ sở, khách, mã đặt chỗ..." />
        </div>
        <button class="icon-btn primary" type="submit" aria-label="Tìm kiếm">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <a class="btn" href="/service/room-inspection">Làm mới</a>
    </form>

    <section class="content-grid">
      <section class="panel">
        <div class="table-wrap">
          <% if (!pageRooms.length) { %>
            <div class="empty">Không có phòng phù hợp với bộ lọc hiện tại.</div>
          <% } else { %>
            <table class="room-table">
              <thead>
                <tr>
                  <th>Phòng</th>
                  <th>Cơ sở</th>
                  <th>Trạng thái</th>
                  <th>Kết quả kiểm tra</th>
                  <th>Giao dịch</th>
                  <th>Gợi ý xử lý</th>
                </tr>
              </thead>
              <tbody>
                <% pageRooms.forEach((room) => {
                  const state = room.trangThaiRealtime || room.trangThai || "";
                  const locked = !isRoomActionable(room);
                %>
                  <tr class="<%= Number(room.id) === selectedRoomId ? "is-selected" : "" %>" data-href="<%= buildRoomUrl(room.id) %>">
                    <td>
                      <span class="room-code"><%= room.soPhong %></span>
                      <span class="sub"><%= room.loaiPhong || "Chưa rõ loại" %></span>
                    </td>
                    <td>
                      <strong><%= room.hotelName || "Không rõ cơ sở" %></strong>
                      <span class="sub"><%= room.hotelCity || "Chưa rõ tỉnh/thành" %></span>
                    </td>
                    <td><span class="<%= statusClass(state) %>"><%= statusText(state) %></span></td>
                    <td>
                      <strong><%= conditionLabel(room.tinhTrangPhong || "Tot") %></strong>
                      <span class="sub"><%= priorityText(room.priorityKey) %></span>
                    </td>
                    <td>
                      <strong><%= room.bookingCode || (room.transactionId ? `GD #${room.transactionId}` : "Không có") %></strong>
                      <span class="sub"><%= room.guestName || (locked ? statusText(room.stayStatus || state) : "Có thể cập nhật") %></span>
                    </td>
                    <td>
                      <span class="<%= locked ? "pill" : "pill ok" %>"><%= locked ? "Chỉ theo dõi" : "Chọn kiểm tra" %></span>
                      <span class="sub"><%= room.suggestedAction || "Theo dõi định kỳ" %></span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
        <div class="list-footer">
          <div class="list-footer-info">
            Hiển thị <strong><%= rangeStart %>-<%= rangeEnd %></strong> trong tổng số <strong><%= filteredRooms.length %></strong> phòng
          </div>
          <div class="page-buttons">
            <a class="page-btn <%= currentPage <= 1 ? "is-disabled" : "" %>" href="<%= pageUrl(currentPage - 1) %>">Trước</a>
            <% for (let page = 1; page <= pageCount; page += 1) { %>
              <% if (page === 1 || page === pageCount || Math.abs(page - currentPage) <= 1) { %>
                <a class="page-btn <%= page === currentPage ? "is-active" : "" %>" href="<%= pageUrl(page) %>"><%= page %></a>
              <% } else if (Math.abs(page - currentPage) === 2) { %>
                <span class="muted">...</span>
              <% } %>
            <% } %>
            <a class="page-btn <%= currentPage >= pageCount ? "is-disabled" : "" %>" href="<%= pageUrl(currentPage + 1) %>">Sau</a>
          </div>
        </div>
      </section>

      <aside>
        <section class="panel inspection-panel" id="inspectionForm">
          <h2>Cập nhật tình trạng</h2>
          <% if (!selectedRoom) { %>
            <div class="empty">Chọn một phòng trong danh sách để cập nhật.</div>
          <% } else {
            const selectedState = selectedRoom.trangThaiRealtime || selectedRoom.trangThai || "";
            const selectedLocked = !isRoomActionable(selectedRoom);
          %>
            <div class="room-summary">
              <span class="<%= statusClass(selectedState) %>"><%= statusText(selectedState) %></span>
              <h3><%= selectedRoom.soPhong %></h3>
              <span class="sub"><%= [selectedRoom.loaiPhong, selectedRoom.hotelName, selectedRoom.hotelCity].filter(Boolean).join(" · ") %></span>
              <div class="summary-grid">
                <div><span>Giao dịch</span><strong><%= selectedRoom.bookingCode || "Không có" %></strong></div>
                <div><span>Khách</span><strong><%= selectedRoom.guestName || "Không có" %></strong></div>
              </div>
              <% if (selectedLocked) { %>
                <p class="sub" style="margin:12px 0 0">Phòng đang có booking/khách ở nên chỉ theo dõi, chưa cho cập nhật trạng thái mở bán.</p>
              <% } %>
            </div>
            <form method="post" action="/service/inspection">
              <% if (typeof csrfToken !== "undefined" && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <% } %>
              <input type="hidden" name="room_id" value="<%= selectedRoom.id %>" />
              <div class="field">
                <label for="roomCondition">Kết quả kiểm tra</label>
                <select id="roomCondition" name="room_condition" <%= selectedLocked ? "disabled" : "" %>>
                  <% conditionOptions.forEach((option) => { %>
                    <option value="<%= option.value %>" <%= conditionValue === option.value ? "selected" : "" %>><%= option.label %> → <%= option.target %></option>
                  <% }) %>
                </select>
              </div>
              <div class="condition-list" aria-label="Quy tắc cập nhật">
                <% conditionOptions.forEach((option) => { %>
                  <div class="condition-item <%= conditionValue === option.value ? "is-active" : "" %>" data-condition-card="<%= option.value %>">
                    <strong><%= option.label %></strong>
                    <span><%= option.hint %></span>
                  </div>
                <% }) %>
              </div>
              <div class="field">
                <label for="inspectionNote">Ghi chú</label>
                <textarea id="inspectionNote" name="note" placeholder="VD: khóa cửa kẹt, thiếu khăn, cần vệ sinh lại ban công..." <%= selectedLocked ? "disabled" : "" %>><%= noteValue %></textarea>
              </div>
              <div class="form-actions">
                <a class="btn" href="/service/room-inspection">Bỏ chọn</a>
                <button class="btn primary" type="submit" <%= selectedLocked ? "disabled" : "" %>>Lưu cập nhật</button>
              </div>
            </form>
          <% } %>
        </section>

        <section class="history-card">
          <h2>Lịch sử gần đây</h2>
          <% if (!inspectionHistory.length) { %>
            <div class="empty">Chưa có lịch sử kiểm tra phòng.</div>
          <% } else { %>
            <div class="history-list">
              <% inspectionHistory.slice(0, 5).forEach((item) => { %>
                <article class="history-item">
                  <span class="<%= statusClass(item.toStatus) %>"><%= statusText(item.toStatus) %></span>
                  <strong><%= item.roomNumber %> · <%= item.hotelName %></strong>
                  <p><%= formatDateTime(item.happenedAt) %></p>
                  <% if (item.note) { %><p><%= item.note %></p><% } %>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </aside>
    </section>
  </div>
</main>

<script>
  (() => {
    document.querySelectorAll("[data-href]").forEach((row) => {
      row.addEventListener("click", (event) => {
        if (event.target.closest("a,button,input,select,textarea")) return;
        window.location.href = row.getAttribute("data-href");
      });
    });

    const select = document.getElementById("roomCondition");
    const note = document.getElementById("inspectionNote");
    const syncCondition = () => {
      if (!select) return;
      document.querySelectorAll("[data-condition-card]").forEach((card) => {
        card.classList.toggle("is-active", card.getAttribute("data-condition-card") === select.value);
      });
      if (note) {
        const needsNote = ["HuHaiNhe", "HuHaiNang", "DangBaoTri"].includes(select.value);
        note.required = needsNote;
        note.minLength = needsNote ? 8 : 0;
      }
    };
    select?.addEventListener("change", syncCondition);
    syncCondition();
  })();
</script>

<%- include("../partials/footer") %>
