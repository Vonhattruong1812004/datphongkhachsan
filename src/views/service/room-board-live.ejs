<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const roomFeed = payload.roomFeed || { summary: {}, items: [], priorityQueue: [], byHotel: [], generatedAt: null };
  const rooms = roomFeed.items || [];
  const priorityQueue = roomFeed.priorityQueue || [];
  const hotelGroups = roomFeed.byHotel || [];
  const summary = roomFeed.summary || {};
  const pageNotice = (typeof notice !== "undefined" && notice) ? notice : {};
  const roleId = Number((typeof currentUser !== "undefined" && currentUser && currentUser.maVaiTro) || 0);
  const realtimeScopeByRole = { 1: "admin", 2: "letan", 4: "dichvu", 6: "quanly" };
  const realtimeScope = realtimeScopeByRole[roleId] || "dichvu";
  const generatedAtLabel = roomFeed.generatedAt
    ? new Date(roomFeed.generatedAt).toLocaleString("vi-VN", { hour: "2-digit", minute: "2-digit", second: "2-digit", day: "2-digit", month: "2-digit", year: "numeric" })
    : "Đang tải";
  const statusOrder = ["Maintenance", "Cleaning", "Booked", "Stayed", "Available"];
  const statusText = (value) => ({
    Available: "Sẵn sàng",
    Cleaning: "Cần vệ sinh",
    Maintenance: "Bảo trì",
    Booked: "Đã đặt",
    Stayed: "Đang ở"
  }[value] || value || "Chưa rõ");
  const statusClass = (value) => {
    if (value === "Available") return "pill ok";
    if (value === "Cleaning") return "pill info";
    if (value === "Maintenance") return "pill warn";
    if (value === "Booked") return "pill purple";
    if (value === "Stayed") return "pill teal";
    return "pill";
  };
  const statusCount = (state) => Number(summary[
    state === "Maintenance" ? "maintenance" :
      state === "Cleaning" ? "cleaning" :
        state === "Booked" ? "booked" :
          state === "Stayed" ? "stayed" : "available"
  ] || rooms.filter((room) => room.trangThaiRealtime === state).length || 0);
  const boardGroups = statusOrder.map((state) => ({
    state,
    label: statusText(state),
    count: statusCount(state),
    rooms: rooms.filter((room) => room.trangThaiRealtime === state).slice(0, 8)
  }));
  const visibleQueue = priorityQueue.length
    ? priorityQueue.slice(0, 10)
    : rooms.filter((room) => room.trangThaiRealtime !== "Available").slice(0, 10);
  const generatedAtIso = roomFeed.generatedAt || new Date().toISOString();
%>

<style>
  .roomboard-page{
    --blue:#0575e6;
    --blue-dark:#034ea2;
    --ink:#102033;
    --muted:#65758b;
    --line:#cfe2f7;
    --soft:#f3f8ff;
    --green:#07875f;
    min-height:calc(100vh - 84px);
    padding:28px 18px 56px;
    color:var(--ink);
    background:
      linear-gradient(180deg,rgba(235,246,255,.82),rgba(247,251,255,.92)),
      url("/images/san-pham-du-lich.webp") center/cover fixed;
  }
  .roomboard-shell{width:min(1360px,calc(100vw - 40px));margin:0 auto}
  .title-band,.toolbar,.panel,.stat-card,.room-card,.hotel-card{border:1px solid var(--line);background:rgba(255,255,255,.9);box-shadow:0 18px 45px rgba(15,23,42,.08);backdrop-filter:blur(12px) saturate(1.08)}
  .title-band{border-radius:12px;padding:20px 24px;background:linear-gradient(135deg,#087cf0,#034ea2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .title-band h1{margin:0;font-size:34px;line-height:1.05;letter-spacing:-.03em;color:#fff}
  .title-band h1::before{content:"";display:inline-block;width:6px;height:38px;border-radius:999px;background:#fff;margin-right:12px;vertical-align:-7px}
  .title-actions,.live-meta{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap}
  .live-meta{font-size:13px;font-weight:850}
  .live-dot{width:10px;height:10px;border-radius:999px;background:#22c55e;box-shadow:0 0 0 7px rgba(34,197,94,.16)}
  .alert{margin-top:12px;border-radius:10px;padding:12px 14px;font-weight:850}
  .alert.error{background:#fff1f2;color:#be123c;border:1px solid #fecdd3}
  .alert.success{background:#ecfdf5;color:#047857;border:1px solid #bbf7d0}
  .stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin:14px 0}
  .stat-card{border-radius:12px;padding:14px 16px;text-decoration:none;color:var(--ink);transition:transform .15s ease,border-color .15s ease;background:rgba(255,255,255,.9)}
  .stat-card:hover{transform:translateY(-1px);border-color:#9ecbff}
  .stat-card strong{display:block;color:#034ea2;font-size:28px;line-height:1}
  .stat-card span{display:block;margin-top:7px;color:var(--muted);font-size:12px;font-weight:850}
  .stat-card.attention strong{color:#be123c}
  .toolbar{border-radius:12px;padding:14px;margin:14px 0;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .searchbar{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
  details.filter{position:relative}
  details.filter summary{list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;padding:12px 16px;min-width:112px}
  details.filter summary::-webkit-details-marker{display:none}
  .filter-pop{position:absolute;z-index:20;top:54px;left:0;width:640px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 22px 50px rgba(15,23,42,.18);padding:16px}
  .filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .field{display:grid;gap:6px}
  .field label{font-size:12px;color:#334155;font-weight:900}
  .field input,.field select{width:100%;border:1px solid var(--line);border-radius:10px;background:#fff;padding:11px 12px;color:var(--ink);font:inherit}
  .field input:focus,.field select:focus{outline:none;border-color:#0b83ef;box-shadow:0 0 0 3px rgba(11,131,239,.12)}
  .field.search-input{max-width:620px;flex:1}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .btn,.icon-btn{border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;text-decoration:none;cursor:pointer}
  .btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 16px}
  .icon-btn{width:48px;height:48px;display:inline-grid;place-items:center}
  .btn.primary,.icon-btn.primary{background:var(--blue);border-color:transparent;color:#fff}
  .board-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:14px;align-items:start}
  .panel{border-radius:12px;overflow:hidden}
  .panel-head{padding:18px 18px 0}
  .panel-head h2{margin:0;font-size:24px}
  .panel-head p{margin:4px 0 12px;color:var(--muted);font-weight:750}
  .ops-list{display:grid;gap:10px;padding:18px}
  .ops-row{display:grid;grid-template-columns:130px 1fr 150px 100px;gap:12px;align-items:center;border:1px solid var(--line);border-radius:10px;background:#fff;padding:12px;text-decoration:none;color:var(--ink);transition:background .15s ease,border-color .15s ease,transform .15s ease}
  .ops-row:hover{background:#f4f9ff;border-color:#9ecbff;transform:translateY(-1px)}
  .room-code{display:block;color:#06479d;font-weight:950;font-size:19px;line-height:1.1}
  .sub{display:block;color:var(--muted);font-size:13px;line-height:1.45}
  .pill{display:inline-flex;align-items:center;width:max-content;border-radius:999px;padding:6px 10px;background:#eef2f7;color:#475569;font-size:12px;font-weight:900}
  .pill.ok{background:#e9fbf1;color:#07875f}
  .pill.info{background:#eaf6ff;color:#0369a1}
  .pill.warn{background:#fff7ed;color:#c2410c}
  .pill.purple{background:#f3e8ff;color:#6d28d9}
  .pill.teal{background:#e6fffb;color:#0f766e}
  .board-columns{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:14px}
  .board-column{border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.9);box-shadow:0 18px 45px rgba(15,23,42,.08);backdrop-filter:blur(12px) saturate(1.08);overflow:hidden}
  .column-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px;background:#edf3f9;border-bottom:1px solid var(--line)}
  .column-head h3{margin:0;font-size:16px}
  .column-body{display:grid;gap:8px;padding:12px;min-height:120px}
  .room-card{display:block;border-radius:10px;padding:10px;text-decoration:none;color:var(--ink);background:#fff;box-shadow:none}
  .room-card:hover{background:#f4f9ff;border-color:#9ecbff}
  .room-card strong{display:block;color:#06479d;font-size:17px}
  .side-stack{display:grid;gap:14px}
  .hotel-list{display:grid;gap:10px;padding:18px}
  .hotel-card{border-radius:10px;padding:12px;background:#fff;box-shadow:none}
  .hotel-card strong{display:block;font-size:16px}
  .hotel-meter{height:8px;border-radius:999px;background:#e5eef8;overflow:hidden;margin-top:10px}
  .hotel-meter span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#0ea5e9,#034ea2)}
  .mini-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
  .mini-link{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:9px;background:#fff;color:#06479d;text-decoration:none;font-weight:900;min-height:34px;padding:0 10px;font-size:12px}
  .mini-link[aria-disabled="true"]{opacity:.55;pointer-events:none}
  .empty{padding:22px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);background:#f8fbff}
  .hidden{display:none!important}
  @media(max-width:1200px){
    .stats{grid-template-columns:repeat(3,minmax(0,1fr))}
    .board-layout{grid-template-columns:1fr}
    .board-columns{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:760px){
    .roomboard-page{padding:18px 10px 42px}
    .roomboard-shell{width:100%}
    .title-band,.toolbar{align-items:stretch;flex-direction:column}
    .title-band h1{font-size:28px}
    .title-actions,.searchbar{width:100%;flex-wrap:wrap}
    .title-actions .btn{flex:1}
    .filter-pop{width:calc(100vw - 36px)}
    .filter-grid,.stats,.board-columns,.ops-row{grid-template-columns:1fr}
  }
</style>

<main class="roomboard-page">
  <div class="roomboard-shell">
    <section class="title-band">
      <h1>Theo dõi room board</h1>
      <div class="title-actions">
        <div class="live-meta">
          <span class="live-dot"></span>
          <span>Cập nhật: <strong id="boardUpdatedAt"><%= generatedAtLabel %></strong></span>
        </div>
        <a class="btn" href="/dashboard/dichvu">Quay về</a>
        <a class="btn" href="/service/room-inspection">Kiểm tra phòng</a>
      </div>
    </section>

    <% if (pageNotice.error) { %><div class="alert error"><%= pageNotice.error %></div><% } %>
    <% if (pageNotice.success) { %><div class="alert success"><%= pageNotice.success %></div><% } %>

    <section class="stats" aria-label="Tổng quan room board">
      <div class="stat-card attention"><strong id="boardAttention"><%= summary.needsAttention || 0 %></strong><span>Cần xử lý</span></div>
      <div class="stat-card"><strong id="boardMaintenance"><%= summary.maintenance || 0 %></strong><span>Bảo trì</span></div>
      <div class="stat-card"><strong id="boardCleaning"><%= summary.cleaning || 0 %></strong><span>Cần vệ sinh</span></div>
      <div class="stat-card"><strong id="boardBooked"><%= summary.booked || 0 %></strong><span>Đã đặt</span></div>
      <div class="stat-card"><strong id="boardAvailable"><%= summary.available || 0 %></strong><span>Sẵn sàng</span></div>
    </section>

    <section class="toolbar" aria-label="Tìm kiếm room board">
      <div class="searchbar">
        <details class="filter">
          <summary>Bộ lọc</summary>
          <div class="filter-pop">
            <div class="filter-grid">
              <div class="field">
                <label for="boardHotel">Cơ sở</label>
                <select id="boardHotel">
                  <option value="">Tất cả cơ sở</option>
                  <% hotelGroups.forEach((hotel) => { %>
                    <option value="<%= hotel.hotelId %>"><%= hotel.hotelName %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field">
                <label for="boardStatus">Trạng thái</label>
                <select id="boardStatus">
                  <option value="">Tất cả trạng thái</option>
                  <% statusOrder.forEach((status) => { %>
                    <option value="<%= status %>"><%= statusText(status) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="field">
                <label for="boardPriority">Mức xử lý</label>
                <select id="boardPriority">
                  <option value="">Tất cả mức xử lý</option>
                  <option value="maintenance">Ưu tiên bảo trì</option>
                  <option value="cleaning">Cần vệ sinh</option>
                  <option value="booked">Sắp nhận khách</option>
                  <option value="stayed">Đang có khách</option>
                  <option value="available">Sẵn sàng</option>
                </select>
              </div>
            </div>
            <div class="mini-actions" style="justify-content:flex-end">
              <button class="btn" type="button" id="boardReset">Đặt lại</button>
            </div>
          </div>
        </details>
        <div class="field search-input">
          <label class="sr-only" for="boardSearch">Tìm phòng</label>
          <input id="boardSearch" placeholder="Tìm phòng, booking, khách, cơ sở..." />
        </div>
        <button class="icon-btn primary" type="button" id="boardSearchButton" aria-label="Tìm kiếm">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
      </div>
      <button class="btn primary" type="button" id="boardRefresh">Cập nhật</button>
    </section>

    <section class="board-layout">
      <section class="panel">
        <div class="panel-head">
          <h2>Ưu tiên xử lý</h2>
          <p>Hiển thị tối đa 10 phòng cần dịch vụ chú ý trong ca.</p>
        </div>
        <div class="ops-list" id="priorityRows">
          <% if (!visibleQueue.length) { %>
            <div class="empty">Không có phòng cần xử lý trong ca hiện tại.</div>
          <% } else { %>
            <% visibleQueue.forEach((room) => { %>
              <a class="ops-row" href="/service/room-inspection?room_id=<%= room.id %>" data-search="<%= room.searchText || "" %>" data-hotel="<%= room.hotelId || 0 %>" data-status="<%= room.trangThaiRealtime || "" %>" data-priority="<%= room.priorityKey || "" %>">
                <span>
                  <span class="room-code"><%= room.soPhong %></span>
                  <span class="sub"><%= room.loaiPhong || "Chưa rõ loại" %></span>
                </span>
                <span>
                  <strong><%= room.hotelName || "Không rõ cơ sở" %></strong>
                  <span class="sub"><%= room.suggestedAction || "Theo dõi định kỳ" %></span>
                </span>
                <span class="<%= statusClass(room.trangThaiRealtime) %>"><%= statusText(room.trangThaiRealtime) %></span>
                <span class="mini-link"><%= room.canInspect ? "Kiểm tra" : "Theo dõi" %></span>
              </a>
            <% }) %>
          <% } %>
        </div>
      </section>

      <aside class="side-stack">
        <section class="panel">
          <div class="panel-head">
            <h2>Theo cơ sở</h2>
            <p>Cơ sở có nhiều phòng cần chú ý sẽ nổi lên trước.</p>
          </div>
          <div class="hotel-list" id="hotelRows">
            <% if (!hotelGroups.length) { %>
              <div class="empty">Chưa có dữ liệu cơ sở.</div>
            <% } else { %>
              <% hotelGroups.slice(0, 6).forEach((hotel) => {
                const ratio = hotel.total ? Math.round((Number(hotel.needsAttention || 0) / Number(hotel.total || 1)) * 100) : 0;
              %>
                <article class="hotel-card">
                  <strong><%= hotel.hotelName %></strong>
                  <span class="sub"><%= hotel.needsAttention %> cần xử lý / <%= hotel.total %> phòng</span>
                  <div class="hotel-meter" aria-hidden="true"><span style="width:<%= ratio %>%"></span></div>
                </article>
              <% }) %>
            <% } %>
          </div>
        </section>
      </aside>
    </section>

    <section class="board-columns" id="boardColumns">
      <% boardGroups.forEach((group) => { %>
        <section class="board-column" data-column="<%= group.state %>">
          <div class="column-head">
            <h3><%= group.label %></h3>
            <span class="<%= statusClass(group.state) %>"><%= group.count %></span>
          </div>
          <div class="column-body">
            <% if (!group.rooms.length) { %>
              <div class="empty">Không có phòng.</div>
            <% } else { %>
              <% group.rooms.forEach((room) => { %>
                <a class="room-card" href="/service/room-inspection?room_id=<%= room.id %>" data-search="<%= room.searchText || "" %>" data-hotel="<%= room.hotelId || 0 %>" data-status="<%= room.trangThaiRealtime || "" %>" data-priority="<%= room.priorityKey || "" %>">
                  <strong><%= room.soPhong %></strong>
                  <span class="sub"><%= [room.hotelName, room.loaiPhong].filter(Boolean).join(" · ") %></span>
                </a>
              <% }) %>
            <% } %>
          </div>
        </section>
      <% }) %>
    </section>
  </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const searchInput = document.getElementById("boardSearch");
  const searchButton = document.getElementById("boardSearchButton");
  const hotelSelect = document.getElementById("boardHotel");
  const statusSelect = document.getElementById("boardStatus");
  const prioritySelect = document.getElementById("boardPriority");
  const resetButton = document.getElementById("boardReset");
  const refreshButton = document.getElementById("boardRefresh");
  const priorityRows = document.getElementById("priorityRows");
  const boardColumns = document.getElementById("boardColumns");
  const hotelRows = document.getElementById("hotelRows");
  const statusOrder = ["Maintenance", "Cleaning", "Booked", "Stayed", "Available"];

  function escapeHtml(value) {
    return String(value || "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "\"": "&quot;",
      "'": "&#39;"
    }[char]));
  }

  function statusLabel(value) {
    return {
      Available: "Sẵn sàng",
      Cleaning: "Cần vệ sinh",
      Maintenance: "Bảo trì",
      Booked: "Đã đặt",
      Stayed: "Đang ở"
    }[value] || value || "Chưa rõ";
  }

  function statusClass(value) {
    if (value === "Available") return "pill ok";
    if (value === "Cleaning") return "pill info";
    if (value === "Maintenance") return "pill warn";
    if (value === "Booked") return "pill purple";
    if (value === "Stayed") return "pill teal";
    return "pill";
  }

  function setText(id, value) {
    const node = document.getElementById(id);
    if (node) node.textContent = String(value || 0);
  }

  function setUpdatedAt(iso) {
    const node = document.getElementById("boardUpdatedAt");
    if (!node || !iso) return;
    node.textContent = new Date(iso).toLocaleString("vi-VN", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      day: "2-digit",
      month: "2-digit",
      year: "numeric"
    });
  }

  function rowDataAttrs(room) {
    return `data-search="${escapeHtml(room.searchText)}" data-hotel="${escapeHtml(room.hotelId || 0)}" data-status="${escapeHtml(room.trangThaiRealtime)}" data-priority="${escapeHtml(room.priorityKey)}"`;
  }

  function renderPriority(items) {
    if (!priorityRows) return;
    if (!items.length) {
      priorityRows.innerHTML = '<div class="empty">Không có phòng cần xử lý trong ca hiện tại.</div>';
      return;
    }
    priorityRows.innerHTML = items.slice(0, 10).map((room) => `
      <a class="ops-row" href="/service/room-inspection?room_id=${encodeURIComponent(room.id)}" ${rowDataAttrs(room)}>
        <span><span class="room-code">${escapeHtml(room.soPhong)}</span><span class="sub">${escapeHtml(room.loaiPhong || "Chưa rõ loại")}</span></span>
        <span><strong>${escapeHtml(room.hotelName || "Không rõ cơ sở")}</strong><span class="sub">${escapeHtml(room.suggestedAction || "Theo dõi định kỳ")}</span></span>
        <span class="${statusClass(room.trangThaiRealtime)}">${escapeHtml(statusLabel(room.trangThaiRealtime))}</span>
        <span class="mini-link">${room.canInspect ? "Kiểm tra" : "Theo dõi"}</span>
      </a>
    `).join("");
  }

  function renderColumns(items) {
    if (!boardColumns) return;
    boardColumns.innerHTML = statusOrder.map((state) => {
      const group = items.filter((room) => room.trangThaiRealtime === state);
      const cards = group.slice(0, 8).map((room) => `
        <a class="room-card" href="/service/room-inspection?room_id=${encodeURIComponent(room.id)}" ${rowDataAttrs(room)}>
          <strong>${escapeHtml(room.soPhong)}</strong>
          <span class="sub">${escapeHtml([room.hotelName, room.loaiPhong].filter(Boolean).join(" · "))}</span>
        </a>
      `).join("") || '<div class="empty">Không có phòng.</div>';
      return `
        <section class="board-column" data-column="${escapeHtml(state)}">
          <div class="column-head">
            <h3>${escapeHtml(statusLabel(state))}</h3>
            <span class="${statusClass(state)}">${group.length}</span>
          </div>
          <div class="column-body">${cards}</div>
        </section>
      `;
    }).join("");
  }

  function renderHotels(groups) {
    if (!hotelRows) return;
    if (!groups.length) {
      hotelRows.innerHTML = '<div class="empty">Chưa có dữ liệu cơ sở.</div>';
      return;
    }
    hotelRows.innerHTML = groups.slice(0, 6).map((hotel) => {
      const ratio = hotel.total ? Math.round((Number(hotel.needsAttention || 0) / Number(hotel.total || 1)) * 100) : 0;
      return `
        <article class="hotel-card">
          <strong>${escapeHtml(hotel.hotelName)}</strong>
          <span class="sub">${escapeHtml(hotel.needsAttention)} cần xử lý / ${escapeHtml(hotel.total)} phòng</span>
          <div class="hotel-meter" aria-hidden="true"><span style="width:${Math.max(0, Math.min(ratio, 100))}%"></span></div>
        </article>
      `;
    }).join("");
  }

  function applyFilters() {
    const keyword = (searchInput?.value || "").trim().toLowerCase();
    const hotel = hotelSelect?.value || "";
    const status = statusSelect?.value || "";
    const priority = prioritySelect?.value || "";
    document.querySelectorAll("[data-search]").forEach((item) => {
      const matchText = !keyword || (item.dataset.search || "").includes(keyword);
      const matchHotel = !hotel || String(item.dataset.hotel || "") === hotel;
      const matchStatus = !status || String(item.dataset.status || "") === status;
      const matchPriority = !priority || String(item.dataset.priority || "") === priority;
      item.classList.toggle("hidden", !(matchText && matchHotel && matchStatus && matchPriority));
    });
  }

  async function refreshBoard() {
    try {
      const response = await fetch("/api/service/room-feed", { credentials: "same-origin" });
      if (!response.ok) return;
      const payload = await response.json();
      if (!payload?.ok || !payload.data) return;
      const data = payload.data;
      const queueItems = (data.priorityQueue || []).length
        ? data.priorityQueue
        : (data.items || []).filter((room) => room.trangThaiRealtime !== "Available");
      renderPriority(queueItems);
      renderColumns(data.items || []);
      renderHotels(data.byHotel || []);
      setText("boardAttention", data.summary?.needsAttention || 0);
      setText("boardMaintenance", data.summary?.maintenance || 0);
      setText("boardCleaning", data.summary?.cleaning || 0);
      setText("boardBooked", data.summary?.booked || 0);
      setText("boardAvailable", data.summary?.available || 0);
      setUpdatedAt(data.generatedAt);
      applyFilters();
    } catch (_error) {
      // Giữ snapshot hiện tại nếu realtime tạm thời lỗi.
    }
  }

  [searchInput, hotelSelect, statusSelect, prioritySelect].forEach((input) => {
    input?.addEventListener("input", applyFilters);
    input?.addEventListener("change", applyFilters);
  });
  searchButton?.addEventListener("click", applyFilters);
  resetButton?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    if (hotelSelect) hotelSelect.value = "";
    if (statusSelect) statusSelect.value = "";
    if (prioritySelect) prioritySelect.value = "";
    applyFilters();
  });
  refreshButton?.addEventListener("click", refreshBoard);

  if (window.EventSource) {
    const stream = new EventSource("/api/realtime/stream?scope=<%= realtimeScope %>");
    ["room_status_changed", "service_order_created", "service_order_updated"].forEach((eventName) => {
      stream.addEventListener(eventName, refreshBoard);
    });
  }

  window.setInterval(refreshBoard, 30000);
  applyFilters();
  setUpdatedAt("<%= generatedAtIso %>");
});
</script>

<%- include("../partials/footer") %>
