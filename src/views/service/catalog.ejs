<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%
  const safeQuery = (typeof query !== "undefined" && query) ? query : {};
  const pageNotice = (typeof notice !== "undefined" && notice) ? notice : {};
  const catalog = payload.catalog || [];
  const serviceHotelScopeSupported = Boolean(payload.serviceHotelScopeSupported);
  const hotelOptions = payload.hotelOptions || [];
  const filters = payload.filters || {};
  const activeHotelId = Number(payload.activeHotelId || filters.hotelId || safeQuery.hotel_id || 0);
  const categoryOptions = payload.categoryOptions || [
    { key: "all", label: "Tất cả nhóm" },
    { key: "wellness", label: "Wellness" },
    { key: "transport", label: "Di chuyển" },
    { key: "room", label: "Tiện nghi phòng" },
    { key: "dining", label: "Ẩm thực" },
    { key: "other", label: "Trải nghiệm khác" }
  ];
  const selectedAttr = (value, expected) => String(value || "all") === String(expected) ? "selected" : "";
  const checkedFilter = (key) => String(filters.attention || "all") === key ? "selected" : "";
  const statusClass = (status) => status === "HoatDong" ? "pill ok" : (status === "BaoTri" ? "pill warn" : "pill danger");
  const baseQuery = new URLSearchParams();
  if (filters.keyword) baseQuery.set("keyword", filters.keyword);
  if (filters.status && filters.status !== "all") baseQuery.set("status", filters.status);
  if (filters.category && filters.category !== "all") baseQuery.set("category", filters.category);
  if (filters.attention && filters.attention !== "all") baseQuery.set("attention", filters.attention);
  if (activeHotelId) baseQuery.set("hotel_id", String(activeHotelId));
  const withEditQuery = (id) => {
    const params = new URLSearchParams(baseQuery.toString());
    const qs = params.toString();
    return `/service/manage/${id}/edit${qs ? `?${qs}` : ""}`;
  };
  const addUrl = `/service/manage/new${baseQuery.toString() ? `?${baseQuery.toString()}` : ""}`;
  const resetUrl = activeHotelId ? `/service/manage?hotel_id=${activeHotelId}` : "/service/manage";
%>

<style>
  .catalog-page{
    --blue:#0575e6;
    --blue-dark:#034ea2;
    --ink:#102033;
    --muted:#65758b;
    --line:#cfe2f7;
    --soft:#f3f8ff;
    --green:#07875f;
    min-height:calc(100vh - 84px);
    padding:28px 18px 56px;
    color:var(--ink);
    background:
      linear-gradient(180deg,rgba(235,246,255,.88),rgba(247,251,255,.96)),
      url("/images/san-pham-du-lich.webp") center/cover fixed;
  }
  .catalog-shell{width:min(1400px,calc(100vw - 40px));margin:0 auto;display:grid;grid-template-columns:1fr;gap:18px}
  .side-card,.title-band,.toolbar,.panel{border:1px solid var(--line);background:rgba(255,255,255,.94);box-shadow:0 18px 45px rgba(15,23,42,.08)}
  .side-card{align-self:start;border-radius:12px;padding:12px;position:sticky;top:104px;background:rgba(255,255,255,.9);backdrop-filter:blur(14px) saturate(1.08)}
  .side-card h2{margin:2px 4px 10px;font-size:20px;line-height:1.1;color:var(--ink)}
  .side-nav{display:grid;gap:8px}
  .side-nav a{min-height:48px;display:flex;align-items:center;border:1px solid var(--line);border-radius:8px;padding:0 12px;color:#06479d;text-decoration:none;font-size:14px;font-weight:850;background:#fff;transition:background .15s ease,border-color .15s ease,color .15s ease,transform .15s ease}
  .side-nav a:hover{background:#edf6ff;border-color:#9ecbff;transform:translateX(2px)}
  .side-nav a.is-active{background:linear-gradient(135deg,var(--blue),var(--blue-dark));color:#fff;border-color:transparent;box-shadow:0 12px 24px rgba(0,108,228,.18)}
  .title-band{border-radius:12px;padding:20px 24px;background:linear-gradient(135deg,#087cf0,#034ea2);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .title-band h1{margin:0;font-size:34px;line-height:1.05;letter-spacing:-.03em}
  .title-band h1::before{content:"";display:inline-block;width:6px;height:38px;border-radius:999px;background:#fff;margin-right:12px;vertical-align:-7px}
  .alert{margin-top:12px;border-radius:10px;padding:12px 14px;font-weight:850}
  .alert.error{background:#fff1f2;color:#be123c;border:1px solid #fecdd3}
  .alert.success{background:#ecfdf5;color:#047857;border:1px solid #bbf7d0}
  .toolbar{border-radius:12px;padding:14px;margin:14px 0;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .searchbar{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
  .toolbar-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap}
  .import-form{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  details.filter{position:relative}
  details.filter summary{list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;padding:12px 16px;min-width:112px}
  details.filter summary::-webkit-details-marker{display:none}
  .filter-pop{position:absolute;z-index:20;top:54px;left:0;width:720px;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 22px 50px rgba(15,23,42,.18);padding:16px}
  .filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .field{display:grid;gap:6px}
  .field label{font-size:12px;color:#334155;font-weight:900}
  .field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;background:#fff;padding:11px 12px;color:var(--ink);font:inherit}
  .field textarea{min-height:104px;resize:vertical}
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:#0b83ef;box-shadow:0 0 0 3px rgba(11,131,239,.12)}
  .field.search-input{max-width:560px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .btn,.icon-btn{border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;text-decoration:none;cursor:pointer}
  .btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 16px}
  .icon-btn{width:48px;height:48px;display:inline-grid;place-items:center}
  .btn.primary,.icon-btn.primary{background:var(--blue);border-color:transparent;color:#fff}
  .btn.danger{color:#be123c;border-color:#fecdd3;background:#fff1f2}
  .btn:disabled{opacity:.55;cursor:not-allowed}
  .content-grid{display:grid;grid-template-columns:1fr;gap:14px;align-items:start}
  .panel{border-radius:12px;overflow:hidden}
  .table-wrap{overflow:auto}
  .catalog-table{width:100%;border-collapse:separate;border-spacing:0;font-size:14px;min-width:980px}
  .catalog-table thead th{background:#edf3f9;color:#334155;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.04em;padding:14px;border-bottom:1px solid var(--line)}
  .catalog-table tbody td{padding:14px;border-bottom:1px solid #e4eef8;vertical-align:middle}
  .catalog-table tbody tr{background:rgba(255,255,255,.9);cursor:pointer}
  .catalog-table tbody tr:hover{background:#f4f9ff}
  .service-cell{display:grid;grid-template-columns:64px minmax(0,1fr);gap:12px;align-items:center}
  .service-img,.service-img-fallback{width:64px;height:64px;border-radius:10px;border:1px solid var(--line);background:#edf6ff;object-fit:cover}
  .service-img-fallback{display:grid;place-items:center;color:#06479d;font-weight:950}
  .service-name{display:block;color:#06479d;font-weight:950;font-size:17px;line-height:1.2;text-decoration:none}
  .service-name:hover{text-decoration:underline}
  .sub{display:block;color:var(--muted);font-size:13px;line-height:1.45}
  .price{color:#07875f;font-weight:950;font-size:17px}
  .pill{display:inline-flex;align-items:center;width:max-content;border-radius:999px;padding:6px 10px;background:#eef2f7;color:#475569;font-size:12px;font-weight:900}
  .pill.ok{background:#e9fbf1;color:#07875f}
  .pill.warn{background:#fff7ed;color:#c2410c}
  .pill.danger{background:#fff1f2;color:#be123c}
  .pill.blue{background:#eaf6ff;color:#0369a1}
  .row-actions{display:flex;justify-content:center}
  .row-menu{width:38px;height:38px;display:inline-grid;place-items:center;border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;text-decoration:none;font-size:24px;line-height:1;font-weight:950}
  .row-menu:hover{background:#edf6ff;border-color:#9ecbff}
  .empty{padding:24px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);background:#f8fbff}
  .form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:14px;flex-wrap:wrap}
  .list-footer{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;border-top:1px solid var(--line);background:#fff;flex-wrap:wrap}
  .list-footer-info{color:#334155;font-weight:700;font-size:14px}
  .list-footer-info strong{color:var(--ink)}
  .pagination-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .page-size{display:inline-flex;align-items:center;gap:8px;color:var(--muted);font-size:13px;font-weight:850}
  .page-size select{height:38px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink);padding:0 10px;font:inherit;font-weight:850}
  .page-buttons{display:flex;align-items:center;gap:6px}
  .page-btn{min-width:38px;height:38px;border:1px solid var(--line);border-radius:10px;background:#fff;color:#06479d;font-weight:900;cursor:pointer}
  .page-btn.is-active{background:var(--blue);border-color:var(--blue);color:#fff}
  .page-btn:disabled{opacity:.45;cursor:not-allowed;background:#f8fafc;color:#94a3b8}
  @media(max-width:1120px){
    .catalog-shell,.content-grid{grid-template-columns:1fr}
    .side-card{position:static}
    .side-nav{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:720px){
    .catalog-page{padding:18px 10px 42px}
    .catalog-shell{width:100%}
    .title-band,.toolbar{align-items:stretch;flex-direction:column}
    .title-band h1{font-size:28px}
    .searchbar,.toolbar-actions{width:100%;flex-wrap:wrap}
    .toolbar-actions .btn{flex:1}
    .filter-pop{width:calc(100vw - 36px)}
    .filter-grid,.side-nav{grid-template-columns:1fr}
  }
</style>

<main class="catalog-page">
  <div class="catalog-shell">
      <section>
        <section class="title-band">
          <h1>Quản lý dịch vụ</h1>
        </section>

      <% if (pageNotice.error) { %><div class="alert error"><%= pageNotice.error %></div><% } %>
      <% if (pageNotice.success) { %><div class="alert success"><%= pageNotice.success %></div><% } %>

      <form class="toolbar" method="get" action="/service/manage">
        <div class="searchbar">
          <details class="filter">
            <summary>Bộ lọc</summary>
            <div class="filter-pop">
              <div class="filter-grid">
                <% if (serviceHotelScopeSupported) { %>
                  <div class="field">
                    <label for="filter_hotel">Cơ sở</label>
                    <select id="filter_hotel" name="hotel_id">
                      <option value="0">Toàn hệ thống</option>
                      <% hotelOptions.forEach((hotel) => { %>
                        <option value="<%= hotel.id %>" <%= Number(activeHotelId) === Number(hotel.id) ? "selected" : "" %>>
                          <%= hotel.tenKhachSan %><%= hotel.tinhThanh ? ` · ${hotel.tinhThanh}` : "" %>
                        </option>
                      <% }) %>
                    </select>
                  </div>
                <% } %>
                <div class="field">
                  <label for="filter_status">Trạng thái</label>
                  <select id="filter_status" name="status">
                    <option value="all" <%= selectedAttr(filters.status, "all") %>>Tất cả</option>
                    <option value="HoatDong" <%= selectedAttr(filters.status, "HoatDong") %>>Đang phục vụ</option>
                    <option value="BaoTri" <%= selectedAttr(filters.status, "BaoTri") %>>Bảo trì</option>
                    <option value="NgungBan" <%= selectedAttr(filters.status, "NgungBan") %>>Ngưng bán</option>
                  </select>
                </div>
                <div class="field">
                  <label for="filter_category">Nhóm dịch vụ</label>
                  <select id="filter_category" name="category">
                    <% categoryOptions.forEach((item) => { %>
                      <option value="<%= item.key %>" <%= selectedAttr(filters.category, item.key) %>><%= item.label %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="field">
                  <label for="filter_attention">Cần chú ý</label>
                  <select id="filter_attention" name="attention">
                    <option value="all" <%= checkedFilter("all") %>>Tất cả</option>
                    <option value="missing_image" <%= checkedFilter("missing_image") %>>Thiếu ảnh</option>
                    <option value="inactive" <%= checkedFilter("inactive") %>>Bảo trì / ngưng bán</option>
                    <option value="open_orders" <%= checkedFilter("open_orders") %>>Còn order mở</option>
                    <option value="ordered" <%= checkedFilter("ordered") %>>Đã phát sinh</option>
                    <option value="no_usage" <%= checkedFilter("no_usage") %>>Chưa phát sinh</option>
                  </select>
                </div>
              </div>
              <div class="form-actions">
                <a class="btn" href="<%= resetUrl %>">Đặt lại</a>
                <button class="btn primary" type="submit">Áp dụng</button>
              </div>
            </div>
          </details>
          <div class="field search-input">
            <label class="sr-only" for="filter_keyword">Tìm dịch vụ</label>
            <input id="filter_keyword" name="keyword" value="<%= filters.keyword || "" %>" placeholder="Tìm tên dịch vụ, mô tả..." />
          </div>
          <button class="icon-btn primary" type="submit" aria-label="Tìm kiếm">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="toolbar-actions">
          <button class="btn" type="button" data-service-import-trigger>Import dịch vụ mới</button>
          <a class="btn primary" href="<%= addUrl %>">Thêm dịch vụ</a>
        </div>
      </form>
      <form class="import-form" method="post" action="/service/manage/import?hotel_id=<%= activeHotelId || 0 %>" enctype="multipart/form-data" data-service-import-form>
        <input type="hidden" name="hotel_id" value="<%= activeHotelId || 0 %>" />
        <input type="file" name="import_file" accept=".csv,.xlsx,.xls" data-service-import-input aria-label="Chọn file import dịch vụ" />
      </form>

      <section class="content-grid">
        <section class="panel">
          <div class="table-wrap">
            <% if (!catalog.length) { %>
              <div class="empty">Không có dịch vụ nào khớp bộ lọc hiện tại.</div>
            <% } else { %>
              <table class="catalog-table">
                <thead>
                  <tr>
                    <th>Dịch vụ</th>
                    <th>Cơ sở</th>
                    <th>Nhóm</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th>Lượt dùng</th>
                    <th>Doanh thu 30 ngày</th>
                    <th>Hành động</th>
                  </tr>
                </thead>
                <tbody>
                  <% catalog.forEach((item) => { %>
                    <tr data-service-row data-edit-url="<%= withEditQuery(item.id) %>">
                      <td>
                        <div class="service-cell">
                          <% if (item.imageUrl) { %>
                            <img class="service-img" src="<%= item.imageUrl %>" alt="Ảnh <%= item.tenDichVu %>" onerror="this.replaceWith(Object.assign(document.createElement('div'), { className: 'service-img-fallback', textContent: 'DV' }))" />
                          <% } else { %>
                            <div class="service-img-fallback" aria-hidden="true">DV</div>
                          <% } %>
                          <div>
                            <a class="service-name" href="<%= withEditQuery(item.id) %>"><%= item.tenDichVu %></a>
                            <span class="sub"><%= item.moTa || "Chưa có mô tả" %></span>
                          </div>
                        </div>
                      </td>
                      <td>
                        <strong><%= item.hotelLabel || "Toàn hệ thống" %></strong>
                        <% if (item.openOrderCount) { %><span class="sub"><%= item.openOrderCount %> order mở</span><% } %>
                      </td>
                      <td><span class="pill blue"><%= item.category?.label || "Trải nghiệm khác" %></span></td>
                      <td><span class="price"><%= item.giaDichVuFormatted %></span></td>
                      <td><span class="<%= statusClass(item.trangThai) %>"><%= item.statusLabel %></span></td>
                      <td>
                        <strong><%= item.orderCount || 0 %></strong>
                        <span class="sub">30 ngày: <%= item.orderCount30Days || 0 %></span>
                      </td>
                      <td><strong><%= item.revenue30DaysFormatted %></strong></td>
                      <td>
                        <div class="row-actions">
                          <a class="row-menu" href="<%= withEditQuery(item.id) %>" aria-label="Chỉnh sửa <%= item.tenDichVu %>">...</a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <footer class="list-footer" data-service-pagination>
                <div class="list-footer-info" data-service-page-info>
                  Hiển thị <strong>0-0</strong> trong tổng số <strong><%= catalog.length %></strong> bản ghi
                </div>
                <div class="pagination-controls">
                  <label class="page-size">
                    <span>Hiển thị</span>
                    <select data-service-page-size aria-label="Số dòng hiển thị">
                      <option value="10" selected>10</option>
                      <option value="20">20</option>
                      <option value="50">50</option>
                    </select>
                  </label>
                  <div class="page-buttons">
                    <button class="page-btn" type="button" data-service-prev>Trước</button>
                    <span data-service-pages></span>
                    <button class="page-btn" type="button" data-service-next>Sau</button>
                  </div>
                </div>
              </footer>
            <% } %>
          </div>
        </section>

      </section>
    </section>
  </div>
</main>

<script>
  (() => {
    const importTrigger = document.querySelector("[data-service-import-trigger]");
    const importInput = document.querySelector("[data-service-import-input]");
    const importForm = document.querySelector("[data-service-import-form]");
    if (importTrigger && importInput && importForm) {
      importTrigger.addEventListener("click", () => importInput.click());
      importInput.addEventListener("change", () => {
        if (!importInput.files || !importInput.files.length) return;
        importTrigger.textContent = "Đang import...";
        importTrigger.setAttribute("disabled", "disabled");
        importForm.submit();
      });
    }

    const rows = Array.from(document.querySelectorAll("[data-service-row]"));
    const pagination = document.querySelector("[data-service-pagination]");
    const pageInfo = document.querySelector("[data-service-page-info]");
    const pageSizeSelect = document.querySelector("[data-service-page-size]");
    const pagePrev = document.querySelector("[data-service-prev]");
    const pageNext = document.querySelector("[data-service-next]");
    const pageNumbers = document.querySelector("[data-service-pages]");
    let currentPage = 1;

    if (!rows.length || !pagination || !pageInfo || !pageSizeSelect || !pagePrev || !pageNext || !pageNumbers) {
      return;
    }

    rows.forEach((row) => {
      row.addEventListener("click", (event) => {
        if (event.target.closest("a,button,input,select,textarea,summary")) return;
        const editUrl = row.getAttribute("data-edit-url");
        if (editUrl) window.location.href = editUrl;
      });
    });

    const getPageSize = () => Math.max(1, Number(pageSizeSelect.value || 10));
    const renderPageButton = (page, totalPages) => {
      if (page === "...") return '<span class="page-ellipsis">...</span>';
      return `<button class="page-btn ${page === currentPage ? "is-active" : ""}" type="button" data-page="${page}" ${page === currentPage ? 'aria-current="page"' : ""}>${page}</button>`;
    };

    const visiblePages = (totalPages) => {
      const pages = new Set([1, totalPages, currentPage, currentPage - 1, currentPage + 1]);
      return [...pages]
        .filter((page) => page >= 1 && page <= totalPages)
        .sort((a, b) => a - b)
        .reduce((items, page, index, array) => {
          if (index > 0 && page - array[index - 1] > 1) items.push("...");
          items.push(page);
          return items;
        }, []);
    };

    const render = () => {
      const totalRows = rows.length;
      const pageSize = getPageSize();
      const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
      currentPage = Math.min(Math.max(1, currentPage), totalPages);
      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = Math.min(startIndex + pageSize, totalRows);

      rows.forEach((row, index) => {
        row.style.display = index >= startIndex && index < endIndex ? "" : "none";
      });

      pageInfo.innerHTML = `Hiển thị <strong>${totalRows ? startIndex + 1 : 0}-${endIndex}</strong> trong tổng số <strong>${totalRows}</strong> bản ghi`;
      pagePrev.disabled = currentPage <= 1;
      pageNext.disabled = currentPage >= totalPages;
      pageNumbers.innerHTML = visiblePages(totalPages).map((page) => renderPageButton(page, totalPages)).join("");
      pagination.style.display = "";
    };

    pageSizeSelect.addEventListener("change", () => {
      currentPage = 1;
      render();
    });
    pagePrev.addEventListener("click", () => {
      currentPage -= 1;
      render();
    });
    pageNext.addEventListener("click", () => {
      currentPage += 1;
      render();
    });
    pageNumbers.addEventListener("click", (event) => {
      const button = event.target.closest("[data-page]");
      if (!button) return;
      currentPage = Number(button.getAttribute("data-page") || 1);
      render();
    });

    render();
  })();
</script>

<%- include("../partials/footer") %>
