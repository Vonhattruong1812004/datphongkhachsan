NODE_ENV=development
PORT=3010
APP_NAME=Bento Booking
APP_PUBLIC_URL=http://127.0.0.1:3010
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
SESSION_SECRET=change_me
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=abc_resort1
PGSCHEMA=abc_resort1
# Local-only public map discovery; production requires your own HTTPS Overpass endpoint.
AI_NEARBY_DISCOVERY=true
AI_NEARBY_OVERPASS_URL=
# shadow: predict without changing routes; on: experimental hybrid; off: rules only.
AI_INTENT_MODEL=shadow
# Optional semantic candidate: off by default; shadow NEVER changes booking or replies.
# Prepare the pinned encoder with npm run ai:semantic:encode -- --download first.
AI_SEMANTIC_MODEL=off
AI_MODEL_CACHE=ml/cache/models
